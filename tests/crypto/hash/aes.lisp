(defpackage #:clempo.aes.tests (:use #:cl #:clempo.base #:clempo.aes))
(in-package #:clempo.aes.tests)

(deftest aes-fips-197 ()
  (let ((block (hex->octets "00112233445566778899aabbccddeeff")))
    (is-equalp (hex->octets "69c4e0d86a7b0430d8cdb78070b4c55a")
               (aes-encrypt-block (make-aes (hex->octets "000102030405060708090a0b0c0d0e0f")) block))
    (is-equalp (hex->octets "8ea2b7ca516745bfeafc49904b496089")
               (aes-encrypt-block (make-aes (hex->octets "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")) block block))))

(deftest ctr-sp-800-38a-f5 ()
  (let* ((key (hex->octets "2b7e151628aed2a6abf7158809cf4f3c"))
         (iv (hex->octets "f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"))
         (aes (make-aes key)) (ctx (make-aes-ctr aes iv))
         (data (hex->octets "6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51"))
         (out (copy-seq data)))
    (aes-ctr-xor ctx out :end 7 :out out)
    (aes-ctr-xor ctx out :start 7 :out out :out-start 7)
    (is-equalp (hex->octets "874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff") out)
    (is-equalp data (aes-ctr-xor (make-aes-ctr aes iv) out))))
