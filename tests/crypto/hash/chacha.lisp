(defpackage #:clempo.chacha.tests (:use #:cl #:clempo.base #:clempo.chacha20poly1305))
(in-package #:clempo.chacha.tests)

(deftest chacha20-rfc-8439-block ()
  (is-equalp (hex->octets "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e")
             (chacha20-xor (hex->octets "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
                           (hex->octets "000000090000004a00000000") (make-octets 64) :counter 1)))

(deftest aead-rfc-8439 ()
  (let* ((key (hex->octets "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"))
         (nonce (hex->octets "070000004041424344454647"))
         (aad (hex->octets "50515253c0c1c2c3c4c5c6c7"))
         (message (string->octets "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."))
         (sealed (aead-encrypt key nonce message :aad aad)))
    (is-equalp (hex->octets "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691") sealed)
    (is-equalp message (aead-decrypt key nonce sealed :aad aad))
    (is (null (aead-decrypt key nonce sealed)))
    (setf (aref sealed 0) (logxor 1 (aref sealed 0)))
    (is (null (aead-decrypt key nonce sealed :aad aad)))))
