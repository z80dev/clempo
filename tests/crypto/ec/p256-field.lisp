(defpackage #:clempo.p256.tests
  (:use #:cl #:clempo.base))
(in-package #:clempo.p256.tests)

(defun residue-integer (arena offset multiply)
  (let ((out (make-array 4 :element-type '(unsigned-byte 64) :initial-element 0)))
    (funcall multiply out 0 arena offset clempo.p256::*p256-integer-one* 0)
    (loop for i below 4 sum (ash (aref out i) (* i 64)))))

(defmacro define-residue-tests (name modulus import multiply add subtract inverse one)
  `(deftest ,name ()
     (let* ((p ,modulus)
            (arena (make-array 32 :element-type '(unsigned-byte 64) :initial-element 17))
            (boundaries (append (list 0 1 2 (1- p) (- p 2) (ash p -1))
                                (loop for bit from 32 to 224 by 32
                                      append (list (1- (ash 1 bit)) (ash 1 bit) (1+ (ash 1 bit)))))))
       (labels ((value (offset) (residue-integer arena offset #',multiply))
                (check (a b)
                  (,import arena 1 a) (,import arena 5 b)
                  (is= a (value 1)) (is= b (value 5))
                  (,multiply arena 9 arena 1 arena 5)
                  (is= (mod (* a b) p) (value 9))
                  (,add arena 9 arena 1 arena 5)
                  (is= (mod (+ a b) p) (value 9))
                  (,subtract arena 9 arena 1 arena 5)
                  (is= (mod (- a b) p) (value 9))
                  ;; Both exact output/input aliases and square alias.
                  (,multiply arena 1 arena 1 arena 5)
                  (is= (mod (* a b) p) (value 1))
                  (,import arena 1 a)
                  (,multiply arena 5 arena 1 arena 5)
                  (is= (mod (* a b) p) (value 5))
                  (,multiply arena 1 arena 1 arena 1)
                  (is= (mod (* a a) p) (value 1))
                  (,import arena 1 a) (,import arena 5 b)
                  (,add arena 1 arena 1 arena 5)
                  (is= (mod (+ a b) p) (value 1))
                  (,import arena 1 a)
                  (,subtract arena 5 arena 1 arena 5)
                  (is= (mod (- a b) p) (value 5))
                  (is= 17 (aref arena 0)) (is= 17 (aref arena 31))))
         (dolist (a boundaries)
           (dolist (b boundaries) (check a b))
           (unless (zerop a)
             (,import arena 1 a)
             (,inverse arena 1 arena 1 arena 13)
             (is= (clempo.ec:invert a p) (value 1))
             (,import arena 5 a)
             (,multiply arena 9 arena 1 arena 5)
             (,one arena 21)
             (is (clempo.p256::p256-equal-p arena 9 arena 21))))
         (let ((state 1))
           (flet ((next ()
                    (setf state (mod (+ (* state #x5851f42d4c957f2d) #x14057b7ef767814f) p))))
             (dotimes (i 4096) (check (next) (next)))))))))

(define-residue-tests p256-field-products clempo.p256:+p256-p+
  clempo.p256::pf-from-integer! clempo.p256::pf-mul!
  clempo.p256::pf-add! clempo.p256::pf-sub! clempo.p256::pf-inv! clempo.p256::pf-one!)
(define-residue-tests p256-scalar-products clempo.p256:+p256-n+
  clempo.p256::ps-from-integer! clempo.p256::ps-mul!
  clempo.p256::ps-add! clempo.p256::ps-sub! clempo.p256::ps-inv! clempo.p256::ps-one!)
