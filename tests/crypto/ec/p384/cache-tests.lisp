(in-package #:clempo.p384.tests)

(deftest p384-word-mac-oracle ()
  (let ((words (list 0 1 #xffffffff (1- (ash 1 63)) (ash 1 63) (1- (ash 1 64)))))
    (dolist (a words)
      (dolist (b words)
        (dolist (c words)
          (dolist (d words)
            (let ((expected (+ (* a b) c d)))
              (when (= b #xffffffffffffffff)
                (multiple-value-bind (hi lo) (clempo.p384::p384-mul-add-minus-one a c d)
                  (is= (ldb (byte 64 0) expected) lo)
                  (is= (ash expected -64) hi)))
              (multiple-value-bind (hi lo) (clempo.p384::p384-mul-add-word a b c d)
                (is= (ldb (byte 64 0) expected) lo)
                (is= (ash expected -64) hi)))))))))

(deftest p384-native-mixed-addition ()
  (let* ((scratch (make-p384-scratch))
         (a (clempo.p384::p384-scratch-arena scratch)) (g (p384-test-g)))
    (dolist (n '(0 1 2 7 31))
      (let ((p (p384-reference-mul g n)))
        (p384-test-import a 0 p) (p384-test-import a 18 g)
        (clempo.p384::p384-jadd-affine! a 18 a 0 a 18 a 216)
        (is-equalp (p384-reference-add p g) (p384-test-affine a 18))
        (p384-test-import a 0 p) (p384-test-import a 18 g)
        (clempo.p384::p384-jadd-affine! a 0 a 0 a 18 a 216)
        (is-equalp (p384-reference-add p g) (p384-test-affine a 0))))
    (p384-test-import a 0 g)
    (p384-test-import a 18 (cons (car g) (- +p384-p+ (cdr g))))
    (clempo.p384::p384-jadd-affine! a 0 a 0 a 18 a 216)
    (is (null (p384-test-affine a 0)))
    (p384-test-import a 0 g) (clempo.p384::p384-jzero! a 18)
    (clempo.p384::p384-jadd-affine! a 0 a 0 a 18 a 216)
    (is-equalp g (p384-test-affine a 0))))

(deftest p384-cache-key-and-positive-only ()
  (let* ((scratch (make-p384-scratch :memoize t))
         (cache (clempo.p384::p384-scratch-cache scratch))
         (g (p384-test-g)) (r (car g)) (s (1+ r))
         (hash (integer->octets 1 48)))
    (is (null (clempo.p384::p384-scratch-cache (make-p384-scratch))))
    (is (null *p384-scratch*))
    (is (p384-verify hash r s (car g) (cdr g) scratch))
    (is= 1 (clempo.p384::p384-verification-cache-count cache))
    (is (clempo.p384::p384-cache-hit-p cache hash r s (car g) (cdr g)))
    ;; The memo owns the digest bytes, not the caller's mutable vector.
    (setf (aref hash 47) 2)
    (is (not (p384-verify hash r s (car g) (cdr g) scratch)))
    (setf (aref hash 47) 1)
    (is (p384-verify hash r s (car g) (cdr g) scratch))
    (is (not (p384-verify hash (1+ r) s (car g) (cdr g) scratch)))
    (is (not (p384-verify hash r (1+ s) (car g) (cdr g) scratch)))
    (is (not (p384-verify hash r s (car g) (- +p384-p+ (cdr g)) scratch)))
    (is (not (p384-verify hash r s 0 0 scratch)))
    (is (not (p384-verify (make-octets 47) r s (car g) (cdr g) scratch)))
    (is (not (p384-verify hash 0 s (car g) (cdr g) scratch)))
    (is= 1 (clempo.p384::p384-verification-cache-count cache))
    (is (p384-verify hash r (- +p384-n+ s) (car g) (cdr g) scratch))
    (is= 2 (clempo.p384::p384-verification-cache-count cache))
    (let ((*p384-scratch* scratch))
      (is (p384-verify hash r s (car g) (cdr g))))))

(deftest p384-cache-bounded-and-isolated ()
  (let* ((scratch (make-p384-scratch :memoize t))
         (other (make-p384-scratch :memoize t))
         (cache (clempo.p384::p384-scratch-cache scratch))
         (g (p384-test-g)) (r (car g)))
    (loop for z from 1 to 70 do
      (is (p384-verify (integer->octets z 48) r (+ r z) (car g) (cdr g) scratch)))
    (is= 64 (clempo.p384::p384-verification-cache-count cache))
    (is (not (clempo.p384::p384-cache-hit-p cache (integer->octets 1 48) r (1+ r) (car g) (cdr g))))
    (is (clempo.p384::p384-cache-hit-p cache (integer->octets 70 48) r (+ r 70) (car g) (cdr g)))
    (is= 0 (clempo.p384::p384-verification-cache-count (clempo.p384::p384-scratch-cache other)))
    (is (not (eq (clempo.p384::p384-scratch-arena scratch)
                 (clempo.p384::p384-scratch-arena other))))))

(deftest p384-cache-wycheproof-parity ()
  (let ((memo (make-p384-scratch :memoize t)) (plain (make-p384-scratch)))
    (dolist (row (fixture-data "wycheproof.sexp"))
      (destructuring-bind (id hash r s x y expected) row
        (declare (ignore id expected))
        (let* ((digest (hex->octets hash)) (truth (p384-verify digest r s x y plain)))
          (is= truth (p384-verify digest r s x y memo))
          (is= truth (p384-verify digest r s x y memo)))))))

(defun p384-cache-batch (rows scratch)
  (declare #.clempo.base:*hot* (type simple-vector rows))
  (let ((valid 0))
    (declare (type fixnum valid))
    (dotimes (i (length rows) valid)
      (let ((row (the simple-vector (svref rows i))))
        (when (p384-verify (svref row 0) (svref row 1) (svref row 2)
                           (svref row 3) (svref row 4) scratch)
          (incf valid))))))

(deftest p384-public-zero-cons-with-cold-and-warm-cache ()
  (let* ((rows (make-array 16)) (g (p384-test-g)) (r (car g)))
    (dotimes (i 16)
      (setf (svref rows i) (vector (integer->octets (1+ i) 48) r (+ r i 1) (car g) (cdr g))))
    (dolist (memoize '(nil t))
      (let* ((scratch (make-p384-scratch :memoize memoize))
             (cache (clempo.p384::p384-scratch-cache scratch)))
        (is= 16 (p384-cache-batch rows scratch))
        (when cache
          (setf (clempo.p384::p384-verification-cache-count cache) 0
                (clempo.p384::p384-verification-cache-next cache) 0))
        (dotimes (pass 2)
          (let* ((before (sb-ext:get-bytes-consed))
                 (valid (loop repeat 64 sum
                          (progn
                            (when (and cache (zerop pass))
                              (setf (clempo.p384::p384-verification-cache-count cache) 0
                                    (clempo.p384::p384-verification-cache-next cache) 0))
                            (p384-cache-batch rows scratch))))
                 (allocated (- (sb-ext:get-bytes-consed) before)))
            (is= 1024 valid) (is= 0 allocated)))))))
