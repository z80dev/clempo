;;; Integer oracles live only in this file. No native result is decoded using
;;; the production conversion routine when checking arithmetic correctness.
(defpackage #:clempo.p384.field-tests
  (:use #:cl #:clempo.base))
(in-package #:clempo.p384.field-tests)

(defun field-arena (words &optional (initial 0))
  (make-array words :element-type '(unsigned-byte 64) :initial-element initial))

(defun field-raw-integer (a offset)
  (loop for i below 6 sum (ash (aref a (+ offset i)) (* i 64))))

(defun field-store-raw (a offset integer)
  (dotimes (i 6)
    (setf (aref a (+ offset i)) (ldb (byte 64 (* i 64)) integer))))

(defun field-power (base exponent modulus)
  (let ((result 1))
    (loop while (plusp exponent) do
      (when (oddp exponent) (setf result (mod (* result base) modulus)))
      (setf exponent (ash exponent -1) base (mod (* base base) modulus)))
    result))

(defun field-boundaries (p)
  (remove-duplicates
   (append (list 0 1 2 3 (1- p) (- p 2) (- p 3) (ash p -1)
                 most-positive-fixnum (1+ most-positive-fixnum))
           (loop for bit in '(1 31 32 63 64 65 127 128 129 191 192 193
                             255 256 257 319 320 321 382 383)
                 append (loop for delta in '(-1 0 1)
                              collect (mod (+ (ash 1 bit) delta) p)))
           (loop for byte in '(#x55 #xaa #xff)
                 collect (mod (loop for i below 48 sum (ash byte (* i 8))) p)))))

(defun field-check-sentinels (a offset words sentinel)
  (loop for i below offset do (is= sentinel (aref a i)))
  (loop for i from (+ offset words) below (length a) do (is= sentinel (aref a i))))

(defun field-check-binary (function operation a b p r-inverse &optional raw)
  (let* ((sentinel #xdabacafef00dfeed)
         (x (field-arena 10 sentinel)) (y (field-arena 12 sentinel))
         (out (field-arena 11 sentinel))
         (r (mod (ash 1 384) p))
         ;; For ordinary inputs, store Montgomery encodings via an independent
         ;; integer calculation. Raw tests deliberately exercise p-1 in the
         ;; machine representation (conversion permutes boundary cases).
         (ar (if raw a (mod (* a r) p)))
         (br (if raw b (mod (* b r) p)))
         (expected (mod (funcall operation a b) p)))
    (field-store-raw x 1 ar)
    (field-store-raw y 3 br)
    (funcall function out 2 x 1 y 3)
    (is= expected (if raw (field-raw-integer out 2)
                     (mod (* (field-raw-integer out 2) r-inverse) p)))
    (is (< (field-raw-integer out 2) p))
    (is= ar (field-raw-integer x 1))
    (is= br (field-raw-integer y 3))
    (funcall function x 1 x 1 y 3)
    (is= expected (if raw (field-raw-integer x 1)
                     (mod (* (field-raw-integer x 1) r-inverse) p)))
    (is (< (field-raw-integer x 1) p))
    (field-store-raw x 1 ar)
    (funcall function y 3 x 1 y 3)
    (is= expected (if raw (field-raw-integer y 3)
                     (mod (* (field-raw-integer y 3) r-inverse) p)))
    (is (< (field-raw-integer y 3) p))
    (field-check-sentinels x 1 6 sentinel)
    (field-check-sentinels y 3 6 sentinel)
    (field-check-sentinels out 2 6 sentinel)))

(deftest p384-raw-word-operations ()
  (let* ((sentinel #xc5a55a5af00dcafe)
         (a (field-arena 11 sentinel)) (b (field-arena 12 sentinel)))
    (field-store-raw a 3 (1- (ash 1 384)))
    (clempo.p384::p384-copy! b 2 a 3)
    (is (clempo.p384::p384-equal-p a 3 b 2))
    (clempo.p384::p384-copy! b 2 b 2)
    (is (clempo.p384::p384-equal-p a 3 b 2))
    (dotimes (i 6)
      (setf (aref b (+ i 2)) (logxor 1 (aref b (+ i 2))))
      (is (not (clempo.p384::p384-equal-p a 3 b 2)))
      (setf (aref b (+ i 2)) (logxor 1 (aref b (+ i 2)))))
    (clempo.p384::p384-zero! a 3)
    (is (clempo.p384::p384-zero-p a 3))
    (dotimes (i 6)
      (setf (aref a (+ i 3)) 1)
      (is (not (clempo.p384::p384-zero-p a 3)))
      (setf (aref a (+ i 3)) 0))
    (field-check-sentinels a 3 6 sentinel)
    (field-check-sentinels b 2 6 sentinel)))

(defmacro define-field-tests (prefix modulus)
  (labels ((native (suffix) (intern (format nil "~A-~A" prefix suffix) '#:clempo.p384))
           (test-name (suffix) (intern (format nil "P384-~A-~A" prefix suffix))))
    `(progn
       (deftest ,(test-name "CONVERSIONS") ()
         (let* ((p ,modulus) (r (mod (ash 1 384) p))
                (sentinel #xc5a55a5af00dcafe) (a (field-arena 11 sentinel))
                (b (field-arena 12 sentinel)))
           (dolist (n (field-boundaries p))
             (,(native "FROM-INTEGER!") a 3 n)
             (is= (mod (* n r) p) (field-raw-integer a 3))
             (is (< (field-raw-integer a 3) p))
             (,(native "TO-ORDINARY!") b 2 a 3)
             (is= n (field-raw-integer b 2))
             (,(native "TO-ORDINARY!") a 3 a 3)
             (is= n (field-raw-integer a 3)))
           (,(native "ONE!") a 3)
           (is= r (field-raw-integer a 3))
           (field-check-sentinels a 3 6 sentinel)
           (field-check-sentinels b 2 6 sentinel)))
       (deftest ,(test-name "BOUNDARY-ARITHMETIC") ()
         (let* ((p ,modulus) (ri (field-power (mod (ash 1 384) p) (- p 2) p))
                (values (field-boundaries p)))
           (dolist (a values)
             (dolist (b values)
               (field-check-binary #',(native "MUL!") #'* a b p ri)
               (field-check-binary #',(native "ADD!") #'+ a b p ri)
               (field-check-binary #',(native "SUB!") #'- a b p ri)
               ;; Near-R operands force the thirteenth-word REDC path and
               ;; carry/borrow chains across all six words.
               (field-check-binary #',(native "MUL!") (lambda (x y) (* x y ri)) a b p ri t)
               (field-check-binary #',(native "ADD!") #'+ a b p ri t)
               (field-check-binary #',(native "SUB!") #'- a b p ri t)))))
       (deftest ,(test-name "RANDOM-ARITHMETIC") ()
         (let* ((p ,modulus) (ri (field-power (mod (ash 1 384) p) (- p 2) p))
                (state #x123456789abcdef0123456789abcdef0123456789abcdef))
           ;; Deterministic integer PRNG, not global RANDOM or external entropy.
           (flet ((next () (setf state (mod (+ (* state #x5851f42d4c957f2d)
                                               #x14057b7ef767814f) p))))
             (dotimes (i 1024)
               (let ((a (next)) (b (next)))
                 (field-check-binary #',(native "MUL!") #'* a b p ri)
                 (field-check-binary #',(native "ADD!") #'+ a b p ri)
                 (field-check-binary #',(native "SUB!") #'- a b p ri)
                 (field-check-binary #',(native "MUL!") (lambda (x y) (* x y ri)) a b p ri t)
                 (let ((arena (field-arena 17 #xcafefeeddeadbeef)))
                   (,(native "FROM-INTEGER!") arena 1 a)
                   (,(native "NEG!") arena 9 arena 1)
                   (is= (mod (- a) p) (mod (* (field-raw-integer arena 9) ri) p))
                   (is (< (field-raw-integer arena 9) p))
                   (,(native "NEG!") arena 1 arena 1)
                   (is= (field-raw-integer arena 9) (field-raw-integer arena 1))
                   (dolist (j '(0 7 8 15 16))
                     (is= #xcafefeeddeadbeef (aref arena j)))))))))
       (deftest ,(test-name "UNARY-AND-INVERSE") ()
         (let* ((p ,modulus) (r (mod (ash 1 384) p))
                (ri (field-power r (- p 2) p))
                (sentinel #xfedcba9876543210) (arena (field-arena 43 sentinel)))
           ;; Coordinates at 1 and 10; exactly twelve scratch words at 23.
           (dolist (a (field-boundaries p))
             (,(native "FROM-INTEGER!") arena 1 a)
             (,(native "SQUARE!") arena 10 arena 1)
             (is= (mod (* a a) p) (mod (* (field-raw-integer arena 10) ri) p))
             (,(native "SQUARE!") arena 1 arena 1)
             (is= (mod (* a a) p) (mod (* (field-raw-integer arena 1) ri) p))
             (,(native "FROM-INTEGER!") arena 1 a)
             (,(native "NEG!") arena 10 arena 1)
             (is= (mod (- a) p) (mod (* (field-raw-integer arena 10) ri) p))
             (is (< (field-raw-integer arena 10) p))
             (,(native "NEG!") arena 1 arena 1)
             (is= (mod (- a) p) (mod (* (field-raw-integer arena 1) ri) p))
             (,(native "NEG!") arena 1 arena 1)
             (is= a (mod (* (field-raw-integer arena 1) ri) p))
             (,(native "MUL!") arena 1 arena 1 arena 1)
             (is= (mod (* a a) p) (mod (* (field-raw-integer arena 1) ri) p))
             (,(native "FROM-INTEGER!") arena 1 a)
             (,(native "ADD!") arena 1 arena 1 arena 1)
             (is= (mod (+ a a) p) (mod (* (field-raw-integer arena 1) ri) p))
             (,(native "SUB!") arena 1 arena 1 arena 1)
             (is (clempo.p384::p384-zero-p arena 1))
             (,(native "FROM-INTEGER!") arena 1 a)
             (,(native "INV!") arena 10 arena 1 arena 23)
             (is= (field-power a (- p 2) p) (mod (* (field-raw-integer arena 10) ri) p))
             (is= (mod (* a r) p) (field-raw-integer arena 1))
             (is (< (field-raw-integer arena 10) p))
             (,(native "MUL!") arena 10 arena 10 arena 1)
             (is= (if (zerop a) 0 r) (field-raw-integer arena 10))
             (,(native "INV!") arena 1 arena 1 arena 23)
             (is= (field-power a (- p 2) p) (mod (* (field-raw-integer arena 1) ri) p)))
           ;; Native exponent identities via repeated squaring/multiply, with
           ;; a separate integer oracle, including full-width exponents.
           (dolist (a (list 0 1 2 17 (1- p)))
             (dolist (exponent (list 0 1 2 3 63 64 65 (1- (ash 1 64))
                                    (ash 1 64) (1+ (ash 1 128)) (1- p) p))
               (,(native "FROM-INTEGER!") arena 1 a)
               (,(native "ONE!") arena 10)
               (loop for bit downfrom (1- (integer-length exponent)) to 0 do
                 (,(native "SQUARE!") arena 10 arena 10)
                 (when (logbitp bit exponent)
                   (,(native "MUL!") arena 10 arena 10 arena 1)))
               (is= (field-power a exponent p) (mod (* (field-raw-integer arena 10) ri) p))))
           (dolist (i '(0 7 8 9 16 17 18 19 20 21 22 35 36 37 38 39 40 41 42))
             (is= sentinel (aref arena i)))))
       (defun ,(test-name "ALLOCATION-BATCH") (arena canonical count)
         (declare #.clempo.base:*hot* (type clempo.p384::p384-arena arena)
                  (type (integer 0 ,(1- (symbol-value modulus))) canonical) (type fixnum count))
         (dotimes (i count)
           (,(native "FROM-INTEGER!") arena 0 canonical)
           (,(native "FROM-INTEGER!") arena 6 7)
           (,(native "MUL!") arena 12 arena 0 arena 6)
           (,(native "SQUARE!") arena 12 arena 12)
           (,(native "ADD!") arena 12 arena 12 arena 6)
           (,(native "SUB!") arena 12 arena 12 arena 6)
           (,(native "NEG!") arena 12 arena 12)
           (clempo.p384::p384-copy! arena 18 arena 12)
           (clempo.p384::p384-equal-p arena 18 arena 12)
           (clempo.p384::p384-zero-p arena 18)
           (clempo.p384::p384-zero! arena 18)
           (,(native "ONE!") arena 18)
           (,(native "TO-ORDINARY!") arena 18 arena 18)
           (,(native "INV!") arena 12 arena 0 arena 24))
         (values))
       (deftest ,(test-name "NO-ALLOCATION") ()
         (let ((arena (field-arena 36))
               (canonical (- ,modulus 17)))
           (,(test-name "ALLOCATION-BATCH") arena canonical 2)
           (let ((before (sb-ext:get-bytes-consed)))
             (,(test-name "ALLOCATION-BATCH") arena canonical 32)
             (is= before (sb-ext:get-bytes-consed))))))))

(define-field-tests pf clempo.p384:+p384-p+)
(define-field-tests ps clempo.p384:+p384-n+)

(deftest p384-scalar-full-digest-import ()
  (let* ((n clempo.p384:+p384-n+) (r (mod (ash 1 384) n))
         (sentinel #x0123456789abcdef) (a (field-arena 11 sentinel))
         (state #xabcdef1234567890abcdef1234567890abcdef))
    (dolist (value (append (field-boundaries n)
                          (list n (1+ n) (+ n 17) (1- (ash 1 384))
                                #x0123456789abcdef00112233445566778899aabbccddeeff0fedcba98765432100123456789abcdef0011223344556677)))
      (let ((hash (integer->octets value 48)))
        (clempo.p384::ps-from-digest! a 3 hash)
        (is= (mod (* value r) n) (field-raw-integer a 3))
        (is (< (field-raw-integer a 3) n))
        (clempo.p384::ps-to-ordinary! a 3 a 3)
        (is= (mod value n) (field-raw-integer a 3))
        (is= value (octets->integer hash))))
    (dotimes (i 512)
      (setf state (mod (+ (* state #x5851f42d4c957f2d) #x14057b7ef767814f) (ash 1 384)))
      (clempo.p384::ps-from-digest! a 3 (integer->octets state 48))
      (is= (mod (* state r) n) (field-raw-integer a 3)))
    (field-check-sentinels a 3 6 sentinel)))

(defun p384-digest-allocation-batch (arena digest count)
  (declare #.clempo.base:*hot* (type clempo.p384::p384-arena arena)
           (type (simple-array (unsigned-byte 8) (*)) digest) (type fixnum count))
  (dotimes (i count)
    (clempo.p384::ps-from-digest! arena 1 digest)
    (clempo.p384::ps-to-ordinary! arena 1 arena 1))
  (values))

(deftest p384-digest-import-no-allocation ()
  (let ((arena (field-arena 8))
        (digest (make-array 48 :element-type '(unsigned-byte 8) :initial-element 255)))
    (p384-digest-allocation-batch arena digest 2)
    (let ((before (sb-ext:get-bytes-consed)))
      (p384-digest-allocation-batch arena digest 4096)
      (is= before (sb-ext:get-bytes-consed)))))
