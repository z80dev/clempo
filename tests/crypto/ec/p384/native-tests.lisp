(in-package #:clempo.p384.tests)

;;; Independent affine integer arithmetic is deliberately confined to tests.
(defun p384-reference-add (a b)
  (cond ((null a) b) ((null b) a)
        (t (let ((x (car a)) (y (cdr a)) (u (car b)) (v (cdr b)) (p +p384-p+))
             (unless (and (= x u) (zerop (mod (+ y v) p)))
               (let* ((m (mod (* (if (= x u) (- (* 3 x x) 3) (- v y))
                                 (clempo.ec:invert (if (= x u) (* 2 y) (- u x)) p)) p))
                      (rx (mod (- (* m m) x u) p)))
                 (cons rx (mod (- (* m (- x rx)) y) p))))))))
(defun p384-reference-mul (p n)
  (let ((r nil))
    (loop for bit downfrom (1- (integer-length n)) to 0 do
      (setf r (p384-reference-add r r))
      (when (logbitp bit n) (setf r (p384-reference-add r p)))) r))
(defun p384-test-g () (cons clempo.p384::+p384-gx+ clempo.p384::+p384-gy+))
(defun p384-test-import (a o p)
  (if p
      (progn (clempo.p384::pf-from-integer! a o (car p))
             (clempo.p384::pf-from-integer! a (+ o 6) (cdr p))
             (clempo.p384::pf-one! a (+ o 12)))
      (clempo.p384::p384-jzero! a o)))
(defun p384-test-integer (a o)
  (let ((b (make-array 6 :element-type '(unsigned-byte 64))))
    (clempo.p384::pf-to-ordinary! b 0 a o)
    (loop for i below 6 sum (ash (aref b i) (* 64 i)))))
(defun p384-test-affine (a o)
  (unless (clempo.p384::p384-zero-p a (+ o 12))
    (let ((z (clempo.ec:invert (p384-test-integer a (+ o 12)) +p384-p+)))
      (cons (mod (* (p384-test-integer a o) z z) +p384-p+)
            (mod (* (p384-test-integer a (+ o 6)) z z z) +p384-p+)))))
(defun p384-test-scalar! (a o n)
  (dotimes (i 6) (setf (aref a (+ o i)) (ldb (byte 64 (* i 64)) n))))

(deftest p384-native-group-edges ()
  (let* ((scratch (clempo.p384::make-p384-scratch))
         (a (clempo.p384::p384-scratch-arena scratch)) (g (p384-test-g)))
    (p384-test-import a 0 g)
    (clempo.p384::p384-jdouble! a 18 a 0 a 216)
    (is-equalp (p384-reference-add g g) (p384-test-affine a 18))
    (clempo.p384::p384-jadd! a 0 a 0 a 0 a 216)
    (is-equalp (p384-test-affine a 18) (p384-test-affine a 0))
    (clempo.p384::p384-jdouble! a 0 a 0 a 216)
    (is-equalp (p384-reference-mul g 4) (p384-test-affine a 0))
    ;; Right operand exact alias, equal points, inverses, and both infinities.
    (p384-test-import a 0 g) (p384-test-import a 18 g)
    (clempo.p384::p384-jadd! a 18 a 0 a 18 a 216)
    (is-equalp (p384-reference-mul g 2) (p384-test-affine a 18))
    (p384-test-import a 18 (cons (car g) (- +p384-p+ (cdr g))))
    (clempo.p384::p384-jadd! a 18 a 0 a 18 a 216)
    (is (null (p384-test-affine a 18)))
    (clempo.p384::p384-jdouble! a 18 a 18 a 216)
    (is (null (p384-test-affine a 18)))
    (clempo.p384::p384-jadd! a 18 a 18 a 0 a 216)
    (is-equalp g (p384-test-affine a 18))
    (clempo.p384::p384-jzero! a 18)
    (clempo.p384::p384-jadd! a 0 a 0 a 18 a 216)
    (is-equalp g (p384-test-affine a 0))
    (clempo.p384::p384-jzero! a 0)
    (clempo.p384::p384-jadd! a 0 a 0 a 18 a 216)
    (is (null (p384-test-affine a 0)))
    ;; The exceptional Y=0 double is infinity even for a synthetic point.
    (p384-test-import a 0 g) (clempo.p384::p384-zero! a 6)
    (clempo.p384::p384-jdouble! a 0 a 0 a 216)
    (is (null (p384-test-affine a 0)))))

(deftest p384-native-wnaf-and-joint ()
  (let* ((scratch (clempo.p384::make-p384-scratch))
         (a (clempo.p384::p384-scratch-arena scratch))
         (digits (clempo.p384::p384-scratch-g-digits scratch))
         (g (p384-test-g)) (q (p384-reference-mul g 7))
         (seed #x123456789abcdef))
    (labels ((next-scalar ()
               (setf seed (mod (+ (* seed #x5851f42d4c957f2d) #x14057b7ef767814f)
                              (ash 1 384)))))
      (dolist (n (list 0 1 127 128 255 256 (1- +p384-n+) (1- (ash 1 384))))
        (p384-test-scalar! a 36 n)
        (dolist (width '(5 8 12 14))
          (let ((length (clempo.p384::p384-wnaf! digits a 36 width)))
            (is= n (loop for i below length sum (ash (aref digits i) i)))
            (dotimes (i length)
              (let ((d (aref digits i)))
                (unless (zerop d)
                  (is (oddp d)) (is (< (abs d) (ash 1 (1- width))))
                  (loop for j from (1+ i) below (min 385 (+ i width)) do
                    (is= 0 (aref digits j)))))))))
      (dotimes (trial 12)
        (let ((u (case trial (0 0) (1 1) (2 (- +p384-n+ 7))
                            (3 (1- (ash 1 384))) (otherwise (next-scalar))))
              (v (case trial (0 0) ((1 2) 1) (3 (1- (ash 1 384)))
                            (otherwise (next-scalar)))))
          (fill a #xffffffffffffffff)
          (p384-test-import a 0 q)
          (p384-test-scalar! a 36 u) (p384-test-scalar! a 42 v)
          (clempo.p384::p384-joint! scratch)
          (is-equalp (p384-reference-add (p384-reference-mul g u) (p384-reference-mul q v))
                     (p384-test-affine a 18))
          (dotimes (i 8)
            (is-equalp (p384-reference-mul q (1+ (* 2 i)))
                       (p384-test-affine a (+ 72 (* 18 i))))))))))

(deftest p384-native-projective-candidates ()
  (let* ((scratch (clempo.p384::make-p384-scratch))
         (a (clempo.p384::p384-scratch-arena scratch)))
    ;; Explicit scaled X candidates exercise the otherwise exceedingly rare r+n.
    (dolist (r (list 1 (1- (- +p384-p+ +p384-n+)) (- +p384-p+ +p384-n+)))
      (dolist (second '(nil t))
        (clempo.p384::pf-from-integer! a 30 7)
        (clempo.p384::pf-from-integer! a 18 (mod (+ r (if second +p384-n+ 0)) +p384-p+))
        (clempo.p384::pf-square! a 66 a 30)
        (clempo.p384::pf-mul! a 18 a 18 a 66)
        (is= (or (not second) (< r (- +p384-p+ +p384-n+)))
             (clempo.p384::p384-projective-r-p a r))))
    (clempo.p384::p384-jzero! a 18)
    (is (not (clempo.p384::p384-projective-r-p a 1)))))

(defun p384-native-batch (hash r s qx qy scratch count)
  (declare #.clempo.base:*hot* (type fixnum count))
  (let ((valid 0))
    (declare (type fixnum valid))
    (dotimes (i count valid)
      (when (clempo.p384::p384-verify-native hash r s qx qy scratch) (incf valid)))))

(deftest p384-native-signatures-and-reuse ()
  (let* ((scratch (clempo.p384::make-p384-scratch)) (g (p384-test-g))
         (a (clempo.p384::p384-scratch-arena scratch)))
    (loop for d in '(1 7 19) for k in '(1 11 31) do
      (let* ((q (p384-reference-mul g d)) (nonce (p384-reference-mul g k))
             (r (mod (car nonce) +p384-n+)))
        (dolist (z (list 0 1 +p384-n+ (1+ +p384-n+) (1- (ash 1 384))))
          (let* ((hash (integer->octets z 48))
                 (s (mod (* (+ z (* r d)) (clempo.ec:invert k +p384-n+)) +p384-n+)))
            (fill a #xffffffffffffffff)
            (fill (clempo.p384::p384-scratch-g-digits scratch) -32768)
            (fill (clempo.p384::p384-scratch-q-digits scratch) 32767)
            (is (clempo.p384::p384-verify-native hash r s (car q) (cdr q) scratch))
            (is (clempo.p384::p384-verify-native hash r (- +p384-n+ s) (car q) (cdr q) scratch))
            (is (not (clempo.p384::p384-verify-native hash r s 0 0 scratch)))
            (is (clempo.p384::p384-verify-native hash r s (car q) (cdr q) scratch))))))
    (is (not (clempo.p384::p384-verify-native
              (integer->octets (- +p384-n+ (car g)) 48) (car g) 1 (car g) (cdr g) scratch)))))

(deftest p384-native-zero-cons ()
  (let* ((scratch (clempo.p384::make-p384-scratch)) (g (p384-test-g))
         (r (car g)) (s (1+ r)))
    (dolist (z '(1 2))
      (let ((hash (integer->octets z 48)))
        (p384-native-batch hash r s (car g) (cdr g) scratch 2)
        (let* ((before (sb-ext:get-bytes-consed))
               (valid (p384-native-batch hash r s (car g) (cdr g) scratch 16))
               (bytes (- (sb-ext:get-bytes-consed) before)))
          (is= (if (= z 1) 16 0) valid)
          (is= 0 bytes))))))
