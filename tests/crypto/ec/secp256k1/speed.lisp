;;; CLEMPO_BUILD=release sbcl --dynamic-space-size 8192 --non-interactive \
;;; --load scripts/build.lisp --eval '(asdf:load-system "clempo-crypto-ec/tests")' \
;;; --load tests/crypto/ec/secp256k1/speed.lisp
(defpackage #:clempo.secp256k1.speed
  (:use #:cl #:clempo.base)
  (:local-nicknames (#:s #:clempo.secp256k1)))
(in-package #:clempo.secp256k1.speed)
(defun measure (name count fn)
  (funcall fn) (sb-ext:gc :full t)
  (let ((wall (get-internal-real-time)) (cpu (get-internal-run-time))
        (bytes (sb-ext:get-bytes-consed)))
    (dotimes (i count) (funcall fn))
    (let ((elapsed-wall (- (get-internal-real-time) wall))
          (elapsed-cpu (- (get-internal-run-time) cpu))
          (allocated (- (sb-ext:get-bytes-consed) bytes)))
      (format t "~&~A: ~,3F us CPU, ~,3F us wall, ~,1F bytes/call, ~,1F% CPU (~D calls)~%"
              name (/ (* 1d6 elapsed-cpu) count internal-time-units-per-second)
              (/ (* 1d6 elapsed-wall) count internal-time-units-per-second)
              (/ allocated (float count 1d0))
              (if (zerop elapsed-wall) 0d0 (* 100d0 (/ elapsed-cpu elapsed-wall))) count))))
(defparameter *hash* (integer->octets 123456789 32))
(defparameter *public* (s:private->public 11))
(defparameter *signature* (multiple-value-list (s:sign *hash* 11)))
(defparameter *scratch* (s:make-recovery-scratch))
(defparameter *output* (make-octets 64))
(defparameter *address* (s:pubkey->address *public*))
(defun recovery-call ()
  (s:ecrecover *hash* (first *signature*) (second *signature*) (third *signature*) *output* *scratch*))
(defun address-call ()
  (s:ecrecover-address *hash* (first *signature*) (second *signature*) (third *signature*) *scratch*))
(assert (equalp *public* (recovery-call)))
(assert (= *address* (address-call)))
(measure "ecrecover, caller output/scratch" 20000 #'recovery-call)
(measure "ecrecover-address, caller scratch" 20000 #'address-call)
(let ((s:*recovery-scratch* *scratch*))
  (measure "ecrecover, fresh pubkey result" 10000
           (lambda () (s:ecrecover *hash* (first *signature*) (second *signature*) (third *signature*)))))
(multiple-value-bind (bytes cpu valid) (clempo.p256.tests::p256-native-measure 2000)
  (format t "~&P256 verify, caller scratch: ~,3F us CPU, ~,1F bytes/call, ~D valid~%"
          cpu (/ bytes 2000d0) valid))
(defun fp-block (words)
  (declare #.clempo.base:*hot* (type s::secp-words words))
  (dotimes (i 1000) (s::sf-mul! words 0 words 0 words 4)) (values))
(let ((words (make-array 8 :element-type '(unsigned-byte 64) :initial-element 0)))
  (s::sf-from-integer! words 0 2) (s::sf-from-integer! words 4 3)
  (measure "Fp multiply x1000" 1000 (lambda () (fp-block words))))
