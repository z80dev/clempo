(in-package #:clempo.ec.tests)

(deftest secp-native-inversion-and-roots ()
  (let ((w (make-array 128 :element-type '(unsigned-byte 64) :initial-element 0))
        (p clempo.secp256k1:+secp256k1-p+) (x 13))
    (dotimes (i 128)
      (setf x (mod (+ (* x #x5851f42d4c957f2d) #x14057b7ef767814f) p))
      (clempo.secp256k1::sf-from-integer! w 0 x)
      (clempo.secp256k1::sf-inv! w 4 w 0 w 32)
      (is= 1 (mod (* x (clempo.secp256k1::sf-to-integer w 4)) p))
      (clempo.secp256k1::sf-inv! w 0 w 0 w 32)
      (is (clempo.secp256k1::sf-equal-p w 0 w 4))
      (clempo.secp256k1::sf-from-integer! w 0 x)
      (clempo.secp256k1::sf-square! w 4 w 0)
      (clempo.secp256k1::sf-sqrt! w 8 w 4 w 32)
      (clempo.secp256k1::sf-square! w 12 w 8)
      (is (clempo.secp256k1::sf-equal-p w 4 w 12)))
    (clempo.secp256k1::sf-from-integer! w 0 (1- p))
    (clempo.secp256k1::sf-sqrt! w 4 w 0 w 32)
    (clempo.secp256k1::sf-square! w 8 w 4)
    (is (not (clempo.secp256k1::sf-equal-p w 0 w 8)))))

(deftest secp-native-scalars ()
  (let ((w (make-array 128 :element-type '(unsigned-byte 64) :initial-element 0))
        (n clempo.secp256k1:+secp256k1-n+) (x 17) (y 23))
    (flet ((check (a b)
             (clempo.secp256k1::sf-from-integer! w 0 a)
             (clempo.secp256k1::sf-from-integer! w 4 b)
             (clempo.secp256k1::sc-mul! w 8 w 0 w 4 w 32)
             (is= (mod (* a b) n) (clempo.secp256k1::sf-to-integer w 8))
             (clempo.secp256k1::sc-mul! w 0 w 0 w 4 w 32)
             (is (clempo.secp256k1::sf-equal-p w 0 w 8))
             (when (plusp a)
               (clempo.secp256k1::sf-from-integer! w 0 a)
               (clempo.secp256k1::sc-inv! w 0 w 0 w 32)
               (is= 1 (mod (* a (clempo.secp256k1::sf-to-integer w 0)) n)))))
      (dolist (a (list 0 1 2 (1- (ash 1 64)) (ash 1 64) (ash 1 128) (ash 1 192) (1- n)))
        (dolist (b (list 0 1 2 (1- (ash 1 64)) (ash 1 64) (ash 1 128) (ash 1 192) (1- n)))
          (check a b)))
      (dotimes (i 1024)
        (setf x (mod (+ (* x #x5851f42d4c957f2d) #x14057b7ef767814f) n)
              y (mod (+ (* y #x14057b7ef767814f) #x5851f42d4c957f2d) n))
        (check x y)
        (multiple-value-bind (a b) (native-scalar-parts x)
          (is= x (mod (+ a (* b #x5363ad4cc05c30e0a5261c028812645a122e22ea20816678df02967c1b23bd72)) n))
          (is (<= (integer-length (abs a)) 129))
          (is (<= (integer-length (abs b)) 129)))))))

(deftest secp-native-field-and-scalar-no-consing ()
  (let ((w (make-array 128 :element-type '(unsigned-byte 64) :initial-element 0))
        (digits (make-array 520 :element-type '(signed-byte 8) :initial-element 0)))
    (clempo.secp256k1::sf-from-integer! w 0 (1- clempo.secp256k1:+secp256k1-n+))
    (clempo.secp256k1::sf-from-integer! w 4 #xfedcba98765432100123456789abcdef0123456789abcdeffedcba9876543210)
    (let ((before (sb-ext:get-bytes-consed)))
      (dotimes (i 32)
        (clempo.secp256k1::sf-mul! w 8 w 0 w 4)
        (clempo.secp256k1::sf-square! w 8 w 8)
        (clempo.secp256k1::sf-inv! w 12 w 8 w 32)
        (clempo.secp256k1::sc-inv! w 12 w 0 w 32)
        (clempo.secp256k1::sc-mul! w 12 w 0 w 4 w 32)
        (clempo.secp256k1::sg-decompose! w 0 digits 0 130 7 32))
      (is= before (sb-ext:get-bytes-consed)))))

(deftest secp-native-recovery-buffers ()
  (let* ((hash (integer->octets 123456789 32))
         (expected (clempo.secp256k1:private->public 11))
         (scratch (clempo.secp256k1:make-recovery-scratch)) (output (make-octets 64)))
    (multiple-value-bind (r s v) (clempo.secp256k1:sign hash 11)
      (fill (clempo.secp256k1::recovery-scratch-words scratch) #xffffffffffffffff)
      (is (eq output (clempo.secp256k1:ecrecover hash r s v output scratch)))
      (is-equalp expected output)
      (let ((before (sb-ext:get-bytes-consed)))
        (dotimes (i 4096) (clempo.secp256k1:ecrecover hash r s v output scratch))
        (is= before (sb-ext:get-bytes-consed)))
      (let* ((address (clempo.secp256k1:pubkey->address expected))
             (before (sb-ext:get-bytes-consed)))
        (dotimes (i 4096) (is= address (clempo.secp256k1:ecrecover-address hash r s v scratch)))
        ;; SBCL counts closed allocation regions, not the current partial one.
        ;; One 32-byte result per call, within one 32 KiB region of rounding.
        (is (<= (- (* 4096 32) 32768) (- (sb-ext:get-bytes-consed) before)
                (+ (* 4096 32) 32768))))
      (let* ((clempo.secp256k1:*recovery-scratch* scratch)
             (one (clempo.secp256k1:ecrecover hash r s v))
             (two (clempo.secp256k1:ecrecover hash r s v)))
        (is (not (eq one two))) (is-equalp expected one) (is-equalp expected two)
        (is (eq output (clempo.secp256k1:ecrecover hash r s v output)))
        (is (null (clempo.secp256k1:ecrecover hash 0 s v output)))
        (is-equalp expected (clempo.secp256k1:ecrecover hash r s v)))
      (signals error (clempo.secp256k1:ecrecover hash r s v (make-octets 63) scratch)))))

(deftest secp-native-recid-overflow-branch ()
  (block found
  (let* ((n clempo.secp256k1:+secp256k1-n+) (p clempo.secp256k1:+secp256k1-p+)
         (hash (make-octets 32)))
    (loop for r from 1 below 100 for x = (+ n r)
          for square = (mod (+ (* x x x) 7) p)
          for y = (clempo.modexp:modular-expt square (ash (1+ p) -2) p)
          when (= square (mod (* y y) p)) do
      (let* ((even-y (if (evenp y) y (- p y)))
             (expected (clempo.secp256k1.native-group-tests::oracle-mul
                        (cons x even-y) (clempo.ec:invert r n))))
        (is-equalp (octets-concat (integer->octets (car expected) 32)
                                 (integer->octets (cdr expected) 32))
                   (clempo.secp256k1:ecrecover hash r 1 2))
        (is-equalp (octets-concat (integer->octets (car expected) 32)
                                 (integer->octets (- p (cdr expected)) 32))
                   (clempo.secp256k1:ecrecover hash r 1 3))
        (return-from found t)))
    (error "Missing small recid=2 test point."))))

(deftest secp-native-compressed-ecdh ()
  (let ((peer (clempo.secp256k1:private->public 7)))
    (loop for secret in '(1 3 19) do
      (let* ((raw (clempo.secp256k1:ecdh secret peer))
             (compressed (clempo.secp256k1:ecdh secret peer :compressed t))
             (public (clempo.secp256k1:private->public (* secret 7))))
        (is= 33 (length compressed))
        (is= (+ 2 (logand (aref public 63) 1)) (aref compressed 0))
        (is-equalp raw (subseq compressed 1))
        (is-equalp (subseq public 0 32) raw))))
  (is (null (clempo.secp256k1:ecdh 0 (make-octets 64) :compressed t))))
