(in-package #:clempo.p256.tests)

;;; Independent affine integer oracle, confined to tests. Existing EIP-7951
;;; fixtures remain the external differential authority, including x>=n cases.
(defparameter *native-gx* #x6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296)
(defparameter *native-gy* #x4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5)

(defun affine-reference-add (a b)
  (cond ((null a) b) ((null b) a)
        (t
         (let ((p clempo.p256:+p256-p+) (x (car a)) (y (cdr a))
               (qx (car b)) (qy (cdr b)))
           (unless (and (= x qx) (zerop (mod (+ y qy) p)))
             (let* ((slope (mod (* (if (= x qx) (- (* 3 x x) 3) (- qy y))
                                  (clempo.ec:invert (if (= x qx) (* 2 y) (- qx x)) p)) p))
                    (rx (mod (- (* slope slope) x qx) p)))
               (cons rx (mod (- (* slope (- x rx)) y) p))))))))

(defun affine-reference-mul (point scalar)
  (let ((out nil))
    (loop for bit downfrom (1- (integer-length scalar)) to 0 do
      (setf out (affine-reference-add out out))
      (when (logbitp bit scalar) (setf out (affine-reference-add out point))))
    out))

(defun native-affine (arena offset)
  (unless (clempo.p256::p256-zero-p arena (+ offset 8))
    (let* ((p clempo.p256:+p256-p+)
           (x (residue-integer arena offset #'clempo.p256::pf-mul!))
           (y (residue-integer arena (+ offset 4) #'clempo.p256::pf-mul!))
           (z (residue-integer arena (+ offset 8) #'clempo.p256::pf-mul!))
           (zi (clempo.ec:invert z p)))
      (cons (mod (* x zi zi) p) (mod (* y zi zi zi) p)))))

(defun import-ordinary-scalar (arena offset integer)
  (dotimes (i 4) (setf (aref arena (+ offset i)) (ldb (byte 64 (* i 64)) integer))))

(deftest p256-native-group ()
  (let* ((g (cons *native-gx* *native-gy*))
         (q (affine-reference-mul g 7))
         (arena (make-array 400 :element-type '(unsigned-byte 64) :initial-element 0)))
    (clempo.p256::pf-from-integer! arena 0 (car q))
    (clempo.p256::pf-from-integer! arena 4 (cdr q))
    (clempo.p256::pf-one! arena 8)
    (is (clempo.p256::p256-affine-on-curve-p arena 0 arena 288))
    (clempo.p256::p256-table! arena 12 arena 0 arena 288)
    (dotimes (i 16)
      (is-equalp (affine-reference-mul q i) (native-affine arena (+ 12 (* i 12)))))
    ;; Exact alias doubling, mixed doubling, inverse addition, and infinity.
    (clempo.p256::p256-jcopy! arena 204 arena 0)
    (clempo.p256::p256-jdouble! arena 204 arena 204 arena 288)
    (is-equalp (affine-reference-add q q) (native-affine arena 204))
    (clempo.p256::p256-jcopy! arena 204 arena 0)
    (clempo.p256::p256-jadd-affine! arena 204 arena 204 arena 204 arena 288)
    (is-equalp (affine-reference-add q q) (native-affine arena 204))
    (clempo.p256::p256-jcopy! arena 204 arena 0)
    (clempo.p256::p256-zero! arena 220)
    (clempo.p256::pf-sub! arena 208 arena 220 arena 208)
    (clempo.p256::p256-jadd-affine! arena 204 arena 204 arena 0 arena 288)
    (is (null (native-affine arena 204)))
    (clempo.p256::p256-jdouble! arena 204 arena 204 arena 288)
    (is (null (native-affine arena 204)))
    (clempo.p256::p256-jadd-affine! arena 204 arena 204 arena 0 arena 288)
    (is-equalp q (native-affine arena 204))
    ;; Full-width scalars, zero, n-1, and cancellation.
    (loop for u in (list 0 1 15 16 (1- clempo.p256:+p256-n+)
                        #x80112233445566778899aabbccddeeff00112233445566778899aabbccddeeff)
          for v in (list 0 1 16 15 1 #xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)
          do
      (import-ordinary-scalar arena 216 u)
      (import-ordinary-scalar arena 220 v)
      (clempo.p256::p256-joint! arena 204 arena 216 arena 220 arena 12 arena 288)
      (is-equalp (affine-reference-add (affine-reference-mul g u) (affine-reference-mul q v))
                 (native-affine arena 204)))
    (import-ordinary-scalar arena 216 (- clempo.p256:+p256-n+ 7))
    (import-ordinary-scalar arena 220 1)
    (clempo.p256::p256-joint! arena 204 arena 216 arena 220 arena 12 arena 288)
    (is (null (native-affine arena 204)))))

(deftest p256-native-input-rules ()
  (let* ((hash (integer->octets 1 32)) (r *native-gx*) (s (1+ r))
         (high (- clempo.p256:+p256-n+ s)))
    (is (clempo.p256:p256-verify hash r s *native-gx* *native-gy*))
    (is (clempo.p256:p256-verify hash r high *native-gx* *native-gy*))
    (is (clempo.p256:p256-verify-low-s hash r s *native-gx* *native-gy*))
    (is (not (clempo.p256:p256-verify-low-s hash r high *native-gx* *native-gy*)))
    (dolist (bad (list nil 1/2 -1 0 clempo.p256:+p256-n+))
      (is (not (clempo.p256:p256-verify hash bad s *native-gx* *native-gy*)))
      (is (not (clempo.p256:p256-verify hash r bad *native-gx* *native-gy*))))
    (dolist (bad (list nil 1/2 -1 clempo.p256:+p256-p+))
      (is (not (clempo.p256:p256-verify hash r s bad *native-gy*)))
      (is (not (clempo.p256:p256-verify hash r s *native-gx* bad))))
    (is (not (clempo.p256:p256-verify hash r s 0 0)))
    (is (not (clempo.p256:p256-verify (make-octets 31) r s *native-gx* *native-gy*)))
    (is (not (clempo.p256:p256-verify #() r s *native-gx* *native-gy*)))))

(deftest p256-native-deterministic-signatures ()
  (let ((g (cons *native-gx* *native-gy*)) (n clempo.p256:+p256-n+))
    (loop for d in (list 1 2 19 (1- n))
          for k in (list 1 7 31 (- n 11)) do
      (let* ((q (affine-reference-mul g d))
             (nonce (affine-reference-mul g k))
             (r (mod (car nonce) n)))
        (dolist (z (list 0 1 n (1+ n) (1- (ash 1 256))))
          (let ((s (mod (* (+ z (* r d)) (clempo.ec:invert k n)) n))
                (hash (integer->octets z 32)))
            (is (plusp s))
            (is (clempo.p256:p256-verify hash r s (car q) (cdr q)))
            (is (clempo.p256:p256-verify hash r (- n s) (car q) (cdr q)))))))
    ;; u1*G+u2*G is infinity, even though all inputs are in range.
    (is (not (clempo.p256:p256-verify (integer->octets (- n *native-gx*) 32)
                                    *native-gx* 1 *native-gx* *native-gy*)))))

(defun p256-verification-batch (hash r s x y count &optional (scratch clempo.p256:*p256-scratch*))
  (declare #.clempo.base:*hot* (type fixnum count))
  (let ((valid 0))
    (declare (type fixnum valid))
    (dotimes (i count valid)
      (when (clempo.p256:p256-verify hash r s x y scratch) (incf valid)))))

(defun p256-native-measure (&optional (count 1000))
  "Parent-run benchmark: returns bytes consed, CPU microseconds/call, valid count.
All inputs, caller scratch and warmup precede measurement."
  (let* ((hash (integer->octets 1 32)) (r *native-gx*) (s (1+ r))
         (scratch (clempo.p256:make-p256-scratch)))
    (p256-verification-batch hash r s *native-gx* *native-gy* 2 scratch)
    (let* ((bytes (sb-ext:get-bytes-consed))
           (start (get-internal-run-time))
           (valid (p256-verification-batch hash r s *native-gx* *native-gy* count scratch))
           (elapsed (- (get-internal-run-time) start))
           (allocated (- (sb-ext:get-bytes-consed) bytes)))
      (values allocated (/ (* elapsed 1000000d0) internal-time-units-per-second count) valid))))

(deftest p256-native-no-allocation ()
  (multiple-value-bind (bytes micros valid) (p256-native-measure 32)
    (declare (ignore micros))
    (is= 32 valid)
    (is= 0 bytes))
  ;; Rejected signatures still run the complete arithmetic path.
  (let* ((hash (integer->octets 2 32)) (r *native-gx*) (s (1+ r))
         (clempo.p256:*p256-scratch* (clempo.p256:make-p256-scratch)))
    (is= 0 (p256-verification-batch hash r s *native-gx* *native-gy* 2))
    (let* ((bytes (sb-ext:get-bytes-consed))
           (valid (p256-verification-batch hash r s *native-gx* *native-gy* 32))
           (allocated (- (sb-ext:get-bytes-consed) bytes)))
      (is= 0 valid) (is= 0 allocated))))

(deftest p256-native-scratch-reuse ()
  (let* ((hash (integer->octets 1 32)) (bad-hash (integer->octets 2 32))
         (r *native-gx*) (s (1+ r))
         (scratch (clempo.p256:make-p256-scratch)))
    ;; A reused arena must not depend on zero initialization or a preceding
    ;; call's success. Explicit NIL still requests fresh, isolated storage.
    (fill scratch #xffffffffffffffff)
    (is (clempo.p256:p256-verify hash r s *native-gx* *native-gy* scratch))
    (is (not (clempo.p256:p256-verify bad-hash r s *native-gx* *native-gy* scratch)))
    (is (not (clempo.p256:p256-verify hash r s 0 0 scratch)))
    (is (clempo.p256:p256-verify-low-s hash r s *native-gx* *native-gy* scratch))
    (let ((clempo.p256:*p256-scratch* scratch))
      (is (clempo.p256:p256-verify hash r s *native-gx* *native-gy*))
      (is (clempo.p256:p256-verify-low-s hash r s *native-gx* *native-gy*))
      (is (clempo.p256:p256-verify hash r s *native-gx* *native-gy* nil)))))
