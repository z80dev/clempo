(defpackage #:clempo.bn254.tests
  (:use #:cl #:clempo.base #:clempo.bn254))
(in-package #:clempo.bn254.tests)

(defun fixture-data (name)
  (with-open-file (stream (asdf:system-relative-pathname
                          "clempo-crypto-ec"
                          (concatenate 'string "../../../tests/crypto/ec/bn254/" name)))
    (let ((*read-eval* nil)) (read stream))))
(defun words (&rest integers)
  (apply #'octets-concat (mapcar (lambda (n) (integer->octets n 32)) integers)))
(defun generator-g1 () (words 1 2))
(defun negative-generator-g1 () (words 1 (- +field-modulus+ 2)))
(defun generator-g2 ()
  (words 11559732032986387107991004021392285783925812861821192530917403151452391805634
         10857046999023057135944570762232829481370756359578518086990519993285655852781
         4082367875863433681332203403145435568316851327593401208105741076214120093531
         8495653923123431417604973247489272438418190587263600148770280649306958101930))
(defun pairing-result= (input expected valid)
  (multiple-value-bind (actual actual-valid) (bn254-pairing input)
    (and (eq expected actual) (eq valid actual-valid))))

(deftest bn254-reference-addition-vectors ()
  (let ((vectors (fixture-data "bn256Add.sexp")))
    (is= 16 (length vectors))
    (dolist (vector vectors)
      (let* ((properties (cdr vector)) (input (hex->octets (getf properties :input)))
             (expected (hex->octets (getf properties :expected))))
        (is-equalp expected (bn254-add input) "~A" (getf properties :name))))))
(deftest bn254-reference-multiplication-vectors ()
  (let ((vectors (fixture-data "bn256ScalarMul.sexp")))
    (is= 19 (length vectors))
    (dolist (vector vectors)
      (let* ((properties (cdr vector)) (input (hex->octets (getf properties :input)))
             (expected (hex->octets (getf properties :expected))))
        (is-equalp expected (bn254-mul input) "~A" (getf properties :name))))))
(deftest bn254-reference-pairing-vectors ()
  (let ((vectors (fixture-data "bn256Pairing.sexp")))
    (is= 14 (length vectors))
    (dolist (vector vectors)
      (let* ((properties (cdr vector)) (input (hex->octets (getf properties :input)))
             (expected (not (zerop (hex->integer (getf properties :expected))))))
        (is (pairing-result= input expected t) "~A" (getf properties :name))))))

(deftest bn254-padding-truncation-and-infinity ()
  (is-equalp (make-octets 64) (bn254-add (make-octets 0)))
  (is-equalp (make-octets 64) (bn254-mul (make-octets 0)))
  (is-equalp (generator-g1) (bn254-add (generator-g1)))
  (is-equalp (make-octets 64) (bn254-mul (generator-g1)))
  (is-equalp (generator-g1) (bn254-add (octets-concat (make-octets 64) (generator-g1))))
  (is-equalp (make-octets 64)
             (bn254-add (octets-concat (generator-g1) (negative-generator-g1))))
  ;; Exercise every partial-word boundary, not only whole words. Compare the
  ;; byte protocol with an explicit right-padded or truncated buffer.
  (let ((full (octets-concat (generator-g1) (generator-g1))))
    (dotimes (n 128)
      (let ((padded (make-octets 128)) (short (subseq full 0 n)))
        (replace padded short)
        (is-equalp (bn254-add padded) (bn254-add short) "addition input length ~D" n)))
    (is-equalp (bn254-add full) (bn254-add (octets-concat full (octets-of 255 1 2)))))
  (let ((full (octets-concat (generator-g1) (integer->octets 257 32))))
    (dotimes (n 96)
      (let ((padded (make-octets 96)) (short (subseq full 0 n)))
        (replace padded short)
        (is-equalp (bn254-mul padded) (bn254-mul short) "multiplication input length ~D" n)))
    (is-equalp (bn254-mul full) (bn254-mul (octets-concat full (octets-of 255 1 2))))))

(deftest bn254-canonical-g1-and-scalar-rules ()
  (dolist (point (list (words 1 3) (words 0 1) (words 0 2) (words 1 0)
                       (words +field-modulus+ 2) (words 1 +field-modulus+)
                       (words (1+ +field-modulus+) 2)
                       (words 1 (+ +field-modulus+ 2))
                       (words (1- (ash 1 256)) 2)))
    (is (null (bn254-add point)))
    (is (null (bn254-add (octets-concat (generator-g1) point))))
    (is (null (bn254-mul (octets-concat point (integer->octets 0 32)))))
    (is (pairing-result= (octets-concat point (make-octets 128)) nil nil)))
  (is-equalp (make-octets 64)
             (bn254-mul (octets-concat (generator-g1) (integer->octets +group-order+ 32))))
  (is-equalp (generator-g1)
             (bn254-mul (octets-concat (generator-g1) (integer->octets (1+ +group-order+) 32))))
  (is-equalp (negative-generator-g1)
             (bn254-mul (octets-concat (generator-g1) (integer->octets (1- +group-order+) 32))))
  (is-equalp (make-octets 64)
             (bn254-mul (octets-concat (make-octets 64) (integer->octets (1- (ash 1 256)) 32)))))

(deftest bn254-g2-subgroup-vectors ()
  (let ((vectors (fixture-data "g2-subgroup.sexp")) (inside 0) (outside 0))
    (is= 12 (length vectors))
    (dolist (vector vectors)
      (let* ((in-p (eq (first vector) :in)) (encoded (hex->octets (second vector))))
        (if in-p (incf inside) (incf outside))
        ;; Establish that every fixture is on the twist before testing order.
        (let* ((x (cons (octets->integer encoded :start 32 :end 64)
                        (octets->integer encoded :start 0 :end 32)))
               (y (cons (octets->integer encoded :start 96 :end 128)
                        (octets->integer encoded :start 64 :end 96)))
               (b (cons 19485874751759354771024239261021720505790618469301721065564631296452457478373
                        266929791119991161246907387137283842545076965332900288569378510910307636690)))
          (is-equalp (clempo.bn254::fp2-square y)
                     (clempo.bn254::fp2+ (clempo.bn254::fp2* (clempo.bn254::fp2-square x) x) b))
          (is (eq in-p (g2-in-subgroup-p (cons x y)))))
        (multiple-value-bind (point valid) (decode-g2 encoded)
          (is (eq in-p valid))
          (is (eq in-p (not (null point)))))
        ;; An infinity in G1 must not bypass the G2 subgroup check.
        (is (pairing-result= (octets-concat (make-octets 64) encoded) in-p in-p))
        (when in-p
          (is (pairing-result= (octets-concat (generator-g1) encoded) nil t))
          (is (pairing-result= (octets-concat (generator-g1) encoded
                                             (negative-generator-g1) encoded) t t)))))
    (is= 6 inside)
    (is= 6 outside)))

(deftest bn254-pairing-validity-boundaries ()
  (is (pairing-result= (make-octets 0) t t))
  (is (pairing-result= (make-octets 192) t t))
  (is (pairing-result= (make-octets 384) t t))
  (dolist (length '(1 31 32 64 128 191 193 383 385))
    (is (pairing-result= (make-octets length) nil nil)))
  (is (pairing-result= (octets-concat (generator-g1) (generator-g2)) nil t))
  (is (pairing-result= (octets-concat (generator-g1) (make-octets 128)) t t))
  (is (pairing-result= (octets-concat (make-octets 64) (generator-g2)) t t))
  (is (pairing-result= (octets-concat (generator-g1) (generator-g2)
                                     (negative-generator-g1) (generator-g2)) t t))
  ;; Each of the four G2 wire coordinates must be canonical on its own.
  (dotimes (coordinate 4)
    (dolist (bad (list +field-modulus+ (1+ +field-modulus+) (1- (ash 1 256))))
      (let ((encoded (generator-g2)))
        (replace encoded (integer->octets bad 32) :start1 (* coordinate 32))
        (is (pairing-result= (octets-concat (generator-g1) encoded) nil nil))
        (is (pairing-result= (octets-concat (make-octets 64) encoded) nil nil)))))
  (let ((off-curve (generator-g2)))
    (setf (aref off-curve 127) (logxor 1 (aref off-curve 127)))
    (is (pairing-result= (octets-concat (make-octets 64) off-curve) nil nil)))
  (is (pairing-result= (octets-concat (make-octets 64) (words 0 0 0 1)) nil nil))
  (let* ((q (generator-g2))
         (reversed (octets-concat (subseq q 32 64) (subseq q 0 32)
                                  (subseq q 96 128) (subseq q 64 96))))
    (is (pairing-result= (octets-concat (generator-g1) reversed) nil nil)))
  (multiple-value-bind (point valid) (decode-g2 (make-octets 127))
    (is (null point)) (is (null valid))))

(deftest bn254-coordinate-and-tower-identities ()
  (multiple-value-bind (point valid) (decode-g1 (generator-g1))
    (is valid)
    (is= '(1 . 2) point)
    (is-equalp (generator-g1) (encode-g1 point)))
  (multiple-value-bind (point valid) (decode-g1 (make-octets 64))
    (is valid) (is (null point)))
  ;; These exercise inverse and optimised square/sparse formulas separately
  ;; from the pairing equation, which deliberately discards subfield factors.
  (let* ((a (cons (vector '(3 . 5) '(7 . 11) '(13 . 17))
                  (vector '(19 . 23) '(29 . 31) '(37 . 41))))
         (line (cons (vector '(43 . 0) '(0 . 0) '(0 . 0))
                     (vector '(47 . 53) '(59 . 61) '(0 . 0)))))
    (is-equalp (clempo.bn254::fp12* a a) (clempo.bn254::fp12-square a))
    (is-equalp (clempo.bn254::fp12-one)
               (clempo.bn254::fp12* a (clempo.bn254::fp12-inverse a)))
    (is-equalp (clempo.bn254::fp12* a line) (clempo.bn254::fp12-mul-line a line))
    (is-equalp (clempo.bn254::fp12-square a) (clempo.bn254::fp12-power a 2))
    (is-equalp (clempo.bn254::fp12* (clempo.bn254::fp12-square a) a)
               (clempo.bn254::fp12-power a 3))
    (is-equalp (clempo.bn254::fp12-one) (clempo.bn254::fp12-power a 0))
    (is-equalp (clempo.bn254::fp12-power a (* +field-modulus+ +field-modulus+))
               (clempo.bn254::fp12-frobenius2 a))))
