(defpackage #:clempo.ec.word.tests
  (:use #:cl #:clempo.base)
  (:local-nicknames (#:w #:clempo.ec.word)))
(in-package #:clempo.ec.word.tests)

(deftest word-carry-and-no-borrow-contract ()
  (let ((words '(0 1 #xffffffff #x100000000 #x7fffffffffffffff
                 #x8000000000000000 #xfffffffffffffffe #xffffffffffffffff)))
    (dolist (a words)
      (dolist (b words)
        (dolist (carry '(0 1))
          (let ((sum (+ a b carry)) (difference (- a b (- 1 carry))))
            (flet ((check-add (low high)
                     (is= (ldb (byte 64 0) sum) low)
                     (is= (ash sum -64) high))
                   (check-sub (low high)
                     (is= (ldb (byte 64 0) difference) low)
                     (is= (if (minusp difference) 0 1) high)))
              (multiple-value-call #'check-add (w:add-with-carry a b carry))
              (multiple-value-call #'check-add (w::portable-add-with-carry a b carry))
              (multiple-value-call #'check-sub (w:subtract-with-borrow a b carry))
              (multiple-value-call #'check-sub (w::portable-subtract-with-borrow a b carry)))))))))

(deftest word-multiply-high-low-contract ()
  (let ((state #x6a09e667f3bcc909))
    (labels ((next-word ()
               (setf state (ldb (byte 64 0) (logxor state (ash state 13)))
                     state (logxor state (ash state -7))
                     state (ldb (byte 64 0) (logxor state (ash state 17))))))
      (let ((words (append '(0 1 #xffffffff #x100000000 #x7fffffffffffffff
                             #x8000000000000000 #xfffffffffffffffe #xffffffffffffffff)
                           (loop repeat 24 collect (next-word)))))
        (dolist (a words)
          (dolist (b words)
            (dolist (c '(0 1 #xffffffffffffffff))
              (let ((expected (+ (* a b) c)))
                (flet ((check (hi lo)
                         (is= (ash expected -64) hi)
                         (is= (ldb (byte 64 0) expected) lo)))
                  (multiple-value-call #'check (w:multiply-and-add a b c))
                  (multiple-value-call #'check (w::portable-multiply-and-add a b c)))))))))))

(defun portable-word-chain! (out count)
  (declare #.clempo.base:*hot*
           (type (simple-array (unsigned-byte 64) (4)) out) (type fixnum count))
  (dotimes (i count)
    (multiple-value-bind (lo carry) (w::portable-add-with-carry (aref out 0) (aref out 1) 1)
      (setf (aref out 0) lo (aref out 2) carry))
    (multiple-value-bind (lo carry) (w::portable-subtract-with-borrow (aref out 1) (aref out 0) 0)
      (setf (aref out 1) lo (aref out 2) carry))
    (multiple-value-bind (hi lo) (w::portable-multiply-and-add (aref out 0) (aref out 1) (aref out 2))
      (setf (aref out 0) hi (aref out 1) lo)))
  (values))

(deftest portable-word-zero-cons ()
  (let ((out (make-array 4 :element-type '(unsigned-byte 64)
                        :initial-contents '(#xffffffffffffffff #x123456789abcdef0 0 0))))
    (portable-word-chain! out 16)
    (let ((before (sb-ext:get-bytes-consed)))
      (portable-word-chain! out 4096)
      (is= 0 (- (sb-ext:get-bytes-consed) before)))))

(deftest word-intrinsic-reader-does-not-intern ()
  ;; Missing primitives need not exist (or be FBOUNDP) for this file to read.
  (let ((missing "CLEMPO-NONEXISTENT-WORD-PRIMITIVE"))
    (is (null (find-symbol missing "SB-BIGNUM")))
    (is (equal '(quote nil)
               (read-from-string
                "'#.(find-symbol \"CLEMPO-NONEXISTENT-WORD-PRIMITIVE\" \"SB-BIGNUM\")")))
    (is (null (find-symbol missing "SB-BIGNUM")))))
