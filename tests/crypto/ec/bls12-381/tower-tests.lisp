(defpackage #:clempo.bls12-381.tower-tests
  (:use #:cl #:clempo.base)
  (:local-nicknames (#:b #:clempo.bls12-381)))
(in-package #:clempo.bls12-381.tower-tests)

(defun arena (n) (make-array n :element-type '(unsigned-byte 64) :initial-element 0))
(defun ref+ (a c) (cons (mod (+ (car a) (car c)) b:+p+) (mod (+ (cdr a) (cdr c)) b:+p+)))
(defun ref* (a c)
  (cons (mod (- (* (car a) (car c)) (* (cdr a) (cdr c))) b:+p+)
        (mod (+ (* (car a) (cdr c)) (* (cdr a) (car c))) b:+p+)))
(defun reference-product (a c)
  ;; Direct schoolbook polynomial oracle in Fp2[w]/(w^6-(1+i)).
  (let ((out (make-array 6 :initial-element '(0 . 0))))
    (dotimes (i 6)
      (dotimes (j 6)
        (let* ((power (+ i j)) (v (ref* (aref a i) (aref c j))))
          (when (>= power 6) (setf power (- power 6) v (ref* v '(1 . 1))))
          (setf (aref out power) (ref+ (aref out power) v))))) out))
(defun store-reference (a o coefficients)
  (loop for target in '(0 3 1 4 2 5) for i from 0 do
    (b::f2-from-integer! a (+ o (* target 12)) (aref coefficients i))))
(defun read-reference (a o)
  (map 'vector (lambda (i) (b::f2-to-integer a (+ o (* i 12)))) '(0 3 1 4 2 5)))
(defun sample-coefficients (seed)
  (let ((x seed))
    (flet ((next () (setf x (mod (+ (* x #x5851f42d4c957f2d) #x14057b7ef767814f) b:+p+))))
      (map 'vector (lambda (i) (declare (ignore i)) (cons (next) (next))) '#(0 1 2 3 4 5)))))

(deftest tower-products-aliases-and-squares ()
  (let ((w (arena 2048)))
    (loop for seed from 1 to 24 do
      (let* ((a (sample-coefficients seed)) (c (sample-coefficients (+ seed 100)))
             (expected (reference-product a c)))
        (store-reference w 0 a) (store-reference w 72 c)
        (b::f12-mul! w 144 w 0 w 72 w 256)
        (is-equalp expected (read-reference w 144))
        (b::f12-mul! w 0 w 0 w 72 w 256)
        (is-equalp expected (read-reference w 0))
        (store-reference w 0 a)
        (b::f12-mul! w 72 w 0 w 72 w 256)
        (is-equalp expected (read-reference w 72))
        (store-reference w 0 a)
        (b::f12-square! w 0 w 0 w 256)
        (is-equalp (reference-product a a) (read-reference w 0))
        (store-reference w 0 a)
        (b::f6-square! w 144 w 0 w 256)
        (b::f6-mul! w 180 w 0 w 0 w 256)
        (is (b::f6-equal-p w 144 w 180))))))

(deftest tower-inversion-sparse-and-frobenius ()
  (let ((w (arena 2048)))
    (loop for seed from 11 to 14 do
      (store-reference w 0 (sample-coefficients seed))
      (b::f12-inv! w 72 w 0 w 256)
      (b::f12-mul! w 144 w 0 w 72 w 256)
      (b::f12-one! w 216)
      (is (b::f12-equal-p w 144 w 216))
      (let* ((c (sample-coefficients (+ seed 50)))
             (line (vector (aref c 0) '(0 . 0) (aref c 2) (aref c 3) '(0 . 0) '(0 . 0))))
        (store-reference w 72 line)
        (b::f2-copy! w 144 w 72)
        (b::f2-copy! w 156 w 84)
        (b::f2-copy! w 168 w 120)
        (b::f12-mul-line! w 180 w 0 w 144 w 320)
        (is-equalp (reference-product (read-reference w 0) line) (read-reference w 180))))
    (store-reference w 0 (sample-coefficients 91))
    (dolist (power '(1 2 3 6 11))
      (b::f12-frobenius! w 72 w 0 power w 256)
      (b::f12-power! w 144 w 0 (expt b:+p+ power) nil w 256)
      (is (b::f12-equal-p w 72 w 144)))))

(deftest tower-cyclotomic-and-exact-final-exponent ()
  (let ((w (arena 2048)))
    (store-reference w 0 (sample-coefficients 127))
    (b::f12-inv! w 72 w 0 w 512)
    (b::f12-conjugate! w 144 w 0)
    (b::f12-mul! w 72 w 72 w 144 w 512)
    (b::f12-frobenius! w 144 w 72 2 w 512)
    (b::f12-mul! w 72 w 72 w 144 w 512)
    (b::f12-square! w 144 w 72 w 512)
    (b::f12-cyclotomic-square! w 216 w 72 w 512)
    (is (b::f12-equal-p w 144 w 216))
    (b::f12-cyclotomic-square! w 72 w 72 w 512)
    (is (b::f12-equal-p w 144 w 72))
    (b::f12-final! w 72 w 0 w 512)
    (b::f12-power! w 144 w 0 (/ (1- (expt b:+p+ 12)) b:+r+) nil w 512)
    (is (b::f12-equal-p w 72 w 144))
    (let ((before (sb-ext:get-bytes-consed)))
      (dotimes (i 8)
        (b::f12-cyclotomic-square! w 144 w 72 w 512)
        (b::f12-mul! w 144 w 144 w 72 w 512)
        (b::f12-frobenius! w 144 w 144 2 w 512))
      (is= before (sb-ext:get-bytes-consed)))))

(deftest miller-and-final-exponent-do-not-cons ()
  (let ((w (arena 2048)) (p (b:g1-generator)) (q (b:g2-generator)))
    (dotimes (i 2)
      (let ((base (* i 84)))
        (b::fp-from-integer! w base (car p))
        (b::fp-from-integer! w (+ base 6) (cdr p))
        (when (= i 1) (b::fp-neg! w (+ base 6) w (+ base 6)))
        (b::g2-jfrom-affine! w (+ base 12) q)
        (b::g2-jcopy! w (+ base 48) w (+ base 12))))
    (let ((before (sb-ext:get-bytes-consed)))
      (b::miller-product! w 168 2 384 420)
      (b::f12-final! w 240 w 168 w 420)
      (is= before (sb-ext:get-bytes-consed)))
    (b::f12-one! w 312)
    (is (b::f12-equal-p w 240 w 312))))
