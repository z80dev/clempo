(defpackage #:clempo.bls12-381.group-tests
  (:use #:cl #:clempo.base))
(in-package #:clempo.bls12-381.group-tests)

(defun group-function (group suffix)
  (fdefinition (find-symbol (format nil "G~D-~A" group suffix) '#:clempo.bls12-381)))

(defun affine-reference-add (group p q)
  ;; Deliberately independent affine formulas over the original integer fields.
  ;; These are slow test oracles, not alternative production implementations.
  (let ((add (if (= group 1) #'clempo.bls12-381::fp+ #'clempo.bls12-381::f2+))
        (sub (if (= group 1) #'clempo.bls12-381::fp- #'clempo.bls12-381::f2-))
        (mul (if (= group 1) #'clempo.bls12-381::fp* #'clempo.bls12-381::f2*))
        (inv (if (= group 1) #'clempo.bls12-381::fp-inv #'clempo.bls12-381::f2-inv))
        (zero (if (= group 1) 0 '(0 . 0))))
    (cond ((null p) q) ((null q) p)
          ((and (equal (car p) (car q))
                (or (not (equal (cdr p) (cdr q))) (equal (cdr p) zero))) nil)
          (t
           (let* ((x (car p)) (y (cdr p))
                  (slope
                    (if (equal p q)
                        (let ((xx (funcall mul x x)))
                          (funcall mul (funcall add xx (funcall add xx xx))
                                   (funcall inv (funcall add y y))))
                        (funcall mul (funcall sub (cdr q) y)
                                 (funcall inv (funcall sub (car q) x)))))
                  (xx (funcall sub (funcall sub (funcall mul slope slope) x) (car q))))
             (cons xx (funcall sub (funcall mul slope (funcall sub x xx)) y)))))))

(deftest limb-group-affine-reference-and-signed-scalars ()
  (dolist (group '(1 2))
    (let* ((g (funcall (group-function group "GENERATOR")))
           (mul (group-function group "MUL")) (add (group-function group "ADD"))
           (neg (group-function group "NEG")) (curve (group-function group "ON-CURVE-P"))
           (saved (copy-tree g)) (expected nil))
      (dotimes (i 25)
        (is (equal expected (funcall mul g i)))
        (is (equal (funcall neg expected) (funcall mul g (- i))))
        (is (funcall curve expected))
        (setf expected (affine-reference-add group expected g)))
      (is (equal g saved) "public operations must not mutate affine arguments")
      (is (equal g (funcall add nil g)))
      (is (equal g (funcall add g nil)))
      (is (null (funcall add nil nil)))
      (is (null (funcall mul nil (ash 1 511))))
      (is (null (funcall mul g 0)))
      (is (null (funcall neg nil)))
      (dolist (n (list (ash 1 64) (1- (ash 1 64)) (1+ (ash 1 64))
                      (ash 1 255) (1- (ash 1 319)) (1+ clempo.bls12-381:+r+)))
        (is (equal (funcall neg (funcall mul g n)) (funcall mul g (- n))))
        (is (equal (funcall mul g (1+ n)) (funcall add g (funcall mul g n)))))
      (signals clempo.bls12-381:invalid-point (funcall mul g 1/2))
      (signals clempo.bls12-381:invalid-point (funcall mul nil 'bad)))))

(defun put-scaled-generator (group arena off scale)
  (let ((g (funcall (group-function group "GENERATOR"))))
    (funcall (group-function group "JFROM-AFFINE!") arena off
             (if (= group 1)
                 (cons (clempo.bls12-381::fp* (car g) (* scale scale))
                       (clempo.bls12-381::fp* (cdr g) (* scale scale scale)))
                 (cons (clempo.bls12-381::f2-scale (car g) (* scale scale))
                       (clempo.bls12-381::f2-scale (cdr g) (* scale scale scale)))))
    (clempo.bls12-381::fp-from-integer! arena (+ off (if (= group 1) 12 24)) scale)))

(deftest limb-jacobian-offset-alias-and-scratch-contracts ()
  (dolist (group '(1 2))
    (let* ((words (if (= group 1) 18 36))
           (scratch (if (= group 1) clempo.bls12-381::+g1-jmul-work-words+
                                    clempo.bls12-381::+g2-jmul-work-words+))
           (p 4) (q (+ p words)) (out (+ q words)) (wo (+ out words))
           (end (+ wo scratch)) (guard #xdedebaba12345678)
           (a (make-array (+ end 4) :element-type '(unsigned-byte 64) :initial-element guard))
           (from (group-function group "JFROM-AFFINE!"))
           (to (group-function group "JTO-AFFINE"))
           (double (group-function group "JDOUBLE!"))
           (add (group-function group "JADD!"))
           (mixed (group-function group "JADD-AFFINE!"))
           (neg (group-function group "JNEG!"))
           (mul (group-function group "JMUL!"))
           (equal-j (group-function group "JEQUAL-P"))
           (g (funcall (group-function group "GENERATOR")))
           (g2 (affine-reference-add group g g))
           (g3 (affine-reference-add group g2 g)))
      (dolist (destination (list p q out))
        (funcall from a p g) (funcall from a q g2)
        (funcall add a destination a p a q a wo)
        (is (equal g3 (funcall to a destination a wo))))
      (dolist (destination (list p q out))
        (funcall from a p g) (funcall from a q g2)
        (funcall mixed a destination a p a q a wo)
        (is (equal g3 (funcall to a destination a wo))))
      (dolist (destination (list p out))
        (funcall from a p g)
        (funcall double a destination a p a wo)
        (is (equal g2 (funcall to a destination a wo))))
      ;; Both operands may denote exactly the same point.
      (funcall from a p g)
      (funcall add a p a p a p a wo)
      (is (equal g2 (funcall to a p a wo)))
      (funcall from a p g) (funcall neg a q a p)
      (funcall add a q a p a q a wo)
      (is (null (funcall to a q a wo)))
      ;; Infinity is determined solely by Z, even with arbitrary X/Y words.
      (fill a guard :start q :end (+ q words))
      (dotimes (i (if (= group 1) 6 12))
        (setf (aref a (+ q (* 2 (if (= group 1) 6 12)) i)) 0))
      (funcall from a p g)
      (funcall add a out a q a p a wo)
      (is (equal g (funcall to a out a wo)))
      (funcall double a q a q a wo)
      (is (null (funcall to a q a wo)))
      ;; Nonunit projective Z exercises the full, not just mixed, formula.
      (put-scaled-generator group a p 3)
      (put-scaled-generator group a q 5)
      (is (funcall equal-j a p a q a wo))
      (is (equal g (funcall to a p a wo)))
      (funcall add a out a p a q a wo)
      (is (equal g2 (funcall to a out a wo)))
      (dolist (s (list 0 1 3 -1 -3 (- (ash 1 64)) (- (1+ (ash 1 64)))))
        (put-scaled-generator group a p 3)
        (funcall mul a p a p s a wo)
        (is (equal (funcall (group-function group "MUL") g s) (funcall to a p a wo))))
      (dotimes (i 4)
        (is (= guard (aref a i)))
        (is (= guard (aref a (+ end i))))))))

(deftest limb-group-subgroup-constants-derived ()
  (let* ((p clempo.bls12-381:+p+) (r clempo.bls12-381:+r+)
         (x (- clempo.bls12-381::+bls-x-absolute+))
         (beta clempo.bls12-381::+g1-beta+)
         (xi '(1 . 1)))
    (is (= r (+ (expt x 4) (- (* x x)) 1)))
    (is (= p (+ (/ (* (expt (1- x) 2) r) 3) x)))
    (is (= (mod p r) (mod x r)))
    (is (/= beta 1))
    (is (= 1 (mod (expt beta 3) p)))
    (is (equal (cons 0 clempo.bls12-381::+g2-psi-x-imag+)
               (clempo.bls12-381::f2-inv
                (clempo.bls12-381::f2-pow xi (/ (1- p) 3)))))
    (is (equal (cons clempo.bls12-381::+g2-psi-y-real+
                     clempo.bls12-381::+g2-psi-y-imag+)
               (clempo.bls12-381::f2-inv
                (clempo.bls12-381::f2-pow xi (/ (1- p) 2)))))
    ;; Selects the correct one of the two nontrivial cubic roots, not just any root.
    (let ((g (clempo.bls12-381:g1-generator)))
      (is (equal (cons (clempo.bls12-381::fp* beta (car g)) (cdr g))
                 (clempo.bls12-381:g1-mul g (- (* x x))))))
    (let* ((g (clempo.bls12-381:g2-generator))
           (conj-x (cons (caar g) (clempo.bls12-381::fp-neg (cdar g))))
           (conj-y (cons (cadr g) (clempo.bls12-381::fp-neg (cddr g)))))
      (is (equal (cons (clempo.bls12-381::f2* conj-x
                         (cons 0 clempo.bls12-381::+g2-psi-x-imag+))
                       (clempo.bls12-381::f2* conj-y
                         (cons clempo.bls12-381::+g2-psi-y-real+
                               clempo.bls12-381::+g2-psi-y-imag+)))
                 (clempo.bls12-381:g2-mul g x))))))

(deftest limb-group-full-scalar-and-subgroup-properties ()
  ;; Order three makes accidental reduction modulo r immediately observable.
  (let ((p '(0 . 2)) (r clempo.bls12-381:+r+))
    (is (clempo.bls12-381:g1-on-curve-p p))
    (is (not (clempo.bls12-381:g1-subgroup-p p)))
    (is (equal p (clempo.bls12-381:g1-mul p r)))
    (is (equal (clempo.bls12-381:g1-neg p) (clempo.bls12-381:g1-mul p (- r))))
    (is (equal p (clempo.bls12-381:g1-msm (vector p) (vector r))))
    (is (null (clempo.bls12-381:g1-mul p (* 3 r)))))
  ;; Deterministic points on the entire curves, not just generator multiples.
  (let ((g1-count 0) (g2-count 0) (g2-outside 0))
    (dotimes (i 18)
      (let ((y (clempo.bls12-381::fp-sqrt (+ (* i i i) 4))))
        (when y
          (incf g1-count)
          (let ((p (cons i y)))
            (is (eql (clempo.bls12-381:g1-subgroup-p p)
                     (null (clempo.bls12-381:g1-mul p clempo.bls12-381:+r+)))))))
      (let* ((x (cons i 1))
             (y (clempo.bls12-381::f2-sqrt
                 (clempo.bls12-381::f2+ (clempo.bls12-381::f2* x (clempo.bls12-381::f2* x x))
                                      '(4 . 4)))))
        (when y
          (incf g2-count)
          (let* ((p (cons x y))
                 (in-subgroup (null (clempo.bls12-381:g2-mul p clempo.bls12-381:+r+))))
            (unless in-subgroup (incf g2-outside))
            (is (eql in-subgroup (clempo.bls12-381:g2-subgroup-p p)))
            (is (equal (clempo.bls12-381:g2-mul p (1+ clempo.bls12-381:+r+))
                       (clempo.bls12-381:g2-msm (list p) (list (1+ clempo.bls12-381:+r+)))))))))
    (is (plusp g1-count)) (is (plusp g2-count)) (is (plusp g2-outside)))
  (dolist (group '(1 2))
    (let ((curve (group-function group "ON-CURVE-P"))
          (subgroup (group-function group "SUBGROUP-P"))
          (g (funcall (group-function group "GENERATOR"))))
      (is (funcall subgroup nil))
      (is (funcall subgroup g))
      (dolist (bad (if (= group 1)
                       (list 7 '(0 . 0) '(-1 . 2) (cons clempo.bls12-381:+p+ 2)
                             (cons (+ clempo.bls12-381:+p+ (car g)) (cdr g)))
                       (list 7 '((0 . 0) . (0 . 0)) '((-1 . 0) . (2 . 0))
                             (cons (cons clempo.bls12-381:+p+ 0) (cdr g)))))
        (is (not (funcall curve bad)))
        (is (not (funcall subgroup bad)))))))

(deftest limb-pippenger-window-and-sequence-properties ()
  (dolist (group '(1 2))
    (let* ((g (funcall (group-function group "GENERATOR")))
           (ng (funcall (group-function group "NEG") g))
           (mul (group-function group "MUL")) (msm (group-function group "MSM")))
      (dolist (n '(0 1 7 8 31 32 127 128 512))
        (let ((points (make-array n)) (scalars (make-array n)) (sum 0))
          (dotimes (i n)
            (let* ((point (cond ((zerop (mod i 7)) nil) ((oddp i) ng) (t g)))
                   (s (if (= n 512) (mod i 4)
                          (case (mod i 5)
                            (0 0) (1 1) (2 clempo.bls12-381:+r+)
                            (3 (ash 1 319)) (t (1- (ash 1 127)))))))
              (setf (aref points i) point (aref scalars i) s)
              (when point (incf sum (if (eq point ng) (- s) s)))))
          (let ((expected (funcall mul g sum)))
            (is (equal expected (funcall msm points scalars)))
            (is (equal expected (funcall msm (coerce points 'list) (coerce scalars 'list)))))
          (is (null (funcall msm points (make-array n :initial-element 0))))))
      (signals clempo.bls12-381:invalid-point (funcall msm (list g) nil))
      (signals clempo.bls12-381:invalid-point (funcall msm nil '(1)))
      (signals clempo.bls12-381:invalid-point (funcall msm (list nil) '(-1)))
      (signals clempo.bls12-381:invalid-point (funcall msm (list g) '(1/2))))))
