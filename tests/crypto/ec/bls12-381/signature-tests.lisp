(defpackage #:clempo.bls-signatures.tests
  (:use #:cl #:clempo.base #:clempo.bls12-381))
(in-package #:clempo.bls-signatures.tests)

(defun sk (n)
  "The secret scalar N mod r as 32 big-endian octets."
  (fr-octets-from-integer n))

(defun check-signature-vectors (variant rows)
  (let ((dst (string->octets
              (if (eq variant :min-sig)
                  "BLS_SIG_BLS12381G1_XMD:SHA-256_SSWU_RO_NUL_"
                  "BLS_SIG_BLS12381G2_XMD:SHA-256_SSWU_RO_NUL_"))))
    (dolist (row rows)
      (let* ((a (position #\: row)) (b (position #\: row :start (1+ a)))
             (secret (sk (parse-integer row :end a :radix 16)))
             (message (hex->octets (subseq row (1+ a) b)))
             (signature (hex->octets (subseq row (1+ b))))
             (public (bls-public-key variant secret)))
        (is-equalp signature (bls-sign variant secret message :dst dst))
        (is (bls-verify variant public message signature :dst dst))))))

(deftest signature-namespace-framing ()
  (is-equalp (hex->octets "000102")
             (bls-union-unique (make-octets 0) (hex->octets "0102")))
  (is-equalp (hex->octets "016162")
             (bls-union-unique (string->octets "a") (string->octets "b")))
  (let ((framed (bls-union-unique (make-octets 128) (make-octets 0))))
    (is (= 128 (aref framed 0)))
    (is (= 1 (aref framed 1)))))

(deftest signature-pop-aggregate-batch-threshold ()
  (dolist (variant '(:min-sig :min-pk))
    (let* ((ns (string->octets "test")) (msg (string->octets "message"))
           (bad (string->octets "wrong"))
           (p1 (bls-public-key variant (sk 11))) (p2 (bls-public-key variant (sk 17)))
           (s1 (bls-sign variant (sk 11) msg :namespace ns))
           (s2 (bls-sign variant (sk 17) msg :namespace ns))
           (aggregate (bls-aggregate variant (list s1 s2)))
           (counter 0))
      (is (bls-verify variant p1 msg s1 :namespace ns))
      (is (not (bls-verify variant p1 bad s1 :namespace ns)))
      (is (bls-pop-verify variant p1 ns (bls-pop-prove variant (sk 11) ns)))
      (is (not (bls-pop-verify variant p1 bad (bls-pop-prove variant (sk 11) ns))))
      (is (bls-fast-aggregate-verify variant (list p1 p2) ns msg aggregate))
      (is (bls-aggregate-verify variant (list (list p1 ns msg) (list p2 ns msg)) aggregate))
      (is (bls-batch-verify variant (list (list p1 ns msg s1) (list p2 ns msg s2))
                            (lambda () (incf counter))))
      (is (= counter 2))
      (is (not (bls-batch-verify variant (list (list p1 ns bad s1) (list p2 ns msg s2))
                                   (lambda () (incf counter)))))
      (dolist (mode '(:nonzero-counter :roots-of-unity))
        (let* ((coefficients (list (bls-public-key variant (sk 11)) (bls-public-key variant (sk 7))))
               (partials
                 (loop for index in '(3 0 2)
                       for x = (bls-participant-scalar index 4 :mode mode)
                       collect (bls-threshold-sign variant (sk (+ 11 (* 7 x)))
                                                   index 4 ns msg :mode mode))))
          (dolist (partial partials)
            (is (bls-threshold-verify variant coefficients 4 ns msg partial :mode mode)))
          (is-equalp s1 (bls-threshold-recover variant 2 4 partials :mode mode))
          (is (bls-verify variant p1 msg (bls-threshold-recover variant 2 4 partials :mode mode)
                          :namespace ns)))))
    (let ((infinity (make-octets (if (eq variant :min-sig) 48 96))))
      (setf (aref infinity 0) #xc0)
      (is (not (bls-verify variant (bls-public-key variant (sk 1)) (make-octets 0) infinity))))
    (dolist (bad (list (make-octets 32) (integer->octets +r+ 32) 11 (subseq (sk 11) 1)))
      (signals error (bls-public-key variant bad))
      (signals error (bls-sign variant bad (make-octets 0))))))

(deftest signature-batch-same-signer ()
  (dolist (variant '(:min-sig :min-pk))
    (let* ((public (bls-public-key variant (sk 11)))
           (ns (string->octets "namespace"))
           (a (string->octets "first"))
           (b (string->octets "second"))
           (sa (bls-sign variant (sk 11) a :namespace ns))
           (sb (bls-sign variant (sk 11) b :namespace ns))
           (counter 0))
      (is (bls-batch-verify-same-signer
           variant public (list (list ns a sa) (list ns b sb))
           (lambda () (incf counter))))
      (is (= counter 2))
      (is (not (bls-batch-verify-same-signer
                variant public (list (list ns b sa) (list ns b sb))
                (lambda () (incf counter))))))))

(deftest signature-rejection-and-cancelling-errors ()
  (dolist (variant '(:min-sig :min-pk))
    (let* ((ns (string->octets "batch-errors")) (msg (string->octets "payload"))
           (pk1 (bls-public-key variant (sk 3))) (pk2 (bls-public-key variant (sk 5)))
           (s1 (bls-sign variant (sk 3) msg :namespace ns))
           (s2 (bls-sign variant (sk 5) msg :namespace ns))
           (decode (if (eq variant :min-sig) #'g1-decompress #'g2-decompress))
           (encode (if (eq variant :min-sig) #'g1-compress #'g2-compress))
           (add (if (eq variant :min-sig) #'g1-add #'g2-add))
           (neg (if (eq variant :min-sig) #'g1-neg #'g2-neg))
           (g (if (eq variant :min-sig) (g1-generator) (g2-generator)))
           (bad1 (funcall encode (funcall add (funcall decode s1) g)))
           (bad2 (funcall encode (funcall add (funcall decode s2) (funcall neg g))))
           (counter 0))
      ;; Aggregation alone cannot prove that either signature is valid.
      (is-equalp (bls-aggregate variant (list s1 s2))
                 (bls-aggregate variant (list bad1 bad2)))
      (is (not (bls-batch-verify variant
                                (list (list pk1 ns msg bad1) (list pk2 ns msg bad2))
                                (lambda () (incf counter)))))
      (is= '(0 1) (bls-batch-verify-same-message
                    variant (list (list pk1 bad1) (list pk2 bad2)) ns msg
                    (lambda () (incf counter))))
      (is (not (bls-verify variant pk1 msg bad1 :namespace ns)))
      (is (not (bls-verify variant pk1 msg (make-octets 1) :namespace ns)))
      (signals error
        (bls-fast-aggregate-verify variant (list pk1 pk1) ns msg
                                   (bls-aggregate variant (list s1 s1))))
      (signals error (bls-threshold-recover variant 2 3 (list (cons 0 s1))))
      (signals error
        (bls-threshold-recover variant 2 3 (list (cons 0 s1) (cons 0 s1))))
      (signals error (bls-participant-scalar 3 3))
      (let ((proof (bls-pop-prove variant (sk 3) ns)))
        (is (not (bls-pop-verify variant pk2 ns proof))))
      (let* ((coefficients (list pk1 (bls-public-key variant (sk 2))))
             (partial (bls-threshold-pop-prove variant (sk 5) 0 3 pk1 ns)))
        (is (bls-threshold-pop-verify variant coefficients 3 ns partial))
        (is (not (bls-threshold-pop-verify variant coefficients 3
                                             (string->octets "other") partial)))))))
