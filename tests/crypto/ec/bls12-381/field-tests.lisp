(defpackage #:clempo.bls12-381.field-tests
  (:use #:cl #:clempo.base))
(in-package #:clempo.bls12-381.field-tests)

(defun field-arena (words &optional (initial 0))
  (make-array words :element-type '(unsigned-byte 64) :initial-element initial))

(defun field-raw-integer (a offset)
  (loop for i below 6 sum (ash (aref a (+ offset i)) (* i 64))))

(defun field-store-raw (a offset integer)
  (dotimes (i 6)
    (setf (aref a (+ offset i)) (ldb (byte 64 (* i 64)) integer))))

(defun field-modular-power (base exponent)
  ;; Independent integer oracle: not the raw field power implementation.
  (let ((p clempo.bls12-381:+p+) (result 1))
    (loop while (plusp exponent) do
      (when (oddp exponent) (setf result (mod (* result base) p)))
      (setf exponent (ash exponent -1) base (mod (* base base) p)))
    result))

(defun field-boundaries ()
  (let ((p clempo.bls12-381:+p+))
    (remove-duplicates
     (append (list 0 1 2 3 (1- p) (- p 2) (- p 3) (ash p -1))
             (loop for bit in '(1 31 32 63 64 65 127 128 129 191 192 193
                               255 256 257 319 320 321 379 380)
                   append (loop for delta in '(-1 0 1)
                                collect (mod (+ (ash 1 bit) delta) p)))
             (loop for byte in '(#x55 #xaa #xff)
                   collect (mod (loop for i below 48 sum (ash byte (* i 8))) p))))))

(deftest raw-fp-montgomery-conversions ()
  (let* ((p clempo.bls12-381:+p+) (r (mod (ash 1 384) p))
         (sentinel #xc5a55a5af00dcafe) (a (field-arena 11 sentinel)))
    (dolist (n (append (field-boundaries)
                      (list -1 (- p) (1+ p) (* p p) (- (* p p) 17)
                            (ash 1 1024) (- (ash 1 1024)))))
      (clempo.bls12-381::fp-from-integer! a 3 n)
      (is= (mod (* n r) p) (field-raw-integer a 3))
      (is= (mod n p) (clempo.bls12-381::fp-to-integer a 3))
      (dotimes (i 3) (is= sentinel (aref a i)))
      (loop for i from 9 below 11 do (is= sentinel (aref a i))))
    (clempo.bls12-381::fp-zero! a 3)
    (is (clempo.bls12-381::fp-zero-p a 3))
    (is= 0 (field-raw-integer a 3))
    (clempo.bls12-381::fp-one! a 3)
    (is= r (field-raw-integer a 3))
    (is (not (clempo.bls12-381::fp-zero-p a 3)))
    (let ((b (field-arena 10 sentinel)))
      (clempo.bls12-381::fp-copy! b 1 a 3)
      (is (clempo.bls12-381::fp-equal-p a 3 b 1))
      (clempo.bls12-381::fp-copy! b 1 b 1)
      (is (clempo.bls12-381::fp-equal-p a 3 b 1))
      ;; Compare every word, including the top word.
      (dotimes (i 6)
        (setf (aref b (+ i 1)) (logxor 1 (aref b (+ i 1))))
        (is (not (clempo.bls12-381::fp-equal-p a 3 b 1)))
        (setf (aref b (+ i 1)) (logxor 1 (aref b (+ i 1)))))
      (clempo.bls12-381::fp-zero! a 3)
      (dotimes (i 6)
        (setf (aref a (+ i 3)) 1)
        (is (not (clempo.bls12-381::fp-zero-p a 3)))
        (setf (aref a (+ i 3)) 0)))))

(defun field-check-binary (function operation a b)
  (let* ((p clempo.bls12-381:+p+) (sentinel #xdabacafef00dfeed)
         (x (field-arena 10 sentinel)) (y (field-arena 12 sentinel))
         (out (field-arena 11 sentinel))
         (expected (mod (funcall operation a b) p)))
    ;; Separate arrays and nonzero offsets, then each exact output alias.
    (clempo.bls12-381::fp-from-integer! x 1 a)
    (clempo.bls12-381::fp-from-integer! y 3 b)
    (funcall function out 2 x 1 y 3)
    (is= expected (clempo.bls12-381::fp-to-integer out 2))
    (is (< (field-raw-integer out 2) p))
    (is= a (clempo.bls12-381::fp-to-integer x 1))
    (is= b (clempo.bls12-381::fp-to-integer y 3))
    (funcall function x 1 x 1 y 3)
    (is= expected (clempo.bls12-381::fp-to-integer x 1))
    (clempo.bls12-381::fp-from-integer! x 1 a)
    (funcall function y 3 x 1 y 3)
    (is= expected (clempo.bls12-381::fp-to-integer y 3))
    (dolist (entry (list (list x 1) (list y 3) (list out 2)))
      (destructuring-bind (array offset) entry
        (loop for i below offset do (is= sentinel (aref array i)))
        (loop for i from (+ offset 6) below (length array)
              do (is= sentinel (aref array i)))))))

(deftest raw-fp-boundary-arithmetic-and-aliases ()
  (let ((values (field-boundaries)))
    (dolist (a values)
      (dolist (b values)
        (field-check-binary #'clempo.bls12-381::fp-mul! #'* a b)
        (field-check-binary #'clempo.bls12-381::fp-add! #'+ a b)
        (field-check-binary #'clempo.bls12-381::fp-sub! #'- a b)))))

(deftest raw-fp-direct-carries-and-borrows ()
  ;; Test raw residues too: conversion permutes the integer boundary set.
  ;; In particular p-1 and chains of all-one low words stress carry/borrow.
  (let* ((p clempo.bls12-381:+p+)
         (r-inverse (field-modular-power (mod (ash 1 384) p) (- p 2)))
         (values (field-boundaries))
         (arena (field-arena 26 #x123456789abcdef0)))
    (dolist (a values)
      (dolist (b values)
        (field-store-raw arena 1 a)
        (field-store-raw arena 9 b)
        (clempo.bls12-381::fp-mul! arena 18 arena 1 arena 9)
        (is= (mod (* a b r-inverse) p) (field-raw-integer arena 18))
        (clempo.bls12-381::fp-add! arena 18 arena 1 arena 9)
        (is= (mod (+ a b) p) (field-raw-integer arena 18))
        (clempo.bls12-381::fp-sub! arena 18 arena 1 arena 9)
        (is= (mod (- a b) p) (field-raw-integer arena 18))))
    (dolist (i '(0 7 8 15 16 17 24 25))
      (is= #x123456789abcdef0 (aref arena i)))))

(deftest raw-fp-deterministic-modular-equivalence ()
  (let ((state #x123456789abcdef) (p clempo.bls12-381:+p+))
    (flet ((next ()
             (setf state (mod (+ (* state #x5851f42d4c957f2d)
                                #x14057b7ef767814f) p))))
      (dotimes (i 4096)
        (let ((a (next)) (b (next)))
          (field-check-binary #'clempo.bls12-381::fp-mul! #'* a b)
          (field-check-binary #'clempo.bls12-381::fp-add! #'+ a b)
          (field-check-binary #'clempo.bls12-381::fp-sub! #'- a b))))))

(deftest raw-fp-unary-and-identical-input-aliases ()
  (let ((p clempo.bls12-381:+p+) (arena (field-arena 24)))
    (dolist (a (field-boundaries))
      (clempo.bls12-381::fp-from-integer! arena 1 a)
      (clempo.bls12-381::fp-square! arena 10 arena 1)
      (is= (mod (* a a) p) (clempo.bls12-381::fp-to-integer arena 10))
      (clempo.bls12-381::fp-square! arena 1 arena 1)
      (is= (mod (* a a) p) (clempo.bls12-381::fp-to-integer arena 1))
      (clempo.bls12-381::fp-from-integer! arena 1 a)
      (clempo.bls12-381::fp-neg! arena 10 arena 1)
      (is= (mod (- a) p) (clempo.bls12-381::fp-to-integer arena 10))
      (clempo.bls12-381::fp-neg! arena 1 arena 1)
      (is= (mod (- a) p) (clempo.bls12-381::fp-to-integer arena 1))
      (clempo.bls12-381::fp-neg! arena 1 arena 1)
      (is= a (clempo.bls12-381::fp-to-integer arena 1))
      (clempo.bls12-381::fp-mul! arena 1 arena 1 arena 1)
      (is= (mod (* a a) p) (clempo.bls12-381::fp-to-integer arena 1))
      (clempo.bls12-381::fp-from-integer! arena 1 a)
      (clempo.bls12-381::fp-add! arena 1 arena 1 arena 1)
      (is= (mod (+ a a) p) (clempo.bls12-381::fp-to-integer arena 1))
      (clempo.bls12-381::fp-sub! arena 1 arena 1 arena 1)
      (is (clempo.bls12-381::fp-zero-p arena 1)))))

(deftest raw-fp-powers-and-inverses ()
  (let* ((p clempo.bls12-381:+p+) (sentinel #xfedcba9876543210)
         (arena (field-arena 60 sentinel)))
    ;; Scratch is a disjoint interval within the same arena, with sentinels
    ;; around its full 24-word reservation. No fresh per-bit workspace.
    (dolist (a (list 0 1 2 17 (1- p) (ash p -1)))
      (dolist (exponent (list 0 1 2 3 63 64 65 (1- (ash 1 64))
                             (ash 1 64) (1+ (ash 1 128)) (- p 1) p))
        (clempo.bls12-381::fp-from-integer! arena 1 a)
        (clempo.bls12-381::fp-pow! arena 10 arena 1 exponent arena 23)
        (is= (field-modular-power a exponent)
             (clempo.bls12-381::fp-to-integer arena 10))
        (is= a (clempo.bls12-381::fp-to-integer arena 1))
        (clempo.bls12-381::fp-pow! arena 1 arena 1 exponent arena 23)
        (is= (field-modular-power a exponent)
             (clempo.bls12-381::fp-to-integer arena 1))))
    (dolist (a (remove 0 (field-boundaries)))
      (clempo.bls12-381::fp-from-integer! arena 1 a)
      (clempo.bls12-381::fp-inv! arena 10 arena 1 arena 23)
      (is= 1 (mod (* a (clempo.bls12-381::fp-to-integer arena 10)) p))
      (clempo.bls12-381::fp-mul! arena 10 arena 10 arena 1)
      (is= 1 (clempo.bls12-381::fp-to-integer arena 10))
      (clempo.bls12-381::fp-inv! arena 1 arena 1 arena 23)
      (is= (field-modular-power a (- p 2))
           (clempo.bls12-381::fp-to-integer arena 1)))
    (clempo.bls12-381::fp-zero! arena 1)
    (signals clempo.bls12-381:invalid-point
      (clempo.bls12-381::fp-inv! arena 10 arena 1 arena 23))
    (signals error
      (clempo.bls12-381::fp-pow! arena 10 arena 1 -1 arena 23))
    (dolist (i '(0 7 8 9 16 17 18 19 20 21 22 47 48 49 59))
      (is= sentinel (aref arena i)))))

(deftest raw-fp-hot-operations-do-not-cons ()
  (let ((arena (field-arena 48))
        (canonical #x123456789abcdef0123456789abcdef0123456789abcdef))
    (clempo.bls12-381::fp-from-integer! arena 0 canonical)
    (clempo.bls12-381::fp-from-integer! arena 6 7)
    (let ((before (sb-ext:get-bytes-consed)))
      (dotimes (i 4096)
        (clempo.bls12-381::fp-mul! arena 12 arena 0 arena 6)
        (clempo.bls12-381::fp-square! arena 12 arena 12)
        (clempo.bls12-381::fp-add! arena 12 arena 12 arena 6)
        (clempo.bls12-381::fp-sub! arena 12 arena 12 arena 6)
        (clempo.bls12-381::fp-neg! arena 12 arena 12)
        (clempo.bls12-381::fp-copy! arena 18 arena 12)
        (clempo.bls12-381::fp-equal-p arena 18 arena 12)
        (clempo.bls12-381::fp-zero-p arena 18)
        (clempo.bls12-381::fp-zero! arena 18)
        (clempo.bls12-381::fp-one! arena 18)
        (clempo.bls12-381::fp-from-integer! arena 0 canonical))
      (is= before (sb-ext:get-bytes-consed)))
    (let ((before (sb-ext:get-bytes-consed)))
      (dotimes (i 32)
        (clempo.bls12-381::fp-pow! arena 12 arena 0 #x10000000000000001 arena 24)
        (clempo.bls12-381::fp-inv! arena 12 arena 0 arena 24))
      (is= before (sb-ext:get-bytes-consed)))))
