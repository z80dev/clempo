(defpackage #:clempo.state.tests
  (:use #:cl #:clempo.base #:clempo.state))

(in-package #:clempo.state.tests)

(defun fresh-world ()
  (let ((b (make-memory-backend)))
    (memory-backend-put-account b 1 :nonce 1 :balance 100)
    (memory-backend-put-account b 2 :code (octets-of #x60 #x00))
    (memory-backend-put-storage b 2 5 7)
    (make-world b)))

(deftest world-reads-backend ()
  (let ((w (fresh-world)))
    (is= 100 (get-balance w 1))
    (is= 1 (get-nonce w 1))
    (is= 7 (sload w 2 5))
    (is= 0 (sload w 2 6))
    (is-equalp (octets-of #x60 #x00) (get-code w 2))
    (is (account-exists-p w 1))
    (is (not (account-exists-p w 3)))))

(deftest journal-rolls-back ()
  (let* ((w (fresh-world))
         (cp (checkpoint w)))
    (set-balance w 1 5)
    (sstore w 2 5 9)
    (tstore w 2 1 4)
    (warm-address w 9)
    (warm-slot w 2 5)
    (add-refund w 10)
    (is= 9 (sload w 2 5))
    (is= 7 (storage-original w 2 5))
    (rollback w cp)
    (is= 100 (get-balance w 1))
    (is= 7 (sload w 2 5))
    (is= 0 (tload w 2 1))
    (is (not (address-warm-p w 9)))
    (is (not (slot-warm-p w 2 5)))
    (is= 0 (world-refund w))))

(deftest finalize-deletes-touched-empty-and-drains ()
  (let* ((b (make-memory-backend))
         (_ (memory-backend-put-account b 4))
         (w (make-world b)))
    (declare (ignore _))
    (add-balance w 4 0)                  ; touch the empty account
    (set-balance w 1 50)                 ; create a new one
    (sstore w 1 3 11)
    (finalize-tx w)
    (is (not (account-exists-p w 4)))
    (is= 11 (storage-original w 1 3))
    (let ((changes (drain-changes w)))
      (is= 2 (length changes))
      (apply-changes b changes))
    (is (null (gethash 4 (memory-backend-accounts b))))
    (is= 50 (mem-account-balance (gethash 1 (memory-backend-accounts b))))
    (is= 11 (gethash 3 (mem-account-storage (gethash 1 (memory-backend-accounts b)))))))

(deftest delegation-designators ()
  (let ((d (delegation-designator #x1234)))
    (is= 23 (length d))
    (is= #x1234 (delegation-target d))
    (is (null (delegation-target (octets-of #xef 1 0))))))

(deftest configuration-commitments ()
  "T14: an account's configuration commitment is read from the backend, journaled, drained
and hashed into the account leaf (0x00 || commitment as the fifth RLP string)."
  (let* ((b (make-memory-backend))
         (marker (octets-of #xef)))
    (memory-backend-put-account b 1 :code marker :commitment 5)
    (let ((w (make-world b)))
      (is= 5 (account-commitment (get-account w 1)))
      (is= 0 (account-commitment (get-account w 2)))
      (let ((cp (checkpoint w)))
        (set-commitment w 2 9)
        (set-code w 2 marker)
        (is= 9 (account-commitment (get-account w 2)))
        (rollback w cp)
        (is= 0 (account-commitment (get-account w 2)))
        (is (not (account-exists-p w 2))))
      (set-commitment w 2 9)
      (set-code w 2 marker)
      (finalize-tx w)
      (let ((change (find 2 (drain-changes w) :key #'account-change-address)))
        (is= 9 (account-change-commitment change))
        (apply-changes b (list change)))
      (is= 9 (mem-account-commitment (gethash 2 (memory-backend-accounts b))))
      (let ((root (backend-state-root b))
            (leaf (lambda (commitment)
                    (clempo.trie:encode-account 0 0 clempo.trie:+empty-trie-root+
                                                (code-hash marker) commitment))))
        (let ((expected (clempo.trie:make-secure-trie)))
          (clempo.trie:trie-put expected (integer->octets 1 20) (funcall leaf 5))
          (clempo.trie:trie-put expected (integer->octets 2 20) (funcall leaf 9))
          (is-equalp (clempo.trie:trie-root expected) root))
        ;; the same state without commitments hashes differently
        (setf (mem-account-commitment (gethash 2 (memory-backend-accounts b))) 0)
        (is (not (equalp root (backend-state-root b))))))))
