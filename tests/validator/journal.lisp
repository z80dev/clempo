(in-package #:clempo.validator-process.tests)

(deftest file-vote-journal-sync-and-replay ()
  (uiop:with-temporary-file (:pathname token :stream stream :direction :output)
    (declare (ignore stream))
    (let* ((dir (uiop:ensure-directory-pathname (concatenate 'string (namestring token) "-journal")))
           (journal (net::make-file-journal dir)))
      (unwind-protect
           (progn
             (clempo.simplex:journal-append journal 2 10 (octets-of 10))
             (clempo.simplex:journal-append journal 2 9 (octets-of 9 1))
             (clempo.simplex:journal-append journal 3 1 (octets-of 1))
             (is (null (clempo.simplex:journal-replay journal 2)))
             (clempo.simplex:journal-sync journal 2)
             (let ((reopened (net::make-file-journal dir)))
               (is (null (clempo.simplex:journal-replay reopened 3)))
               (is-equalp (list (octets-of 9 1) (octets-of 10)) (clempo.simplex:journal-replay reopened 2))
               (clempo.simplex:journal-append reopened 2 9 (octets-of 9 2))
               (clempo.simplex:journal-sync reopened 2)
               (is-equalp (list (octets-of 9 1) (octets-of 9 2) (octets-of 10))
                          (clempo.simplex:journal-replay reopened 2))
               (clempo.simplex:journal-prune reopened 2 10)
               (is-equalp (list (octets-of 10)) (clempo.simplex:journal-replay reopened 2))
               (with-open-file (out (net::journal-file reopened 2 10) :direction :output
                                    :if-exists :append :element-type 'octet)
                 (write-byte 0 out))
               (signals error (clempo.simplex:journal-replay reopened 2))))
        (uiop:delete-directory-tree dir :validate t)))))

(deftest file-dkg-store-roundtrip ()
  (uiop:with-temporary-file (:pathname token :stream stream :direction :output)
    (declare (ignore stream))
    (let* ((dir (uiop:ensure-directory-pathname (concatenate 'string (namestring token) "-dkg")))
           (store (net::make-file-dkg-store dir))
           (a (octets-of 42)) (b (octets-of 43)))
      (unwind-protect
           (progn
             (clempo.dkg:dkg-store-put-state store 1 a)
             (clempo.dkg:dkg-store-put-state store 2 a)
             (clempo.dkg:dkg-store-put-state store 2 b)
             (clempo.dkg:dkg-store-append-event store 2 b)
             (clempo.dkg:dkg-store-append-event store 1 a)
             (let ((reopened (net::make-file-dkg-store dir)))
               (is-equalp (list (cons 2 b) (cons 1 a)) (clempo.dkg:dkg-store-events reopened))
               (clempo.dkg:dkg-store-append-event reopened 2 a)
               (clempo.dkg:dkg-store-prune reopened 2)
               (is-equalp (list (cons 2 b)) (clempo.dkg:dkg-store-states reopened))
               (is-equalp (list (cons 2 b) (cons 2 a)) (clempo.dkg:dkg-store-events reopened))))
        (uiop:delete-directory-tree dir :validate t)))))
