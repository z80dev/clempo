(defpackage #:clempo.trie.tests
  (:use #:cl #:clempo.base #:clempo.trie))

(in-package #:clempo.trie.tests)

(defun fixture (name)
  (clempo.json:parse-json
   (clempo.io:read-file-string
    (asdf:system-relative-pathname "clempo-trie"
                                  (concatenate 'string "../../tests/trie/data/" name)))))

(deftest ordered-empty-root ()
  (is-equalp (hex->octets "56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421")
             +empty-trie-root+)
  (is-equalp +empty-trie-root+ (ordered-trie-root nil)))

(deftest ordered-mainnet-transactions-root ()
  (let* ((record (fixture "mainnet_41788340.json"))
         (block (clempo.rlp:rlp-decode (hex->octets (clempo.json:jget record "rawBlock"))))
         (items (loop for tx in (second block)
                      collect (if (listp tx) (clempo.rlp:rlp-encode tx) tx))))
    (is (plusp (length items)))
    (is-equalp (hex->octets (clempo.json:jget record "transactionsRoot"))
               (ordered-trie-root items))))

(defun vector-bytes (value)
  (cond ((eq value :null) (make-octets 0))
        ((and (>= (length value) 2) (string= "0x" value :end2 2)) (hex->octets value))
        (t (string->octets value))))

(defun check-trie-vectors (name &key secure)
  (dolist (case (cdr (fixture name)))
    (let* ((input (clempo.json:jget (cdr case) "in"))
           (expected (hex->octets (clempo.json:jget (cdr case) "root")))
           (trie (make-trie :secure secure))
           (model (make-hash-table :test 'equalp)))
      (flet ((apply-pair (key value)
               (let ((key (vector-bytes key)) (value (vector-bytes value)))
                 (trie-put trie key value)
                 (if (zerop (length value))
                     (progn (remhash key model) (is (null (trie-get trie key))))
                     (progn (setf (gethash key model) value)
                            (is-equalp value (trie-get trie key)))))))
        (if (vectorp input)
            (loop for pair across input do (apply-pair (aref pair 0) (aref pair 1)))
            (dolist (pair (cdr input)) (apply-pair (car pair) (cdr pair)))))
      (is (octets= expected (trie-root trie)) "~A: ~A" name (car case))
      (maphash (lambda (key value)
                 (is-equalp value (trie-get trie key))
                 (multiple-value-bind (proved valid)
                     (verify-proof expected key (trie-proof trie key) :secure secure)
                   (is valid)
                   (is-equalp value proved)))
               model))))

(deftest ethereum-trie-vectors ()
  (check-trie-vectors "trietest.json")
  (check-trie-vectors "trieanyorder.json")
  (check-trie-vectors "trietest_secureTrie.json" :secure t)
  (check-trie-vectors "trieanyorder_secureTrie.json" :secure t)
  (check-trie-vectors "hex_encoded_securetrie_test.json" :secure t))

(deftest proof-inline-boundary ()
  (let ((trie (make-trie))
        (inline (octets-of #x10)) (hashed (octets-of #x20))
        (absent (octets-of #x11)))
    (trie-put trie inline (make-octets 28))
    (trie-put trie hashed (make-octets 29))
    (let* ((root (trie-root trie))
           (inline-proof (trie-proof trie inline))
           (hashed-proof (trie-proof trie hashed))
           (decoded (clempo.rlp:rlp-decode (first hashed-proof))))
      (is= 1 (length inline-proof))
      (is= 2 (length hashed-proof))
      (is (listp (nth 1 decoded)))
      (is= 32 (length (nth 2 decoded)))
      (is= 32 (length (second hashed-proof)))
      (is-equalp (list nil t)
                 (multiple-value-list (verify-proof root absent (trie-proof trie absent))))
      (is-equalp (list nil nil)
                 (multiple-value-list (verify-proof root hashed inline-proof)))
      (is-equalp (list nil nil)
                 (multiple-value-list (verify-proof root inline hashed-proof)))
      (let ((corrupt (copy-seq (second hashed-proof))))
        (setf (aref corrupt 10) 1)
        (is-equalp (list nil nil)
                   (multiple-value-list (verify-proof root hashed
                                                     (list (first hashed-proof) corrupt))))))))

(defstruct memory-store
  (nodes (make-hash-table :test 'equalp))
  (reads 0)
  (writes 0))

(defmethod node-store-get ((store memory-store) hash)
  (incf (memory-store-reads store))
  (gethash hash (memory-store-nodes store)))

(defmethod node-store-put ((store memory-store) hash bytes)
  (incf (memory-store-writes store))
  (setf (gethash hash (memory-store-nodes store)) bytes))

(deftest trie-store-and-snapshots ()
  (let* ((store (make-memory-store))
         (trie (make-trie :store store))
         (a (octets-of #x10)) (b (octets-of #x11)) (c (octets-of #x20))
         (v (fill (make-octets 64) 1))
         (other (octets-of 2)))
    (dolist (key (list a b c)) (trie-put trie key v))
    (let* ((root (trie-root trie))
           (snapshot (trie-clone trie))
           (lazy (make-trie :store store :root root))
           (writes (memory-store-writes store)))
      (is-equalp root (trie-root lazy))
      (is= 0 (memory-store-reads store))
      (is-equalp v (trie-get lazy a))
      (is (< (memory-store-reads store) writes))
      (trie-put trie a (copy-seq v))
      (is (eq root (trie-root trie)))
      (is= writes (memory-store-writes store))
      (trie-put trie a other)
      (is (not (octets= root (trie-root trie))))
      (is= (+ writes 2) (memory-store-writes store))
      (is-equalp root (trie-root snapshot))
      (is-equalp v (trie-get snapshot a))
      (is (trie-delete lazy b))
      (is (not (trie-delete lazy b)))
      (is-equalp v (trie-get lazy a))
      (is (null (trie-get lazy b)))
      (is-equalp v (trie-get snapshot b))
      (trie-put lazy a (make-octets 0))
      (trie-put lazy c other)
      (let* ((short-root (trie-root lazy))
             (opened (make-trie :store store :root short-root)))
        (is-equalp other (trie-get opened c))
        (is-equalp (list other t)
                   (multiple-value-list (verify-proof short-root c (trie-proof opened c)))))
      (is (trie-delete lazy c))
      (is-equalp +empty-trie-root+ (trie-root lazy)))))

(deftest eth-getproof-mainnet ()
  (let* ((record (fixture "mainnet-pathusd-proof.json"))
         (root (hex->octets (clempo.json:jget record "stateRoot")))
         (proof (clempo.json:jget record "proof"))
         (address (hex->octets (clempo.json:jget proof "address"))))
    (multiple-value-bind (account valid)
        (verify-proof root address
                      (map 'list #'hex->octets (clempo.json:jget proof "accountProof")) :secure t)
      (is valid)
      (multiple-value-bind (nonce balance storage-root code-hash) (decode-account account)
        (is= (hex->integer (clempo.json:jget proof "nonce")) nonce)
        (is= (hex->integer (clempo.json:jget proof "balance")) balance)
        (is-equalp (hex->octets (clempo.json:jget proof "storageHash")) storage-root)
        (is-equalp (hex->octets (clempo.json:jget proof "codeHash")) code-hash)
        (is-equalp account (encode-account nonce balance storage-root code-hash))
        (loop for slot across (clempo.json:jget proof "storageProof")
              for key = (integer->octets (hex->integer (clempo.json:jget slot "key")) 32)
              for expected = (hex->integer (clempo.json:jget slot "value"))
              do (multiple-value-bind (value valid)
                     (verify-proof storage-root key
                                   (map 'vector #'hex->octets (clempo.json:jget slot "proof"))
                                   :secure t)
                   (is valid)
                   (is= expected (if value (clempo.rlp:rlp-decode-integer
                                           (clempo.rlp:rlp-decode value)) 0))))))))
