(defpackage #:clempo.cw-stream.tests
  (:use #:cl #:clempo.base #:clempo.cw-stream))
(in-package #:clempo.cw-stream.tests)

(defparameter *vectors-path*
  (asdf:system-relative-pathname "clempo-p2p" "../../tests/p2p/data/sake_cups_vectors.json"))
(defun vectors ()
  (with-open-file (in *vectors-path*)
    (let ((text (make-string (file-length in))))
      (read-sequence text in) (clempo.json:parse-json text))))
(defun field (vector name) (hex->octets (clempo.json:jget vector name)))
(defun entropy (start)
  (let ((out (make-octets 32)))
    (dotimes (i 32 out) (setf (aref out i) (mod (+ start i) 256)))))
(defun setup (vector version)
  (let ((namespace (field vector "namespace")) (now (clempo.json:jget vector "now_ms")))
    (multiple-value-bind (dial syn)
        (dial-start (field vector "dialer_seed") (field vector "listener_public") namespace
                    :version version :now-ms now :ephemeral-secret (entropy 10))
      (multiple-value-bind (listen synack)
          (listen-start (field vector "listener_seed") (field vector "dialer_public") namespace syn
                        :version version :now-ms now :ephemeral-secret (entropy 100))
        (multiple-value-bind (ack transcript) (dial-end dial synack)
          (values syn synack ack transcript (listen-end listen ack)))))))

;; Memory binary stream exercises the real framing and both blocking handshake
;; paths against recorded incoming frames, without sockets or scheduler races.
(defclass memory-wire (sb-gray:fundamental-binary-input-stream sb-gray:fundamental-binary-output-stream)
  ((input :initarg :input :initform (make-octets 0) :reader wire-input)
   (position :initform 0 :accessor wire-position)
   (output :initform (make-array 0 :element-type 'octet :adjustable t :fill-pointer 0) :reader %wire-output)))
(defun wire-output (stream) (coerce (%wire-output stream) '(simple-array (unsigned-byte 8) (*))))
(defmethod stream-element-type ((stream memory-wire)) '(unsigned-byte 8))
(defmethod sb-gray:stream-read-byte ((stream memory-wire))
  (if (= (wire-position stream) (length (wire-input stream))) :eof
      (prog1 (aref (wire-input stream) (wire-position stream)) (incf (wire-position stream)))))
(defmethod sb-gray:stream-write-byte ((stream memory-wire) byte)
  (vector-push-extend byte (%wire-output stream)) byte)
(defmethod sb-gray:stream-finish-output ((stream memory-wire)) nil)
(defun framed (&rest messages)
  (apply #'octets-concat
         (mapcar (lambda (message) (octets-concat (clempo.cw-stream::uint (length message)) message)) messages)))
(defun mutate (data &optional (index 0))
  (let ((copy (copy-seq data))) (setf (aref copy index) (logxor 1 (aref copy index))) copy))

(deftest sake-cups-fixed-vectors ()
  (loop for vector across (vectors) for version from 0 do
    (multiple-value-bind (syn synack ack dial listen) (setup vector version)
      (is-equalp (field vector "syn") syn)
      (is-equalp (field vector "synack") synack)
      (is-equalp (field vector "ack") ack)
      (is-equalp (field vector "summary") (transcript-summary dial))
      (is-equalp (transcript-summary dial) (transcript-summary listen))
      ;; Fixture seals are bare cipher operations, not whole CUPS records.
      (let* ((d (make-session nil nil dial t :cups-version version))
             (l (make-session nil nil listen nil :cups-version version))
             (ds (clempo.cw-stream::connection-sender d))
             (lr (clempo.cw-stream::connection-receiver l)))
        (let ((hello (seal ds (string->octets "hello"))))
          (is-equalp (field vector "d2l_seal_hello") hello)
          (is-equalp (string->octets "hello") (open-sealed lr hello)))
        (let ((empty (seal ds (make-octets 0))))
          (is-equalp (field vector "d2l_seal_empty") empty)
          (is-equalp (make-octets 0) (open-sealed lr empty)))
        (is-equalp (field vector "l2d_seal_back")
                   (seal (clempo.cw-stream::connection-sender l) (string->octets "back")))))))

(deftest sake-dial-and-accept-wire ()
  (loop for vector across (vectors) for version from 0 do
    (let* ((syn (field vector "syn")) (synack (field vector "synack")) (ack (field vector "ack"))
           (dw (make-instance 'memory-wire :input (framed synack)))
           (lw (make-instance 'memory-wire :input (framed (field vector "dialer_public") syn ack)))
           (d (dial dw (field vector "dialer_seed") (field vector "listener_public") (field vector "namespace")
                    :version version :cups-version version :now-ms (clempo.json:jget vector "now_ms")
                    :ephemeral-secret (entropy 10)))
           (l (accept lw (field vector "listener_seed") (field vector "namespace")
                      :version version :cups-version version :now-ms (clempo.json:jget vector "now_ms")
                      :ephemeral-secret (entropy 100))))
      (is-equalp (field vector "listener_public") (connection-peer d))
      (is-equalp (field vector "dialer_public") (connection-peer l))
      (is-equalp (framed (field vector "dialer_public") syn ack) (wire-output dw))
      (is-equalp (framed synack) (wire-output lw)))))

(deftest cups-record-framing-and-corruption ()
  (loop for vector across (vectors) for version from 0 do
    (multiple-value-bind (syn synack ack dt lt) (setup vector version)
      (declare (ignore syn synack ack))
      (let* ((wire (make-instance 'memory-wire))
             (d (make-session wire nil dt t :cups-version version :max-message-size 128)))
        (dolist (message (list (string->octets "hello") (make-octets 0) (make-octets 128)))
          (send-message d message))
        (let* ((input (make-instance 'memory-wire :input (wire-output wire)))
               (l (make-session input nil lt nil :cups-version version :max-message-size 128)))
          (is-equalp (string->octets "hello") (receive-message l))
          (is-equalp (make-octets 0) (receive-message l))
          (is-equalp (make-octets 128) (receive-message l)))
        (let* ((bad (mutate (wire-output wire) (1- (if (zerop version) 22 41))))
               (input (make-instance 'memory-wire :input bad))
               (l (make-session input nil lt nil :cups-version version)))
          (signals clempo.p2p-wire:p2p-error (receive-message l))
          (let ((position (wire-position input)))
            (signals clempo.p2p-wire:p2p-error (receive-message l))
            (is= position (wire-position input))))))))

(deftest sake-rejects-corruption-namespace-and-time ()
  (loop for vector across (vectors) for version from 0 do
    (let ((seed (field vector "listener_seed")) (peer (field vector "dialer_public"))
          (namespace (field vector "namespace")) (syn (field vector "syn"))
          (now (clempo.json:jget vector "now_ms")))
      (dolist (bad (list (mutate syn 8) (mutate syn 40)))
        (signals clempo.p2p-wire:p2p-error
          (listen-start seed peer namespace bad :version version :now-ms now)))
      (signals clempo.p2p-wire:p2p-error
        (listen-start seed peer (mutate namespace) syn :version version :now-ms now))
      ;; Lower bound inclusive, upper bound exclusive.
      (listen-start seed peer namespace syn :version version :now-ms (+ now 10000) :ephemeral-secret (entropy 100))
      (signals clempo.p2p-wire:p2p-error
        (listen-start seed peer namespace syn :version version :now-ms (+ now 10001)))
      (signals clempo.p2p-wire:p2p-error
        (listen-start seed peer namespace syn :version version :now-ms (- now 5000)))
      (multiple-value-bind (ds ignored)
          (dial-start (field vector "dialer_seed") (field vector "listener_public") namespace
                      :version version :now-ms now :ephemeral-secret (entropy 10))
        (declare (ignore ignored))
        (signals clempo.p2p-wire:p2p-error (dial-end ds (mutate (field vector "synack") 104))))
      (multiple-value-bind (ls ignored)
          (listen-start seed peer namespace syn :version version :now-ms now :ephemeral-secret (entropy 100))
        (declare (ignore ignored))
        (signals clempo.p2p-wire:p2p-error (listen-end ls (mutate (field vector "ack"))))))))

(deftest cups-direction-limits-and-exhaustion ()
  (loop for vector across (vectors) for version from 0 do
    (multiple-value-bind (syn synack ack dt lt) (setup vector version)
      (declare (ignore syn synack ack))
      (let* ((wire (make-instance 'memory-wire))
             (listener (make-session wire nil lt nil :cups-version version :max-message-size 4)))
        ;; Oversize sends must not consume a nonce.
        (signals clempo.p2p-wire:p2p-error (send-message listener (make-octets 5)))
        (send-message listener (string->octets "back"))
        (let ((dialer (make-session (make-instance 'memory-wire :input (wire-output wire))
                                    nil dt t :cups-version version :max-message-size 4)))
          (is-equalp (string->octets "back") (receive-message dialer)))
        (let ((small (make-session (make-instance 'memory-wire :input (wire-output wire))
                                   nil dt t :cups-version version :max-message-size 3)))
          (signals clempo.p2p-wire:p2p-error (receive-message small)))
        (let ((cipher (clempo.cw-stream::connection-sender listener)))
          (setf (clempo.cw-stream::cipher-counter cipher) (1- (ash 1 96)))
          (seal cipher (make-octets 0))
          (signals clempo.p2p-wire:p2p-error (seal cipher (make-octets 0))))))))
