(defpackage #:clempo.devp2p.tests
  (:use #:cl #:clempo.base)
  (:local-nicknames (#:eth #:clempo.eth) (#:sn #:clempo.snappy) (#:rlpx #:clempo.rlpx))
  (:import-from #:clempo.p2p-wire #:p2p-error))
(in-package #:clempo.devp2p.tests)

(defun fixture-rows (file)
  (with-open-file (in (asdf:system-relative-pathname "clempo-p2p" (concatenate 'string "../../tests/p2p/data/" file)))
    (loop for line = (read-line in nil) while line
          collect (uiop:split-string line :separator '(#\Space)))))

(defun fixture-bytes (hex) (if (string= hex "-") (make-octets 0) (hex->octets hex)))

(defun fixtures (name)
  (let ((table (make-hash-table :test 'equal)))
    (dolist (row (fixture-rows name) table)
      (setf (gethash (first row) table) (fixture-bytes (second row))))))

(deftest snappy-reference-blocks ()
  (dolist (row (fixture-rows "vectors.txt"))
    (destructuring-bind (name plain compressed) row
      (let ((plain (fixture-bytes plain)))
        (is (octets= plain (sn:decompress (fixture-bytes compressed))) "~A" name)
        (is (octets= plain (sn:decompress (sn:compress plain))) "~A" name))))
  (is (< (length (sn:compress (make-octets 65536))) 4096))
  ;; The compressor need not choose this four-byte-offset form, but peers may.
  (is-equalp (string->octets "abcdabcd") (sn:decompress (octets-of 8 12 97 98 99 100 15 4 0 0 0))))

(deftest snappy-malformed-blocks ()
  (dolist (hex '("" "ffffffff1f" "020061" "020861" "01046162" "01020000" "0000" "017c"))
    (signals p2p-error (sn:decompress (hex->octets hex))))
  (signals p2p-error (sn:decompress (octets-of 128 1) :max-size 100)))

(deftest rlpx-reference-frames ()
  (let* ((vectors (fixtures "frames.txt"))
         (aes (gethash "aes_secret" vectors)) (mac (gethash "mac_secret" vectors))
         (seed (gethash "egress_seed" vectors))
         (tx (rlpx::make-frame-state aes mac seed)) (rx (rlpx::make-frame-state aes mac seed)))
    (dotimes (i 4)
      (let* ((plain (gethash (format nil "payload_~D" i) vectors))
             (wire (gethash (format nil "frame_~D" i) vectors)))
        (is (octets= wire (rlpx::encode-frame tx plain)) "frame ~D" i)
        (let ((n (rlpx::decode-header rx (subseq wire 0 32))))
          (is= (length plain) n)
          (is (octets= plain (rlpx::decode-body rx n (subseq wire 32)))))))
    (let* ((wire (copy-seq (gethash "frame_0" vectors)))
           (rx (rlpx::make-frame-state aes mac seed)))
      (setf (aref wire 16) (logxor (aref wire 16) 1))
      (signals p2p-error (rlpx::decode-header rx (subseq wire 0 32))))
    (let* ((wire (copy-seq (gethash "frame_0" vectors)))
           (rx (rlpx::make-frame-state aes mac seed))
           (n (rlpx::decode-header rx (subseq wire 0 32))))
      (setf (aref wire 32) (logxor (aref wire 32) 1))
      (signals p2p-error (rlpx::decode-body rx n (subseq wire 32))))))

(deftest rlpx-eip8-vectors ()
  (let ((vectors (fixtures "handshake.txt")))
    (flet ((v (name) (gethash name vectors)))
      (let ((key-a (octets->integer (v "key_a"))) (key-b (octets->integer (v "key_b"))))
        (dolist (name '("auth_eip8_v4" "auth_eip8_v56" "ack_eip8_v4" "ack_eip8_v57"))
          (let* ((auth-p (equal "auth" (subseq name 0 4)))
                 (packet (v (concatenate 'string name "_message")))
                 (clear (rlpx::ecies-decrypt (if auth-p key-b key-a) packet)))
            (is (octets= (v (concatenate 'string name "_plaintext")) clear) "~A" name)
            (if auth-p
                (multiple-value-bind (public ephemeral nonce) (rlpx::parse-auth key-b clear)
                  (is (octets= (v "key_a_public") public))
                  (is (octets= (v "eph_a_public") ephemeral))
                  (is (octets= (v "nonce_a") nonce)))
                (multiple-value-bind (ephemeral nonce) (rlpx::parse-ack clear)
                  (is (octets= (v "eph_b_public") ephemeral))
                  (is (octets= (v "nonce_b") nonce))))))
        (multiple-value-bind (aes mac)
            (rlpx::derive-secrets (octets->integer (v "eph_a")) (v "eph_b_public") (v "nonce_a") (v "nonce_b"))
          (is (octets= (v "want_aes") aes))
          (is (octets= (v "want_mac") mac))
          (let ((state (rlpx::make-frame-state aes mac (clempo.p2p-wire:xor-octets mac (v "nonce_b"))
                                              (v "auth_eip8_v4_message"))))
            (clempo.keccak:keccak-update (rlpx::frame-state-digest state) (string->octets "foo"))
            (is (octets= (v "want_ingress_foo") (rlpx::frame-digest state)))))
        (let* ((clear (octets-of 1 2 3))
               (wire (rlpx::ecies-encrypt (v "key_b_public") clear :key key-a :iv (make-octets 16))))
          (is (octets= clear (rlpx::ecies-decrypt key-b wire)))
          (setf (aref wire (1- (length wire))) (logxor 1 (aref wire (1- (length wire)))))
          (signals p2p-error (rlpx::ecies-decrypt key-b wire)))))))

(deftest eth-codecs ()
  (let* ((hash (make-octets 32)) (fork (list (octets-of 1 2 3 4) 1770908400))
         (status68 (list 68 4217 0 hash hash fork)) (status69 (list 69 4217 hash fork 0 1024 hash)))
    (is-equalp status68 (eth:decode-message :status68 (apply #'eth:encode-message :status68 status68)))
    (is-equalp status69 (eth:decode-message :status69 (apply #'eth:encode-message :status69 status69)))
    (is-equalp '(100 (545 256 3 t))
               (eth:decode-message :get-block-headers
                                   (eth:encode-message :get-block-headers 100 '(545 256 3 t))))
    (is-equalp (list 1111 (list hash))
               (eth:decode-message :get-receipts (eth:encode-message :get-receipts 1111 (list hash))))
    (let* ((receipt (hex->octets "c38080c0"))
           (decoded (eth:decode-message :receipts (eth:encode-message :receipts 7 (list (list receipt))))))
      (is= 7 (first decoded))
      (is (octets= receipt (eth:rlp-view-octets (caaadr decoded)))))
    (signals p2p-error (eth:decode-message :ping (octets-of #xc1 #x80)))
    (signals p2p-error (eth:decode-message :status69 (apply #'eth:encode-message :status68 status68))))
  (is-equalp (list (hex->octets "fde57c3e") 1770908400) (eth:fork-id (eth:tempo-eth-chain) 0))
  (is-equalp (list (hex->octets "9e6fe384") 1771858800) (eth:fork-id (eth:tempo-eth-chain) 1770908400)))

(deftest eth-block-byte-comparison ()
  (let* ((inner (append (make-list 8 :initial-element 0) '(5 300 250 512)))
         (header (list 10 20 30 inner))
         (body (list (list (octets-of 118 5)) nil nil))
         (block (clempo.rlp:rlp-encode (cons header body)))
         (header-view (eth:block-header-view block))
         (body-view (car (second (eth:decode-message :block-bodies
                                                   (eth:encode-message :block-bodies 9 (list (clempo.rlp:rlp-encode body))))))))
    (is= 5 (eth:tempo-header-number header-view))
    (is= 512 (eth:tempo-header-timestamp header-view))
    (is (eth:block-matches-p block header-view body-view))
    (let ((bad (copy-seq block)))
      (setf (aref bad (1- (length bad))) 0)
      (is (not (eth:block-matches-p bad header-view body-view))))))
