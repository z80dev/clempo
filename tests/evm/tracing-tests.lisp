(defpackage #:clempo.tracing.tests
  (:use #:cl #:clempo.base #:clempo.state #:clempo.evm #:clempo.tracing)
  (:import-from #:clempo.json #:parse-json #:to-json-string))

(in-package #:clempo.tracing.tests)

;;; Scenarios run through APPLY-TRANSACTION on a memory backend under Prague. The
;;; expected JSON was checked field by field against the reference node's answers for the
;;; same code (debug_traceCall / trace_call with state overrides on a Tempo mainnet node),
;;; gas figures recomputed for Ethereum's schedule where Tempo's differs.

(defconstant +sender+ #x1000000000000000000000000000000000000001)
(defconstant +a+ #x2000000000000000000000000000000000000002)
(defconstant +b+ #x3000000000000000000000000000000000000003)
(defconstant +coinbase+ #xc0ffee)

(defun run-traced (tracer accounts &key (to +a+) (data "") (value 0) (gas 200000) (fork :prague)
                                        (log-index 0))
  "Run a transaction from +SENDER+ to TO under TRACER. ACCOUNTS: (address :code hex
:balance n :nonce n :storage ((slot . value) ...)). Returns the TX-RESULT."
  (declare (ignore log-index))
  (let ((b (make-memory-backend)))
    (memory-backend-put-account b +sender+ :balance (expt 10 18))
    (loop for (address . plist) in accounts
          do (memory-backend-put-account b address
                                         :code (hex->octets (getf plist :code ""))
                                         :balance (getf plist :balance 0)
                                         :nonce (getf plist :nonce 0))
             (loop for (slot . v) in (getf plist :storage)
                   do (memory-backend-put-storage b address slot v)))
    (let* ((world (make-world b))
           (*spec* (make-spec fork))
           (*block* (make-block-env :number 1 :gas-limit 30000000 :coinbase +coinbase+
                                    :base-fee 7 :chain-id 1 :timestamp 1000)))
      (with-tracer (tracer world)
        (apply-transaction (make-instance 'ethereum-handler) world
                           (make-evm-tx :type 2 :nonce 0 :gas-limit gas :max-fee 10
                                        :max-priority-fee 1 :to to :value value
                                        :data (hex->octets data) :sender +sender+))))))

(defun geth-json (options accounts &rest keys)
  (let ((tracer (make-geth-tracer (parse-json options))))
    (apply #'run-traced tracer accounts keys)
    (to-json-string (geth-result tracer))))

(defun parity-json (types accounts &rest keys)
  (let ((tracer (make-parity-tracer types)))
    (apply #'run-traced tracer accounts keys)
    (to-json-string (parity-result tracer))))

;;; Code

(defun code (&rest parts)
  "Concatenate hex PARTS (strings) and integers (pushed with the shortest PUSH)."
  (apply #'concatenate 'string
         (mapcar (lambda (p)
                   (if (stringp p)
                       p
                       (let ((n (max 1 (ceiling (integer-length p) 8))))
                         (format nil "~(~2,'0x~v,'0x~)" (+ #x5f n) (* 2 n) p))))
                 parts)))

;; B: SLOAD 0, MSTORE(0, 0x2a), LOG0(0, 32), RETURN(0, 32)
(defparameter *b-code* (code 0 "5450" #x2a 0 "52" 32 0 "a0" 32 0 "f3"))

;; A: SSTORE(0,1); LOG1(0,0,0xaa); CALL(0xffff, B, 0, 0,0, 0,32); POP;
;;    STATICCALL(500, 0x04, 0,0,0,0); POP; DELEGATECALL(0xffff, B, 0,0,0,0); POP; RETURN(0,32)
(defparameter *a-code*
  (code 1 0 "55" #xaa 0 0 "a1"
        32 0 0 0 0 +b+ #xffff "f1" "50"
        0 0 0 0 4 500 "fa" "50"
        0 0 0 0 +b+ #xffff "f4" "50"
        32 0 "f3"))

(defun nested-accounts ()
  (list (list +a+ :code *a-code*) (list +b+ :code *b-code*)))

(defun error-string-revert (string &optional (op "fd"))
  "Code that ends with OP (REVERT) over Error(STRING) (at most 32 bytes)."
  (let ((bytes (string->octets string)))
    (code #x08c379a0 224 "1b" 0 "52" #x20 4 "52" (length bytes) 36 "52"
          (octets->integer (let ((w (make-octets 32))) (replace w bytes) w)) 68 "52"
          100 0 op)))

(defun call-code (target &key (gas #xffff) (value 0) (op "f1") (out-size 0))
  "Code that calls TARGET with no input and pops the result."
  (if (member op '("f1" "f2") :test #'string=)
      (code out-size 0 0 0 value target gas op "50")
      (code out-size 0 0 0 target gas op "50")))

(defparameter *c-revert* #x4000000000000000000000000000000000000004)
(defparameter *c-loop* #x4000000000000000000000000000000000000005)
(defparameter *c-errors*
  '((#x5000000000000000000000000000000000000001 "600356")      ; invalid jump
    (#x5000000000000000000000000000000000000002 "01")          ; stack underflow
    (#x5000000000000000000000000000000000000003 "fe")          ; INVALID
    (#x5000000000000000000000000000000000000004 "0c")          ; undefined
    (#x5000000000000000000000000000000000000005 "6001600055")  ; SSTORE (static)
    (#x5000000000000000000000000000000000000006 "6001600060003e"))) ; RETURNDATACOPY

(defun scenario (name)
  "(values accounts value) of scenario NAME."
  (ecase name
    (:nested (nested-accounts))
    (:revert
     (list (list +a+ :code (code (call-code *c-revert* :out-size 32) (error-string-revert "outer")))
           (list *c-revert* :code (error-string-revert "boom"))))
    (:panic
     (list (list +a+ :code (code #x4e487b71 224 "1b" 0 "52" #x11 4 "52" 36 0 "fd"))))
    (:oog
     (list (list +a+ :code (code (call-code *c-loop* :gas #x1000) 0 0 "f3"))
           (list *c-loop* :code "5b600056")))
    (:errors
     (list* (list +a+ :code (apply #'code
                                   (append (loop for (address) in *c-errors*
                                                 collect (call-code address :gas #x2000))
                                           (list (call-code (first (nth 4 *c-errors*))
                                                            :gas #x2000 :op "fa")
                                                 0 0 "f3"))))
            (loop for (address hex) in *c-errors* collect (list address :code hex))))
    (:create
     ;; runtime: SELFDESTRUCT(caller); initcode returns it; A does CREATE2 then calls the
     ;; new contract, then a CREATE whose initcode reverts.
     (let* ((init (code #x33ff 0 "52" 2 30 "f3"))
            (bad-init (code 0 0 "fd"))
            (init-word (octets->integer (let ((w (make-octets 32))) (replace w (hex->octets init)) w)))
            (bad-word (octets->integer (let ((w (make-octets 32))) (replace w (hex->octets bad-init)) w))))
       (list (list +a+ :balance 5
                       :code (code init-word 0 "52"
                                   #x5a (/ (length init) 2) 0 1 "f5"    ; CREATE2 salt 0x5a value 1
                                   ;; call the created address (on the stack) with no input
                                   0 0 0 0 0 "85" #xffff "f1" "50" "50"
                                   bad-word 0 "52" (/ (length bad-init) 2) 0 0 "f0" "50"
                                   0 0 "f3")))))
    (:refund
     ;; clearing a slot in A and in B: the refund counter is the frame's own
     (list (list +a+ :code (code 0 0 "55" (call-code +b+) 0 0 0 "55" 0 0 "f3") :storage '((0 . 1)))
           (list +b+ :code (code 0 0 "55" 1 "50" 0 0 "f3") :storage '((0 . 1)))))
    (:value
     ;; CALL with value to a fresh account, to SHA-256 with value, a CALL with more value
     ;; than A holds, then a CALL with a too-deep-free but underfunded CALLCODE.
     (list (list +a+ :balance 10
                     :code (code (call-code #x6000000000000000000000000000000000000006 :value 3)
                                 (call-code 2 :value 1 :gas 1000)
                                 (call-code +b+ :value 100)
                                 0 0 "f3"))
           (list +b+ :code *b-code*)))))

;;; Golden cases: (name thunk), each thunk returning the result's JSON text.

(defparameter *call-log* "{\"tracer\":\"callTracer\",\"tracerConfig\":{\"withLog\":true}}")

(defparameter *cases*
  (list
   (list "callTracer nested" (lambda () (geth-json *call-log* (scenario :nested))))
   (list "callTracer onlyTopCall"
         (lambda () (geth-json "{\"tracer\":\"callTracer\",\"tracerConfig\":{\"onlyTopCall\":true,\"withLog\":true}}"
                               (scenario :nested))))
   (list "callTracer revert" (lambda () (geth-json *call-log* (scenario :revert))))
   (list "callTracer panic" (lambda () (geth-json "{\"tracer\":\"callTracer\"}" (scenario :panic))))
   (list "callTracer oog" (lambda () (geth-json "{\"tracer\":\"callTracer\"}" (scenario :oog))))
   (list "callTracer errors" (lambda () (geth-json "{\"tracer\":\"callTracer\"}" (scenario :errors))))
   (list "callTracer create" (lambda () (geth-json *call-log* (scenario :create))))
   (list "callTracer value" (lambda () (geth-json *call-log* (scenario :value))))
   (list "structLogger nested" (lambda () (geth-json "{}" (scenario :nested))))
   (list "structLogger panic memory returnData"
         (lambda () (geth-json "{\"enableMemory\":true,\"enableReturnData\":true}" (scenario :revert))))
   (list "structLogger refund" (lambda () (geth-json "{\"disableStack\":true}" (scenario :refund))))
   (list "structLogger limit"
         (lambda () (geth-json "{\"disableStack\":true,\"disableStorage\":true,\"limit\":700}" (scenario :create))))
   (list "prestateTracer nested" (lambda () (geth-json "{\"tracer\":\"prestateTracer\"}" (scenario :nested))))
   (list "prestateTracer disableCode disableStorage"
         (lambda () (geth-json "{\"tracer\":\"prestateTracer\",\"tracerConfig\":{\"disableCode\":true,\"disableStorage\":true}}"
                               (scenario :value))))
   (list "prestateTracer diff nested"
         (lambda () (geth-json "{\"tracer\":\"prestateTracer\",\"tracerConfig\":{\"diffMode\":true}}" (scenario :nested))))
   (list "prestateTracer diff create"
         (lambda () (geth-json "{\"tracer\":\"prestateTracer\",\"tracerConfig\":{\"diffMode\":true}}" (scenario :create))))
   (list "prestateTracer diff value"
         (lambda () (geth-json "{\"tracer\":\"prestateTracer\",\"tracerConfig\":{\"diffMode\":true}}" (scenario :value))))
   (list "flatCallTracer create"
         (lambda ()
           (let ((tracer (make-geth-tracer (parse-json "{\"tracer\":\"flatCallTracer\"}"))))
             (run-traced tracer (scenario :create))
             (to-json-string (geth-result tracer :block-number 7 :block-hash #xbb :tx-hash #xcc :tx-index 2)))))
   (list "flatCallTracer includePrecompiles"
         (lambda () (geth-json "{\"tracer\":\"flatCallTracer\",\"tracerConfig\":{\"includePrecompiles\":true}}"
                               (scenario :value))))
   (list "4byteTracer" (lambda () (geth-json "{\"tracer\":\"4byteTracer\"}" (scenario :nested)
                                             :data "12345678aabb")))
   (list "noopTracer" (lambda () (geth-json "{\"tracer\":\"noopTracer\"}" (scenario :nested))))
   (list "muxTracer"
         (lambda () (geth-json "{\"tracer\":\"muxTracer\",\"tracerConfig\":{\"callTracer\":{\"onlyTopCall\":true},\"4byteTracer\":null,\"prestateTracer\":{\"diffMode\":true,\"disableCode\":true}}}"
                               (scenario :nested) :data "abcdef0102")))
   (list "parity trace stateDiff create" (lambda () (parity-json '(:trace :state-diff) (scenario :create))))
   (list "parity trace errors" (lambda () (parity-json '(:trace) (scenario :errors))))
   (list "parity stateDiff value" (lambda () (parity-json '(:state-diff) (scenario :value))))
   (list "parity vmTrace nested" (lambda () (parity-json '(:vm-trace) (scenario :nested))))
   (list "parity vmTrace create" (lambda () (parity-json '(:vm-trace) (scenario :create))))
   (list "parity transaction traces create"
         (lambda ()
           (let ((tracer (make-parity-tracer '(:trace))))
             (run-traced tracer (scenario :create))
             (to-json-string (parity-transaction-traces tracer :block-number 7 :block-hash #xbb
                                                               :tx-hash #xcc :tx-index 2)))))
   (list "opcode gas nested"
         (lambda ()
           (let ((tracer (make-opcode-gas-tracer)))
             (run-traced tracer (scenario :nested))
             (to-json-string (opcode-gas-result tracer)))))))

