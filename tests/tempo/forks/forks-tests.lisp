(defpackage #:clempo.forks.tests
  (:use #:cl #:clempo.base #:clempo.forks))

(in-package #:clempo.forks.tests)

(deftest fork-order ()
  (is (fork< :genesis :t0))
  (is (fork< :t1 :t1a))
  (is (fork< :t1c :t2))
  (is (fork>= :t13 :t8))
  (is (not (fork>= :t7 :t8)))
  (is= 0 (fork-index :genesis))
  (is= :t1a (parse-fork "T1A"))
  (is= "Genesis" (fork-name :genesis))
  (is= "T1C" (fork-name :t1c))
  (is= :t15 (latest-fork)))

(deftest fork-if-branches-and-records ()
  (is= :new (with-spec (:t8) (fork-if (:since :t8) :new :old)))
  (is= :old (with-spec (:t7) (fork-if (:since :t8) :new :old)))
  (is= :new (with-spec (:t8) (fork-if (:before :t8) :old :new)))
  (is (some (lambda (s) (eq (fork-site-kind s) :branch)) (fork-sites :t8))))

(deftest gas-schedule-per-fork ()
  ;; Osaka defaults before T1, TIP-1000 at T1, TIP-1060 at T7 (gas_params.rs).
  (is= 19900 (gas :sstore-set-without-load-cost :t0))
  (is= 250000 (gas :sstore-set-without-load-cost :t1))
  (is= 5000 (gas :sstore-set-without-load-cost :t7))
  (is= 4800 (gas :sstore-clearing-slot-refund :t6))
  (is= 0 (gas :sstore-clearing-slot-refund :t7))
  (is= 1 (gas :max-refund-quotient :t7))
  (is= 2500 (gas :cold-account-additional-cost :t13))
  (is= 1000 (gas :code-deposit-cost :t1))
  (with-spec (:t11) (is= 100 (gas :warm-storage-read-cost))))

(deftest input-and-dedup-cost ()
  ;; crates/precompiles/src/lib.rs test_input_cost_schedule / test_dedup_cost_schedule
  (is= 0 (input-cost :t10 0))
  (is= 6 (input-cost :t10 1))
  (is= 6 (input-cost :t10 32))
  (is= 12 (input-cost :t10 33))
  (is= 30 (input-cost :t11 1))
  (is= 60 (input-cost :t11 33))
  (is= 0 (dedup-cost :t10 65536))
  (is= 1310720 (dedup-cost :t11 65536))
  (is= 36 (keccak-gas 1))
  (is= 30 (keccak-gas 0)))

(deftest tip1067-base-fee ()
  (is= (floor +t7-base-fee-cap+ 2)
       (t7-next-block-base-fee (floor +t7-base-fee-cap+ 2) +t7-base-fee-gas-target+))
  (is= (+ +t7-base-fee-floor+ 7)
       (t7-next-block-base-fee +t7-base-fee-floor+ (1+ +t7-base-fee-gas-target+)))
  (let ((fee +t7-base-fee-cap+))
    (dotimes (i 64) (setf fee (t7-next-block-base-fee fee 0)))
    (is= +t7-base-fee-floor+ fee)))

(deftest selectively-metered-gas-parameters ()
  (with-gas-parameters-only (:sstore-set-without-load-cost :warm-storage-read-cost)
    (is= 0 (gas :sstore-static :t1))
    (is= 100 (gas :warm-storage-read-cost :t1))
    (is= 250000 (gas :sstore-set-without-load-cost :t1))
    (is= 5000 (gas :sstore-set-without-load-cost :t7))
    (with-gas-parameters-only (:warm-storage-read-cost)
      (is= 0 (gas :sstore-set-without-load-cost :t1))
      (is= 100 (gas :warm-storage-read-cost :t1)))
    (is= 250000 (gas :sstore-set-without-load-cost :t1)))
  (is= 100 (gas :sstore-static :t1))
  (signals error
    (macroexpand-1 '(with-gas-parameters-only (:unknown-gas-parameter) nil))))

(defun two-t8-branches ()
  (list (fork-if (:since :t8) :first-new :first-old)
        (fork-if (:since :t8) :second-new :second-old)))

(defgeneric t8-method (value))
(defmethod t8-method ((value integer))
  (fork-if (:before :t8) value (1+ value)))

(deftest fork-sites-preserve-source-identities ()
  (let ((sites (remove-if-not (lambda (site)
                                (eq (fork-site-definition site) 'two-t8-branches))
                              (fork-sites :t8))))
    (is= 2 (length sites))
    (when (= (length sites) 2)
      (is= "tests/tempo/forks/forks-tests.lisp" (fork-site-file (first sites)))
      (is (plusp (fork-site-form-number (first sites))))
      (is= (fork-site-form-number (first sites)) (fork-site-form-number (second sites)))
      (is (not (equal (fork-site-form-path (first sites)) (fork-site-form-path (second sites)))))
      (is (every (lambda (site) (eq (fork-site-relation site) :since)) sites))))
  (let ((site (find 't8-method (fork-sites :t8) :key #'fork-site-definition)))
    (is site)
    (when site
      (is= :before (fork-site-relation site))
      (is= "tests/tempo/forks/forks-tests.lisp" (fork-site-file site)))))

(deftest source-registration-is-idempotent ()
  (let ((clempo.forks::*fork-sites* (make-hash-table :test 'equal))
        (source '(:file "src/fixture.lisp" :form-number 2 :form-path (3)
                  :definition fixture-function :relation :since)))
    (record-fork-site :t8 :branch 'fixture-function "old documentation" source)
    (record-fork-site :t8 :branch 'fixture-function "new documentation" source)
    (is= 1 (length (fork-sites :t8)))
    (is= "new documentation" (fork-site-doc (first (fork-sites :t8))))))

;;; Raw comparisons against a literal fork register their sites like FORK-IF.
(defun raw-gates (fork)
  (list (spec>= :t9) (spec< :t9) (since :t9) (until :t9)
        (fork>= fork :t9) (fork< fork :t9) (fork> fork :t8) (fork<= fork :t8)))

(deftest raw-comparisons-record-their-sites ()
  (with-spec (:t9) (is (equal '(t nil t nil t nil t nil) (raw-gates :t9))))
  (with-spec (:t8) (is (equal '(nil t nil t nil t nil t) (raw-gates :t8))))
  (let ((sites (remove 'raw-gates (fork-sites :t9) :key #'fork-site-definition :test-not #'eq)))
    ;; FORK> :t8 gates on T9 :since, FORK<= :t8 on T9 :before.
    (is= 8 (length sites))
    (is= 4 (count :since sites :key #'fork-site-relation))
    (is= 4 (count :before sites :key #'fork-site-relation))
    (is (every (lambda (s) (equal "tests/tempo/forks/forks-tests.lisp" (fork-site-file s))) sites))
    (is= 8 (length (remove-duplicates (mapcar #'fork-site-form-path sites) :test #'equal))))
  ;; A comparison after the last fork gates nothing and records nothing.
  (is (not (fork> :t15 :t15))))
