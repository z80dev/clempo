(defpackage #:clempo.forks.tests
  (:use #:cl #:clempo.base #:clempo.forks))

(in-package #:clempo.forks.tests)

(deftest fork-order ()
  (is (fork< :genesis :t0))
  (is (fork< :t1 :t1a))
  (is (fork< :t1c :t2))
  (is (fork>= :t13 :t8))
  (is (not (fork>= :t7 :t8)))
  (is= 0 (fork-index :genesis))
  (is= :t1a (parse-fork "T1A"))
  (is= "Genesis" (fork-name :genesis))
  (is= "T1C" (fork-name :t1c))
  (is= :t15 (latest-fork)))

(deftest fork-if-branches-and-records ()
  (is= :new (with-spec (:t8) (fork-if (:since :t8) :new :old)))
  (is= :old (with-spec (:t7) (fork-if (:since :t8) :new :old)))
  (is= :new (with-spec (:t8) (fork-if (:before :t8) :old :new)))
  (is (some (lambda (s) (eq (fork-site-kind s) :branch)) (fork-sites :t8))))

(deftest gas-schedule-per-fork ()
  ;; Osaka defaults before T1, TIP-1000 at T1, TIP-1060 at T7 (gas_params.rs).
  (is= 19900 (gas :sstore-set-without-load-cost :t0))
  (is= 250000 (gas :sstore-set-without-load-cost :t1))
  (is= 5000 (gas :sstore-set-without-load-cost :t7))
  (is= 4800 (gas :sstore-clearing-slot-refund :t6))
  (is= 0 (gas :sstore-clearing-slot-refund :t7))
  (is= 1 (gas :max-refund-quotient :t7))
  (is= 2500 (gas :cold-account-additional-cost :t13))
  (is= 1000 (gas :code-deposit-cost :t1))
  (with-spec (:t11) (is= 100 (gas :warm-storage-read-cost))))

(deftest input-and-dedup-cost ()
  ;; crates/precompiles/src/lib.rs test_input_cost_schedule / test_dedup_cost_schedule
  (is= 0 (input-cost :t10 0))
  (is= 6 (input-cost :t10 1))
  (is= 6 (input-cost :t10 32))
  (is= 12 (input-cost :t10 33))
  (is= 30 (input-cost :t11 1))
  (is= 60 (input-cost :t11 33))
  (is= 0 (dedup-cost :t10 65536))
  (is= 1310720 (dedup-cost :t11 65536))
  (is= 36 (keccak-gas 1))
  (is= 30 (keccak-gas 0)))

(deftest tip1067-base-fee ()
  (is= (floor +t7-base-fee-cap+ 2)
       (t7-next-block-base-fee (floor +t7-base-fee-cap+ 2) +t7-base-fee-gas-target+))
  (is= (+ +t7-base-fee-floor+ 7)
       (t7-next-block-base-fee +t7-base-fee-floor+ (1+ +t7-base-fee-gas-target+)))
  (let ((fee +t7-base-fee-cap+))
    (dotimes (i 64) (setf fee (t7-next-block-base-fee fee 0)))
    (is= +t7-base-fee-floor+ fee)))

(deftest selectively-metered-gas-parameters ()
  (with-gas-parameters-only (:sstore-set-without-load-cost :warm-storage-read-cost)
    (is= 0 (gas :sstore-static :t1))
    (is= 100 (gas :warm-storage-read-cost :t1))
    (is= 250000 (gas :sstore-set-without-load-cost :t1))
    (is= 5000 (gas :sstore-set-without-load-cost :t7))
    (with-gas-parameters-only (:warm-storage-read-cost)
      (is= 0 (gas :sstore-set-without-load-cost :t1))
      (is= 100 (gas :warm-storage-read-cost :t1)))
    (is= 250000 (gas :sstore-set-without-load-cost :t1)))
  (is= 100 (gas :sstore-static :t1))
  (signals error
    (macroexpand-1 '(with-gas-parameters-only (:unknown-gas-parameter) nil))))
