(defpackage #:clempo.zone.tests
  (:use #:cl #:clempo.base #:clempo.forks #:clempo.contract #:clempo.precompiles)
  (:shadowing-import-from #:clempo.contract #:read #:write #:delete))
(in-package #:clempo.zone.tests)

;;; Layout and runtime assertions originate from Rust zone_factory/{mod,portal}.rs.
(deftest zone-factory-layout ()
  (let ((next (layout-field 'clempo.zone-factory:zone-factory 'next-zone-id))
        (owner (layout-field 'clempo.zone-factory:zone-factory 'owner))
        (zones (layout-field 'clempo.zone-factory:zone-factory 'zones)))
    (is= 0 (field-slot next)) (is= 0 (field-offset next))
    (is= 0 (field-slot owner)) (is= 4 (field-offset owner))
    (is= 1 (field-slot zones)))
  (loop for (name slot offset) in
        '((admin 0 0) (rpc-url 12 0) (zone-id 15 0) (messenger 15 4)
          (verifier 16 0) (initialized 16 20) (sequencer-threshold 16 29)
          (sequencers 18 0) (role 20 0) (leader 23 0) (leader-epoch 23 20)
          (token-enablement-hash 26 0) (token-enablement-cursor-initialized 28 8))
        for field = (layout-field 'clempo.zone-factory:zone-portal name)
        do (is= slot (field-slot field)) (is= offset (field-offset field))))

(deftest zone-factory-ownership-and-range ()
  (with-spec (:t10)
    (with-storage ((make-hashmap-storage))
      (write (clempo.zone-factory::factory-owner +zone-factory-address+) 42)
      (write (clempo.zone-factory::factory-next-zone-id +zone-factory-address+) 3)
      (is= 42 (clempo.zone-factory:owner))
      (is (clempo.zone-factory:is-zone-portal (clempo.zone-factory:portal-address 2)))
      (is (not (clempo.zone-factory:is-zone-portal (clempo.zone-factory:portal-address 3))))
      (is (not (clempo.zone-factory:is-zone-portal 2)))
      (is (handler-case (progn (clempo.zone-factory:transfer-ownership 41 99) nil)
            (precompile-revert (e) (eq (precompile-revert-name e) 'clempo.zone-factory::not-owner))))
      (clempo.zone-factory:transfer-ownership 42 99)
      (is= 99 (clempo.zone-factory:owner))
      (is= 3 (clempo.zone-factory:next-zone-id)))))

(deftest zone-portal-initialization ()
  (dolist (spec '(:t10 :t13))
    (with-spec (spec)
      (with-storage ((make-hashmap-storage :block (make-block-info :number 123)))
        (let ((portal (clempo.zone-factory:portal-address 7)))
          (clempo.zone-factory::initialize-portal portal 7 +path-usd-address+ t nil
                                                 '(14) '(15) 11 '(12 13) 2 "https://zone" 88)
          (is (equalp (account-info-code (account portal)) clempo.zone-factory:+portal-runtime+))
          (is= 45 (length clempo.zone-factory:+portal-runtime+))
          (is= 11 (read (clempo.zone-factory::portal-admin portal)))
          (is= 12 (read (clempo.zone-factory::portal-leader portal)))
          (is= 1 (read (clempo.zone-factory::portal-leader-epoch portal)))
          (is= 123 (read (clempo.zone-factory::portal-leader-activation-tempo-block portal)))
          (is= 1 (read (clempo.zone-factory::portal-role portal 12)))
          (is= 2 (read (clempo.zone-factory::portal-role portal 14)))
          (is= 3 (read (clempo.zone-factory::portal-role portal 15)))
          (is (eq (eq spec :t13)
                  (read (clempo.zone-factory::portal-token-enablement-cursor-initialized portal))))
          (is (handler-case
                  (progn (clempo.zone-factory::initialize-portal portal 7 +path-usd-address+ nil nil
                                                               nil nil 11 '(12) 1 "" 0) nil)
                (precompile-revert (e)
                  (eq (precompile-revert-name e) 'clempo.zone-factory::already-initialized)))))))))

(deftest zone-closed-loop-fork ()
  (with-spec (:t10)
    (with-storage ((make-hashmap-storage))
      (clempo.zone-factory::validate-closed-loop '(1 1) '(2) '(3))
      (is= 0 (gas-used))))
  (with-spec (:t11)
    (with-storage ((make-hashmap-storage))
      (is (handler-case (progn (clempo.zone-factory::validate-closed-loop '(1 1) '(2) '(3)) nil)
            (precompile-revert (e)
              (eq (precompile-revert-name e) 'clempo.zone-factory::invalid-closed-loop-config))))
      (is= 80 (gas-used)))))
