(defpackage #:clempo.dex.tests
  (:use #:cl #:clempo.base #:clempo.forks #:clempo.contract #:clempo.precompiles #:clempo.dex)
  (:shadowing-import-from #:clempo.contract #:read #:write #:delete))

(in-package #:clempo.dex.tests)

(deftest dex-layout ()
  ;; tests/storage_tests/solidity/testdata/stablecoin_dex.layout.json; dexStorageCredits (T7)
  ;; came after the fixture.
  (is= '("STABLECOIN-DEX.dexStorageCredits exists in clempo but not in Solidity")
       (clempo.contract.layout-tests:layout-fixture-mismatches "stablecoin_dex" 'stablecoin-dex))
  (is= 5 (field-slot (layout-field 'stablecoin-dex 'clempo.dex::dex-storage-credits))))

(deftest dex-order-record-layouts ()
  ;; order/storage.rs: V1 is 4 slots with the version byte at offset 31 of slot 0, V2 is 3
  (flet ((slots (s) (type-slots s))
         (where (s f) (let ((f (layout-field s f))) (list (field-slot f) (field-offset f)))))
    (is= 6 (slots 'clempo.dex::order))
    (is= 4 (slots 'clempo.dex::v1-order))
    (is= 3 (slots 'clempo.dex::v2-order))
    (is= '(0 31) (where 'clempo.dex::v1-order 'clempo.dex::version))
    (is= '(0 31) (where 'clempo.dex::v2-order 'clempo.dex::version))
    (is= '(0 25) (where 'clempo.dex::v2-order 'clempo.dex::book-index))
    (is= '(1 16) (where 'clempo.dex::v1-order 'clempo.dex::remaining))
    (is= '(2 16) (where 'clempo.dex::v2-order 'clempo.dex::next))
    (is= '(3 0) (where 'clempo.dex::v1-order 'clempo.dex::book-key))))

(deftest dex-prices ()
  (is= 100000 (clempo.dex::tick-to-price 0))
  ;; rounding: escrow up, payout down
  (is= 99900000 (clempo.dex::base-to-quote 100000000 -100 nil))
  (is= 2 (clempo.dex::base-to-quote 1 10 t))
  (is= 1 (clempo.dex::base-to-quote 1 10 nil))
  (is= 1 (clempo.dex::quote-to-base 2 10 nil))
  (is= 2 (clempo.dex::quote-to-base 2 10 t))
  (is= nil (clempo.dex::base-to-quote u128-max 10 nil))
  ;; priceToTick wraps the out-of-range tick through i32 then i16
  (with-storage ((make-hashmap-storage))
    (with-spec (:t13)
      (is= -20 (clempo.dex::price-to-tick 99980))
      (flet ((reason (price)
               (handler-case (progn (clempo.dex::price-to-tick price) nil)
                 (precompile-revert (c) (list (precompile-revert-name c) (precompile-revert-args c))))))
        (is= '(clempo.dex::tick-out-of-bounds (-2001)) (reason 97999))
        (is= '(clempo.dex::invalid-tick nil) (reason 99995))
        ;; (u32::MAX as i32 - 100000) as i16
        (is= '(clempo.dex::tick-out-of-bounds (31071)) (reason 4294967295))))))

(deftest dex-order-terms ()
  (flet ((reason (amount tick flip bid fork)
           (with-spec (fork)
             (handler-case (progn (clempo.dex::validate-order-terms amount tick flip bid) :ok)
               (precompile-revert (c) (precompile-revert-name c))))))
    (is= :ok (reason 100000000 -20 nil t :t4))
    (is= 'clempo.dex::below-minimum-order-size (reason 99999999 0 nil t :t4))
    (is= 'clempo.dex::tick-out-of-bounds (reason 100000000 2010 nil t :t4))
    (is= 'clempo.dex::invalid-tick (reason 100000000 15 nil t :t4))
    (is= 'clempo.dex::invalid-flip-tick (reason 100000000 20 25 t :t4))
    ;; TIP-1030: same-tick flips from T5, never on the wrong side
    (is= 'clempo.dex::invalid-flip-tick (reason 100000000 20 20 t :t4))
    (is= :ok (reason 100000000 20 20 t :t5))
    (is= 'clempo.dex::invalid-flip-tick (reason 100000000 20 10 t :t5))
    (is= 'clempo.dex::invalid-flip-tick (reason 100000000 20 30 nil :t5))))

(deftest dex-tick-bitmap ()
  (with-storage ((make-hashmap-storage))
    (with-spec (:t13)
      (let ((key 7))
        (dolist (tick '(-2000 -300 -10 0 250 2000))
          (clempo.dex::set-tick-bit key tick nil)
          (clempo.dex::set-tick-bit key tick t))
        (flet ((next (tick bid) (multiple-value-list (clempo.dex::next-initialized-tick key tick bid))))
          (is= '(250 t) (next 0 nil))
          (is= '(-300 t) (next -10 t))
          (is= '(-10 t) (next -300 nil))
          (is= '(2000 t) (next 250 nil))
          (is= '(2000 nil) (next 2000 nil))
          (is= '(-2000 t) (next -300 t))
          (is= '(-2000 nil) (next -2000 t))
          (clempo.dex::delete-tick-bit key 2000 nil)
          (is= '(2048 nil) (next 250 nil))
          (clempo.dex::delete-tick-bit key -2000 t)
          (is= '(-2049 nil) (next -300 t)))))))

(deftest dex-order-records ()
  ;; T8 writes V2 when the book has an index, V1 otherwise; reads restore the logical order
  (with-storage ((make-hashmap-storage))
    (with-spec (:t13)
      (let ((order (clempo.dex::make-order :order-id 9 :maker #xabc :book-key #x1234 :is-bid t
                                           :tick -30 :amount 200000000 :remaining 150000000
                                           :prev 3 :next 0 :is-flip t :flip-tick 10)))
        (clempo.dex::write-order order 0)
        (is= 1 (clempo.dex::record-version 9))
        (is= (clempo.dex::order-tuple order) (clempo.dex::order-tuple (clempo.dex::read-order 9)))
        (clempo.dex::write-order order 5)
        (is= 2 (clempo.dex::record-version 9))
        (is= 0 (sload +stablecoin-dex-address+ (+ 3 (clempo.dex::record-base 9)))
             "the V1 book-key slot is cleared")
        (is= (clempo.dex::order-tuple order)
             (clempo.dex::order-tuple (clempo.dex::read-order 9 #x1234)))
        (is= #xabc (clempo.dex::record-maker 9))
        (clempo.dex::delete-order-record 9)
        (is= 0 (clempo.dex::record-version 9))
        (is= 0 (clempo.dex::order-maker (clempo.dex::read-order 9)))))))
