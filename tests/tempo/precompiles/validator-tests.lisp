(defpackage #:clempo.validator.tests
  (:use #:cl #:clempo.base #:clempo.forks #:clempo.contract #:clempo.precompiles)
  (:shadowing-import-from #:clempo.contract #:read #:write #:delete)
  (:local-nicknames (#:v1 #:clempo.validator-config)
                    (#:v2 #:clempo.validator-config-v2)
                    (#:committee #:clempo.committee)))

(in-package #:clempo.validator.tests)

(defun assert-revert (name args thunk)
  (handler-case
      (progn (funcall thunk) (is nil "expected ~S" name))
    (precompile-revert (c)
      (is= name (precompile-revert-name c))
      (is= args (precompile-revert-args c))
      (is (octets= (if (eq name 'panic)
                       (clempo.abi:panic-data (first args))
                       (apply #'error-data name args))
                   (precompile-revert-data c))))))

(defmacro reverts ((name &rest args) &body body)
  `(assert-revert ',name (list ,@args) (lambda () ,@body)))

(defun invoke (address signature args &optional (sender 1))
  (call-precompile address
                   (clempo.abi:abi-encode-call (clempo.abi:abi-selector signature)
                                               (clempo.abi:signature-types signature) args)
                   sender))

(defun validator-signature (seed kind address ingress egress &optional recipient)
  (let* ((in (clempo.abi:utf8-encode ingress)) (out (clempo.abi:utf8-encode egress))
         (namespace (string->octets
                     (ecase kind
                       (:add "TEMPO_VALIDATOR_CONFIG_V2_ADD_VALIDATOR")
                       (:rotate "TEMPO_VALIDATOR_CONFIG_V2_ROTATE_VALIDATOR"))))
         (message (apply #'octets-concat
                         (append (list (integer->octets (chain-id) 8)
                                       (integer->octets +validator-config-v2-address+ 20)
                                       (integer->octets address 20)
                                       (octets-of (length in)) in (octets-of (length out)) out)
                                 (when (eq kind :add) (list (integer->octets recipient 20)))))))
    (clempo.ed25519:ed25519-sign
     seed (octets-concat (octets-of (length namespace)) namespace (clempo.keccak:keccak256 message)))))

(defun test-seed (byte)
  (fill (make-octets 32) byte))

(defun add-test-validator (seed address ingress &optional (egress "192.0.2.1"))
  (v2:add-validator 1 address (octets->integer (clempo.ed25519:ed25519-public-key seed))
                    ingress egress address (validator-signature seed :add address ingress egress address)))

(deftest validator-storage-layouts ()
  (is= '(0 1 2 3) (mapcar #'field-slot (layout-fields 'v1:validator-config)))
  (is= '(0 1 2 3 4 5 6) (mapcar #'field-slot (layout-fields 'v2:validator-config-v2)))
  (is= '(0 1) (mapcar #'field-slot (layout-fields 'committee:current-committee)))
  (is= 1 (type-slots 'v2::config))
  (is= 6 (type-slots 'v2::validator-record))
  (is= '(0 0 0 0 0) (mapcar #'field-slot (layout-fields 'v2::config)))
  (is= '(0 20 21 29 30) (mapcar #'field-offset (layout-fields 'v2::config)))
  (is= '(0 1 2 3 4 4 5 5 5) (mapcar #'field-slot (layout-fields 'v2::validator-record)))
  (is= '(0 0 0 0 0 20 0 8 16) (mapcar #'field-offset (layout-fields 'v2::validator-record))))

(deftest validator-activation-and-dispatch-gates ()
  (with-storage ((make-hashmap-storage))
    (with-spec (:t0)
      (is (precompile-address-p +validator-config-address+))
      (is (precompile-address-p +validator-config-v2-address+))
      (multiple-value-bind (status output) (call-precompile +validator-config-v2-address+ (octets-of 1) 1)
        (is= :success status) (is= 0 (length output)))
      (multiple-value-bind (status output) (invoke +validator-config-address+ "changeValidatorStatusByIndex(uint64,bool)" '(0 t))
        (is= :revert status)
        (is (octets= (clempo.abi:abi-encode-error "UnknownFunctionSelector(bytes4)"
                                                (clempo.abi:abi-selector "changeValidatorStatusByIndex(uint64,bool)")) output))))
    (with-spec (:t1)
      (reverts (v1:validator-not-found) (v1:change-validator-status-by-index 0 0 t)))
    (with-spec (:t2)
      (multiple-value-bind (status output) (invoke +validator-config-v2-address+ "isInitialized()" nil)
        (is= :success status)
        (is (octets= (clempo.abi:abi-encode '(:bool) '(nil)) output))))
    (with-spec (:t7) (is (not (precompile-address-p +current-committee-address+))))
    (with-spec (:t8) (is (precompile-address-p +current-committee-address+)))))

(deftest validator-v1-error-order-and-rotation ()
  (with-spec (:t1)
    (with-storage ((make-hashmap-storage))
      (v1:initialize 1)
      (reverts (v1:invalid-public-key) (v1:add-validator 9 2 0 t "bad" "bad"))
      (reverts (v1:unauthorized) (v1:add-validator 9 2 3 t "bad" "bad"))
      (reverts (v1:not-host-port "inboundAddress" "host:80" "Parse(AddrParseError(Socket))")
        (v1:add-validator 1 2 3 t "host:80" "bad"))
      (with-spec (:t2)
        (reverts (v1:not-host-port "inboundAddress" "host:80" "input was not of the form `<ip>:<port>`")
          (v1:add-validator 1 2 3 t "host:80" "bad")))
      (v1:add-validator 1 2 3 t "[::1]:80" "192.0.2.1:80")
      (reverts (v1:validator-already-exists) (v1:add-validator 1 2 4 t "bad" "bad"))
      (reverts (v1:validator-not-found) (v1:update-validator 1 7 5 "[::1]:80" "192.0.2.1:80"))
      (let ((trace (make-recording-storage *storage*)))
        (with-storage (trace)
          (v1:update-validator 2 7 5 "[::2]:81" "192.0.2.2:81"))
        (is (not (find-if (lambda (op)
                           (and (eq (first op) 'backend-sload) (= (third op) 1)))
                         (recording-storage-trace trace)))))
      (is= '(0 nil 0 0 "" "") (v1:validators 2))
      (is= '(5 t 0 7 "[::2]:81" "192.0.2.2:81") (v1:validators 7))
      (is= 7 (v1:validators-array 0))
      (v1:change-validator-status-by-index 1 0 nil)
      (is (not (second (v1:validators 7))))
      (reverts (panic +panic-array-oob+) (v1:validators-array 1)))))

(deftest validator-endpoint-syntax-and-canonicalization ()
  (dolist (entry '(("[::]:0" "::") ("[0:0:0:0:0:0:0:1]:65535" "::1")
                   ("[2001:0:0:1:0:0:1:1%4294967295]:00080" "2001::1:0:0:1:1")
                   ("[::ffff:c000:201]:80" "::ffff:192.0.2.1")
                   ("[::192.0.2.1]:80" "::c000:201") ("192.0.2.1:00000080" "192.0.2.1")))
    (let ((socket (v2::parse-ip-port (first entry))))
      (is socket (first entry))
      (when socket (is= (second entry) (v2::ip-port-ip-string socket)))))
  (dolist (invalid '("host:80" "192.00.2.1:80" "192.0.2.1:65536" "192.0.2.1:-1"
                     "[::1]:+80" "[::1%eth0]:80" "[::1%4294967296]:80"
                     "[1:2:3:4:5:6:7:8::]:80" "[1:2:3:4:5:6:7]:80" "::1:80"))
    (is (null (v2::parse-ip-port invalid)) invalid))
  (is= (v2::ingress-key "[0:0:0:0:0:0:0:1%0]:080") (v2::ingress-key "[::1]:80"))
  (is (/= (v2::ingress-key "[::1%1]:80") (v2::ingress-key "[::1]:80")))
  (with-spec (:t13) (is (v2::validate-endpoints "[::ffff:192.0.2.1]:80" "::ffff:192.0.2.2")))
  (with-spec (:t14)
    (reverts (v2:invalid-ip "[::ffff:192.0.2.1]:80" "IPv4-mapped IPv6 address; use the IPv4 form")
      (v2::validate-endpoints "[::ffff:192.0.2.1]:80" "bad"))
    (let ((long (make-string 256 :initial-element #\x)))
      (reverts (v2:invalid-ip long "IP address exceeds 255 bytes") (v2::validate-endpoints long "bad")))
    (reverts (v2:not-ip "bad" "input was not a valid IP address")
      (v2::validate-endpoints "192.0.2.1:80" "bad"))))

(deftest validator-v2-signatures-and-lifecycle ()
  (with-spec (:t14)
    (with-storage ((make-hashmap-storage :block (make-block-info :number 100 :chain-id 4217)))
      (let* ((seed (test-seed 7)) (other (test-seed 8))
             (rotated (test-seed 9))
             (key (octets->integer (clempo.ed25519:ed25519-public-key seed)))
             (new-key (octets->integer (clempo.ed25519:ed25519-public-key rotated))))
        (v2:initialize 1)
        (is (v2:is-initialized)) (is= 100 (v2:get-initialized-at-height))
        (reverts (v2:invalid-signature-format)
          (v2:add-validator 1 10 key "192.0.2.1:80" "192.0.2.1" 10 (make-octets 63)))
        (reverts (v2:invalid-signature)
          (v2:add-validator 1 10 key "192.0.2.1:80" "192.0.2.1" 10
                            (validator-signature seed :rotate 10 "192.0.2.1:80" "192.0.2.1")))
        (is= 0 (add-test-validator seed 10 "192.0.2.1:80"))
        (is= 1 (add-test-validator other 11 "192.0.2.2:80"))
        (reverts (v2:ingress-already-exists "192.0.2.1:80")
          (v2:rotate-validator 10 0 new-key "192.0.2.1:80" "192.0.2.1" (make-octets 0)))
        (v2:rotate-validator 10 0 new-key "[::1]:81" "::1"
                             (validator-signature rotated :rotate 10 "[::1]:81" "::1"))
        (is= 3 (v2:validator-count))
        (is= '(2 100) (list (sixth (v2:validator-by-public-key key)) (eighth (v2:validator-by-public-key key))))
        (is= 0 (sixth (v2:validator-by-public-key new-key)))
        (reverts (v2:public-key-already-exists)
          (v2:add-validator 1 12 key "192.0.2.3:80" "192.0.2.3" 12 (make-octets 0)))
        (v2:set-fee-recipient 10 0 99)
        (is= 99 (fifth (v2:validator-by-index 0)))
        (v2:transfer-validator-ownership 10 0 12)
        (reverts (v2:validator-not-found) (v2:validator-by-address 10))
        (is= 12 (second (v2:validator-by-index 0)))
        (v2:deactivate-validator 12 0)
        (is= '(11) (mapcar #'second (v2:get-active-validators)))
        (v2:deactivate-validator 11 1)
        (is= nil (v2:get-active-validators))
        (reverts (v2:validator-already-deactivated) (v2:deactivate-validator 1 0))
        (v2:set-network-identity-rotation-epoch 1 22)
        (is= 22 (v2:get-next-network-identity-rotation-epoch))
        (v2:transfer-ownership 1 7)
        (is= 7 (v2:owner))))))

(deftest validator-v2-zip215-public-keys ()
  ;; Commonware accepts identity/noncanonical Edwards encodings, not only subgroup keys.
  (let ((identity (make-octets 32)) (signature (make-octets 64)))
    (setf (aref identity 0) 1 (aref signature 0) 1)
    (is (v2::valid-validator-public-key-p identity))
    (with-storage ((make-hashmap-storage))
      (is (v2::verify-validator-signature :rotate identity signature 1 "192.0.2.1:80" "192.0.2.1")))
    (setf (aref identity 31) 128)
    (is (v2::valid-validator-public-key-p identity))))

(deftest validator-v2-reverse-migration-and-finalization ()
  (with-spec (:t14)
    (with-storage ((make-hashmap-storage :block (make-block-info :number 200)))
      (let ((key (octets->integer (clempo.ed25519:ed25519-public-key (test-seed 3)))))
        (v1:initialize 1)
        (v1:add-validator 1 10 key t "192.0.2.1:80" "[2001:0:0:1:0:0:1:1%2]:80")
        (v1:add-validator 1 11 key nil "192.0.2.2:80" "192.0.2.2:80")
        (v1:set-next-full-dkg-ceremony 1 30)
        (reverts (v2:invalid-migration-index) (v2:migrate-validator 1 0))
        (v2:migrate-validator 1 1)
        (is= 200 (eighth (v2:validator-by-index 0)))
        (reverts (v2:migration-not-complete) (v2:initialize-if-migrated 1))
        (v2:migrate-validator 1 0)
        (is= 1 (v2:validator-count))
        (v2:initialize-if-migrated 1)
        (is (v2:is-initialized))
        (is= 200 (v2:get-initialized-at-height))
        (is= 30 (v2:get-next-network-identity-rotation-epoch))
        (reverts (v2:already-initialized) (v2:migrate-validator 1 0))))))

(deftest committee-system-writes-clear-stale-tail-without-credits ()
  (with-spec (:t8)
    (let* ((host (make-memory-host)) (backend (make-metered-storage host)))
      (with-storage (backend)
        (reverts (committee:unauthorized) (committee:set-committee-members 1 3 '(11 12)))
        (committee:set-committee-members 0 3 '(11 12))
        (committee:set-committee-members 0 4 '(13))
        (is= '(4 (13)) (multiple-value-list (committee:get-committee-members)))
        (let* ((base (clempo.keccak:keccak256-integer (integer->octets 1 32)))
               (slots (gethash +current-committee-address+ (memory-host-storage host))))
          (is= 0 (gethash (1+ base) slots 0)))
        (is= 0 (gethash +current-committee-address+
                        (or (gethash clempo.contract:+storage-credits-address+ (memory-host-storage host))
                            (make-hash-table)) 0))))))
