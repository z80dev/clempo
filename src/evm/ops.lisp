(in-package #:clempo.evm)

;;; The instruction set, Istanbul..Osaka. Static gas in :gas; dynamic gas in the body.

(defmacro access-account-gas (address)
  "EIP-2929 account access: warm/cold from Berlin, the flat Istanbul price before."
  `(if (fork>= :berlin)
       (if (warm-address world ,address) (gas-params-warm-read gp) (gas-params-cold-account gp))
       (gas-params-account-read gp)))

(defmacro copy-gas (size)
  `(* (gas-params-copy-word gp) (ceiling (the fixnum ,size) 32)))

(defmacro static-guard ()
  `(when (frame-static-p frame) (halt :static-violation)))

;;; 0x00s: stop and arithmetic

(defop #x00 stop () () (halt :stop))
(defop #x01 add (a b) (:gas 3 :pushes 1) (push-word (u+ a b)))
(defop #x02 mul (a b) (:gas 5 :pushes 1) (push-word (u* a b)))
(defop #x03 sub (a b) (:gas 3 :pushes 1) (push-word (u- a b)))
(defop #x04 div (a b) (:gas 5 :pushes 1) (push-word (u/ a b)))
(defop #x05 sdiv (a b) (:gas 5 :pushes 1) (push-word (s/ a b)))
(defop #x06 mod (a b) (:gas 5 :pushes 1) (push-word (u-mod a b)))
(defop #x07 smod (a b) (:gas 5 :pushes 1) (push-word (s-mod a b)))
(defop #x08 addmod (a b n) (:gas 8 :pushes 1) (push-word (add-mod a b n)))
(defop #x09 mulmod (a b n) (:gas 8 :pushes 1) (push-word (mul-mod a b n)))
(defop #x0a exp (base exponent) (:gas 10 :pushes 1)
  (charge (* (gas-params-exp-byte gp) (ceiling (integer-length exponent) 8)))
  (push-word (u-exp base exponent)))
(defop #x0b signextend (b x) (:gas 5 :pushes 1) (push-word (sign-extend b x)))

;;; 0x10s: comparison and bitwise

(defop #x10 lt (a b) (:gas 3 :pushes 1) (push-word (u-lt a b)))
(defop #x11 gt (a b) (:gas 3 :pushes 1) (push-word (u-gt a b)))
(defop #x12 slt (a b) (:gas 3 :pushes 1) (push-word (s-lt a b)))
(defop #x13 sgt (a b) (:gas 3 :pushes 1) (push-word (s-gt a b)))
(defop #x14 eq (a b) (:gas 3 :pushes 1) (push-word (if (= a b) 1 0)))
(defop #x15 iszero (a) (:gas 3 :pushes 1) (push-word (if (eql a 0) 1 0)))
(defop #x16 and (a b) (:gas 3 :pushes 1) (push-word (logand a b)))
(defop #x17 or (a b) (:gas 3 :pushes 1) (push-word (logior a b)))
(defop #x18 xor (a b) (:gas 3 :pushes 1) (push-word (logxor a b)))
(defop #x19 not (a) (:gas 3 :pushes 1) (push-word (word-not a)))
(defop #x1a byte (i x) (:gas 3 :pushes 1) (push-word (word-byte i x)))
(defop #x1b shl (shift x) (:gas 3 :pushes 1) (push-word (shl shift x)))
(defop #x1c shr (shift x) (:gas 3 :pushes 1) (push-word (shr shift x)))
(defop #x1d sar (shift x) (:gas 3 :pushes 1) (push-word (sar shift x)))
(defop #x1e clz (x) (:gas 5 :pushes 1 :since :osaka :doc "EIP-7939")
  (push-word (- 256 (integer-length x))))

;;; 0x20: keccak

(defop #x20 keccak256 (offset size) (:gas 30 :pushes 1)
  (mem-ensure offset size)
  (charge (* (gas-params-keccak-word gp) (ceiling size 32)))
  (push-word (octets->integer
              (keccak256 (frame-memory frame) :start (if (zerop size) 0 offset)
                                              :end (if (zerop size) 0 (+ offset size))))))

;;; 0x30s: environment

(defop #x30 address () (:gas 2 :pushes 1) (push-word (frame-address frame)))
(defop #x31 balance (a) (:pushes 1)
  (let ((address (to-address a)))
    (charge (access-account-gas address))
    (push-word (get-balance world address))))
(defop #x32 origin () (:gas 2 :pushes 1) (push-word (tx-env-origin *tx-env*)))
(defop #x33 caller () (:gas 2 :pushes 1) (push-word (frame-caller frame)))
(defop #x34 callvalue () (:gas 2 :pushes 1) (push-word (frame-value frame)))
(defop #x35 calldataload (offset) (:gas 3 :pushes 1)
  (push-word (read-word-padded (frame-input frame) offset)))
(defop #x36 calldatasize () (:gas 2 :pushes 1) (push-word (length (frame-input frame))))
(defop #x37 calldatacopy (mem-offset offset size) (:gas 3)
  (mem-ensure mem-offset size)
  (unless (zerop size)
    (charge (copy-gas size))
    (copy-padded (frame-input frame) offset (frame-memory frame) mem-offset size)))
(defop #x38 codesize () (:gas 2 :pushes 1) (push-word code-len))
(defop #x39 codecopy (mem-offset offset size) (:gas 3)
  (mem-ensure mem-offset size)
  (unless (zerop size)
    (charge (copy-gas size))
    (copy-padded code offset (frame-memory frame) mem-offset size)))
(defop #x3a gasprice () (:gas 2 :pushes 1) (push-word (tx-env-gas-price *tx-env*)))
(defop #x3b extcodesize (a) (:pushes 1)
  (let ((address (to-address a)))
    (charge (access-account-gas address))
    (push-word (length (get-code world address)))))
(defop #x3c extcodecopy (a mem-offset offset size) ()
  (let ((address (to-address a)))
    (charge (access-account-gas address))
    (mem-ensure mem-offset size)
    (unless (zerop size)
      (charge (copy-gas size))
      (copy-padded (get-code world address) offset (frame-memory frame) mem-offset size))))
(defop #x3d returndatasize () (:gas 2 :pushes 1) (push-word (length (frame-return-data frame))))
(defop #x3e returndatacopy (mem-offset offset size) (:gas 3)
  (let ((data (frame-return-data frame)))
    (unless (<= (+ offset size) (length data)) (halt :return-data-out-of-bounds))
    (mem-ensure mem-offset size)
    (unless (zerop size)
      (charge (copy-gas size))
      (replace (frame-memory frame) data :start1 mem-offset :start2 offset :end2 (+ offset size)))))
(defop #x3f extcodehash (a) (:pushes 1)
  (let ((address (to-address a)))
    (charge (access-account-gas address))
    (let ((account (get-account world address)))
      (push-word (if (account-dead-p account)
                     0
                     (octets->integer (account-code-hash account)))))))

;;; 0x40s: block

(defop #x40 blockhash (n) (:gas 20 :pushes 1)
  (let ((current (block-env-number block)))
    (push-word (if (and (< n current) (<= (- current 256) n))
                   (let ((fn (block-env-block-hash-fn block)))
                     (if fn (funcall fn n) 0))
                   0))))
(defop #x41 coinbase () (:gas 2 :pushes 1) (push-word (block-env-coinbase block)))
(defop #x42 timestamp () (:gas 2 :pushes 1) (push-word (block-env-timestamp block)))
(defop #x43 number () (:gas 2 :pushes 1) (push-word (block-env-number block)))
(defop #x44 prevrandao () (:gas 2 :pushes 1 :doc "DIFFICULTY before Paris")
  (push-word (if (fork>= :paris) (block-env-prevrandao block) (block-env-difficulty block))))
(defop #x45 gaslimit () (:gas 2 :pushes 1) (push-word (block-env-gas-limit block)))
(defop #x46 chainid () (:gas 2 :pushes 1) (push-word (block-env-chain-id block)))
(defop #x47 selfbalance () (:gas 5 :pushes 1) (push-word (account-balance (frame-account frame))))
(defop #x48 basefee () (:gas 2 :pushes 1 :since :london) (push-word (block-env-base-fee block)))
(defop #x49 blobhash (i) (:gas 3 :pushes 1 :since :cancun)
  (let ((hashes (tx-env-blob-hashes *tx-env*)))
    (push-word (if (< i (length hashes)) (svref hashes i) 0))))
(defop #x4a blobbasefee () (:gas 2 :pushes 1 :since :cancun)
  (push-word (block-env-blob-base-fee block)))

;;; 0x50s: stack, memory, storage, flow

(defop #x50 pop (a) (:gas 2))
(defop #x51 mload (offset) (:gas 3 :pushes 1)
  (mem-ensure offset 32)
  (push-word (read-word (frame-memory frame) offset)))
(defop #x52 mstore (offset value) (:gas 3)
  (mem-ensure offset 32)
  (write-word (frame-memory frame) offset value))
(defop #x53 mstore8 (offset value) (:gas 3)
  (mem-ensure offset 1)
  (setf (aref (frame-memory frame) offset) (ldb (byte 8 0) value)))
(defop #x54 sload (key) (:pushes 1)
  (charge (if (fork>= :berlin)
              (if (warm-slot world (frame-address frame) key)
                  (gas-params-warm-read gp)
                  (gas-params-cold-sload gp))
              (gas-params-sload gp)))
  (push-word (account-sload world (frame-account frame) key)))
(defop #x55 sstore (key value) (:doc "SPEC-SSTORE-HOOK, when set, is called after the write as
(hook frame key original present new cold-p) with FRAME-GAS current; it returns NIL or a
halt status and may spend gas.")
  (when (<= gas (gas-params-sstore-sentry gp)) (halt :out-of-gas))
  (multiple-value-bind (cost cold) (sstore-cost world gp (current-fork) frame key value)
    (charge cost)
    (static-guard)
    (multiple-value-bind (original present) (account-sstore world (frame-account frame) key value)
      (let ((hook (spec-sstore-hook spec)))
        (when hook
          (sync-gas)
          (let ((status (funcall (the function hook) frame key original present value cold)))
            (when status (halt status)))
          (reload-gas))))))
(defop #x56 jump (dest) (:gas 8 :manual-pc t)
  (if (and (typep dest 'fixnum) (< dest code-len) (= 1 (sbit jumpdests dest)))
      (setf pc dest)
      (halt :invalid-jump)))
(defop #x57 jumpi (dest condition) (:gas 10 :manual-pc t)
  (if (eql condition 0)
      (incf pc)
      (if (and (typep dest 'fixnum) (< dest code-len) (= 1 (sbit jumpdests dest)))
          (setf pc dest)
          (halt :invalid-jump))))
(defop #x58 pc () (:gas 2 :pushes 1) (push-word pc))
(defop #x59 msize () (:gas 2 :pushes 1) (push-word (frame-mem-size frame)))
(defop #x5a gas () (:gas 2 :pushes 1) (push-word gas))
(defop #x5b jumpdest () (:gas 1))
(defop #x5c tload (key) (:gas 100 :pushes 1 :since :cancun)
  (push-word (tload world (frame-address frame) key)))
(defop #x5d tstore (key value) (:gas 100 :since :cancun)
  (static-guard)
  (tstore world (frame-address frame) key value))
(defop #x5e mcopy (dst src size) (:gas 3 :since :cancun)
  (unless (zerop size)
    (mem-ensure (max dst src) size)
    (charge (copy-gas size))
    (let ((mem (frame-memory frame)))
      (replace mem mem :start1 dst :start2 src :end2 (+ src size)))))
(defop #x5f push0 () (:gas 2 :pushes 1 :since :shanghai) (push-word 0))

(macrolet ((define-pushes ()
             `(progn
                ,@(loop for n from 1 to 32
                        collect `(defop ,(+ #x5f n) ,(intern (format nil "PUSH~D" n)) ()
                                   (:gas 3 :pushes 1 :manual-pc t)
                                   (push-word (svref pushes pc))
                                   (incf pc ,(1+ n))))))
           (define-dups ()
             `(progn
                ,@(loop for n from 1 to 16
                        collect `(defop ,(+ #x7f n) ,(intern (format nil "DUP~D" n)) ()
                                   (:gas 3 :pushes 1 :needs ,n)
                                   (push-word (svref stack (- sp ,n)))))))
           (define-swaps ()
             `(progn
                ,@(loop for n from 1 to 16
                        collect `(defop ,(+ #x8f n) ,(intern (format nil "SWAP~D" n)) ()
                                   (:gas 3 :needs ,(1+ n))
                                   (rotatef (svref stack (- sp 1)) (svref stack (- sp ,(1+ n))))))))
           (define-logs ()
             `(progn
                ,@(loop for n from 0 to 4
                        for topics = (loop for i from 1 to n collect (intern (format nil "TOPIC~D" i)))
                        collect `(defop ,(+ #xa0 n) ,(intern (format nil "LOG~D" n))
                                     (offset size ,@topics) (:gas 375)
                                   (static-guard)
                                   (mem-ensure offset size)
                                   (charge (+ ,(* 375 n) (* (gas-params-log-data gp) size)))
                                   (let ((entry (make-log-entry (frame-address frame)
                                                                (list ,@topics)
                                                                (memory-slice frame offset size))))
                                     (add-log world entry)
                                     (when-tracing (trace-log tracer frame entry))))))))
  (define-pushes)
  (define-dups)
  (define-swaps)
  (define-logs))

;;; 0xf0s: system

(defop #xf0 create (value offset size) (:gas 32000 :pushes 1)
  (static-guard)
  (mem-ensure offset size)
  (sync-gas)
  (let ((result (op-create frame :create value offset size 0)))
    (unless result (halt :out-of-gas))
    (reload-gas)
    (push-word result)))
(defop #xf5 create2 (value offset size salt) (:gas 32000 :pushes 1)
  (static-guard)
  (mem-ensure offset size)
  (charge (* (gas-params-keccak-word gp) (ceiling size 32)))
  (sync-gas)
  (let ((result (op-create frame :create2 value offset size salt)))
    (unless result (halt :out-of-gas))
    (reload-gas)
    (push-word result)))
(defop #xf1 call (g to value in-offset in-size out-offset out-size) (:pushes 1)
  (when (and (frame-static-p frame) (/= value 0)) (halt :static-violation))
  (mem-ensure in-offset in-size)
  (mem-ensure out-offset out-size)
  (sync-gas)
  (let ((result (op-call frame :call g (to-address to) value in-offset in-size out-offset out-size)))
    (unless result (halt :out-of-gas))
    (reload-gas)
    (push-word result)))
(defop #xf2 callcode (g to value in-offset in-size out-offset out-size) (:pushes 1)
  (mem-ensure in-offset in-size)
  (mem-ensure out-offset out-size)
  (sync-gas)
  (let ((result (op-call frame :callcode g (to-address to) value in-offset in-size out-offset out-size)))
    (unless result (halt :out-of-gas))
    (reload-gas)
    (push-word result)))
(defop #xf4 delegatecall (g to in-offset in-size out-offset out-size) (:pushes 1)
  (mem-ensure in-offset in-size)
  (mem-ensure out-offset out-size)
  (sync-gas)
  (let ((result (op-call frame :delegatecall g (to-address to) 0 in-offset in-size out-offset out-size)))
    (unless result (halt :out-of-gas))
    (reload-gas)
    (push-word result)))
(defop #xfa staticcall (g to in-offset in-size out-offset out-size) (:pushes 1)
  (mem-ensure in-offset in-size)
  (mem-ensure out-offset out-size)
  (sync-gas)
  (let ((result (op-call frame :staticcall g (to-address to) 0 in-offset in-size out-offset out-size)))
    (unless result (halt :out-of-gas))
    (reload-gas)
    (push-word result)))
(defop #xf3 return (offset size) ()
  (mem-ensure offset size)
  (halt :return (memory-slice frame offset size)))
(defop #xfd revert (offset size) ()
  (mem-ensure offset size)
  (halt :revert (memory-slice frame offset size)))
(defop #xfe invalid () () (halt :invalid-opcode))
(defop #xff selfdestruct (b) ()
  (static-guard)
  (sync-gas)
  (unless (op-selfdestruct frame (to-address b)) (halt :out-of-gas))
  (reload-gas)
  (halt :stop))
