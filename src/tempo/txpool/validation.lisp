(in-package #:clempo.txpool)

(defconstant +expiring-nonce-key+ #xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)

(defun fee-cap (tx)
  (or (clempo.transactions:transaction-max-fee-per-gas tx)
      (clempo.transactions:transaction-gas-price tx)))
(defun priority-fee (tx)
  (or (clempo.transactions:transaction-max-priority-fee-per-gas tx)
      (clempo.transactions:transaction-gas-price tx)))
(defun nonce-key (tx) (or (clempo.transactions:transaction-nonce-key tx) 0))
(defun aa-p (tx) (= (clempo.transactions:transaction-type tx) #x76))
(defun key-authorization (tx)
  (when (and (aa-p tx) (= (length (clempo.transactions:transaction-fields tx)) 15))
    (nth 13 (clempo.transactions:transaction-fields tx))))

(defun present-list (value) (and (listp value) value))

(defun ensure-field-limits (pool tx)
  ;; validator.rs::ensure_aa_field_limits: bounds are pool policy, not wire limits.
  (when (aa-p tx)
    (let ((calls (clempo.transactions:transaction-calls tx))
          (access (clempo.transactions:transaction-access-list tx))
          (auth (key-authorization tx)))
      (when (> (length calls) 32) (reject :too-many-calls))
      (when (some (lambda (call) (> (length (third call)) (* 128 1024))) calls)
        (reject :call-input-too-large))
      (when (> (length (clempo.transactions:transaction-tempo-authorization-list tx))
               (pool-max-authorizations pool))
        (reject :too-many-authorizations))
      (when (> (length access) 256) (reject :too-many-access-list-accounts))
      (let ((total 0))
        (dolist (account access)
          (let ((n (length (second account))))
            (when (> n 256) (reject :too-many-storage-keys-per-account))
            (incf total n)))
        (when (> total 2048) (reject :too-many-storage-keys)))
      (when auth
        (let ((fields (first auth)))
          (unless (listp fields) (reject :invalid-key-authorization))
          (when (> (length (present-list (nth 4 fields))) 256)
            (reject :too-many-token-limits))
          (let ((scopes (present-list (nth 5 fields))))
            (when (> (length scopes) 64) (reject :too-many-call-scopes))
            (dolist (scope scopes)
              (unless (and (listp scope) (= (length scope) 2) (listp (second scope)))
                (reject :invalid-key-authorization))
              (when (> (length (second scope)) 64) (reject :too-many-selector-rules))
              (dolist (rule (second scope))
                (unless (and (listp rule) (= (length rule) 2) (listp (second rule)))
                  (reject :invalid-key-authorization))
                (when (> (length (second rule)) 64) (reject :too-many-recipients))))))))))

(defun ensure-time-bounds (pool tx timestamp admission-p)
  (let ((before (clempo.transactions:transaction-valid-before tx))
        (after (clempo.transactions:transaction-valid-after tx)))
    (when (and before (<= before (min +u64-max+ (+ timestamp (if admission-p 3 0)))))
      (reject :expired before))
    (when (and admission-p after
               (> after (min +u64-max+ (+ (clempo.io:now-seconds)
                                          (pool-valid-after-max-seconds pool)))))
      (reject :valid-after-too-far after))))

(defun snapshot-context (reader timestamp fork)
  (check-type reader state-reader)
  (let* ((env (state-reader-env reader))
         (tip (clempo.executor:block-env-timestamp env))
         (spec (clempo.executor:block-env-spec env)))
    (when (or (and timestamp (/= timestamp tip)) (and fork (not (eq fork spec))))
      (reject :state-context "timestamp/fork must match the reader's block-env"))
    (values tip spec (clempo.executor:block-env-base-fee env))))

(defun entry-authorities-for (tx sender key-id payer)
  (let* ((authorization (key-authorization tx))
         (account (and authorization (nth 8 (first authorization))))
         (authorizer
           (when authorization
             (if (and account (plusp (length account))) (octets->integer account)
                 (clempo.transactions:transaction-key-authorization-signer tx)))))
    (remove-duplicates (remove nil (list sender authorizer payer key-id)) :test #'=)))

(defun recover-pool-sender (tx)
  (handler-case (clempo.transactions:transaction-sender tx)
    (clempo.signatures:signature-error (condition)
      (reject :invalid-signature (princ-to-string condition)))
    (invariant-violation (condition)
      (reject :invalid-signature (princ-to-string condition)))))

(defun validate-entry (pool tx reader timestamp spec &key (admission-p t))
  "Pool policy plus the same rollback-only semantic validation used by execution.
Only INVALID-TRANSACTION is translated; storage/provider failures stay fatal to admission."
  (check-type tx clempo.transactions:transaction)
  (unless (member (clempo.transactions:transaction-type tx) '(0 1 2 4 #x76))
    (reject :unsupported-transaction-type))
  ;; The legacy zero-r/s even-parity marker is a system transaction, not a user signature.
  (when (and (zerop (clempo.transactions:transaction-type tx))
             (zerop (clempo.transactions:transaction-r tx))
             (zerop (clempo.transactions:transaction-s tx))
             (let ((v (clempo.transactions:transaction-v tx)))
               (if (>= v 35) (evenp (- v 35)) (= v 27))))
    (reject :system-transaction))
  (let ((size (clempo.transactions:transaction-encoded-length tx))
        (key (nonce-key tx)))
    (when (> size (pool-max-transaction-bytes pool)) (reject :oversized-transaction size))
    (when (< (fee-cap tx) (pool-minimum-fee-cap pool)) (reject :fee-cap-below-floor))
    (when (= (ldb (byte 8 248) key) #x5b) (reject :subblock-nonce-key))
    (ensure-field-limits pool tx)
    (ensure-time-bounds pool tx timestamp admission-p)
    (multiple-value-bind (sender key-id) (recover-pool-sender tx)
      (let* ((expiring (and (clempo.forks:fork>= spec :t1) (= key +expiring-nonce-key+)))
             (nonce (clempo.transactions:transaction-nonce tx))
             (state-nonce (if expiring 0 (state-reader-nonce reader sender key))))
        (check-type state-nonce (unsigned-byte 64))
        (unless expiring
          (when (= nonce +u64-max+) (reject :nonce-overflow))
          (when (< nonce state-nonce) (reject :nonce-too-low state-nonce)))
        (let ((outcome
                (handler-case (state-reader-check reader tx sender)
                  (clempo.executor:invalid-transaction (condition)
                    (reject :invalid-transaction
                            (clempo.executor:execution-failure-reason condition))))))
          (check-type outcome clempo.executor:tx-outcome)
          (let* ((token (clempo.executor:tx-outcome-fee-token outcome))
                 (payer (clempo.executor:tx-outcome-fee-payer outcome))
                 (expiry (clempo.executor:tx-outcome-key-expiry outcome))
                 (cost (ceiling (* (clempo.transactions:transaction-gas-limit tx) (fee-cap tx))
                                1000000000000))
                 (replay (when expiring
                           (hash-key (clempo.transactions:transaction-unique-identifier tx sender)))))
            ;; Missing validation metadata is a backend error, never implicit approval.
            (check-type token (unsigned-byte 160))
            (check-type payer (unsigned-byte 160))
            (when (and expiry
                       (<= expiry (max (min +u64-max+ (+ timestamp (if admission-p 3 0)))
                                       (or (clempo.transactions:transaction-valid-after tx) 0))))
              (reject :access-key-expired expiry))
            (unless (state-reader-liquidity-p reader token cost)
              (reject :insufficient-amm-liquidity))
            (make-entry :tx tx :hash (hash-key (clempo.transactions:transaction-hash tx))
                        :sender sender :lane (if replay (cons :expiring replay) (cons sender key))
                        :nonce nonce
                        :state-nonce state-nonce
                        :fee-cap (fee-cap tx) :priority-fee (priority-fee tx)
                        :valid-before (clempo.transactions:transaction-valid-before tx)
                        :valid-after (clempo.transactions:transaction-valid-after tx)
                        :replay-hash replay
                        :fee-cost cost :fee-balance-slot (cons token (state-mapping-slot payer 9))
                        :fallback-fee-token-p (clempo.executor:tx-outcome-fallback-fee-token-p outcome)
                        :key-expiry expiry
                        :authorities (entry-authorities-for tx sender key-id payer))))))))
