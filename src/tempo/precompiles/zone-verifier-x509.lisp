(in-package #:clempo.zone-verifier)

;;; The X.509 profile in crates/nitro-attestation/src/x509.rs. Decode the schema
;;; directly, preserving signed DER; no generic ASN.1 tree or normalization.
(define-constant +aws-nitro-root-der+
  (hex->octets ""))

(defun aws-nitro-root () +aws-nitro-root-der+)

(defun nitro-der-item (reader &optional expected-tag)
  "Return a content reader, tag and original TLV start, advancing the parent past it."
  (let* ((start (nitro-reader-pos reader)) (tag (nitro-byte reader))
         (length-byte (nitro-byte reader))
         (count (if (< length-byte 128) length-byte
                    (let ((width (logand length-byte 127)))
                      (unless (<= 1 width 4) (nitro-invalid))
                      (let ((n (nitro-byte reader)))
                        (when (zerop n) (nitro-invalid))
                        (dotimes (i (1- width))
                          (setf n (+ (ash n 8) (nitro-byte reader))))
                        (unless (>= n 128) (nitro-invalid))
                        n))))
         (content (nitro-reader-pos reader)) (end (+ content count)))
    (unless (and (/= (logand tag 31) 31)
                 (or (>= tag #x40)
                     (member tag '(1 2 3 4 5 6 9 10 12 18 19 20 21 22 23 24 26 30 48 49)))
                 (or (null expected-tag) (= tag expected-tag))
                 (<= end (nitro-reader-end reader)))
      (nitro-invalid))
    (setf (nitro-reader-pos reader) end)
    (values (nitro-reader (nitro-reader-data reader) content end) tag start)))

(defun nitro-der-bytes (reader tag)
  (let ((value (nitro-der-item reader tag)))
    (nitro-take value (- (nitro-reader-end value) (nitro-reader-pos value)))))

(defun nitro-der-integer (reader &optional (maximum-bytes 48) signed)
  (let* ((value (nitro-der-item reader 2))
         (start (nitro-reader-pos value)) (end (nitro-reader-end value))
         (data (nitro-reader-data value)) (count (- end start)))
    (unless (plusp count) (nitro-invalid))
    (let ((first (aref data start)))
      (when (and (not signed) (>= first 128)) (nitro-invalid))
      (when (and (> count 1)
                 (or (and (zerop first) (< (aref data (1+ start)) 128))
                     (and (= first 255) (>= (aref data (1+ start)) 128))))
        (nitro-invalid))
      (when (and (> count 1) (zerop first)) (incf start))
      ;; SerialNumber limits its signed DER content to 21 octets, including sign padding.
      (when (> (if signed count (- end start)) maximum-bytes) (nitro-invalid))
      (octets->integer data :start start :end end))))

(defun nitro-der-boolean (reader)
  (let ((value (nitro-der-item reader 1)))
    (let ((byte (nitro-byte value)))
      (nitro-finished value)
      (case byte (0 nil) (255 t) (t (nitro-invalid))))))

(defun nitro-der-oid (reader)
  (let ((oid (nitro-der-bytes reader 6)))
    (unless (<= 1 (length oid) 39) (nitro-invalid))
    (let ((start t) (arc 0))
      (loop for byte across oid
            do (when (and start (= byte 128)) (nitro-invalid))
               (setf arc (+ (ash arc 7) (logand byte 127)))
               (when (> arc #xffffffff) (nitro-invalid))
               (setf start (< byte 128))
               (when start (setf arc 0)))
      (unless start (nitro-invalid)))
    oid))

(defun nitro-der-oid= (reader bytes)
  (unless (equalp (nitro-der-oid reader) bytes) (nitro-invalid)))

(defun nitro-der-signature-algorithm (reader)
  (let ((algorithm (nitro-der-item reader #x30)))
    (nitro-der-oid= algorithm #(#x2a #x86 #x48 #xce #x3d 4 3 3))
    (nitro-finished algorithm)))

(defun nitro-der-bit-string (reader &optional (tag 3) aligned)
  (let* ((value (nitro-der-item reader tag)) (unused (nitro-byte value))
         (count (- (nitro-reader-end value) (nitro-reader-pos value))))
    (unless (and (<= unused 7) (or (plusp count) (zerop unused))
                 (or (not aligned) (zerop unused)))
      (nitro-invalid))
    (values value (- (* count 8) unused))))

(defun nitro-der-lex< (data start-a end-a start-b end-b)
  (loop for a from start-a below end-a for b from start-b below end-b
        for x = (aref data a) for y = (aref data b)
        when (/= x y) do (return-from nitro-der-lex< (< x y)))
  (< (- end-a start-a) (- end-b start-b)))

(defun nitro-der-name (reader)
  (multiple-value-bind (name tag start) (nitro-der-item reader #x30)
    (declare (ignore tag))
    (let ((data (nitro-reader-data name)))
      (loop while (nitro-peek name)
            do (let ((rdn (nitro-der-item name #x31)) (previous-start nil) (previous-end nil))
                 (loop while (nitro-peek rdn)
                       do (multiple-value-bind (attribute tag attribute-start) (nitro-der-item rdn #x30)
                            (declare (ignore tag))
                            (let ((attribute-end (nitro-reader-end attribute)))
                              ;; x509-cert sorts SET OF while decoding. Its DER round trip
                              ;; rejects unsorted input, and duplicate values are invalid.
                              (when (and previous-start
                                         (not (nitro-der-lex< data previous-start previous-end
                                                             attribute-start attribute-end)))
                                (nitro-invalid))
                              (setf previous-start attribute-start previous-end attribute-end))
                            (nitro-der-oid attribute)
                            (nitro-der-item attribute)
                            (nitro-finished attribute)))))
      (subseq data start (nitro-reader-end name)))))

(defun nitro-leap-year-p (year)
  (and (zerop (mod year 4)) (or (not (zerop (mod year 100))) (zerop (mod year 400)))))

(defun nitro-der-time (reader)
  (multiple-value-bind (value tag) (nitro-der-item reader)
    (unless (member tag '(23 24)) (nitro-invalid))
    (unless (= (- (nitro-reader-end value) (nitro-reader-pos value)) (if (= tag 23) 13 15))
      (nitro-invalid))
    (flet ((decimal ()
             (let ((a (nitro-byte value)) (b (nitro-byte value)))
               (unless (and (<= 48 a 57) (<= 48 b 57)) (nitro-invalid))
               (+ (* (- a 48) 10) (- b 48)))))
      (let* ((year (decimal))
             (year (if (= tag 23) (+ year (if (>= year 50) 1900 2000))
                       (+ (* year 100) (decimal))))
             (month (decimal)) (day (decimal)) (hour (decimal))
             (minute (decimal)) (second (decimal)))
        (unless (and (= (nitro-byte value) 90) (<= 1970 year 9999)
                     (<= 1 month 12) (<= 0 hour 23) (<= 0 minute 59) (<= 0 second 59))
          (nitro-invalid))
        (let ((month-days (if (and (= month 2) (nitro-leap-year-p year)) 29
                              (aref #(31 28 31 30 31 30 31 31 30 31 30 31) (1- month)))))
          (unless (<= 1 day month-days) (nitro-invalid)))
        (let* ((prior (1- year))
               (days (+ (* 365 (- year 1970))
                        (- (floor prior 4) 492) (- 19 (floor prior 100))
                        (- (floor prior 400) 4)
                        (aref #(0 31 59 90 120 151 181 212 243 273 304 334) (1- month))
                        (if (and (> month 2) (nitro-leap-year-p year)) 1 0) (1- day))))
          (+ (* days 86400) (* hour 3600) (* minute 60) second))))))

(defun nitro-der-public-key (reader)
  (let* ((spki (nitro-der-item reader #x30)) (algorithm (nitro-der-item spki #x30)))
    (nitro-der-oid= algorithm #(#x2a #x86 #x48 #xce #x3d 2 1))
    (nitro-der-oid= algorithm #(#x2b #x81 4 0 #x22))
    (nitro-finished algorithm)
    (let* ((bits (nitro-der-bit-string spki 3 t)) (data (nitro-reader-data bits))
           (start (nitro-reader-pos bits)))
      (unless (and (= (- (nitro-reader-end bits) start) 97) (= (nitro-byte bits) 4))
        (nitro-invalid))
      (let ((x (octets->integer data :start (1+ start) :end (+ start 49)))
            (y (octets->integer data :start (+ start 49) :end (+ start 97))))
        (unless (clempo.p384:p384-valid-public-key-p x y) (nitro-invalid))
        (nitro-finished spki)
        (values x y)))))

(defun nitro-der-basic-constraints (bytes)
  (let* ((input (nitro-reader bytes)) (sequence (nitro-der-item input #x30))
         (ca (and (eql (nitro-peek sequence) 1) (nitro-der-boolean sequence)))
         (path-length (when (eql (nitro-peek sequence) 2) (nitro-der-integer sequence 1))))
    (nitro-finished input)
    (nitro-finished sequence)
    (values ca path-length)))

(defun nitro-der-key-usage (bytes ca)
  (let ((input (nitro-reader bytes)))
    (multiple-value-bind (bits bit-count) (nitro-der-bit-string input)
      (nitro-finished input)
      (let ((bit (if ca 5 0)))
        (unless (and (<= bit-count 16) (> bit-count bit)
                     (logbitp (- 7 bit) (aref (nitro-reader-data bits) (nitro-reader-pos bits))))
          (nitro-invalid))))))

(defun nitro-der-extensions (reader ca)
  (let ((seen nil) (basic-seen nil) (usage-seen nil) (path-length nil))
    (when (eql (nitro-peek reader) #xa3)
      (let* ((wrapper (nitro-der-item reader #xa3)) (extensions (nitro-der-item wrapper #x30)))
        (nitro-finished wrapper)
        (loop while (nitro-peek extensions)
              do (let* ((extension (nitro-der-item extensions #x30))
                        (oid (nitro-der-oid extension))
                        (critical (when (eql (nitro-peek extension) 1)
                                    ;; Explicit DEFAULT FALSE changes the certificate's DER.
                                    (unless (nitro-der-boolean extension) (nitro-invalid))
                                    t))
                        (bytes (nitro-der-bytes extension 4)))
                   (nitro-finished extension)
                   (when (member oid seen :test #'equalp) (nitro-invalid))
                   (push oid seen)
                   (cond ((equalp oid #(85 29 19))
                          (setf basic-seen t)
                          (multiple-value-bind (is-ca constraint) (nitro-der-basic-constraints bytes)
                            (if ca
                                (unless (and critical is-ca) (nitro-invalid))
                                (when (or is-ca constraint) (nitro-invalid)))
                            (setf path-length constraint)))
                         ((equalp oid #(85 29 15))
                          (setf usage-seen t)
                          (nitro-der-key-usage bytes ca))
                         (critical (nitro-invalid)))))))
    (unless (and usage-seen (or (not ca) basic-seen)) (nitro-invalid))
    path-length))

(defun nitro-der-ecdsa-signature (reader)
  (let* ((bits (nitro-der-bit-string reader 3 t)) (sequence (nitro-der-item bits #x30))
         (r (nitro-der-integer sequence)) (s (nitro-der-integer sequence)))
    (nitro-finished bits)
    (nitro-finished sequence)
    (values r s)))

(defstruct nitro-certificate data tbs-start tbs-end issuer subject path-length x y r s)

(defun nitro-check-certificate (der timestamp ca)
  (let* ((input (nitro-reader der)) (certificate (nitro-der-item input #x30)))
    (nitro-finished input)
    (multiple-value-bind (tbs tag tbs-start) (nitro-der-item certificate #x30)
      (declare (ignore tag))
      (let ((version (nitro-der-item tbs #xa0)))
        (unless (= (nitro-der-integer version 1) 2) (nitro-invalid))
        (nitro-finished version))
      (nitro-der-integer tbs 21 t)
      (nitro-der-signature-algorithm tbs)
      (let* ((issuer (nitro-der-name tbs)) (validity (nitro-der-item tbs #x30))
             (not-before (nitro-der-time validity)) (not-after (nitro-der-time validity)))
        (nitro-finished validity)
        (unless (<= not-before timestamp not-after) (nitro-invalid))
        (let ((subject (nitro-der-name tbs)))
          (multiple-value-bind (x y) (nitro-der-public-key tbs)
            (when (eql (nitro-peek tbs) #x81) (nitro-der-bit-string tbs #x81))
            (when (eql (nitro-peek tbs) #x82) (nitro-der-bit-string tbs #x82))
            (let ((path-length (nitro-der-extensions tbs ca)))
              (nitro-finished tbs)
              (nitro-der-signature-algorithm certificate)
              (multiple-value-bind (r s) (nitro-der-ecdsa-signature certificate)
                (nitro-finished certificate)
                (make-nitro-certificate :data der :tbs-start tbs-start :tbs-end (nitro-reader-end tbs)
                                        :issuer issuer :subject subject :path-length path-length
                                        :x x :y y :r r :s s)))))))))

(defun nitro-validate-chain (attestation timestamp root)
  (let ((bundle (nitro-attestation-cabundle attestation)))
    (unless (and bundle (octets= (first bundle) root)) (nitro-invalid))
    (let* ((ca-count (length bundle))
           (path (make-array (1+ ca-count))))
      (loop for der in bundle for i from 0
            do (setf (aref path i) (nitro-check-certificate der timestamp t)))
      (setf (aref path ca-count)
            (nitro-check-certificate (nitro-attestation-certificate attestation) timestamp nil))
      (loop for i from 1 to ca-count
            unless (octets= (nitro-certificate-issuer (aref path i))
                            (nitro-certificate-subject (aref path (1- i))))
              do (nitro-invalid))
      (loop for i below ca-count for constraint = (nitro-certificate-path-length (aref path i))
            when constraint
              do (when (> (loop for j from (1+ i) below ca-count
                                count (not (octets= (nitro-certificate-issuer (aref path j))
                                                   (nitro-certificate-subject (aref path j)))))
                          constraint)
                   (nitro-invalid)))
      ;; Trust in the root is byte-identical pinning, not its self-signature.
      (loop for i from 1 to ca-count
            for parent = (aref path (1- i)) for child = (aref path i)
            unless (clempo.p384:p384-verify
                    (clempo.sha2:sha384 (nitro-certificate-data child)
                                        :start (nitro-certificate-tbs-start child)
                                        :end (nitro-certificate-tbs-end child))
                    (nitro-certificate-r child) (nitro-certificate-s child)
                    (nitro-certificate-x parent) (nitro-certificate-y parent))
              do (nitro-invalid))
      (aref path ca-count))))

(defun nitro-verify-parsed (attestation timestamp root)
  (let* ((leaf (nitro-validate-chain attestation timestamp root))
         (signature (nitro-attestation-signature attestation)))
    (unless (clempo.p384:p384-verify
             (clempo.sha2:sha384 (nitro-sig-structure attestation))
             (octets->integer signature :end 48) (octets->integer signature :start 48)
             (nitro-certificate-x leaf) (nitro-certificate-y leaf))
      (nitro-invalid))
    attestation))

(defun verify-attestation-with-root (document timestamp root)
  "Gas-metered Nitro verification: NIL for invalid proofs; gas failures propagate."
  (when (> (length document) 24576) (return-from verify-attestation-with-root nil))
  (deduct-gas 40000)
  (handler-case
      (let ((parsed (parse-nitro-attestation document)))
        (deduct-gas (* 150000 (1+ (length (nitro-attestation-cabundle parsed)))))
        (nitro-verify-parsed parsed timestamp root))
    (nitro-validation-error () nil)))
