(in-package #:clempo.validator-config-v2)

;;; ValidatorConfigV2: append-only history with an active-index backpointer.
;;; ABI validators are lists: public key, address, ingress, egress, fee recipient,
;;; index, added height, deactivated height. Storage records additionally hold active-idx.

(defstorable config
  (owner address) (is-init bool) (init-at-height u64)
  (migration-skipped-count u8) (v1-validator-count u8))

(defstorable validator-record
  (public-key b256) (validator-address address) (ingress string) (egress string)
  (fee-recipient address) (index u64) (active-idx u64)
  (added-at-height u64) (deactivated-at-height u64))

(defcontract validator-config-v2 (:address +validator-config-v2-address+ :prefix "STORE")
  (config config)
  (validators (vec validator-record))
  (address-to-index (mapping address u64))
  (pubkey-to-index (mapping b256 u64))
  (next-network-identity-rotation-epoch u64)
  (active-ingress-ips (mapping b256 bool))
  (active-indices (vec u64)))

(deferror already-initialized "AlreadyInitialized()")
(deferror ingress-already-exists "IngressAlreadyExists(string ingress)")
(deferror empty-v1-validator-set "EmptyV1ValidatorSet()")
(deferror invalid-migration-index "InvalidMigrationIndex()")
(deferror invalid-ip "InvalidIp(string input,string reason)")
(deferror invalid-owner "InvalidOwner()")
(deferror invalid-public-key "InvalidPublicKey()")
(deferror invalid-signature "InvalidSignature()")
(deferror invalid-signature-format "InvalidSignatureFormat()")
(deferror invalid-validator-address "InvalidValidatorAddress()")
(deferror migration-not-complete "MigrationNotComplete()")
(deferror not-initialized "NotInitialized()")
(deferror not-ip "NotIp(string input,string backtrace)")
(deferror not-ip-port "NotIpPort(string input,string backtrace)")
(deferror public-key-already-exists "PublicKeyAlreadyExists()")
(deferror unauthorized "Unauthorized()")
(deferror address-already-has-validator "AddressAlreadyHasValidator()")
(deferror validator-already-deactivated "ValidatorAlreadyDeactivated()")
(deferror validator-not-found "ValidatorNotFound()")

(defevent validator-added "ValidatorAdded(uint64 indexed index,address indexed validatorAddress,bytes32 publicKey,string ingress,string egress,address feeRecipient)")
(defevent validator-deactivated "ValidatorDeactivated(uint64 indexed index,address indexed validatorAddress)")
(defevent validator-rotated "ValidatorRotated(uint64 indexed index,uint64 indexed deactivatedIndex,address indexed validatorAddress,bytes32 oldPublicKey,bytes32 newPublicKey,string ingress,string egress,address caller)")
(defevent fee-recipient-updated "FeeRecipientUpdated(uint64 indexed index,address feeRecipient,address caller)")
(defevent ip-addresses-updated "IpAddressesUpdated(uint64 indexed index,string ingress,string egress,address caller)")
(defevent validator-ownership-transferred "ValidatorOwnershipTransferred(uint64 indexed index,address indexed oldAddress,address indexed newAddress,address caller)")
(defevent ownership-transferred "OwnershipTransferred(address indexed oldOwner,address indexed newOwner)")
(defevent validator-migrated "ValidatorMigrated(uint64 indexed index,address indexed validatorAddress,bytes32 publicKey)")
(defevent network-identity-rotation-epoch-set "NetworkIdentityRotationEpochSet(uint64 indexed previousEpoch,uint64 indexed nextEpoch)")
(defevent initialized "Initialized(uint64 height)")
(defevent skipped-validator-migration "SkippedValidatorMigration(uint64 indexed index,address indexed validatorAddress,bytes32 publicKey)")

(defun config-place () (store-config +validator-config-v2-address+))
(defun validators-place () (store-validators +validator-config-v2-address+))
(defun active-indices-place () (store-active-indices +validator-config-v2-address+))
(defun record-place (index) (vec-element (validators-place) index))

(defun require-init (config)
  (unless (config-is-init config) (revert 'not-initialized))
  config)

(defun require-owner (config sender)
  (unless (= (config-owner config) sender) (revert 'unauthorized))
  config)

(defun require-owner-or-validator (config sender validator)
  (unless (or (= sender validator) (= sender (config-owner config)))
    (revert 'unauthorized))
  config)

(defun initialize (owner)
  "Initialize V2 directly at genesis, including its precompile account code."
  (set-code +validator-config-v2-address+ (octets-of #xef))
  (write (config-place) (make-config :owner owner :is-init t :init-at-height (block-number)))
  (values))

(defun owner ()
  "Return the V2 registry owner under the bound storage context."
  (read (field (config-place) 'owner)))

(defun get-initialized-at-height ()
  "Return the migration/direct-initialization height (zero before initialization)."
  (read (field (config-place) 'init-at-height)))

(defun is-initialized ()
  "Whether consensus should use V2 rather than the V1 validator registry."
  (read (field (config-place) 'is-init)))

(defun validator-count ()
  "Return the total records, including deactivated validators and rotation snapshots."
  (vec-length (validators-place)))

(defun get-active-validator (index)
  (when (>= index (validator-count)) (revert 'validator-not-found))
  (let ((v (read (record-place index))))
    (unless (zerop (validator-record-deactivated-at-height v))
      (revert 'validator-already-deactivated))
    v))

(defun read-validator-at (index)
  (let ((v (read (record-place index))))
    (list (validator-record-public-key v) (validator-record-validator-address v)
          (validator-record-ingress v) (validator-record-egress v)
          (validator-record-fee-recipient v) (validator-record-index v)
          (validator-record-added-at-height v) (validator-record-deactivated-at-height v))))

(defun validator-by-index (index)
  "Return the ABI validator tuple at INDEX; revert ValidatorNotFound out of bounds."
  (when (>= index (validator-count)) (revert 'validator-not-found))
  (read-validator-at index))

(defun validator-by-address (address)
  "Return the current ABI validator tuple for ADDRESS, including a deactivated entry."
  (let ((idx1 (read (store-address-to-index +validator-config-v2-address+ address))))
    (when (zerop idx1) (revert 'validator-not-found))
    (read-validator-at (1- idx1))))

(defun validator-by-public-key (public-key)
  "Return the ABI validator tuple for PUBLIC-KEY; rotated keys resolve to snapshots."
  (let ((idx1 (read (store-pubkey-to-index +validator-config-v2-address+ public-key))))
    (when (zerop idx1) (revert 'validator-not-found))
    (read-validator-at (1- idx1))))

(defun get-active-validators ()
  "Return active ABI validator tuples; swap-and-pop order is deliberately unstable."
  (loop for i below (vec-length (active-indices-place))
        for idx1 = (read (vec-element (active-indices-place) i))
        collect (read-validator-at (1- idx1))))

(defun get-next-network-identity-rotation-epoch ()
  "Return the epoch in which a fresh network-identity DKG ceremony is requested."
  (read (store-next-network-identity-rotation-epoch +validator-config-v2-address+)))

(defun require-unique-ingress (ingress)
  (let ((hash (ingress-key ingress)))
    (when (read (store-active-ingress-ips +validator-config-v2-address+ hash))
      (revert 'ingress-already-exists ingress))
    hash))

(defun update-ingress-ip-tracking (old-ingress new-ingress)
  (let ((old-hash (ingress-key old-ingress)) (new-hash (ingress-key new-ingress)))
    (unless (= old-hash new-hash)
      (when (read (store-active-ingress-ips +validator-config-v2-address+ new-hash))
        (revert 'ingress-already-exists new-ingress))
      (delete (store-active-ingress-ips +validator-config-v2-address+ old-hash))
      (write (store-active-ingress-ips +validator-config-v2-address+ new-hash) t))))

(defun append-validator (address public-key ingress egress fee-recipient added deactivated)
  (let ((count (validator-count)) (active-idx 0))
    (when (zerop deactivated)
      (vec-push (active-indices-place) (1+ count))
      (setf active-idx (vec-length (active-indices-place))))
    (vec-push (validators-place)
              (make-validator-record :public-key public-key :validator-address address
                                     :ingress ingress :egress egress :fee-recipient fee-recipient
                                     :index count :active-idx active-idx
                                     :added-at-height added :deactivated-at-height deactivated))
    (write (store-pubkey-to-index +validator-config-v2-address+ public-key) (1+ count))
    (write (store-address-to-index +validator-config-v2-address+ address) (1+ count))
    count))

(defun require-new-address (address)
  (when (zerop address) (revert 'invalid-validator-address))
  (let ((idx1 (read (store-address-to-index +validator-config-v2-address+ address))))
    (when (and (plusp idx1)
               (zerop (read (field (record-place (1- idx1)) 'deactivated-at-height))))
      (revert 'address-already-has-validator))))

(defun require-new-pubkey (public-key)
  (when (zerop public-key) (revert 'invalid-public-key))
  (unless (zerop (read (store-pubkey-to-index +validator-config-v2-address+ public-key)))
    (revert 'public-key-already-exists)))

(defun add-validator (sender address public-key ingress egress fee-recipient signature)
  "Add an owner-authorized, Ed25519 signature-gated active validator; return its index."
  (require-owner (require-init (read (config-place))) sender)
  (require-new-pubkey public-key)
  (require-new-address address)
  (validate-endpoints ingress egress)
  (let ((ingress-hash (require-unique-ingress ingress)))
    (verify-validator-signature :add public-key signature address ingress egress fee-recipient)
    (write (store-active-ingress-ips +validator-config-v2-address+ ingress-hash) t)
    (let ((index (append-validator address public-key ingress egress fee-recipient (block-number) 0)))
      (emit +validator-config-v2-address+ 'validator-added index address public-key ingress egress fee-recipient)
      index)))

(defun deactivate-validator (sender index)
  "Deactivate INDEX, free its ingress endpoint and remove its active-index backpointer."
  (let ((v (get-active-validator index)))
    (require-owner-or-validator (read (config-place)) sender (validator-record-validator-address v))
    (delete (store-active-ingress-ips +validator-config-v2-address+ (ingress-key (validator-record-ingress v))))
    (write (field (record-place index) 'deactivated-at-height) (block-number))
    (let ((active-index (1- (validator-record-active-idx v)))
          (last-pos (1- (vec-length (active-indices-place)))))
      (unless (= active-index last-pos)
        (let ((moved (read (vec-element (active-indices-place) last-pos))))
          (write (vec-element (active-indices-place) active-index) moved)
          (write (field (record-place (1- moved)) 'active-idx) (1+ active-index))))
      (vec-pop (active-indices-place))
      (write (field (record-place index) 'active-idx) 0))
    (emit +validator-config-v2-address+ 'validator-deactivated index (validator-record-validator-address v)))
  (values))

(defun transfer-ownership (sender new-owner)
  "Transfer the initialized registry to a nonzero NEW-OWNER."
  (when (zerop new-owner) (revert 'invalid-owner))
  (let* ((config (require-owner (require-init (read (config-place))) sender))
         (old-owner (config-owner config)))
    (setf (config-owner config) new-owner)
    (write (config-place) config)
    (emit +validator-config-v2-address+ 'ownership-transferred old-owner new-owner))
  (values))

(defun set-network-identity-rotation-epoch (sender epoch)
  "Request a fresh network-identity DKG in EPOCH (owner only)."
  (require-owner (require-init (read (config-place))) sender)
  (let* ((place (store-next-network-identity-rotation-epoch +validator-config-v2-address+))
         (previous (read place)))
    (write place epoch)
    (emit +validator-config-v2-address+ 'network-identity-rotation-epoch-set previous epoch))
  (values))

(defun rotate-validator (sender index public-key ingress egress signature)
  "Snapshot the old identity and replace INDEX in place, preserving its active position."
  (let ((v (get-active-validator index)))
    (require-owner-or-validator (require-init (read (config-place))) sender
                                (validator-record-validator-address v))
    (require-new-pubkey public-key)
    (validate-endpoints ingress egress)
    (require-unique-ingress ingress)
    (verify-validator-signature :rotate public-key signature (validator-record-validator-address v) ingress egress)
    (let ((height (block-number)))
      (update-ingress-ip-tracking (validator-record-ingress v) ingress)
      (let ((appended-index (vec-length (validators-place))))
        (vec-push (validators-place)
                  (make-validator-record :public-key (validator-record-public-key v)
                                         :validator-address (validator-record-validator-address v)
                                         :ingress (validator-record-ingress v) :egress (validator-record-egress v)
                                         :fee-recipient (validator-record-fee-recipient v) :index appended-index
                                         :active-idx 0 :added-at-height (validator-record-added-at-height v)
                                         :deactivated-at-height height))
        (write (store-pubkey-to-index +validator-config-v2-address+ (validator-record-public-key v)) (1+ appended-index))
        (let ((updated (read (record-place index))))
          (setf (validator-record-public-key updated) public-key
                (validator-record-ingress updated) ingress (validator-record-egress updated) egress
                (validator-record-added-at-height updated) height)
          (write (record-place index) updated))
        (write (store-pubkey-to-index +validator-config-v2-address+ public-key) (1+ index))
        (emit +validator-config-v2-address+ 'validator-rotated index appended-index
              (validator-record-validator-address v) (validator-record-public-key v) public-key ingress egress sender))))
  (values))

(defun set-fee-recipient (sender index fee-recipient)
  "Update INDEX's fee recipient, authorized by its validator address or the owner."
  (let ((v (get-active-validator index)))
    (require-owner-or-validator (require-init (read (config-place))) sender (validator-record-validator-address v))
    (setf (validator-record-fee-recipient v) fee-recipient)
    (write (record-place index) v)
    (emit +validator-config-v2-address+ 'fee-recipient-updated index fee-recipient sender))
  (values))

(defun set-ip-addresses (sender index ingress egress)
  "Update INDEX's endpoints after parsing and enforcing active-ingress uniqueness."
  (let ((v (get-active-validator index)))
    (require-owner-or-validator (require-init (read (config-place))) sender (validator-record-validator-address v))
    (validate-endpoints ingress egress)
    (update-ingress-ip-tracking (validator-record-ingress v) ingress)
    (setf (validator-record-ingress v) ingress (validator-record-egress v) egress)
    (write (record-place index) v)
    (emit +validator-config-v2-address+ 'ip-addresses-updated index ingress egress sender))
  (values))

(defun transfer-validator-ownership (sender index new-address)
  "Move INDEX's address lookup to NEW-ADDRESS; retain its public key and active position."
  (let ((v (get-active-validator index)))
    (require-owner-or-validator (require-init (read (config-place))) sender (validator-record-validator-address v))
    (require-new-address new-address)
    (let ((old-address (validator-record-validator-address v)))
      (setf (validator-record-validator-address v) new-address)
      (write (record-place index) v)
      (delete (store-address-to-index +validator-config-v2-address+ old-address))
      (write (store-address-to-index +validator-config-v2-address+ new-address) (1+ index))
      (emit +validator-config-v2-address+ 'validator-ownership-transferred index old-address new-address sender)))
  (values))

(defun require-migration-owner (sender)
  (let ((config (read (config-place))))
    (when (config-is-init config) (revert 'already-initialized))
    (when (zerop (config-owner config))
      (setf (config-owner config) (clempo.validator-config:owner))
      (let ((count (clempo.validator-config:validator-count)))
        (when (zerop count) (revert 'empty-v1-validator-set))
        (setf (config-v1-validator-count config) (ldb (byte 8 0) count)))
      (write (config-place)
             (make-config :owner (config-owner config) :v1-validator-count (config-v1-validator-count config))))
    (require-owner config sender)))

(defun migrate-validator (sender index)
  "Migrate V1 INDEX in reverse order; skip invalid keys, egresses and duplicate identities."
  (let* ((config (require-migration-owner sender))
         (height (block-number))
         (count (config-v1-validator-count config))
         (migrated (validator-count))
         (skipped (config-migration-skipped-count config))
         (processed (+ migrated skipped)))
    (when (or (>= processed count) (/= index (- count processed 1))) (revert 'invalid-migration-index))
    (destructuring-bind (public-key active old-index address ingress outbound)
        (clempo.validator-config:validators (clempo.validator-config:validators-array index))
      (declare (ignore old-index))
      (flet ((skip ()
               (emit +validator-config-v2-address+ 'skipped-validator-migration index address public-key)
               (write (field (config-place) 'migration-skipped-count) (min 255 (1+ skipped)))
               (return-from migrate-validator (values))))
        (unless (valid-validator-public-key-p public-key) (skip))
        (let ((outbound-parsed (parse-ip-port outbound)))
          (unless outbound-parsed (skip))
          (unless (zerop (read (store-pubkey-to-index +validator-config-v2-address+ public-key))) (skip))
          (let ((idx1 (read (store-address-to-index +validator-config-v2-address+ address))))
            (when (and (plusp idx1)
                       (zerop (read (field (record-place (1- idx1)) 'deactivated-at-height))))
              (revert 'address-already-has-validator)))
          (let ((hash (ingress-key ingress)))
            (when (and active (read (store-active-ingress-ips +validator-config-v2-address+ hash))) (skip))
            (let ((new-index (append-validator address public-key ingress (ip-port-ip-string outbound-parsed)
                                               0 height (if active 0 height))))
              (when active (write (store-active-ingress-ips +validator-config-v2-address+ hash) t))
              (emit +validator-config-v2-address+ 'validator-migrated new-index address public-key)))))))
  (values))

(defun initialize-if-migrated (sender)
  "Finalize migration and copy V1's requested DKG epoch; unlock V2 mutations."
  (let ((config (require-migration-owner sender)))
    (when (or (zerop (config-v1-validator-count config))
              (< (+ (validator-count) (config-migration-skipped-count config)) (config-v1-validator-count config)))
      (revert 'migration-not-complete))
    (write (store-next-network-identity-rotation-epoch +validator-config-v2-address+)
           (clempo.validator-config:get-next-full-dkg-ceremony))
    (let ((height (block-number)))
      (setf (config-init-at-height config) height (config-is-init config) t)
      (write (config-place) config)
      (emit +validator-config-v2-address+ 'initialized height)))
  (values))

(defcall validator-config-v2 owner* () (:sol "owner()" :returns "address") (owner))
(defcall validator-config-v2 active* ()
    (:sol "getActiveValidators()" :returns "(bytes32,address,string,string,address,uint64,uint64,uint64)[]")
  (get-active-validators))
(defcall validator-config-v2 initialized-height* () (:sol "getInitializedAtHeight()" :returns "uint64") (get-initialized-at-height))
(defcall validator-config-v2 count* () (:sol "validatorCount()" :returns "uint64") (validator-count))
(defcall validator-config-v2 by-index* (index)
    (:sol "validatorByIndex(uint64)" :returns "(bytes32,address,string,string,address,uint64,uint64,uint64)")
  (validator-by-index index))
(defcall validator-config-v2 by-address* (address)
    (:sol "validatorByAddress(address)" :returns "(bytes32,address,string,string,address,uint64,uint64,uint64)")
  (validator-by-address address))
(defcall validator-config-v2 by-key* (public-key)
    (:sol "validatorByPublicKey(bytes32)" :returns "(bytes32,address,string,string,address,uint64,uint64,uint64)")
  (validator-by-public-key public-key))
(defcall validator-config-v2 next-epoch* () (:sol "getNextNetworkIdentityRotationEpoch()" :returns "uint64")
  (get-next-network-identity-rotation-epoch))
(defcall validator-config-v2 initialized* () (:sol "isInitialized()" :returns "bool") (is-initialized))
(defcall validator-config-v2 add* (address public-key ingress egress fee-recipient signature)
    (:sol "addValidator(address,bytes32,string,string,address,bytes)" :returns "uint64" :mutates t)
  (add-validator sender address public-key ingress egress fee-recipient signature))
(defcall validator-config-v2 deactivate* (index) (:sol "deactivateValidator(uint64)" :mutates t)
  (deactivate-validator sender index))
(defcall validator-config-v2 rotate* (index public-key ingress egress signature)
    (:sol "rotateValidator(uint64,bytes32,string,string,bytes)" :mutates t)
  (rotate-validator sender index public-key ingress egress signature))
(defcall validator-config-v2 fee* (index recipient) (:sol "setFeeRecipient(uint64,address)" :mutates t)
  (set-fee-recipient sender index recipient))
(defcall validator-config-v2 ip* (index ingress egress) (:sol "setIpAddresses(uint64,string,string)" :mutates t)
  (set-ip-addresses sender index ingress egress))
(defcall validator-config-v2 validator-owner* (index address) (:sol "transferValidatorOwnership(uint64,address)" :mutates t)
  (transfer-validator-ownership sender index address))
(defcall validator-config-v2 owner-transfer* (owner) (:sol "transferOwnership(address)" :mutates t)
  (transfer-ownership sender owner))
(defcall validator-config-v2 epoch* (epoch) (:sol "setNetworkIdentityRotationEpoch(uint64)" :mutates t)
  (set-network-identity-rotation-epoch sender epoch))
(defcall validator-config-v2 migrate* (index) (:sol "migrateValidator(uint64)" :mutates t :until :t15)
  (migrate-validator sender index))
(defcall validator-config-v2 finish-migration* () (:sol "initializeIfMigrated()" :mutates t :until :t15)
  (initialize-if-migrated sender))

(defdispatch validator-config-v2 (self input sender)
  (charge-input-cost input)
  (fork-if (:before :t2) (make-octets 0) (dispatch-calls)))

(register-precompile +validator-config-v2-address+ 'validator-config-v2 :genesis)
