(in-package #:clempo.zone-factory)

;;; TIP-1091. Layout and operation ordering: crates/precompiles/src/zone_factory.
;;; Runtime provenance: portal.rs::ZONE_PORTAL_PROXY_RUNTIME (ERC-1167, 45 bytes),
;;; delegating to the protocol-managed 0x5ad1 implementation. No compiler regeneration.
(define-constant +portal-runtime+
  (hex->octets "363d3d373d3d3d363d735ad10000000000000000000000000000000000005af43d82803e903d91602b57fd5bf3"))

(defstorable zone-info-storage
  (zone-id u32) (portal address) (access-mode bool) (gateway-mode bool)
  (admin address) (sequencers (vec address)) (threshold u8) (verifier address)
  (rpc-url string))
(defcontract zone-factory (:address +zone-factory-address+ :prefix "factory")
  (next-zone-id u32) (owner address) (zones (mapping u32 zone-info-storage)))

(defstorable portal-token-config (enabled bool) (deposits-active bool))
(defstorable portal-encryption-key (x b256) (y-parity u8) (activation-block u64))
(defstorable portal-deposit-bucket (hash b256) (cumulative-weight u64))
(defstorable portal-withdrawal-queue (head u256) (tail u256) (slots (mapping u256 b256)))
(defcontract zone-portal (:prefix "portal")
  (admin address) (zone-gas-rate u128) (withdrawal-batch-index u64)
  (block-hash b256) (current-deposit-queue-hash b256)
  (deposit-count u64) (last-processed-deposit-number u64)
  (last-synced-tempo-block-number u64) (bounceback-gas u64)
  (encryption-keys (vec portal-encryption-key))
  (token-configs (mapping address portal-token-config)) (enabled-tokens (vec address))
  (refunds (mapping address (mapping address u128)))
  (withdrawal-queue portal-withdrawal-queue) (rpc-url string) (pending-admin address)
  (withdrawal-reentrancy-status u256) (zone-id u32) (messenger address)
  (verifier address) (initialized bool) (sequencer-set-version u64) (sequencer-threshold u8)
  (zone-height u256) (sequencers (vec address)) (reserved-slot-19 u256 :reserved t)
  (role (mapping address u8)) (is-access-enforced bool) (is-gateway-enforced bool)
  (reserved b30 :reserved t) (max-tempo-gas-rate u128)
  (leader address) (leader-epoch u64) (leader-activation-tempo-block u64)
  (deposit-count-block u64) (deposits-in-current-block u64) (token-enable-count-block u64)
  (tokens-enabled-in-current-block u64) (pause-expiry u64) (token-enablement-hash b256)
  (abdication-effective-at (mapping u8 u64))
  (last-processed-enabled-token-count u64) (token-enablement-cursor-initialized bool :since :t13)
  (transfers-enabled bool) (deposit-buckets (vec portal-deposit-bucket))
  (deposit-weight u64) (settled-deposit-weight u64) (deposit-price-block u64)
  (deposit-price-tier u64) (deposit-bucket-base u64) (next-deposit-bucket-to-prune u64))

(deferror invalid-token "InvalidToken()")
(deferror token-transfer-policy-not-set "TokenTransferPolicyNotSet()")
(deferror invalid-closed-loop-config "InvalidClosedLoopConfig()")
(deferror not-owner "NotOwner()")
(deferror invalid-admin "InvalidAdmin()")
(deferror invalid-sequencer-set "InvalidSequencerSet()")
(deferror already-initialized "AlreadyInitialized()")
(deferror token-metadata-too-long "TokenMetadataTooLong()")
(defevent ownership-transferred "OwnershipTransferred(address indexed previousOwner,address indexed newOwner)")
(defevent zone-created "ZoneCreated(uint32 indexed zoneId,address indexed portal,address initialToken,bool accessMode,bool gatewayMode,address admin,address[] sequencers,uint8 threshold,address verifier)")
(defevent enforcement-modes-updated "EnforcementModesUpdated(bool accessMode,bool gatewayMode)")
(defevent sequencer-set-updated "SequencerSetUpdated(uint64 indexed nonce,uint8 threshold,address[] sequencers)")
(defevent leader-updated "LeaderUpdated(address indexed previousLeader,address indexed newLeader,uint64 indexed epoch,uint64 activationTempoBlock)")
(defevent role-updated "RoleUpdated(address indexed account,uint8 prev,uint8 next)")
(defevent token-enabled "TokenEnabled(address indexed token,string name,string symbol,string currency)")

(defun owner () (read (factory-owner +zone-factory-address+)))
(defun next-zone-id () (read (factory-next-zone-id +zone-factory-address+)))
(defun portal-address (zone-id) (logior #x5ad0000000000000000000000000000000000000 zone-id))
(defun transfer-ownership (sender new-owner)
  (let ((previous (owner)))
    (unless (= sender previous) (revert 'not-owner))
    (write (factory-owner +zone-factory-address+) new-owner)
    (emit +zone-factory-address+ 'ownership-transferred previous new-owner))
  (values))
(defun zone (id)
  (let ((info (read (factory-zones +zone-factory-address+ id))))
    (list (zone-info-storage-zone-id info) (zone-info-storage-portal info)
          (zone-info-storage-access-mode info) (zone-info-storage-gateway-mode info)
          (zone-info-storage-admin info) (zone-info-storage-sequencers info)
          (zone-info-storage-threshold info) (zone-info-storage-verifier info)
          (zone-info-storage-rpc-url info))))
(defun is-zone-portal (address)
  (and (= (ash address -64) #x5ad000000000000000000000)
       (< (ldb (byte 64 0) address) (next-zone-id))))

(defun validate-closed-loop (accounts gateways sequencers)
  (when (member +zone-messenger-address+ accounts) (revert 'invalid-closed-loop-config))
  (fork-if (:since :t11)
      (when (has-duplicates-metered (append accounts gateways sequencers))
        (revert 'invalid-closed-loop-config))
      (when (or (some (lambda (a) (member a accounts)) gateways)
                (some (lambda (s) (or (member s accounts) (member s gateways))) sequencers))
        (revert 'invalid-closed-loop-config))))
(defun validate-sequencers (sequencers threshold)
  (unless (and (<= 1 (length sequencers) 8) (<= 1 threshold (length sequencers)))
    (revert 'invalid-sequencer-set))
  (loop for (sequencer . rest) on sequencers
        when (or (zerop sequencer) (member sequencer rest))
          do (revert 'invalid-sequencer-set)))

(defun initialize-portal (portal id token access-mode gateway-mode accounts gateways admin
                          sequencers threshold rpc-url enablement-hash)
  (when (read (portal-initialized portal)) (revert 'already-initialized))
  (set-code portal +portal-runtime+)
  (write (portal-admin portal) admin)
  (write (portal-token-configs portal token)
         (make-portal-token-config :enabled t :deposits-active t))
  (write (portal-enabled-tokens portal) (list token))
  (write (portal-rpc-url portal) rpc-url)
  (write (portal-zone-id portal) id)
  (write (portal-messenger portal) +zone-messenger-address+)
  (write (portal-verifier portal) +zone-verifier-address+)
  (write (portal-initialized portal) t)
  (write (portal-sequencer-threshold portal) threshold)
  (write (portal-sequencers portal) sequencers)
  (dolist (sequencer sequencers) (write (portal-role portal sequencer) 1))
  (write (portal-is-access-enforced portal) access-mode)
  (write (portal-is-gateway-enforced portal) gateway-mode)
  (write (portal-leader portal) (first sequencers))
  (write (portal-leader-epoch portal) 1)
  (let ((creation-block (block-number)))
    (write (portal-leader-activation-tempo-block portal) creation-block)
    (write (portal-token-enable-count-block portal) creation-block))
  (write (portal-tokens-enabled-in-current-block portal) 1)
  (write (portal-token-enablement-hash portal) enablement-hash)
  (fork-if (:since :t13) (write (portal-token-enablement-cursor-initialized portal) t))
  (dolist (gateway gateways) (write (portal-role portal gateway) 3))
  (dolist (account accounts) (write (portal-role portal account) 2)))

(defun create-zone (sender params)
  (deduct-gas 15000000)
  (unless (= sender (owner)) (revert 'not-owner))
  (destructuring-bind (token access-mode gateway-mode accounts gateways admin sequencers threshold rpc-url)
      params
    (unless (clempo.tip20-factory:tip20-p token) (revert 'invalid-token))
    (unless (clempo.tip403:registered-token-transfer-policy-id token)
      (revert 'token-transfer-policy-not-set))
    (validate-closed-loop accounts gateways sequencers)
    (when (zerop admin) (revert 'invalid-admin))
    (validate-sequencers sequencers threshold)
    (let* ((id (next-zone-id)) (portal (portal-address id))
           (name (clempo.tip20:name token)) (symbol (clempo.tip20:symbol token))
           (currency (clempo.tip20:currency token)))
      (when (some (lambda (s) (> (length (clempo.abi:utf8-encode s)) 31))
                  (list name symbol currency))
        (revert 'token-metadata-too-long))
      (let ((enablement-hash
              (clempo.keccak:keccak256-integer
               (clempo.abi:abi-encode '((:bytes-n 32) :address :string :string :string)
                                      (list 0 token name symbol currency)))))
        (write (factory-next-zone-id +zone-factory-address+) (checked+ id 1 32))
        (initialize-portal portal id token access-mode gateway-mode accounts gateways admin
                           sequencers threshold rpc-url enablement-hash))
      (write (factory-zones +zone-factory-address+ id)
             (make-zone-info-storage :zone-id id :portal portal :access-mode access-mode
              :gateway-mode gateway-mode :admin admin :sequencers sequencers :threshold threshold
              :verifier +zone-verifier-address+ :rpc-url rpc-url))
      (emit portal 'enforcement-modes-updated access-mode gateway-mode)
      (emit portal 'sequencer-set-updated 0 threshold sequencers)
      (emit portal 'leader-updated 0 (first sequencers) 1 (block-number))
      (let ((roles (make-hash-table)))
        (dolist (gateway gateways)
          (emit portal 'role-updated gateway (gethash gateway roles 0) 3)
          (setf (gethash gateway roles) 3))
        (dolist (account accounts)
          (emit portal 'role-updated account (gethash account roles 0) 2)
          (setf (gethash account roles) 2)))
      (emit portal 'token-enabled token name symbol currency)
      (emit +zone-factory-address+ 'zone-created id portal token access-mode gateway-mode admin
            sequencers threshold +zone-verifier-address+)
      (values id portal))))

(defcall zone-factory owner* () (:sol "owner()" :returns "address") (owner))
(defcall zone-factory next-zone-id* () (:sol "nextZoneId()" :returns "uint32") (next-zone-id))
(defcall zone-factory zones* (id)
    (:sol "zones(uint32)" :returns "(uint32,address,bool,bool,address,address[],uint8,address,string)")
  (zone id))
(defcall zone-factory is-zone-portal* (portal)
    (:sol "isZonePortal(address)" :returns "bool") (is-zone-portal portal))
(defcall zone-factory transfer-ownership* (new-owner)
    (:sol "transferOwnership(address)" :mutates t) (transfer-ownership sender new-owner))
(defcall zone-factory create-zone* (params)
    (:sol "createZone((address,bool,bool,address[],address[],address,address[],uint8,string))"
     :returns ("uint32" "address") :mutates t)
  (create-zone sender params))
(defdispatch zone-factory (self input sender)
  (charge-input-cost input)
  (dispatch-calls))
(register-precompile +zone-factory-address+ 'zone-factory :t10)
