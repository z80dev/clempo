(in-package #:clempo.zone-verifier)

;;; Nitro's bounded CBOR profile (crates/nitro-attestation/src/cbor.rs).
;;; These are validation errors, not EVM reverts. Gas exceptions must escape unchanged.
(define-condition nitro-validation-error (error) ())

(defun nitro-invalid () (error 'nitro-validation-error))

(defstruct (nitro-reader (:constructor nitro-reader (data &optional (pos 0) (end (length data)))))
  (data (make-octets 0) :type octets)
  (pos 0 :type fixnum)
  (end 0 :type fixnum))

(defun nitro-byte (reader)
  (when (>= (nitro-reader-pos reader) (nitro-reader-end reader)) (nitro-invalid))
  (prog1 (aref (nitro-reader-data reader) (nitro-reader-pos reader))
    (incf (nitro-reader-pos reader))))

(defun nitro-peek (reader)
  (when (< (nitro-reader-pos reader) (nitro-reader-end reader))
    (aref (nitro-reader-data reader) (nitro-reader-pos reader))))

(defun nitro-finished (reader)
  (unless (= (nitro-reader-pos reader) (nitro-reader-end reader)) (nitro-invalid)))

(defun nitro-take (reader count)
  (let ((start (nitro-reader-pos reader)))
    (unless (<= 0 count (- (nitro-reader-end reader) start)) (nitro-invalid))
    (incf (nitro-reader-pos reader) count)
    (subseq (nitro-reader-data reader) start (+ start count))))

(defun nitro-cbor-head (reader major &optional indefinite)
  (let* ((head (nitro-byte reader)) (extra (logand head 31)))
    (unless (= (ash head -5) major) (nitro-invalid))
    (cond ((< extra 24) extra)
          ((<= 24 extra 27)
           (loop repeat (ash 1 (- extra 24))
                 for value = (nitro-byte reader) then (+ (ash value 8) (nitro-byte reader))
                 finally (return value)))
          ((and indefinite (= extra 31)) nil)
          (t (nitro-invalid)))))

(defun nitro-cbor-bytes (reader &optional (minimum 0) (maximum 24576))
  (let ((count (nitro-cbor-head reader 2)))
    (unless (<= minimum count maximum) (nitro-invalid))
    (nitro-take reader count)))

(defun nitro-cbor-text (reader)
  (let* ((count (nitro-cbor-head reader 3))
         (start (nitro-reader-pos reader))
         (end (+ start count)))
    (unless (and (<= end (nitro-reader-end reader))
                 (clempo.abi:utf8-valid-p (nitro-reader-data reader) :start start :end end))
      (nitro-invalid))
    (setf (nitro-reader-pos reader) end)
    (clempo.abi:utf8-decode (nitro-reader-data reader) :start start :end end)))

(defun nitro-cbor-more-p (reader count index)
  (if count
      (< index count)
      (if (eql (nitro-peek reader) #xff)
          (progn (nitro-byte reader) nil)
          t)))

(defun nitro-cbor-optional-bytes (reader minimum maximum)
  (if (eql (nitro-peek reader) #xf6)
      (progn (nitro-byte reader) (make-octets 0))
      (nitro-cbor-bytes reader minimum maximum)))

(defstruct nitro-attestation
  module-id timestamp pcrs certificate cabundle public-key user-data nonce protected payload signature)

(defun nitro-parse-pcr-map (reader)
  (let ((count (nitro-cbor-head reader 5 t))
        (pcrs (make-array 32 :initial-element nil)))
    (when (and count (not (<= 1 count 32))) (nitro-invalid))
    (loop for i from 0 while (nitro-cbor-more-p reader count i)
          do (when (>= i 32) (nitro-invalid))
             (let ((index (nitro-cbor-head reader 0)))
               (unless (and (< index 32) (null (aref pcrs index))) (nitro-invalid))
               (let ((value (nitro-cbor-bytes reader 32 64)))
                 (unless (member (length value) '(32 48 64)) (nitro-invalid))
                 (setf (aref pcrs index) value)))
          finally (when (zerop i) (nitro-invalid)))
    pcrs))

(defun nitro-parse-cabundle (reader)
  (let ((count (nitro-cbor-head reader 4 t)) (certs nil))
    (when (and count (not (<= 1 count 32))) (nitro-invalid))
    (loop for i from 0 while (nitro-cbor-more-p reader count i)
          do (when (>= i 32) (nitro-invalid))
             (push (nitro-cbor-bytes reader 1 1024) certs))
    (unless certs (nitro-invalid))
    (nreverse certs)))

(defun nitro-parse-payload (payload protected signature)
  (let* ((reader (nitro-reader payload))
         (count (nitro-cbor-head reader 5 t))
         (seen 0)
         (attestation (make-nitro-attestation
                       :protected protected :payload payload :signature signature
                       :public-key (make-octets 0) :user-data (make-octets 0) :nonce (make-octets 0))))
    (when (and count (> count 9)) (nitro-invalid))
    (loop for i from 0 while (nitro-cbor-more-p reader count i)
          do (let* ((name (nitro-cbor-text reader))
                    (index (position name '#("module_id" "digest" "timestamp" "pcrs" "certificate"
                                             "cabundle" "public_key" "user_data" "nonce") :test #'string=)))
               (unless (and index (not (logbitp index seen))) (nitro-invalid))
               (setf seen (logior seen (ash 1 index)))
               (case index
               (0 (let ((module (nitro-cbor-text reader)))
                    (when (zerop (length module)) (nitro-invalid))
                    (setf (nitro-attestation-module-id attestation) module)))
               (1 (unless (string= (nitro-cbor-text reader) "SHA384") (nitro-invalid)))
               (2 (let ((timestamp (nitro-cbor-head reader 0)))
                    (when (zerop timestamp) (nitro-invalid))
                    (setf (nitro-attestation-timestamp attestation) timestamp)))
               (3 (setf (nitro-attestation-pcrs attestation) (nitro-parse-pcr-map reader)))
               (4 (setf (nitro-attestation-certificate attestation) (nitro-cbor-bytes reader 1 1024)))
               (5 (setf (nitro-attestation-cabundle attestation) (nitro-parse-cabundle reader)))
               (6 (setf (nitro-attestation-public-key attestation)
                        (nitro-cbor-optional-bytes reader 1 1024)))
               (7 (setf (nitro-attestation-user-data attestation)
                        (nitro-cbor-optional-bytes reader 0 512)))
                 (8 (setf (nitro-attestation-nonce attestation)
                          (nitro-cbor-optional-bytes reader 0 512))))))
    (unless (= (logand seen 63) 63) (nitro-invalid))
    (nitro-finished reader)
    attestation))

(defun parse-nitro-attestation (document)
  "Decode a bounded Nitro COSE_Sign1 document, signaling NITRO-VALIDATION-ERROR on invalid input."
  (when (> (length document) 24576) (nitro-invalid))
  (let ((reader (nitro-reader document)))
    (when (and (nitro-peek reader) (= (ash (nitro-peek reader) -5) 6))
      (unless (= (nitro-cbor-head reader 6) 18) (nitro-invalid)))
    (unless (= (nitro-cbor-head reader 4) 4) (nitro-invalid))
    (let* ((protected (nitro-cbor-bytes reader))
           (unprotected (nitro-cbor-head reader 5 t)))
      (if unprotected
          (unless (zerop unprotected) (nitro-invalid))
          (unless (= (nitro-byte reader) #xff) (nitro-invalid)))
      (let ((payload (nitro-cbor-bytes reader 1 16384))
            (signature (nitro-cbor-bytes reader 96 96))
            (headers (nitro-reader protected)))
        (nitro-finished reader)
        (unless (and (= (nitro-cbor-head headers 5) 1)
                     (= (nitro-cbor-head headers 0) 1)
                     (= (nitro-cbor-head headers 1) 34))
          (nitro-invalid))
        (nitro-finished headers)
        (nitro-parse-payload payload protected signature)))))

(defun nitro-cbor-bytes-header-length (count)
  (cond ((< count 24) 1) ((<= count 255) 2) (t 3)))

(defun nitro-put-cbor-bytes (output pos bytes)
  (let ((count (length bytes)))
    (cond ((< count 24) (setf (aref output pos) (+ #x40 count)) (incf pos))
          ((<= count 255)
           (setf (aref output pos) #x58 (aref output (1+ pos)) count) (incf pos 2))
          (t (setf (aref output pos) #x59
                   (aref output (1+ pos)) (ash count -8)
                   (aref output (+ pos 2)) (logand count 255))
             (incf pos 3)))
    (replace output bytes :start1 pos)
    (+ pos count)))

(defun nitro-sig-structure (attestation)
  "Encode [\"Signature1\", protected, h'', payload], retaining the original signed bytes."
  (let* ((protected (nitro-attestation-protected attestation))
         (payload (nitro-attestation-payload attestation))
         (out (make-octets (+ 13 (length protected) (length payload)
                             (nitro-cbor-bytes-header-length (length protected))
                             (nitro-cbor-bytes-header-length (length payload))))))
    (replace out #(#x84 #x6a 83 105 103 110 97 116 117 114 101 49))
    (let ((pos (nitro-put-cbor-bytes out 12 protected)))
      (setf (aref out pos) #x40)
      (nitro-put-cbor-bytes out (1+ pos) payload))
    out))
