(in-package #:clempo.tip20)

;;; Opt-in rewards (crates/precompiles/src/tip20/rewards.rs): a global reward-per-token
;;; accumulator scaled by 1e18 over the opted-in supply. Distribution and opt-in stop at T7;
;;; the per-holder hooks stop at T8.

(defconstant +acc-precision+ (expt 10 18))

(defevent reward-distributed "RewardDistributed(address indexed funder, uint256 amount)")
(defevent reward-recipient-set "RewardRecipientSet(address indexed holder, address indexed recipient)")

(defun global-reward-per-token (token) (read (token-global-reward-per-token token)))
(defun opted-in-supply (token) (read (token-opted-in-supply token)))
(defun user-reward (token account) (read (token-user-reward-info token account)))

(defun accrued (balance delta)
  "balance * delta / ACC_PRECISION, the product checked in U256."
  (checked-div (checked* balance delta) +acc-precision+))

(defun update-rewards (token holder)
  "Accrue HOLDER's rewards to its delegate; returns the delegate (zero when opted out).
A no-op returning zero from T8."
  (fork-if (:since :t8) (return-from update-rewards 0))
  (let* ((info (user-reward token holder))
         (delegate (user-reward-info-reward-recipient info))
         (global (global-reward-per-token token))
         (delta (checked- global (user-reward-info-reward-per-token info))))
    (unless (zerop delta)
      (unless (zerop delegate)
        (let ((reward (accrued (balance-of token holder) delta)))
          (if (= delegate holder)
              (setf (user-reward-info-reward-balance info)
                    (checked+ (user-reward-info-reward-balance info) reward))
              (let ((delegate-info (user-reward token delegate)))
                (setf (user-reward-info-reward-balance delegate-info)
                      (checked+ (user-reward-info-reward-balance delegate-info) reward))
                (write (token-user-reward-info token delegate) delegate-info)))))
      (setf (user-reward-info-reward-per-token info) global)
      (write (token-user-reward-info token holder) info))
    delegate))

(defun handle-rewards-on-transfer (token from to amount)
  (let ((from-delegate (update-rewards token from))
        (to-delegate (update-rewards token to)))
    (cond ((not (zerop from-delegate))
           (when (zerop to-delegate) (adjust-opted-in-supply token (- amount))))
          ((not (zerop to-delegate))
           (adjust-opted-in-supply token amount)))))

(defun handle-rewards-on-mint (token to amount)
  (unless (zerop (update-rewards token to))
    (adjust-opted-in-supply token amount)))

(defun distribute-reward (token sender amount)
  (fork-if (:since :t7) (return-from distribute-reward (values)))
  (check-not-paused token)
  (when (zerop amount) (revert 'invalid-amount))
  (ensure-transfer-authorized token sender token)
  (check-and-update-spending-limit token sender amount)
  (%transfer token sender (recipient-direct token) amount)
  (let ((opted-in (opted-in-supply token)))
    (when (zerop opted-in) (revert 'no-opted-in-supply))
    (let ((delta (checked-div (checked* amount +acc-precision+) opted-in)))
      (write (token-global-reward-per-token token)
             (checked+ (global-reward-per-token token) delta))))
  (emit token 'reward-distributed sender amount)
  (values))

(defun virtual-address-p* (address)
  (= (ldb (byte 80 48) address) #xfdfdfdfdfdfdfdfdfdfd))

(defun set-reward-recipient (token sender recipient)
  (fork-if (:since :t7) (return-from set-reward-recipient (values)))
  (check-not-paused token)
  (when (and (fork-if (:since :t3) t nil) (virtual-address-p* recipient))
    (revert 'invalid-recipient))
  (unless (zerop recipient) (ensure-transfer-authorized token sender recipient))
  (let ((from-delegate (update-rewards token sender))
        (balance (balance-of token sender)))
    (cond ((not (zerop from-delegate))
           (when (zerop recipient) (adjust-opted-in-supply token (- balance))))
          ((not (zerop recipient))
           (adjust-opted-in-supply token balance))))
  (let ((info (user-reward token sender)))
    (setf (user-reward-info-reward-recipient info) recipient)
    (write (token-user-reward-info token sender) info))
  (emit token 'reward-recipient-set sender recipient)
  (values))

(defun claim-rewards (token sender)
  (check-not-paused token)
  (ensure-transfer-authorized token token sender)
  (let* ((reward-recipient (update-rewards token sender))
         (info (user-reward token sender))
         (amount (user-reward-info-reward-balance info))
         (contract-balance (balance-of token token))
         (paid (min amount contract-balance)))
    (setf (user-reward-info-reward-balance info) (- amount paid))
    (write (token-user-reward-info token sender) info)
    (when (plusp paid)
      (write (token-balances token token) (- contract-balance paid))
      (write (token-balances token sender) (checked+ (balance-of token sender) paid))
      (unless (zerop reward-recipient) (adjust-opted-in-supply token paid))
      (emit token 'transfer token sender paid))
    paid))

(defun pending-rewards (token account)
  (let* ((info (user-reward token account))
         (pending (user-reward-info-reward-balance info)))
    (fork-if (:before :t8)
             (when (= (user-reward-info-reward-recipient info) account)
               (let ((balance (balance-of token account)))
                 (when (plusp balance)
                   (let ((delta (checked- (global-reward-per-token token)
                                          (user-reward-info-reward-per-token info))))
                     (when (plusp delta)
                       (setf pending (checked+ pending (accrued balance delta)))))))))
    (when (> pending +u128-max+) (panic +panic-under-overflow+))
    pending))

(defcall tip20-token distribute-reward* ((amount u256))
    (:sol "distributeReward(uint256 amount)" :mutates t)
  (distribute-reward self sender amount))
(defcall tip20-token set-reward-recipient* ((recipient address))
    (:sol "setRewardRecipient(address recipient)" :mutates t)
  (set-reward-recipient self sender recipient))
(defcall tip20-token claim-rewards* () (:sol "claimRewards()" :returns "uint256" :mutates t)
  (claim-rewards self sender))
(defcall tip20-token global-reward-per-token* () (:sol "globalRewardPerToken()" :returns "uint256")
  (global-reward-per-token self))
(defcall tip20-token opted-in-supply* () (:sol "optedInSupply()" :returns "uint128")
  (opted-in-supply self))
(defcall tip20-token user-reward-info* ((account address))
    (:sol "userRewardInfo(address account)" :returns "(address,uint256,uint256)")
  (let ((info (user-reward self account)))
    (list (user-reward-info-reward-recipient info) (user-reward-info-reward-per-token info)
          (user-reward-info-reward-balance info))))
(defcall tip20-token get-pending-rewards ((account address))
    (:sol "getPendingRewards(address account)" :returns "uint128")
  (pending-rewards self account))
