(in-package #:clempo.validator-config-v2)

;;; Rust core::net parsing, without DNS or platform socket APIs. Keep the input
;;; spelling out of these values: signatures cover the original UTF-8 strings.
(defstruct (parsed-validator-ip (:constructor %validator-ip (octets)))
  (octets (make-octets 4) :type octets :read-only t))
(defstruct (parsed-validator-socket (:constructor %validator-socket (ip port scope)))
  (ip (%validator-ip (make-octets 4)) :type parsed-validator-ip :read-only t)
  (port 0 :type (unsigned-byte 16) :read-only t)
  (scope 0 :type (unsigned-byte 32) :read-only t))

(defun %endpoint-number (string start end radix maximum &optional no-leading-zero)
  (when (or (= start end)
            (and no-leading-zero (> (- end start) 1) (char= (char string start) #\0)))
    (return-from %endpoint-number nil))
  (let ((value 0))
    (loop for i from start below end for code = (char-code (char string i))
          for digit = (cond ((<= 48 code 57) (- code 48))
                            ((and (= radix 16) (<= 65 code 70)) (- code 55))
                            ((and (= radix 16) (<= 97 code 102)) (- code 87)))
          do (unless (and digit (< digit radix)) (return-from %endpoint-number nil))
             (setf value (+ (* value radix) digit))
             (when (> value maximum) (return-from %endpoint-number nil)))
    value))

(defun %parse-validator-v4 (string start end)
  (let ((bytes (make-octets 4)) (at start))
    (dotimes (i 4 bytes)
      (let* ((stop (or (position #\. string :start at :end end) end))
             (value (%endpoint-number string at stop 10 255 t)))
        (unless (and value (if (= i 3) (= stop end) (< stop end)))
          (return-from %parse-validator-v4 nil))
        (setf (aref bytes i) value at (1+ stop))))))

(defun %parse-validator-v6 (string start end)
  (let ((words nil) (gap nil) (at start))
    (when (= at end) (return-from %parse-validator-v6 nil))
    (when (char= (char string at) #\:)
      (unless (and (< (1+ at) end) (char= (char string (1+ at)) #\:))
        (return-from %parse-validator-v6 nil))
      (setf gap 0 at (+ at 2)))
    (loop while (< at end) do
      (let ((stop (or (position #\: string :start at :end end) end)))
        (when (= stop at) (return-from %parse-validator-v6 nil))
        (if (position #\. string :start at :end stop)
            (let ((v4 (and (= stop end) (%parse-validator-v4 string at end))))
              (unless v4 (return-from %parse-validator-v6 nil))
              (push (+ (ash (aref v4 0) 8) (aref v4 1)) words)
              (push (+ (ash (aref v4 2) 8) (aref v4 3)) words))
            (let ((word (and (<= (- stop at) 4)
                             (%endpoint-number string at stop 16 65535))))
              (unless word (return-from %parse-validator-v6 nil))
              (push word words)))
        (when (> (length words) 8) (return-from %parse-validator-v6 nil))
        (setf at stop)
        (when (< at end)
          (incf at)
          (cond ((and (< at end) (char= (char string at) #\:))
                 (when gap (return-from %parse-validator-v6 nil))
                 (setf gap (length words))
                 (incf at))
                ((= at end) (return-from %parse-validator-v6 nil))))))
    (let ((count (length words)))
      (unless (if gap (< count 8) (= count 8))
        (return-from %parse-validator-v6 nil))
      (let ((bytes (make-octets 16)) (index 0))
        (loop for word in (nreverse words) for i from 0 do
          (when (eql i gap) (incf index (* 2 (- 8 count))))
          (setf (aref bytes index) (ash word -8)
                (aref bytes (1+ index)) (logand word 255))
          (incf index 2))
        bytes))))

(defun parse-ip-address (string)
  "Parse Rust IpAddr syntax, returning a parsed address or NIL."
  (let ((bytes (if (find #\: string)
                   (%parse-validator-v6 string 0 (length string))
                   (%parse-validator-v4 string 0 (length string)))))
    (when bytes (%validator-ip bytes))))

(defun parse-ip-port (string)
  "Parse Rust SocketAddr syntax, including numeric IPv6 scope IDs."
  (let ((end (length string)))
    (when (zerop end) (return-from parse-ip-port nil))
    (if (char= (char string 0) #\[)
        (let ((close (position #\] string)))
          (when (and close (< (1+ close) end) (char= (char string (1+ close)) #\:))
            (let* ((percent (position #\% string :start 1 :end close))
                   (bytes (%parse-validator-v6 string 1 (or percent close)))
                   (scope (if percent (%endpoint-number string (1+ percent) close 10 #xffffffff) 0))
                   (port (%endpoint-number string (+ close 2) end 10 65535)))
              (when (and bytes scope port) (%validator-socket (%validator-ip bytes) port scope)))))
        (let ((colon (position #\: string)))
          (when colon
            (let ((bytes (%parse-validator-v4 string 0 colon))
                  (port (%endpoint-number string (1+ colon) end 10 65535)))
              (when (and bytes port) (%validator-socket (%validator-ip bytes) port 0))))))))

(defun %mapped-validator-ip-p (ip)
  (let ((bytes (parsed-validator-ip-octets ip)))
    (and (= (length bytes) 16)
         (loop for i below 10 always (zerop (aref bytes i)))
         (= (aref bytes 10) 255) (= (aref bytes 11) 255))))

(defun ip-port-ip-string (parsed)
  "Rust Display spelling of a socket's IP; excludes port and scope."
  (let ((bytes (parsed-validator-ip-octets (parsed-validator-socket-ip parsed))))
    (cond ((= (length bytes) 4)
           (format nil "~D.~D.~D.~D" (aref bytes 0) (aref bytes 1) (aref bytes 2) (aref bytes 3)))
          ((%mapped-validator-ip-p (parsed-validator-socket-ip parsed))
           (format nil "::ffff:~D.~D.~D.~D" (aref bytes 12) (aref bytes 13) (aref bytes 14) (aref bytes 15)))
          (t
           (let ((words (make-array 8)) (best-start 0) (best-length 0) (run-start 0) (run-length 0))
             (dotimes (i 8)
               (setf (aref words i) (+ (ash (aref bytes (* 2 i)) 8) (aref bytes (1+ (* 2 i))))))
             (dotimes (i 8)
               (if (zerop (aref words i))
                   (progn (when (zerop run-length) (setf run-start i))
                          (incf run-length)
                          (when (> run-length best-length)
                            (setf best-start run-start best-length run-length)))
                   (setf run-length 0)))
             (when (< best-length 2) (setf best-length 0))
             (with-output-to-string (out)
               (loop for i from 0 below 8 do
                 (cond ((and (plusp best-length) (= i best-start))
                        (write-string "::" out)
                        (incf i (1- best-length)))
                       (t (when (and (> i 0) (not (and (plusp best-length) (= i (+ best-start best-length)))))
                            (write-char #\: out))
                          (format out "~(~X~)" (aref words i)))))))))))

(defun ingress-key (string)
  "Unmetered Keccak of the Rust socket's binary identity."
  (let ((socket (parse-ip-port string)))
    (unless socket (revert 'not-ip-port string "input was not of the form `<ip>:<port>`"))
    (let* ((bytes (parsed-validator-ip-octets (parsed-validator-socket-ip socket)))
           (key (make-octets (if (= (length bytes) 4) 6 22))))
      (replace key bytes)
      (when (= (length bytes) 16)
        (replace key (integer->octets (parsed-validator-socket-scope socket) 4) :start1 16))
      (replace key (integer->octets (parsed-validator-socket-port socket) 2) :start1 (- (length key) 2))
      (clempo.keccak:keccak256-integer key))))

(defun validate-endpoints (ingress egress)
  "Validate ingress first, then egress, with T14 length/mapped-address rules."
  (labels ((validate (string socket-p)
             (fork-if (:since :t14)
                 (when (> (length (string->octets string)) 255)
                   (revert 'invalid-ip string "IP address exceeds 255 bytes"))
                 nil)
             (let ((parsed (if socket-p (parse-ip-port string) (parse-ip-address string))))
               (unless parsed
                 (if socket-p
                     (revert 'not-ip-port string "input was not of the form `<ip>:<port>`")
                     (revert 'not-ip string "input was not a valid IP address")))
               (fork-if (:since :t14)
                   (when (%mapped-validator-ip-p (if socket-p (parsed-validator-socket-ip parsed) parsed))
                     (revert 'invalid-ip string "IPv4-mapped IPv6 address; use the IPv4 form"))
                   nil)
               parsed)))
    (let ((in (validate ingress t)))
      (values in (validate egress nil)))))

(defun valid-validator-public-key-p (pubkey)
  "Commonware PublicKey::decode: ZIP-215 point decoding, not subgroup validation."
  (clempo.ed25519:ed25519-public-key-valid-p
   (if (integerp pubkey) (integer->octets pubkey 32) pubkey)))

(defun verify-validator-signature (kind pubkey signature validator-address ingress egress
                                   &optional fee-recipient)
  "Verify Commonware's namespace-framed Ed25519 signature; no EVM gas charge."
  (unless (= (length signature) 64) (revert 'invalid-signature-format))
  (let* ((in (string->octets ingress)) (out (string->octets egress))
         (namespace (string->octets
                     (ecase kind
                       (:add "TEMPO_VALIDATOR_CONFIG_V2_ADD_VALIDATOR")
                       (:rotate "TEMPO_VALIDATOR_CONFIG_V2_ROTATE_VALIDATOR"))))
         (hash (clempo.keccak:make-keccak)))
    ;; Pre-T14 oversized valid socket strings panic in Rust's u8 conversion.
    (invariant (<= (length in) 255) "validator ingress length must fit in uint8")
    (invariant (<= (length out) 255) "validator egress length must fit in uint8")
    (dolist (part (list (integer->octets (chain-id) 8)
                       (integer->octets +validator-config-v2-address+ 20)
                       (integer->octets validator-address 20)
                       (octets-of (length in)) in (octets-of (length out)) out))
      (clempo.keccak:keccak-update hash part))
    (when (eq kind :add)
      (clempo.keccak:keccak-update hash (integer->octets fee-recipient 20)))
    (let ((public-key (if (integerp pubkey) (integer->octets pubkey 32) pubkey)))
      (unless (valid-validator-public-key-p public-key) (revert 'invalid-public-key))
      ;; Commonware union_unique prefixes the namespace with its unsigned
      ;; varint length. Both fixed namespaces fit in one byte.
      (unless (clempo.ed25519:ed25519-verify
               public-key
               (octets-concat (octets-of (length namespace)) namespace (clempo.keccak:keccak-final hash))
               signature)
        (revert 'invalid-signature))))
  t)
