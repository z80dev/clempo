(defpackage #:clempo.snappy
  (:use #:cl #:clempo.base)
  (:import-from #:clempo.p2p-wire #:protocol-error)
  (:export #:compress #:decompress))

(in-package #:clempo.snappy)

(declaim (inline little-word))
(defun little-word (data pos bytes)
  (declare (type octets data) (type fixnum pos) (type (integer 1 4) bytes) #.*hot*)
  (let ((word 0))
    (declare (type (unsigned-byte 32) word))
    (dotimes (i bytes word)
      (setf word (logior word (ash (aref data (+ pos i)) (* 8 i)))))))

(defun decompress (data &key (start 0) (end (length data)) (max-size #xffffff))
  "Decode one raw Snappy block. Bound expansion before allocating the output."
  (declare (type octets data) (type fixnum start end max-size) #.*hot*)
  (unless (<= 0 start end (length data)) (protocol-error "invalid Snappy input range"))
  (let ((p start) (size 0))
    (declare (type fixnum p size))
    (loop for shift from 0 to 28 by 7
          do (when (= p end) (protocol-error "short Snappy length"))
             (let ((b (aref data p)))
               (incf p)
               (when (and (= shift 28) (> b 15)) (protocol-error "invalid Snappy length"))
               (setf size (logior size (ash (logand b 127) shift)))
               (when (< b 128) (return))))
    (when (> size max-size) (protocol-error "Snappy output length ~D exceeds limit" size))
    (let ((out (make-octets size)) (q 0))
      (declare (type fixnum q))
      (macrolet ((need (n)
                   `(when (> (+ p ,n) end) (protocol-error "truncated Snappy block")))
                 (need-room (n)
                   `(when (> (+ q ,n) size) (protocol-error "Snappy output overrun"))))
        (loop while (< p end)
              do (let* ((tag (aref data p)) (kind (logand tag 3)) (arg (ash tag -2)))
                   (incf p)
                   (cond
                     ((zerop kind)
                      (let ((n (if (< arg 60)
                                   (1+ arg)
                                   (let ((bytes (- arg 59)))
                                     (need bytes)
                                     (prog1 (1+ (little-word data p bytes)) (incf p bytes))))))
                        (need n)
                        (need-room n)
                        (replace out data :start1 q :start2 p :end2 (+ p n))
                        (incf p n)
                        (incf q n)))
                     (t
                      (let* ((bytes (ash 1 (1- kind)))
                             (n (if (= kind 1) (+ 4 (logand arg 7)) (1+ arg)))
                             (offset (progn (need bytes)
                                            (logior (little-word data p bytes)
                                                    (if (= kind 1) (ash (logand arg 56) 5) 0))))
                             (src (- q offset)))
                        (incf p bytes)
                        (unless (<= 0 src (1- q)) (protocol-error "invalid Snappy copy offset"))
                        (need-room n)
                        (cond ((<= n offset)
                               (replace out out :start1 q :start2 src :end2 (+ src n)))
                              (t
                               ;; The source of an overlapping copy grows as we write.
                               (dotimes (i n)
                                 (setf (aref out (+ q i)) (aref out (+ src i))))))
                        (incf q n)))))))
      (unless (= q size) (protocol-error "short Snappy output: ~D of ~D bytes" q size))
      out)))

(declaim (inline hash-word))
(defun hash-word (word mask)
  (declare (type (unsigned-byte 32) word) (type fixnum mask) #.*hot*)
  (logand mask (ash (ldb (byte 32 0) (* word #x1e35a7bd)) -18)))

(defun compress (data)
  "Encode one raw Snappy block using a bounded single-probe match table."
  (declare (type octets data) #.*hot*)
  (let* ((n (length data))
         (out (make-octets (+ n (floor n 6) 32)))
         (q 0))
    (declare (type fixnum n q))
    (when (> n #xffffffff) (protocol-error "Snappy input too large"))
    (macrolet ((emit (byte) `(progn (setf (aref out q) ,byte) (incf q))))
      (flet ((literal (a b)
               (declare (type fixnum a b))
               (when (< a b)
                 (let ((n-1 (- b a 1)))
                   (if (< n-1 60)
                       (emit (ash n-1 2))
                       (let ((bytes (ceiling (integer-length n-1) 8)))
                         (emit (ash (+ 59 bytes) 2))
                         (dotimes (i bytes) (emit (ldb (byte 8 (* 8 i)) n-1))))))
                 (replace out data :start1 q :start2 a :end2 b)
                 (incf q (- b a))))
             (copy-match (offset length)
               (declare (type fixnum offset length))
               (loop while (plusp length)
                     for n = (if (<= 65 length 67) 60 (min 64 length))
                     do (if (and (< offset 2048) (<= 4 n 11))
                            (progn (emit (logior 1 (ash (- n 4) 2) (ash (ash offset -8) 5)))
                                   (emit (logand offset 255)))
                            (progn (emit (logior 2 (ash (1- n) 2)))
                                   (emit (logand offset 255))
                                   (emit (ash offset -8))))
                        (decf length n))))
        (loop for rest = n then (ash rest -7)
              while (>= rest 128) do (emit (logior 128 (logand rest 127)))
              finally (emit rest))
        (let* ((slots (ash 1 (min 14 (max 4 (integer-length (ash n -1))))))
               (mask (1- slots))
               (table (make-array slots :element-type '(unsigned-byte 32) :initial-element 0))
               (p 0) (pending 0))
          (declare (type fixnum slots mask p pending))
          (loop while (<= (+ p 4) n)
                for word = (little-word data p 4)
                for h = (hash-word word mask)
                for prev = (1- (aref table h))
                do (setf (aref table h) (1+ p))
                   (if (and (>= prev 0) (<= 1 (- p prev) 65535) (= word (little-word data prev 4)))
                       (let ((len 4))
                         (declare (type fixnum len))
                         (loop while (and (< (+ p len) n)
                                          (= (aref data (+ p len)) (aref data (+ prev len))))
                               do (incf len))
                         (literal pending p)
                         (copy-match (- p prev) len)
                         (incf p len)
                         (setf pending p))
                       (incf p)))
          (literal pending n))))
    (subseq out 0 q)))
