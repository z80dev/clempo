(defpackage #:clempo.cw-stream
  (:use #:cl #:clempo.base)
  (:shadow #:listen)
  (:import-from #:clempo.p2p-wire #:read-octets #:write-octets #:protocol-error
                #:secure-equal-p)
  (:export #:dial #:accept #:connection-peer #:send-message #:receive-message
           #:close-connection #:dial-start #:dial-end #:listen-start #:listen-end
           #:transcript-summary #:seal #:open-sealed #:make-session))
(in-package #:clempo.cw-stream)

;; Commonware cryptography/stream 2026.10.1. Versions are agreed out of band;
;; neither SAKE nor CUPS inserts a version negotiation byte on the wire.
(defun bytes (&rest values) (make-array (length values) :element-type 'octet :initial-contents values))
(defun be (value size)
  (let ((out (make-octets size)))
    (dotimes (i size out) (setf (aref out (- size i 1)) (ldb (byte 8 (* i 8)) value)))))
(defun uint (value)
  (let ((out (make-array 0 :element-type 'octet :adjustable t :fill-pointer 0)))
    (loop (vector-push-extend (logior (logand value 127) (if (> value 127) 128 0)) out)
          (setf value (ash value -7)) (when (zerop value) (return)))
    (coerce out '(simple-array (unsigned-byte 8) (*)))))
(defun check-version (version)
  (unless (member version '(0 1)) (protocol-error "Unsupported Commonware version ~S" version)))
(defstruct (transcript (:constructor %transcript (version key data))) version key data)
(defun commit-packet (tr data)
  (let ((length (uint (length data))))
    (when (= (transcript-version tr) 1) (setf length (reverse length)))
    (setf (transcript-data tr) (octets-concat (transcript-data tr) data length)))
  tr)
(defun transcript-summary (tr)
  (if (transcript-key tr)
      (clempo.blake3:blake3-keyed (transcript-key tr) (transcript-data tr))
      (clempo.blake3:blake3 (transcript-data tr))))
(defun branch (tr label &optional (tag 2))
  (commit-packet (%transcript (transcript-version tr) (transcript-summary tr) (bytes tag))
                 (string->octets label)))
(defun initial-transcript (namespace version)
  (check-version version)
  (let ((tr (branch (commit-packet (%transcript version nil (bytes 0)) namespace)
                    (if (zerop version) "_COMMONWARE_CRYPTOGRAPHY_HANDSHAKE"
                        "_COMMONWARE_CRYPTOGRAPHY_SAKE"))))
    (when (= version 1) (commit-packet tr (bytes 1)))
    tr))
(defun signed-summary (tr) (octets-concat (bytes 0) (transcript-summary tr)))
(defun sign-transcript (seed tr) (clempo.ed25519:ed25519-sign seed (signed-summary tr)))
(defun verify-transcript (public tr signature)
  (unless (clempo.ed25519:ed25519-verify public (signed-summary tr) signature)
    (protocol-error "Invalid SAKE signature")))
(defun check-size (data size)
  (unless (= (length data) size) (protocol-error "Invalid SAKE field size")))
(defun valid-time (data now age synchrony)
  (let ((time (octets->integer (subseq data 0 8))))
    (unless (<= (max 0 (- now age)) time (1- (min (1- (ash 1 64)) (+ now synchrony))))
      (protocol-error "SAKE timestamp outside acceptance window"))))
(defun ephemeral (secret)
  (let ((secret (or secret (clempo.io:random-octets 32)))
        (base (make-octets 32)))
    (check-size secret 32) (setf (aref base 0) 9)
    (values secret (clempo.x25519:x25519 secret base))))
(defun shared (tr secret public)
  (let ((value (clempo.x25519:x25519 secret public)))
    (unless (and value (some (lambda (x) (not (zerop x))) value))
      (protocol-error "Noncontributory SAKE ephemeral key"))
    (commit-packet tr value)))
(defstruct handshake transcript secret peer now age synchrony (used nil))
(defun consume-handshake (state)
  (when (handshake-used state) (protocol-error "SAKE state already consumed"))
  (setf (handshake-used state) t))
(defun dial-start (seed peer namespace &key (version 1) (now-ms (clempo.io:now-ms))
                                       (max-age-ms 10000) (synchrony-ms 5000) ephemeral-secret)
  "Return one-use dial state and the unframed 104-byte Syn."
  (check-size seed 32) (check-size peer 32)
  (multiple-value-bind (secret public) (ephemeral ephemeral-secret)
    (let ((tr (initial-transcript namespace version)) (time (be now-ms 8))
          (identity (clempo.ed25519:ed25519-public-key seed)))
      (commit-packet tr time) (commit-packet tr peer)
      (when (= version 1) (commit-packet tr identity))
      (commit-packet tr public)
      (let ((signature (sign-transcript seed tr)))
        (when (zerop version) (commit-packet tr identity))
        (values (make-handshake :transcript tr :secret secret :peer peer :now now-ms
                                :age max-age-ms :synchrony synchrony-ms)
                (octets-concat time public signature))))))
(defun listen-start (seed peer namespace syn &key (version 1) (now-ms (clempo.io:now-ms))
                                                (max-age-ms 10000) (synchrony-ms 5000) ephemeral-secret)
  "Authenticate Syn, returning one-use listener state and the 136-byte SynAck."
  (check-size seed 32) (check-size peer 32) (check-size syn 104)
  (valid-time syn now-ms max-age-ms synchrony-ms)
  (let ((tr (initial-transcript namespace version)))
    (commit-packet tr (subseq syn 0 8))
    (commit-packet tr (clempo.ed25519:ed25519-public-key seed))
    (when (= version 1) (commit-packet tr peer))
    (commit-packet tr (subseq syn 8 40))
    (verify-transcript peer tr (subseq syn 40))
    (when (zerop version) (commit-packet tr peer))
    (multiple-value-bind (secret public) (ephemeral ephemeral-secret)
      (let ((time (be now-ms 8)))
        (commit-packet tr time) (commit-packet tr public)
        (let ((signature (sign-transcript seed tr)))
          (shared tr secret (subseq syn 8 40))
          (values (make-handshake :transcript tr :peer peer)
                  (octets-concat time public signature
                                 (transcript-summary (branch tr "confirmation_l2d")))))))))
(defun dial-end (state synack)
  "Return the unframed Ack and the confirmed secret transcript."
  (consume-handshake state) (check-size synack 136)
  (valid-time synack (handshake-now state) (handshake-age state) (handshake-synchrony state))
  (let ((tr (handshake-transcript state)))
    (commit-packet tr (subseq synack 0 8)) (commit-packet tr (subseq synack 8 40))
    (verify-transcript (handshake-peer state) tr (subseq synack 40 104))
    (shared tr (handshake-secret state) (subseq synack 8 40))
    (unless (secure-equal-p (subseq synack 104) (transcript-summary (branch tr "confirmation_l2d")))
      (protocol-error "Invalid SAKE listener confirmation"))
    (values (transcript-summary (branch tr "confirmation_d2l")) tr)))
(defun listen-end (state ack)
  (consume-handshake state) (check-size ack 32)
  (let ((tr (handshake-transcript state)))
    (unless (secure-equal-p ack (transcript-summary (branch tr "confirmation_d2l")))
      (protocol-error "Invalid SAKE dialer confirmation"))
    tr))

(defstruct cipher key (counter 0) (closed nil))
(defun next-nonce (cipher)
  (when (or (cipher-closed cipher) (>= (cipher-counter cipher) (ash 1 96)))
    (setf (cipher-closed cipher) t) (protocol-error "CUPS cipher closed or exhausted"))
  (prog1 (reverse (be (cipher-counter cipher) 12)) (incf (cipher-counter cipher))))
(defun seal (cipher plaintext)
  (handler-case (clempo.chacha20poly1305:aead-encrypt (cipher-key cipher) (next-nonce cipher) plaintext)
    (error (e) (setf (cipher-closed cipher) t) (error e))))
(defun open-sealed (cipher ciphertext)
  (handler-case
      (or (clempo.chacha20poly1305:aead-decrypt (cipher-key cipher) (next-nonce cipher) ciphertext)
          (protocol-error "Invalid CUPS authentication tag"))
    (error (e) (setf (cipher-closed cipher) t) (error e))))
(defstruct (connection (:constructor %connection)) stream peer sender receiver version max-message-size)
(defun make-session (stream peer transcript dialer-p &key (cups-version 1) (max-message-size (* 16 1024 1024)))
  (check-version cups-version)
  (unless (<= 0 max-message-size (- (ash 1 32) 17)) (protocol-error "Invalid CUPS message bound"))
  (let ((tr transcript))
    (when (= cups-version 1)
      (setf tr (branch tr "_COMMONWARE_STREAM_CUPS")) (commit-packet tr (bytes 1)))
    (let ((l2d (make-cipher :key (transcript-summary (branch tr "cipher_l2d" 3))))
          (d2l (make-cipher :key (transcript-summary (branch tr "cipher_d2l" 3)))))
      (%connection :stream stream :peer peer :sender (if dialer-p d2l l2d)
                   :receiver (if dialer-p l2d d2l) :version cups-version :max-message-size max-message-size))))
(defun send-frame (stream data)
  (write-octets stream (uint (length data))) (write-octets stream data) (finish-output stream))
(defun read-length (stream)
  (loop with value = 0 for shift from 0 below 35 by 7
        for byte = (aref (read-octets stream 1) 0)
        do (when (and (= shift 28) (> byte 15)) (protocol-error "CUPS length overflow"))
           (setf value (logior value (ash (logand byte 127) shift)))
        when (zerop (logand byte 128))
          do (when (and (> shift 0) (zerop byte)) (protocol-error "Noncanonical CUPS length"))
             (return value)
        finally (protocol-error "CUPS length overflow")))
(defun receive-frame (stream size)
  (let ((length (read-length stream)))
    (unless (= length size) (protocol-error "Incorrect SAKE frame size"))
    (read-octets stream length)))
(defun dial (stream seed peer namespace &key (version 1) (cups-version 1)
                                        (now-ms (clempo.io:now-ms)) (max-age-ms 10000)
                                        (synchrony-ms 5000) (max-message-size (* 16 1024 1024)) ephemeral-secret)
  (multiple-value-bind (state syn)
      (dial-start seed peer namespace :version version :now-ms now-ms :max-age-ms max-age-ms
                  :synchrony-ms synchrony-ms :ephemeral-secret ephemeral-secret)
    (send-frame stream (clempo.ed25519:ed25519-public-key seed))
    (send-frame stream syn)
    (multiple-value-bind (ack tr) (dial-end state (receive-frame stream 136))
      (send-frame stream ack)
      (make-session stream peer tr t :cups-version cups-version :max-message-size max-message-size))))
(defun accept (stream seed namespace &key (version 1) (cups-version 1) now-ms
                                         (max-age-ms 10000) (synchrony-ms 5000)
                                         (max-message-size (* 16 1024 1024)) ephemeral-secret (bouncer (constantly t)))
  (let ((peer (receive-frame stream 32)))
    (unless (funcall bouncer peer) (protocol-error "SAKE peer rejected"))
    (let ((syn (receive-frame stream 104)))
      (multiple-value-bind (state synack)
          (listen-start seed peer namespace syn :version version :now-ms (or now-ms (clempo.io:now-ms))
                        :max-age-ms max-age-ms :synchrony-ms synchrony-ms :ephemeral-secret ephemeral-secret)
        (send-frame stream synack)
        (make-session stream peer (listen-end state (receive-frame stream 32)) nil
                      :cups-version cups-version :max-message-size max-message-size)))))
(defun send-message (connection plaintext)
  "Send one bounded plaintext record. A failed write permanently closes this sender."
  (when (> (length plaintext) (connection-max-message-size connection)) (protocol-error "CUPS message too large"))
  (let ((cipher (connection-sender connection)) (stream (connection-stream connection)))
    (handler-case
        (let* ((header (if (zerop (connection-version connection)) (uint (+ 16 (length plaintext)))
                           (seal cipher (be (length plaintext) 4))))
               (body (seal cipher plaintext)))
          (write-octets stream header) (write-octets stream body) (finish-output stream))
      (error (e) (setf (cipher-closed cipher) t) (error e)))))
(defun receive-message (connection)
  "Receive one record; every receive failure permanently closes this receiver."
  (let ((cipher (connection-receiver connection)) (stream (connection-stream connection)))
    (when (cipher-closed cipher) (protocol-error "CUPS receiver closed"))
    (handler-case
        (let ((size (if (zerop (connection-version connection))
                        (- (read-length stream) 16)
                        (octets->integer (open-sealed cipher (read-octets stream 20))))))
          (unless (<= 0 size (connection-max-message-size connection)) (protocol-error "CUPS message too large"))
          (open-sealed cipher (read-octets stream (+ size 16))))
      (error (e) (setf (cipher-closed cipher) t) (error e)))))
(defun close-connection (connection)
  (setf (cipher-closed (connection-sender connection)) t
        (cipher-closed (connection-receiver connection)) t)
  (close (connection-stream connection)))
