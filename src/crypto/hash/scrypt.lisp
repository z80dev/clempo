(defpackage #:clempo.scrypt
  (:use #:cl #:clempo.base)
  (:documentation "PBKDF2-HMAC-SHA256 (RFC 8018) and scrypt (RFC 7914) with Salsa20/8.")
  (:export #:pbkdf2-hmac-sha256 #:scrypt #:salsa20/8))
(in-package #:clempo.scrypt)

(defun pbkdf2-hmac-sha256 (password salt iterations length)
  "RFC 8018 PBKDF2 with HMAC-SHA256; returns LENGTH octets."
  (check-type password octets)
  (check-type salt octets)
  (check-type iterations (integer 1))
  (check-type length (integer 0 #.(* 32 (1- (expt 2 32)))))
  (let ((out (make-octets length)) (counter (make-octets 4)))
    (loop for offset from 0 below length by 32 for block from 1 do
      (setf (aref counter 0) (ldb (byte 8 24) block) (aref counter 1) (ldb (byte 8 16) block)
            (aref counter 2) (ldb (byte 8 8) block) (aref counter 3) (ldb (byte 8 0) block))
      (let* ((u (clempo.sha2:hmac-sha256 password salt counter)) (acc (copy-seq u)))
        (loop repeat (1- iterations) do
          (setf u (clempo.sha2:hmac-sha256 password u))
          (dotimes (i 32) (setf (aref acc i) (logxor (aref acc i) (aref u i)))))
        (replace out acc :start1 offset)))
    out))

(deftype words () '(simple-array (unsigned-byte 32) (*)))

(defmacro define-salsa-core ()
  (let ((x (loop for i below 16 collect (gensym (format nil "X~D-" i)))))
    (flet ((quarter (a b c d)
             (loop for (target left right shift) in (list (list b a d 7) (list c b a 9)
                                                         (list d c b 13) (list a d c 18))
                   collect `(setf ,(nth target x)
                                  (logxor ,(nth target x)
                                          (let ((s (ldb (byte 32 0) (+ ,(nth left x) ,(nth right x)))))
                                            (logior (ldb (byte 32 0) (ash s ,shift))
                                                    (ash s ,(- shift 32)))))))))
      `(defun salsa-core (block offset)
         "Salsa20/8 in place on 16 words of BLOCK starting at OFFSET."
         (declare #.clempo.base:*hot* (type words block) (type fixnum offset))
         (let (,@(loop for v in x for i below 16 collect `(,v (aref block (+ offset ,i)))))
           (declare (type (unsigned-byte 32) ,@x))
           (dotimes (round 4)
             ,@(loop for (a b c d) in '((0 4 8 12) (5 9 13 1) (10 14 2 6) (15 3 7 11)
                                        (0 1 2 3) (5 6 7 4) (10 11 8 9) (15 12 13 14))
                     append (quarter a b c d)))
           ,@(loop for v in x for i below 16 collect
                   `(setf (aref block (+ offset ,i)) (ldb (byte 32 0) (+ (aref block (+ offset ,i)) ,v)))))
         (values)))))
(define-salsa-core)

(defun salsa20/8 (input)
  "Salsa20/8 core of a 64-octet INPUT (RFC 7914 section 3); returns 64 octets."
  (check-type input octets)
  (assert (= (length input) 64))
  (let ((w (make-array 16 :element-type '(unsigned-byte 32))) (out (make-octets 64)))
    (dotimes (i 16) (setf (aref w i) (octets->integer-le input (* 4 i))))
    (salsa-core w 0)
    (dotimes (i 16 out)
      (dotimes (j 4) (setf (aref out (+ (* 4 i) j)) (ldb (byte 8 (* 8 j)) (aref w i)))))))

(defun octets->integer-le (o start)
  (logior (aref o start) (ash (aref o (+ start 1)) 8) (ash (aref o (+ start 2)) 16)
          (ash (aref o (+ start 3)) 24)))

(defun block-mix (x y r)
  "scryptBlockMix of the 32R words of X into Y; X ends up holding the result."
  (declare #.clempo.base:*hot* (type words x y) (type (integer 1 1024) r))
  (let ((tmp (make-array 16 :element-type '(unsigned-byte 32)))
        (blocks (* 2 r)))
    (declare (dynamic-extent tmp))
    (replace tmp x :start2 (* 16 (1- blocks)))
    (dotimes (i blocks)
      (dotimes (k 16) (setf (aref tmp k) (logxor (aref tmp k) (aref x (+ (* 16 i) k)))))
      (salsa-core tmp 0)
      ;; Even outputs first, then odd ones.
      (replace y tmp :start1 (* 16 (+ (ash i -1) (if (oddp i) r 0)))))
    (replace x y)
    (values)))

(defun ro-mix (x n r)
  (declare #.clempo.base:*hot* (type words x) (type (integer 2 #.(expt 2 24)) n)
           (type (integer 1 1024) r))
  (let* ((width (* 32 r))
         (v (make-array (* n width) :element-type '(unsigned-byte 32)))
         (y (make-array width :element-type '(unsigned-byte 32))))
    (declare (type fixnum width))
    (dotimes (i n)
      (replace v x :start1 (* i width))
      (block-mix x y r))
    (dotimes (i n)
      (let ((base (* width (logand (aref x (- width 16)) (1- n)))))
        (declare (type fixnum base))
        (dotimes (k width) (setf (aref x k) (logxor (aref x k) (aref v (+ base k))))))
      (block-mix x y r))
    (values)))

(defun scrypt (password salt n r p length)
  "RFC 7914 scrypt. N is a power of two, at most 2^24."
  (check-type password octets)
  (check-type salt octets)
  (check-type n (integer 2 #.(expt 2 24)))
  (check-type r (integer 1 1024))
  (check-type p (integer 1 16))
  (assert (zerop (logand n (1- n))) () "scrypt N must be a power of two")
  (let* ((width (* 32 r))
         (b (pbkdf2-hmac-sha256 password salt 1 (* p 4 width)))
         (x (make-array width :element-type '(unsigned-byte 32))))
    (dotimes (j p)
      (let ((base (* j 4 width)))
        (dotimes (k width) (setf (aref x k) (octets->integer-le b (+ base (* 4 k)))))
        (ro-mix x n r)
        (dotimes (k width)
          (dotimes (m 4) (setf (aref b (+ base (* 4 k) m)) (ldb (byte 8 (* 8 m)) (aref x k)))))))
    (pbkdf2-hmac-sha256 password b 1 length)))
