(defpackage #:clempo.aes
  (:use #:cl #:clempo.base)
  (:export #:make-aes #:aes-encrypt-block #:make-aes-ctr #:aes-ctr-xor))
(in-package #:clempo.aes)

(declaim (inline xtime))
(defun xtime (x)
  (declare (type (unsigned-byte 8) x))
  (logxor (ldb (byte 8 0) (ash x 1)) (if (logbitp 7 x) #x1b 0)))

(defun gf-mul (x y)
  (loop with result = 0 while (plusp y)
        when (oddp y) do (setf result (logxor result x))
        do (setf y (ash y -1) x (xtime x))
        finally (return result)))

(defun s-box-entry (x)
  (let ((y (if (zerop x) 0
               (loop with r = 1 for exponent = 254 then (ash exponent -1)
                     while (plusp exponent)
                     when (oddp exponent) do (setf r (gf-mul r x))
                     do (setf x (gf-mul x x)) finally (return r)))))
    (logxor #x63 y
            (loop with a = 0 for shift from 1 to 4
                  do (setf a (logxor a (ldb (byte 8 0) (logior (ash y shift) (ash y (- shift 8))))))
                  finally (return a)))))

(defparameter *s-box*
  (let ((table (make-octets 256)))
    (dotimes (i 256 table) (setf (aref table i) (s-box-entry i)))))
(declaim (type octets *s-box*))

(defstruct (aes (:constructor %make-aes (keys rounds)))
  (keys (make-octets 0) :type octets :read-only t)
  (rounds 10 :type (member 10 14) :read-only t))

(defun make-aes (key)
  (check-type key octets)
  (assert (member (length key) '(16 32)))
  (let* ((n (length key)) (rounds (if (= n 16) 10 14))
         (keys (make-octets (* 16 (1+ rounds)))) (rcon 1) (s *s-box*))
    (replace keys key)
    (loop for j from n below (length keys) by 4
          for a = (aref keys (- j 4)) for b = (aref keys (- j 3))
          for c = (aref keys (- j 2)) for d = (aref keys (- j 1))
          do (cond ((zerop (mod j n))
                    (psetf a (logxor rcon (aref s b)) b (aref s c) c (aref s d) d (aref s a))
                    (setf rcon (xtime rcon)))
                   ((and (= n 32) (= (mod j n) 16))
                    (setf a (aref s a) b (aref s b) c (aref s c) d (aref s d))))
             (setf (aref keys j) (logxor a (aref keys (- j n)))
                   (aref keys (+ j 1)) (logxor b (aref keys (+ (- j n) 1)))
                   (aref keys (+ j 2)) (logxor c (aref keys (+ (- j n) 2)))
                   (aref keys (+ j 3)) (logxor d (aref keys (+ (- j n) 3)))))
    (%make-aes keys rounds)))

(defmacro define-block-encryption ()
  (let ((state (loop repeat 16 collect (gensym)))
        (shifted (loop repeat 16 collect (gensym))))
    (labels ((sub-shift ()
               (loop for byte in shifted for i below 16 for row = (mod i 4)
                     collect `(,byte (aref s (the (unsigned-byte 8)
                                                 ,(nth (+ (* 4 (mod (+ (floor i 4) row) 4)) row) state)))))))
      `(defun encrypt-block-into (cipher input output)
         (declare #.clempo.base:*hot* (type aes cipher) (type octets input output))
         (let* ((keys (aes-keys cipher)) (s *s-box*) (end (* (aes-rounds cipher) 16))
                ,@(loop for byte in state for i below 16 collect `(,byte (logxor (aref input ,i) (aref keys ,i)))))
           (declare (type (unsigned-byte 8) ,@state))
           (loop for offset of-type fixnum from 16 below end by 16 do
             (let (,@(sub-shift))
               ,@(loop for i from 0 below 16 by 4 append
                       (let ((a (nth i shifted)) (b (nth (+ i 1) shifted))
                             (c (nth (+ i 2) shifted)) (d (nth (+ i 3) shifted)))
                         `((let ((sum (logxor ,a ,b ,c ,d)))
                             ,@(loop for x in (list a b c d) for y in (list b c d a)
                                     for j from i to (+ i 3)
                                     collect `(setf ,(nth j state)
                                                    (logxor sum ,x (xtime (logxor ,x ,y))
                                                            (aref keys (+ offset ,j)))))))))))
           (let (,@(sub-shift))
             ,@(loop for x in shifted for i below 16
                     collect `(setf (aref output ,i) (logxor ,x (aref keys (+ end ,i)))))))
         output))))
(define-block-encryption)

(defun aes-encrypt-block (cipher block &optional (out (make-octets 16)))
  (check-type cipher aes)
  (check-type block octets)
  (check-type out octets)
  (assert (= (length block) (length out) 16))
  (encrypt-block-into cipher block out))

(defstruct (aes-ctr (:constructor %make-aes-ctr (cipher counter)))
  (cipher nil :type (or null aes) :read-only t)
  (counter (make-octets 16) :type octets :read-only t)
  (keystream (make-octets 16) :type octets :read-only t)
  (used 16 :type (integer 0 16))
  (exhausted nil :type boolean))

(defun make-aes-ctr (cipher initial-counter)
  (check-type cipher aes)
  (check-type initial-counter octets)
  (assert (= (length initial-counter) 16))
  (%make-aes-ctr cipher (copy-seq initial-counter)))

(defun aes-ctr-xor (ctx data &key (start 0) (end (length data)) out (out-start 0))
  "XOR DATA's slice with this context's next bytes, preserving partial blocks."
  (check-type ctx aes-ctr)
  (check-type data octets)
  (assert (<= 0 start end (length data)))
  (let ((out (or out (make-octets (+ out-start (- end start)))))
        (key (aes-ctr-keystream ctx)) (ctr (aes-ctr-counter ctx)) (cipher (aes-ctr-cipher ctx)))
    (check-type out octets)
    (assert (<= 0 out-start (+ out-start (- end start)) (length out)))
    (assert (or (not (eq out data)) (<= out-start start) (>= out-start end)))
    (loop for source from start below end for dest from out-start do
      (when (= (aes-ctr-used ctx) 16)
        (assert (not (aes-ctr-exhausted ctx)))
        (encrypt-block-into cipher ctr key)
        (setf (aes-ctr-used ctx) 0)
        (unless (loop for j from 15 downto 0
                      for next = (ldb (byte 8 0) (1+ (aref ctr j)))
                      do (setf (aref ctr j) next)
                      when (plusp next) return t)
          (setf (aes-ctr-exhausted ctx) t)))
      (setf (aref out dest) (logxor (aref data source) (aref key (aes-ctr-used ctx))))
      (incf (aes-ctr-used ctx)))
    out))
