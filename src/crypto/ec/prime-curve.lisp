(defpackage #:clempo.ec
  (:use #:cl)
  (:export #:define-prime-curve #:invert #:wnaf))
(in-package #:clempo.ec)

(defun invert (value modulus)
  "Multiplicative inverse, or NIL when VALUE is not a unit."
  (declare #.clempo.base:*hot* (type integer value) (type (integer 2 *) modulus))
  (let ((a modulus) (b (mod value modulus)) (x 0) (y 1))
    (loop until (zerop b) do
      (multiple-value-bind (q r) (floor a b)
        (psetf a b b r x y y (- x (* q y)))))
    (when (= a 1) (mod x modulus))))

(defun wnaf (scalar width)
  "Signed odd digits, least significant first. SCALAR may be negative."
  (declare #.clempo.base:*hot* (type integer scalar) (type (integer 2 8) width))
  (let* ((sign (if (minusp scalar) -1 1))
         (k (abs scalar))
         (digits (make-array (1+ (integer-length k)) :element-type '(signed-byte 16)
                             :initial-element 0))
         (half (ash 1 (1- width)))
         (mask (1- (ash 1 width)))
         (i 0))
    (declare (type fixnum sign half mask i))
    (loop until (zerop k) do
      (when (oddp k)
        (let* ((low (logand k mask))
               (d (if (>= low half) (- low (1+ mask)) low)))
          (declare (type fixnum low d))
          (setf (aref digits i) (* sign d) k (- k d))))
      (setf k (ash k -1))
      (incf i))
    (values digits i)))

(defmacro define-prime-curve (name &key p a b n gx gy reduction multiply addition subtraction scaling)
  "Generate specialised Jacobian arithmetic for y^2=x^3+a*x+b.
Only the affine table boundary inverts; the hot multiplication loop returns
coordinates as multiple values and creates no point objects."
  (let* ((package (symbol-package name))
         (prefix (symbol-name name))
         (sym (lambda (suffix) (intern (concatenate 'string prefix suffix) package)))
         (fp (funcall sym "-F")) (add (funcall sym "-F+"))
         (sub (funcall sym "-F-")) (mul (funcall sym "-F*"))
         (scale (funcall sym "-SCALE"))
         (dbl (funcall sym "-DOUBLE")) (mix (funcall sym "-ADD-MIXED"))
         (jadd (funcall sym "-ADD-PROJECTIVE"))
         (affine (funcall sym "-AFFINE")) (on-curve (funcall sym "-POINT-P"))
         (table (funcall sym "-TABLE")) (joint (funcall sym "-JOINT"))
         (scalar-mul (funcall sym "-MUL")) (generator (funcall sym "-GENERATOR")))
    `(progn
       (declaim (inline ,fp ,add ,sub ,mul ,scale))
       (defun ,fp (x)
         (declare #.clempo.base:*hot* (type integer x))
         ,(if reduction `(,reduction x) `(mod x ,p)))
       (defun ,add (x y)
         (declare #.clempo.base:*hot* (type (integer 0 ,(1- p)) x y))
         ,(if addition `(,addition x y) `(let ((z (+ x y))) (if (>= z ,p) (- z ,p) z))))
       (defun ,sub (x y)
         (declare #.clempo.base:*hot* (type (integer 0 ,(1- p)) x y))
         ,(if subtraction `(,subtraction x y) `(let ((z (- x y))) (if (minusp z) (+ z ,p) z))))
       (defun ,mul (x y)
         (declare #.clempo.base:*hot* (type (integer 0 ,(1- p)) x y))
         ,(if multiply `(,multiply x y) `(,fp (* x y))))
       (defun ,scale (x k)
         (declare #.clempo.base:*hot* (type (integer 0 ,(1- p)) x) (type (integer 0 8) k))
         ,(if scaling `(,scaling x k) `(,fp (* x k))))
       (defun ,on-curve (x y)
         (and (typep x '(integer 0 ,(1- p))) (typep y '(integer 0 ,(1- p)))
              (= (,mul y y) (,fp (+ (* x x x) (* ,a x) ,b)))))
       (defun ,dbl (x y z)
         (declare #.clempo.base:*hot* (type (integer 0 ,(1- p)) x y z))
         (if (or (zerop z) (zerop y))
             (values 0 1 0)
             (let* ((yy (,mul y y))
                    (s (,scale (,mul x yy) 4))
                    (m ,(cond ((zerop a) `(,scale (,mul x x) 3))
                              ((= a -3) `(let ((zz (,mul z z)))
                                           (,scale (,mul (,sub x zz) (,add x zz)) 3)))
                              (t `(,fp (+ (* 3 (,mul x x)) (* ,a (,mul (,mul z z) (,mul z z))))))))
                    (xx (,sub (,mul m m) (,add s s)))
                    (yyy (,sub (,mul m (,sub s xx)) (,scale (,mul yy yy) 8))))
               (values xx yyy (,mul (,add y y) z)))))
       (defun ,mix (x y z qx qy)
         (declare #.clempo.base:*hot* (type (integer 0 ,(1- p)) x y z qx qy))
         (if (zerop z)
             (values qx qy 1)
             (let* ((zz (,mul z z))
                    (u (,mul qx zz))
                    (v (,mul qy (,mul zz z)))
                    (h (,sub u x))
                    (r (,sub v y)))
               (if (zerop h)
                   (if (zerop r) (,dbl x y z) (values 0 1 0))
                   (let* ((hh (,mul h h))
                          (hhh (,mul h hh))
                          (xh (,mul x hh))
                          (xx (,sub (,sub (,mul r r) hhh) (,add xh xh)))
                          (yyy (,sub (,mul r (,sub xh xx)) (,mul y hhh))))
                     (values xx yyy (,mul z h)))))))
       (defun ,jadd (x y z qx qy qz)
         (declare #.clempo.base:*hot* (type (integer 0 ,(1- p)) x y z qx qy qz))
         (cond ((zerop z) (values qx qy qz))
               ((zerop qz) (values x y z))
               (t
                (let* ((z2 (,mul z z)) (qz2 (,mul qz qz))
                       (u1 (,mul x qz2)) (u2 (,mul qx z2))
                       (s1 (,mul y (,mul qz qz2))) (s2 (,mul qy (,mul z z2)))
                       (h (,sub u2 u1)) (r (,sub s2 s1)))
                  (if (zerop h)
                      (if (zerop r) (,dbl x y z) (values 0 1 0))
                      (let* ((hh (,mul h h)) (hhh (,mul hh h))
                             (v (,mul u1 hh))
                             (xx (,sub (,sub (,mul r r) hhh) (,add v v)))
                             (yyy (,sub (,mul r (,sub v xx)) (,mul s1 hhh))))
                        (values xx yyy (,mul h (,mul z qz)))))))))
       (defun ,affine (x y z)
         (unless (zerop z)
           (let* ((zi (invert z ,p)) (zi2 (,mul zi zi)))
             (values (,mul x zi2) (,mul y (,mul zi2 zi))))))
       (defun ,table (px py &optional (width 5))
         "Odd multiples, batch-normalised with a single field inversion."
         (declare (type (integer 0 ,(1- p)) px py) (type (integer 2 8) width))
         (let* ((size (ash 1 (- width 2)))
                (xs (make-array size)) (ys (make-array size))
                (zs (make-array size)) (products (make-array size))
                (out (make-array size))
                (x px) (y py) (z 1) (product 1))
           (multiple-value-bind (dx dy dz) (,dbl px py 1)
             (dotimes (i size)
               (setf (aref xs i) x (aref ys i) y (aref zs i) z
                     (aref products i) product)
               (unless (zerop z) (setf product (,mul product z)))
               (when (< (1+ i) size)
                 (multiple-value-setq (x y z) (,jadd x y z dx dy dz)))))
           (let ((inverse (invert product ,p)))
             (loop for i downfrom (1- size) to 0 do
               (let ((zi (aref zs i)))
                 (unless (zerop zi)
                   (let* ((iz (,mul inverse (aref products i))) (iz2 (,mul iz iz)))
                     (setf (aref out i) (cons (,mul (aref xs i) iz2)
                                             (,mul (aref ys i) (,mul iz2 iz))))
                     (setf inverse (,mul inverse zi)))))))
           out))
       (defparameter ,generator (,table ,gx ,gy 7))
       (defun ,joint (k1 table1 k2 table2 &optional (width1 5) (width2 5))
         "k1*P+k2*Q, with odd-multiple affine tables."
         (declare #.clempo.base:*hot* (type integer k1 k2)
                  (type simple-vector table1 table2)
                  (type (integer 2 8) width1 width2))
         (multiple-value-bind (d1 l1) (wnaf k1 width1)
           (multiple-value-bind (d2 l2) (wnaf k2 width2)
             (let ((x 0) (y 1) (z 0))
               (loop for i of-type fixnum downfrom (1- (max l1 l2)) to 0 do
                 (multiple-value-setq (x y z) (,dbl x y z))
                 (let ((d (if (< i l1) (aref d1 i) 0)))
                   (declare (type fixnum d))
                   (unless (zerop d)
                     (let ((q (aref table1 (ash (abs d) -1))))
                       (when q
                         (multiple-value-setq (x y z)
                           (,mix x y z (car q) (if (minusp d) (,sub 0 (cdr q)) (cdr q))))))))
                 (let ((d (if (< i l2) (aref d2 i) 0)))
                   (declare (type fixnum d))
                   (unless (zerop d)
                     (let ((q (aref table2 (ash (abs d) -1))))
                       (when q
                         (multiple-value-setq (x y z)
                           (,mix x y z (car q) (if (minusp d) (,sub 0 (cdr q)) (cdr q)))))))))
               (,affine x y z)))))
       (defun ,scalar-mul (k &optional (table ,generator) (width 7))
         (,joint (mod k ,n) table 0 #() width 5)))))
