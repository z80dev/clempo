;;; Prime-field curves and pairings.
(defsystem "clempo-crypto-ec"
  :description "secp256k1, p256, p384, bn254, bls12-381, kzg, modexp"
  :depends-on ("clempo-base" "clempo-crypto-keccak" "clempo-crypto-hash")
  :serial t
  :components ((:file "native-word")
               (:file "modexp")
               (:file "prime-curve")
               (:file "secp256k1-native-field")
               (:file "secp256k1-native-scalar")
               (:file "secp256k1-native-group")
               (:file "secp256k1-native-recovery")
               (:file "secp256k1")
               (:file "p256-field")
               (:file "p256-native")
               (:file "p256")
               (:file "p384-parameters")
               (:file "p384-field")
               (:file "p384-native")
               (:file "p384-cache")
               (:file "p384")
               (:file "bn254")
               (:file "bls12-381")
               (:file "bls12-381-field")
               (:file "bls12-381-tower")
               (:file "bls12-381-group")
               (:file "bls12-381-pairing")
               (:file "bls12-381-hash")
               (:file "bls12-381-signatures")
               (:file "kzg")))

(defsystem "clempo-crypto-ec/tests"
  :depends-on ("clempo-crypto-ec" "clempo-codec")
  :serial t
  :pathname "../../../tests/crypto/ec/"
  :components ((:file "native-word")
               (:file "secp256k1/native-group-tests")
               (:file "prime-curves")
               (:file "secp256k1/native-tests")
               (:file "p256-field")
               (:file "p256/native-tests")
               (:file "p384/p384-tests")
               (:file "p384/field-tests")
               (:file "p384/native-tests")
               (:file "p384/cache-tests")
               (:file "bn254/bn254-tests")
               (:file "bls12-381/field-tests")
               (:file "bls12-381/tower-tests")
               (:file "bls12-381/group-tests")
               (:file "bls12-381/precompile-tests")
               (:file "bls12-381/hash-tests")
               (:file "bls12-381/signature-tests")
               (:file "bls12-381/signature-min-sig-vectors")
               (:file "bls12-381/signature-min-pk-vectors")
               (:file "kzg/kzg-tests")))
