;;; RFC 9380, sections 5, 6.6.2, 8.8 and appendix E.
(in-package #:clempo.bls12-381)


(defun h2c-ascii (text)
  (map '(simple-array (unsigned-byte 8) (*)) #'char-code text))

(defun expand-message-xmd (message dst length)
  "RFC 9380 SHA-256 XMD. MESSAGE and DST are octet vectors; LENGTH is 1..8160."
  (unless (<= 1 length 8160) (error "Invalid XMD output length: ~S" length))
  (when (> (length dst) 255)
    (setf dst (clempo.sha2:sha256
               (concatenate '(vector (unsigned-byte 8))
                            (h2c-ascii "H2C-OVERSIZE-DST-") dst))))
  (let* ((domain (concatenate '(vector (unsigned-byte 8)) dst (vector (length dst))))
         (b0 (clempo.sha2:sha256
               (concatenate '(vector (unsigned-byte 8))
                            (make-array 64 :element-type '(unsigned-byte 8) :initial-element 0)
                            message (vector (ldb (byte 8 8) length) (ldb (byte 8 0) length) 0)
                            domain)))
         (previous (clempo.sha2:sha256
                     (concatenate '(vector (unsigned-byte 8)) b0 #(1) domain)))
         (result (make-array length :element-type '(unsigned-byte 8))))
    (loop for i from 1 to (ceiling length 32)
          for offset from 0 by 32 do
      (when (> i 1)
        (let ((xor (make-array 32 :element-type '(unsigned-byte 8))))
          (dotimes (j 32) (setf (aref xor j) (logxor (aref b0 j) (aref previous j))))
          (setf previous (clempo.sha2:sha256
                          (concatenate '(vector (unsigned-byte 8)) xor (vector i) domain)))))
      (replace result previous :start1 offset :end2 (min 32 (- length offset))))
    result))

(defun h2c-field (message dst count)
  (let ((bytes (expand-message-xmd message dst (* count 64))))
    (loop for start from 0 below (length bytes) by 64 collect
      (mod (loop for i from start below (+ start 64)
                 for n = (aref bytes i) then (+ (ash n 8) (aref bytes i))
                 finally (return n)) +p+))))

