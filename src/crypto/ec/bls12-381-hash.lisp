;;; G2 coefficients expressed using the small rational constants in appendix E.3.
(defparameter *h2c-g2-isogeny*
  (let ((n (fp-inv 9)) (m (fp-inv 27)))
    (flet ((q (a b scale) (cons (mod (* a scale) +p+) (mod (* b scale) +p+))))
      (list (list (q 304 304 n) (q 0 -24 n) (q 12 -12 n) (q 1 0 n))
            (list (cons 0 (mod -72 +p+)) (cons 12 (mod -12 +p+)) '(1 . 0))
            (list (q 752 752 m) (q 0 264 m) (q -18 18 m) (q -1 0 m))
            (list (cons (mod -432 +p+) (mod -432 +p+))
                  (cons 0 (mod -216 +p+)) (cons 18 (mod -18 +p+)) '(1 . 0))))))

(defun h2c-map (u extension)
  ;; Straight-line simplified SWU, with inv0 and the exceptional denominator.
  ;; Field operators are selected once; no search or try-and-increment occurs.
  (let* ((add (if extension #'f2+ (lambda (a b) (mod (+ a b) +p+))))
         (mul (if extension #'f2* (lambda (a b) (mod (* a b) +p+))))
         (neg (if extension #'f2-neg (lambda (a) (mod (- a) +p+))))
         (div (if extension #'f2/ (lambda (a b) (mod (* a (fp-inv b)) +p+))))
         (root (if extension #'f2-sqrt #'fp-sqrt))
         (zero (if extension '(0 . 0) 0))
         (one (if extension '(1 . 0) 1))
         (a (if extension '(0 . 240)
                12190336318893619529228877361869031420615612348429846051986726275283378313155663745811710833465465981901188123677))
         (b (if extension '(1012 . 1012)
                2906670324641927570491258158026293881577086121416628140204402091718288198173574630967936031029026176254968826637280))
         (z (if extension (cons (- +p+ 2) (1- +p+)) 11)))
    (flet ((sgn (v) (if extension
                       (if (zerop (car v)) (logand 1 (cdr v)) (logand 1 (car v)))
                       (logand 1 v))))
      (let* ((t1 (funcall mul z (funcall mul u u)))
             (denom (funcall add (funcall mul t1 t1) t1))
             (x (if (equal denom zero)
                    (funcall div b (funcall mul z a))
                    (funcall mul (funcall neg (funcall div b a))
                             (funcall add one (funcall div one denom)))))
             (gx (funcall add (funcall mul (funcall add (funcall mul x x) a) x) b))
             (y (funcall root gx)))
        (unless y
          (setf x (funcall mul t1 x)
                y (funcall root (funcall add
                                 (funcall mul (funcall add (funcall mul x x) a) x) b))))
        (unless y (error "SWU invariant: no square root"))
        (unless (= (sgn u) (sgn y)) (setf y (funcall neg y)))
        (labels ((poly (coefficients)
                   (reduce (lambda (coefficient accumulated)
                             (funcall add coefficient (funcall mul x accumulated)))
                           coefficients :from-end t :initial-value zero)))
          (destructuring-bind (xn xd yn yd) (if extension *h2c-g2-isogeny* *h2c-g1-isogeny*)
            (let ((dx (poly xd)) (dy (poly yd)))
              (unless (or (equal dx zero) (equal dy zero))
                (cons (funcall div (poly xn) dx)
                      (funcall mul y (funcall div (poly yn) dy)))))))))))

(defun map-fp-to-g1 (u)
  "Map an Fp integer to G1 using SSWU, the 11-isogeny and effective cofactor."
  (g1-mul (h2c-map (mod u +p+) nil) #xd201000000010001))

(defun map-fp2-to-g2 (u)
  "Map (real . imaginary) Fp2 to G2, including effective cofactor clearing."
  (g2-mul (h2c-map (cons (mod (car u) +p+) (mod (cdr u) +p+)) t)
          #xbc69f08f2ee75b3584c6a0ea91b352888e2a8e9145ad7689986ff031508ffe1329c2f178731db956d82bf015d1212b02ec0ec69d7477c1ae954cbc06689f6a359894c0adebbf6b4e8020005aaa95551))

(defun hash-to-g1 (message &key (dst (h2c-ascii "BLS12381G1_XMD:SHA-256_SSWU_RO_")))
  "RFC 9380 random-oracle suite. MESSAGE and DST are octet vectors."
  (let ((u (h2c-field message dst 2)))
    (g1-add (map-fp-to-g1 (first u)) (map-fp-to-g1 (second u)))))

(defun hash-to-g2 (message &key (dst (h2c-ascii "BLS12381G2_XMD:SHA-256_SSWU_RO_")))
  "RFC 9380 random-oracle suite. MESSAGE and DST are octet vectors."
  (let ((u (h2c-field message dst 4)))
    (g2-add (map-fp2-to-g2 (cons (first u) (second u)))
            (map-fp2-to-g2 (cons (third u) (fourth u))))))


(defun map-g1-precompile (input)
  "EIP-2537 padded big-endian Fp input; return (values output valid-p)."
  (handler-case
      (progn
        (expect-length input 64)
        (values (g1-encode (map-fp-to-g1 (decode-fp input 0))) t))
    (invalid-point () (values nil nil))))

(defun map-g2-precompile (input)
  "EIP-2537 real-then-imaginary padded Fp2; return (values output valid-p)."
  (handler-case
      (progn
        (expect-length input 128)
        (values (g2-encode
                 (map-fp2-to-g2 (cons (decode-fp input 0) (decode-fp input 64))))
                t))
    (invalid-point () (values nil nil))))
