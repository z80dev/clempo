;;; Optimal-ate product on the M twist, with allocation-free projective lines.
(in-package #:clempo.bls12-381)

(clempo.base:defbound +miller-loop-bits+ 64
  "Bits of |x| = #xd201000000010000, the Miller loop parameter. The top bit is the
starting point R = Q; the loop runs over the bits below it."
  (= +miller-loop-bits+ (integer-length #xd201000000010000))
  (typep (- +miller-loop-bits+ 2) 'fixnum))

(defun miller-double! (arena r p line lo w wo)
  (declare #.clempo.base:*hot* (type mont-words arena line w) (type fixnum r p lo wo))
  ;; For Jacobian R=(X:Y:Z), scale the affine tangent by 2YZ³:
  ;; (3X³-2Y²) - (3X²Z²*xP)w² + (2YZ³*yP)w³.
  (f2-square! w wo arena r w (+ wo 72))
  (f2-square! w (+ wo 12) arena (+ r 12) w (+ wo 72))
  (f2-square! w (+ wo 24) arena (+ r 24) w (+ wo 72))
  (f2-mul! w (+ wo 36) w wo arena r w (+ wo 72))
  (f2-add! w (+ wo 48) w (+ wo 36) w (+ wo 36))
  (f2-add! w (+ wo 36) w (+ wo 36) w (+ wo 48))
  (f2-add! w (+ wo 48) w (+ wo 12) w (+ wo 12))
  (f2-sub! line lo w (+ wo 36) w (+ wo 48))
  (f2-add! w (+ wo 60) w wo w wo)
  (f2-add! w (+ wo 60) w (+ wo 60) w wo)
  (f2-mul! w (+ wo 60) w (+ wo 60) w (+ wo 24) w (+ wo 72))
  (f2-mul-fp! line (+ lo 12) w (+ wo 60) arena p)
  (f2-neg! line (+ lo 12) line (+ lo 12))
  (f2-mul! w (+ wo 48) arena (+ r 12) arena (+ r 24) w (+ wo 72))
  (f2-mul! w (+ wo 48) w (+ wo 48) w (+ wo 24) w (+ wo 72))
  (f2-add! w (+ wo 48) w (+ wo 48) w (+ wo 48))
  (f2-mul-fp! line (+ lo 24) w (+ wo 48) arena (+ p 6))
  (g2-jdouble! arena r arena r w (+ wo 120)) (values))

(defun miller-add! (arena r q p line lo w wo)
  (declare #.clempo.base:*hot* (type mont-words arena line w) (type fixnum r q p lo wo))
  ;; Q has Z=1. h=qxZ²-X, d=qyZ³-Y. Scale the line by hZ³.
  (f2-square! w wo arena (+ r 24) w (+ wo 72))
  (f2-mul! w (+ wo 12) arena (+ r 24) w wo w (+ wo 72))
  (f2-mul! w (+ wo 24) arena q w wo w (+ wo 72))
  (f2-sub! w (+ wo 24) w (+ wo 24) arena r)
  (f2-mul! w (+ wo 36) arena (+ q 12) w (+ wo 12) w (+ wo 72))
  (f2-sub! w (+ wo 36) w (+ wo 36) arena (+ r 12))
  (when (f2-zero-p w (+ wo 24))
    (when (f2-zero-p w (+ wo 36))
      (miller-double! arena r p line lo w wo)
      (return-from miller-add! (values)))
    ;; A vertical line lies in Fp6 and disappears in the final exponent.
    (f2-one! line lo) (f2-zero! line (+ lo 12)) (f2-zero! line (+ lo 24))
    (g2-jzero! arena r) (return-from miller-add! (values)))
  (f2-mul! w (+ wo 48) w (+ wo 36) arena r w (+ wo 72))
  (f2-mul! w (+ wo 60) w (+ wo 24) arena (+ r 12) w (+ wo 72))
  (f2-sub! line lo w (+ wo 48) w (+ wo 60))
  (f2-mul! w (+ wo 48) w (+ wo 36) w wo w (+ wo 72))
  (f2-mul-fp! line (+ lo 12) w (+ wo 48) arena p)
  (f2-neg! line (+ lo 12) line (+ lo 12))
  (f2-mul! w (+ wo 48) w (+ wo 24) w (+ wo 12) w (+ wo 72))
  (f2-mul-fp! line (+ lo 24) w (+ wo 48) arena (+ p 6))
  (g2-jadd! arena r arena r arena q w (+ wo 120)) (values))

(defun miller-product! (arena f count line work)
  "Validated pair table at word zero, 84 words per pair. No boundary conversions."
  (declare #.clempo.base:*hot* (type mont-words arena) (type fixnum f count line work))
  (f12-one! arena f)
  (loop for bit of-type fixnum downfrom (- +miller-loop-bits+ 2) to 0 do
    (f12-square! arena f arena f arena work)
    (dotimes (i count)
      (let ((base (* i 84)))
        (miller-double! arena (+ base 48) base arena line arena work)
        (f12-mul-line! arena f arena f arena line arena work)))
    (when (logbitp bit #xd201000000010000)
      (dotimes (i count)
        (let ((base (* i 84)))
          (miller-add! arena (+ base 48) (+ base 12) base arena line arena work)
          (f12-mul-line! arena f arena f arena line arena work)))))
  (f12-conjugate! arena f arena f) (values))

(defun pairing-product-p (pairs)
  (let* ((count (count-if (lambda (pair) (and (car pair) (cdr pair))) pairs))
         (end (if (zerop count) (return-from pairing-product-p t) (* count 84)))
         (arena (make-array (+ end 1536) :element-type '(unsigned-byte 64) :initial-element 0))
         (f end) (result (+ end 72)) (one (+ end 144))
         (line (+ end 216)) (work (+ end 252)) (index 0))
    (declare (type fixnum count end f result one line work index) (type mont-words arena))
    (dolist (pair pairs)
      (when (and (car pair) (cdr pair))
        (let ((base (* index 84)))
          (fp-from-integer! arena base (caar pair))
          (fp-from-integer! arena (+ base 6) (cdar pair))
          (g2-jfrom-affine! arena (+ base 12) (cdr pair))
          (g2-jcopy! arena (+ base 48) arena (+ base 12)))
        (incf index)))
    (f12-one! arena one)
    (miller-product! arena f count line work)
    (f12-final! arena result arena f arena work)
    (f12-equal-p arena result arena one)))

(defun pairing-check (input)
  "Product pairing predicate: (values result valid-input-p). Validate each point once."
  (handler-case
      (let ((pairs (if (typep input '(array (unsigned-byte 8) (*)))
                       (progn
                         (when (or (zerop (length input)) (not (zerop (mod (length input) 384))))
                           (invalid))
                         (loop for i from 0 below (length input) by 384
                               collect (cons (g1-decode input :start i :subgroup nil)
                                             (g2-decode input :start (+ i 128) :subgroup nil))))
                       input)))
        (unless (listp pairs) (invalid))
        (dolist (pair pairs)
          (unless (and (consp pair) (g1-valid-p (car pair) t) (g2-valid-p (cdr pair) t))
            (invalid)))
        (values (pairing-product-p pairs) t))
    (invalid-point () (values nil nil))
    (type-error () (values nil nil))))
