;;; Native P-384. All points are Jacobian (X,Y,Z), six words per coordinate.
;;; Exact aliases are allowed; workspace must be disjoint. Tables become affine
;;; by one batch inversion, not a common-Z curve isomorphism (a remains -3).
(in-package #:clempo.p384)

(defun p384-jzero! (a o)
  (declare #.clempo.base:*hot* (type p384-arena a) (type fixnum o))
  (p384-zero! a o) (pf-one! a (+ o 6)) (p384-zero! a (+ o 12)))
(defun p384-jcopy! (a o b bo)
  (declare #.clempo.base:*hot* (type p384-arena a b) (type fixnum o bo))
  (dotimes (i 18) (setf (aref a (+ o i)) (aref b (+ bo i)))) (values))

(defun p384-jdouble! (out o p po work wo)
  "a=-3 doubling; 48 disjoint workspace words."
  (declare #.clempo.base:*hot* (type p384-arena out p work) (type fixnum o po wo))
  (if (or (p384-zero-p p (+ po 12)) (p384-zero-p p (+ po 6)))
      (p384-jzero! out o)
      (let ((yy wo) (s (+ wo 6)) (m (+ wo 12)) (t0 (+ wo 18))
            (x (+ wo 24)) (y (+ wo 30)) (z (+ wo 36)) (t1 (+ wo 42)))
        (declare (type fixnum yy s m t0 x y z t1))
        (pf-square! work yy p (+ po 6))
        (pf-mul! work s p po work yy)
        (pf-add! work s work s work s) (pf-add! work s work s work s)
        (pf-square! work t0 p (+ po 12))
        (pf-sub! work m p po work t0) (pf-add! work t1 p po work t0)
        (pf-mul! work m work m work t1)
        (pf-add! work t0 work m work m) (pf-add! work m work m work t0)
        (pf-square! work x work m)
        (pf-sub! work x work x work s) (pf-sub! work x work x work s)
        (pf-sub! work y work s work x) (pf-mul! work y work y work m)
        (pf-square! work t0 work yy)
        (dotimes (i 3) (pf-add! work t0 work t0 work t0))
        (pf-sub! work y work y work t0)
        (pf-mul! work z p (+ po 6) p (+ po 12)) (pf-add! work z work z work z)
        (p384-copy! out o work x) (p384-copy! out (+ o 6) work y)
        (p384-copy! out (+ o 12) work z)))
  (values))

(defun p384-jadd! (out o p po q qo work wo)
  "General Jacobian addition; 84 disjoint workspace words."
  (declare #.clempo.base:*hot* (type p384-arena out p q work) (type fixnum o po qo wo))
  (cond ((p384-zero-p p (+ po 12)) (p384-jcopy! out o q qo))
        ((p384-zero-p q (+ qo 12)) (p384-jcopy! out o p po))
        (t
         (let ((zz1 wo) (zz2 (+ wo 6)) (u1 (+ wo 12)) (u2 (+ wo 18))
               (s1 (+ wo 24)) (s2 (+ wo 30)) (h (+ wo 36)) (r (+ wo 42))
               (hh (+ wo 48)) (hhh (+ wo 54)) (v (+ wo 60))
               (x (+ wo 66)) (y (+ wo 72)) (z (+ wo 78)))
           (declare (type fixnum zz1 zz2 u1 u2 s1 s2 h r hh hhh v x y z))
           (pf-square! work zz1 p (+ po 12)) (pf-square! work zz2 q (+ qo 12))
           (pf-mul! work u1 p po work zz2) (pf-mul! work u2 q qo work zz1)
           (pf-mul! work s1 work zz2 q (+ qo 12)) (pf-mul! work s1 work s1 p (+ po 6))
           (pf-mul! work s2 work zz1 p (+ po 12)) (pf-mul! work s2 work s2 q (+ qo 6))
           (pf-sub! work h work u2 work u1) (pf-sub! work r work s2 work s1)
           (if (p384-zero-p work h)
               (if (p384-zero-p work r) (p384-jdouble! out o p po work wo) (p384-jzero! out o))
               (progn
                 (pf-square! work hh work h) (pf-mul! work hhh work hh work h)
                 (pf-mul! work v work u1 work hh) (pf-square! work x work r)
                 (pf-sub! work x work x work hhh)
                 (pf-sub! work x work x work v) (pf-sub! work x work x work v)
                 (pf-sub! work y work v work x) (pf-mul! work y work y work r)
                 (pf-mul! work s1 work s1 work hhh) (pf-sub! work y work y work s1)
                 (pf-mul! work z p (+ po 12) q (+ qo 12)) (pf-mul! work z work z work h)
                 (p384-copy! out o work x) (p384-copy! out (+ o 6) work y)
                 (p384-copy! out (+ o 12) work z))))))
  (values))

(defun p384-jadd-affine! (out o p po q qo work wo)
  "Mixed Jacobian/affine addition; Q has Z=1 or 0. Sixty-six scratch words."
  (declare #.clempo.base:*hot* (type p384-arena out p q work)
           (type fixnum o po qo wo))
  (cond ((p384-zero-p q (+ qo 12)) (p384-jcopy! out o p po))
        ((p384-zero-p p (+ po 12)) (p384-jcopy! out o q qo))
        (t
         (let ((zz wo) (u (+ wo 6)) (v (+ wo 12)) (h (+ wo 18))
               (r (+ wo 24)) (hh (+ wo 30)) (hhh (+ wo 36)) (xh (+ wo 42))
               (x (+ wo 48)) (y (+ wo 54)) (z (+ wo 60)))
           (declare (type fixnum zz u v h r hh hhh xh x y z))
           (pf-square! work zz p (+ po 12))
           (pf-mul! work u q qo work zz)
           (pf-mul! work v work zz p (+ po 12))
           (pf-mul! work v work v q (+ qo 6))
           (pf-sub! work h work u p po)
           (pf-sub! work r work v p (+ po 6))
           (if (p384-zero-p work h)
               (if (p384-zero-p work r)
                   (p384-jdouble! out o p po work wo)
                   (p384-jzero! out o))
               (progn
                 (pf-square! work hh work h)
                 (pf-mul! work hhh work h work hh)
                 (pf-mul! work xh p po work hh)
                 (pf-square! work x work r)
                 (pf-sub! work x work x work hhh)
                 (pf-sub! work x work x work xh)
                 (pf-sub! work x work x work xh)
                 (pf-sub! work y work xh work x)
                 (pf-mul! work y work y work r)
                 (pf-mul! work v p (+ po 6) work hhh)
                 (pf-sub! work y work y work v)
                 (pf-mul! work z p (+ po 12) work h)
                 (p384-copy! out o work x)
                 (p384-copy! out (+ o 6) work y)
                 (p384-copy! out (+ o 12) work z))))))
  (values))

(defun p384-odd-table! (table to count q qo work wo)
  "Build affine Q,3Q,... with one inversion. Workspace: 6*count+108 words.
Q must be finite and on this prime-order curve; table and work are disjoint."
  (declare #.clempo.base:*hot* (type p384-arena table q work) (type fixnum to count qo wo))
  (let ((twice (+ wo (* 6 count))) (tmp (+ wo (* 6 count) 18)))
    (declare (type fixnum twice tmp))
    (p384-jcopy! table to q qo)
    (p384-jdouble! work twice q qo work tmp)
    (loop for i of-type fixnum from 1 below count do
      (p384-jadd! table (+ to (* 18 i)) table (+ to (* 18 (1- i))) work twice work tmp))
    (pf-one! work wo)
    (loop for i of-type fixnum from 1 below count do
      (pf-mul! work (+ wo (* 6 i)) work (+ wo (* 6 (1- i))) table (+ to (* 18 (1- i)) 12)))
    (pf-mul! work tmp work (+ wo (* 6 (1- count))) table (+ to (* 18 (1- count)) 12))
    (pf-inv! work twice work tmp work (+ tmp 6))
    (loop for i of-type fixnum downfrom (1- count) to 0
          for p of-type fixnum = (+ to (* 18 i)) do
      (pf-mul! work tmp work twice work (+ wo (* 6 i)))
      (pf-mul! work twice work twice table (+ p 12))
      (pf-square! work (+ tmp 6) work tmp)
      (pf-mul! table p table p work (+ tmp 6))
      (pf-mul! work (+ tmp 6) work (+ tmp 6) work tmp)
      (pf-mul! table (+ p 6) table (+ p 6) work (+ tmp 6))
      (pf-one! table (+ p 12))))
  (values))

;;; These load-time tables are read-only after construction.
(defparameter *p384-constants*
  (let ((a (make-array 30 :element-type '(unsigned-byte 64) :initial-element 0)))
    (pf-from-integer! a 0 +p384-gx+) (pf-from-integer! a 6 +p384-gy+)
    (pf-one! a 12) (pf-from-integer! a 18 +p384-b+)
    (pf-from-integer! a 24 +p384-n+) a))
(defparameter *p384-generator-table*
  (let ((table (make-array (* 18 +p384-generator-count+)
                           :element-type '(unsigned-byte 64) :initial-element 0))
        (work (make-array (+ (* 6 +p384-generator-count+) 108)
                          :element-type '(unsigned-byte 64) :initial-element 0)))
    (p384-odd-table! table 0 +p384-generator-count+ *p384-constants* 0 work 0) table))

(defun p384-affine-on-curve-p (p po work wo)
  (declare #.clempo.base:*hot* (type p384-arena p work) (type fixnum po wo))
  (pf-square! work wo p po) (pf-mul! work wo work wo p po)
  (dotimes (i 3) (pf-sub! work wo work wo p po))
  (pf-add! work wo work wo *p384-constants* 18)
  (pf-square! work (+ wo 6) p (+ po 6))
  (p384-equal-p work wo work (+ wo 6)))

(defun p384-wnaf! (digits scalar so width)
  "Recode ordinary six-word scalar, including bit 384 carry; no boxed shifts."
  (declare #.clempo.base:*hot* (type (simple-array (signed-byte 16) (385)) digits)
           (type p384-arena scalar) (type fixnum so) (type (integer 2 14) width))
  (fill digits 0)
  (let ((pos 0) (carry 0) (length 0))
    (declare (type fixnum pos carry length))
    (loop while (< pos 385) do
      (let ((window carry))
        (declare (type fixnum window))
        (dotimes (j width)
          (let ((bit (+ pos j)))
            (declare (type fixnum bit))
            (when (< bit 384)
              (when (logbitp (logand bit 63) (aref scalar (+ so (ash bit -6))))
                (incf window (ash 1 j))))))
        (if (oddp window)
            (let* ((radix (ash 1 width)) (digit (logand window (1- radix))))
              (declare (type fixnum radix digit))
              (setf carry (if (>= digit (ash radix -1)) 1 0))
              (when (= carry 1) (decf digit radix))
              (setf (aref digits pos) digit length (1+ pos))
              (incf pos width))
            (progn
              ;; Even windows only consume their low bit, retaining its carry.
              (setf carry (if (= (+ (if (and (< pos 384)
                                                            (logbitp (logand pos 63)
                                                                     (aref scalar (+ so (ash pos -6)))))
                                                       1 0) carry) 2) 1 0))
              (incf pos)))))
    length))

(defstruct (p384-scratch (:constructor %make-p384-scratch ()))
  ;; 0 Q; 18 result; 36/42 scalars; 48 r; 54..71 temporaries;
  ;; 72..215 affine Q odd table; 216..371 table/general workspace.
  (arena (make-array 384 :element-type '(unsigned-byte 64) :initial-element 0) :type p384-arena :read-only t)
  (g-digits (make-array 385 :element-type '(signed-byte 16) :initial-element 0)
            :type (simple-array (signed-byte 16) (385)) :read-only t)
  (q-digits (make-array 385 :element-type '(signed-byte 16) :initial-element 0)
            :type (simple-array (signed-byte 16) (385)) :read-only t)
  ;; Optional bounded positive math cache; no implicit global/thread-local cache.
  (cache nil))
(defvar *p384-scratch* nil "Optional private, nonconcurrent, nonreentrant context.")

(defun p384-joint! (scratch)
  "Consume ordinary scalars at 36/42 and affine Q at 0; write Jacobian at 18."
  (declare #.clempo.base:*hot* (type p384-scratch scratch))
  (let* ((a (p384-scratch-arena scratch))
         (gd (p384-scratch-g-digits scratch)) (qd (p384-scratch-q-digits scratch))
         (length (max (p384-wnaf! gd a 36 +p384-generator-width+) (p384-wnaf! qd a 42 5))))
    (declare (type fixnum length))
    (p384-odd-table! a 72 8 a 0 a 216)
    (p384-jzero! a 18)
    (loop for bit of-type fixnum downfrom (1- length) to 0 do
      (p384-jdouble! a 18 a 18 a 216)
      (dotimes (stream 2)
        (let* ((digit (if (zerop stream) (aref gd bit) (aref qd bit)))
               (table (if (zerop stream) *p384-generator-table* a))
               (offset (+ (if (zerop stream) 0 72) (* 18 (ash (abs digit) -1)))))
          (declare (type fixnum digit offset) (type p384-arena table))
          (unless (zerop digit)
            (p384-jcopy! a 54 table offset)
            (when (minusp digit) (pf-neg! a 60 a 60))
            (p384-jadd-affine! a 18 a 18 a 54 a 216))))))
  (values))

(defun p384-projective-r-p (a r)
  "Compare X/Z^2 to r or r+n without an inverse or constructing r+n."
  (declare #.clempo.base:*hot* (type p384-arena a)
           (type (integer 1 #.(1- +p384-n+)) r))
  (and (not (p384-zero-p a 30))
       (progn
         (pf-from-integer! a 48 r) (pf-square! a 54 a 30)
         (pf-mul! a 60 a 48 a 54)
         (or (p384-equal-p a 18 a 60)
             (and (< r #.(- +p384-p+ +p384-n+))
                  (progn (pf-add! a 48 a 48 *p384-constants* 24)
                         (pf-mul! a 60 a 48 a 54)
                         (p384-equal-p a 18 a 60)))))))

(defun p384-valid-native-public-key-p (qx qy scratch)
  (declare #.clempo.base:*hot* (type p384-scratch scratch)
           (type (integer 0 #.(1- +p384-p+)) qx qy))
  (let ((a (p384-scratch-arena scratch)))
    (pf-from-integer! a 0 qx) (pf-from-integer! a 6 qy) (pf-one! a 12)
    (p384-affine-on-curve-p a 0 a 216)))

(defun p384-verify-native (hash48 r s qx qy scratch)
  (declare #.clempo.base:*hot* (type p384-scratch scratch)
           (type (simple-array (unsigned-byte 8) (48)) hash48)
           (type (integer 1 #.(1- +p384-n+)) r s)
           (type (integer 0 #.(1- +p384-p+)) qx qy))
  (when (p384-valid-native-public-key-p qx qy scratch)
    (let ((a (p384-scratch-arena scratch)))
      (ps-from-integer! a 48 s) (ps-inv! a 48 a 48 a 216)
      (ps-from-digest! a 36 hash48) (ps-mul! a 36 a 36 a 48)
      (ps-from-integer! a 42 r) (ps-mul! a 42 a 42 a 48)
      (ps-to-ordinary! a 36 a 36) (ps-to-ordinary! a 42 a 42)
      (p384-joint! scratch)
      (p384-projective-r-p a r))))
