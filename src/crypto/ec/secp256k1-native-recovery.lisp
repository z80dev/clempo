(in-package #:clempo.secp256k1)

(defstruct (recovery-scratch (:constructor %make-recovery-scratch (words digits public digest)))
  (words (error "Missing words") :type secp-words :read-only t)
  (digits (error "Missing digits") :type (simple-array (signed-byte 8) (520)) :read-only t)
  (public (error "Missing pubkey buffer") :type octets :read-only t)
  (digest (error "Missing digest buffer") :type octets :read-only t))
(defun make-recovery-scratch ()
  "Private mutable workspace: bind once per worker, never share concurrently."
  (%make-recovery-scratch
   (make-array 512 :element-type '(unsigned-byte 64) :initial-element 0)
   (make-array 520 :element-type '(signed-byte 8) :initial-element 0)
   (clempo.base:make-octets 64) (clempo.base:make-octets 32)))
(defvar *recovery-scratch* nil
  "Caller-owned recovery workspace, normally dynamically bound once per worker.
NIL requests a fresh context, never a shared global cache.")

(defun valid-recovery-input-p (hash r s recid)
  (and (typep hash 'octets) (= (length hash) 32)
       (integerp r) (< 0 r +secp256k1-n+) (integerp s) (< 0 s +secp256k1-n+)
       (typep recid '(integer 0 3))))
(defun native-joint-affine! (arena digits)
  (declare #.clempo.base:*hot* (type secp-words arena)
           (type (simple-array (signed-byte 8) (520)) digits))
  (let ((length (max (sg-decompose! arena 24 digits 0 130 +sn-generator-window+ 64)
                     (sg-decompose! arena 28 digits 260 390 5 64))))
    (declare (type (integer 0 130) length))
    (sn-joint! arena 40 0 digits length 128)
    (sn-to-affine! arena 0 40 64)))
(defun recover-native! (hash r s recid arena digits)
  "Validated input boundary. Affine output occupies words 0..7 on success."
  (declare #.clempo.base:*hot* (type octets hash) (type secp-words arena)
           (type (simple-array (signed-byte 8) (520)) digits)
           (type (integer 1 #xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364140) r s)
           (type (integer 0 3) recid))
  (sf-from-integer! arena 8 r) (sf-from-integer! arena 12 s)
  (sf-copy! arena 0 arena 8)
  (when (logbitp 1 recid)
    (when (or (= (sw-add! arena 0 arena 0 *sc-order* 0) 1)
              (sw-ge-p arena 0 *sf-prime* 0))
      (return-from recover-native! nil)))
  (sf-square! arena 32 arena 0) (sf-mul! arena 32 arena 32 arena 0)
  (sf-add! arena 32 arena 32 *sf-seven* 0)
  (sf-sqrt! arena 4 arena 32 arena 64)
  (sf-square! arena 36 arena 4)
  (unless (sf-equal-p arena 32 arena 36) (return-from recover-native! nil))
  (unless (= (logand (aref arena 4) 1) (logand recid 1)) (sf-neg! arena 4 arena 4))
  (sw-read32! arena 16 hash 0)
  (when (sw-ge-p arena 16 *sc-order* 0) (sw-sub! arena 16 arena 16 *sc-order* 0))
  (sc-inv! arena 20 arena 8 arena 64)
  (sc-mul! arena 24 arena 16 arena 20 arena 64) (sc-neg! arena 24 arena 24)
  (sc-mul! arena 28 arena 12 arena 20 arena 64)
  (native-joint-affine! arena digits))

(defun write-native-public! (out arena)
  (declare #.clempo.base:*hot* (type octets out) (type secp-words arena))
  (sw-write32! out 0 arena 0) (sw-write32! out 32 arena 4) out)
(defun digest-address (digest)
  "Construct only the returned positive 160-bit integer."
  (declare #.clempo.base:*hot* (type octets digest))
  (let ((out (sb-bignum::%allocate-bignum 3)))
    (setf (sb-bignum::%bignum-ref out 0) (read-word64-be digest 24)
          (sb-bignum::%bignum-ref out 1) (read-word64-be digest 16)
          (sb-bignum::%bignum-ref out 2)
          (logior (ash (aref digest 12) 24) (ash (aref digest 13) 16)
                  (ash (aref digest 14) 8) (aref digest 15)))
    (sb-bignum::%normalize-bignum out 3)))

(defun native-generator-mul (scalar)
  "Affine integer boundary for signing/key generation, not the recovery loop."
  (let* ((context (or *recovery-scratch* (make-recovery-scratch)))
         (arena (recovery-scratch-words context)) (digits (recovery-scratch-digits context)))
    (sf-from-integer! arena 0 +sn-generator-x+) (sf-from-integer! arena 4 +sn-generator-y+)
    (sf-from-integer! arena 24 scalar) (sf-zero! arena 28)
    (when (native-joint-affine! arena digits)
      (values (sf-to-integer arena 0) (sf-to-integer arena 4)))))
