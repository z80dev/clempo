;;; Fp2/Fp6/Fp12 arenas. Offsets count 64-bit words, not bytes.
(in-package #:clempo.bls12-381)
(deftype mont-words () '(simple-array (unsigned-byte 64) (*)))
(defconstant +f6-work-words+ 144)
(defconstant +f12-work-words+ 512)
(defconstant +f12-pow-work-words+ 656)

(clempo.base:defbound +f6-degree+ 3
  "Fp2 coefficients of an Fp6 element: Fp6 = Fp2[v]/(v^3 - xi)."
  ;; DEFINE-EXTENSION-LINEAR F6 36: three Fp2 coefficients of two Fp limb vectors.
  (= (* +f6-degree+ 2 +fp-limbs+) 36)
  ;; F6-MUL!'s three products and its result fit below its Fp2 scratch at word 96.
  (<= (* 2 +f6-degree+ 2 +fp-limbs+) 96))
(clempo.base:defbound +f12-f2-degree+ 6
  "Fp2 coefficients of an Fp12 element: Fp12 = Fp6[w]/(w^2 - v)."
  (= +f12-f2-degree+ (* 2 +f6-degree+))
  ;; DEFINE-EXTENSION-LINEAR F12 72, and the 72-word stride of each Frobenius power.
  (= (* +f12-f2-degree+ 2 +fp-limbs+) 72))

(defmacro define-extension-linear (prefix words)
  (let ((copy (intern (format nil "~A-COPY!" prefix)))
        (zero (intern (format nil "~A-ZERO!" prefix)))
        (one (intern (format nil "~A-ONE!" prefix)))
        (zero-p (intern (format nil "~A-ZERO-P" prefix)))
        (equal-p (intern (format nil "~A-EQUAL-P" prefix)))
        (add (intern (format nil "~A-ADD!" prefix)))
        (sub (intern (format nil "~A-SUB!" prefix)))
        (neg (intern (format nil "~A-NEG!" prefix))))
    `(progn
       (defun ,copy (out o a ao)
         (declare #.clempo.base:*hot* (type mont-words out a) (type fixnum o ao))
         (dotimes (i ,words) (setf (aref out (+ o i)) (aref a (+ ao i)))) (values))
       (defun ,zero (out o)
         (declare #.clempo.base:*hot* (type mont-words out) (type fixnum o))
         (dotimes (i ,words) (setf (aref out (+ o i)) 0)) (values))
       (defun ,one (out o) (,zero out o) (fp-one! out o))
       (defun ,zero-p (a ao)
         (declare #.clempo.base:*hot* (type mont-words a) (type fixnum ao))
         (dotimes (i ,words t) (unless (zerop (aref a (+ ao i))) (return nil))))
       (defun ,equal-p (a ao b bo)
         (declare #.clempo.base:*hot* (type mont-words a b) (type fixnum ao bo))
         (dotimes (i ,words t) (unless (= (aref a (+ ao i)) (aref b (+ bo i))) (return nil))))
       ,@(loop for name in (list add sub) for op in '(fp-add! fp-sub!) collect
           `(defun ,name (out o a ao b bo)
              (declare #.clempo.base:*hot* (type mont-words out a b) (type fixnum o ao bo))
              ,@(loop for i from 0 below words by 6 collect `(,op out (+ o ,i) a (+ ao ,i) b (+ bo ,i)))
              (values)))
       (defun ,neg (out o a ao)
         (declare #.clempo.base:*hot* (type mont-words out a) (type fixnum o ao))
         ,@(loop for i from 0 below words by 6 collect `(fp-neg! out (+ o ,i) a (+ ao ,i)))
         (values)))))
(define-extension-linear f2 12)
(define-extension-linear f6 36)
(define-extension-linear f12 72)

(defun f2-from-integer! (out o pair)
  (fp-from-integer! out o (car pair)) (fp-from-integer! out (+ o 6) (cdr pair)) (values))
(defun f2-to-integer (a ao)
  (cons (fp-to-integer a ao) (fp-to-integer a (+ ao 6))))
(defun f2-mul! (out o a ao b bo w wo)
  (declare #.clempo.base:*hot* (type mont-words out a b w) (type fixnum o ao bo wo))
  (fp-mul! w wo a ao b bo)
  (fp-mul! w (+ wo 6) a (+ ao 6) b (+ bo 6))
  (fp-add! w (+ wo 12) a ao a (+ ao 6))
  (fp-add! w (+ wo 18) b bo b (+ bo 6))
  (fp-mul! w (+ wo 12) w (+ wo 12) w (+ wo 18))
  (fp-sub! w (+ wo 12) w (+ wo 12) w wo)
  (fp-sub! out (+ o 6) w (+ wo 12) w (+ wo 6))
  (fp-sub! out o w wo w (+ wo 6)) (values))
(defun f2-square! (out o a ao w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo))
  (fp-add! w wo a ao a (+ ao 6))
  (fp-sub! w (+ wo 6) a ao a (+ ao 6))
  (fp-mul! w (+ wo 12) a ao a (+ ao 6))
  (fp-mul! out o w wo w (+ wo 6))
  (fp-add! out (+ o 6) w (+ wo 12) w (+ wo 12)) (values))
(defun f2-mul-xi! (out o a ao w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo))
  (fp-add! w wo a ao a (+ ao 6))
  (fp-sub! out o a ao a (+ ao 6))
  (fp-copy! out (+ o 6) w wo) (values))
(defun f2-conjugate! (out o a ao)
  (fp-copy! out o a ao) (fp-neg! out (+ o 6) a (+ ao 6)) (values))
(defun f2-mul-fp! (out o a ao b bo)
  (fp-mul! out o a ao b bo) (fp-mul! out (+ o 6) a (+ ao 6) b bo) (values))
(defun f2-inv! (out o a ao w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo))
  (fp-square! w wo a ao) (fp-square! w (+ wo 6) a (+ ao 6))
  (fp-add! w wo w wo w (+ wo 6))
  (fp-inv! w (+ wo 12) w wo w (+ wo 24))
  (fp-mul! out o a ao w (+ wo 12))
  (fp-mul! out (+ o 6) a (+ ao 6) w (+ wo 12))
  (fp-neg! out (+ o 6) out (+ o 6)) (values))

(defun f6-mul! (out o a ao b bo w wo)
  (declare #.clempo.base:*hot* (type mont-words out a b w) (type fixnum o ao bo wo))
  ;; v0,v1,v2; result; two sums; nested Fp2 scratch. Exact aliases are safe.
  (dotimes (i +f6-degree+) (f2-mul! w (+ wo (* i 12)) a (+ ao (* i 12)) b (+ bo (* i 12)) w (+ wo 96)))
  (f2-add! w (+ wo 72) a (+ ao 12) a (+ ao 24))
  (f2-add! w (+ wo 84) b (+ bo 12) b (+ bo 24))
  (f2-mul! w (+ wo 36) w (+ wo 72) w (+ wo 84) w (+ wo 96))
  (f2-sub! w (+ wo 36) w (+ wo 36) w (+ wo 12))
  (f2-sub! w (+ wo 36) w (+ wo 36) w (+ wo 24))
  (f2-mul-xi! w (+ wo 36) w (+ wo 36) w (+ wo 96))
  (f2-add! w (+ wo 36) w (+ wo 36) w wo)
  (f2-add! w (+ wo 72) a ao a (+ ao 12))
  (f2-add! w (+ wo 84) b bo b (+ bo 12))
  (f2-mul! w (+ wo 48) w (+ wo 72) w (+ wo 84) w (+ wo 96))
  (f2-sub! w (+ wo 48) w (+ wo 48) w wo)
  (f2-sub! w (+ wo 48) w (+ wo 48) w (+ wo 12))
  (f2-mul-xi! w (+ wo 72) w (+ wo 24) w (+ wo 96))
  (f2-add! w (+ wo 48) w (+ wo 48) w (+ wo 72))
  (f2-add! w (+ wo 72) a ao a (+ ao 24))
  (f2-add! w (+ wo 84) b bo b (+ bo 24))
  (f2-mul! w (+ wo 60) w (+ wo 72) w (+ wo 84) w (+ wo 96))
  (f2-sub! w (+ wo 60) w (+ wo 60) w wo)
  (f2-sub! w (+ wo 60) w (+ wo 60) w (+ wo 24))
  (f2-add! w (+ wo 60) w (+ wo 60) w (+ wo 12))
  (f6-copy! out o w (+ wo 36)))
(defun f6-square! (out o a ao w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo))
  ;; s0=a0², s1=2a0a1, s2=(a0-a1+a2)², s3=2a1a2, s4=a2².
  (f2-square! w wo a ao w (+ wo 96))
  (f2-mul! w (+ wo 12) a ao a (+ ao 12) w (+ wo 96))
  (f2-add! w (+ wo 12) w (+ wo 12) w (+ wo 12))
  (f2-sub! w (+ wo 24) a ao a (+ ao 12))
  (f2-add! w (+ wo 24) w (+ wo 24) a (+ ao 24))
  (f2-square! w (+ wo 24) w (+ wo 24) w (+ wo 96))
  (f2-mul! w (+ wo 36) a (+ ao 12) a (+ ao 24) w (+ wo 96))
  (f2-add! w (+ wo 36) w (+ wo 36) w (+ wo 36))
  (f2-square! w (+ wo 48) a (+ ao 24) w (+ wo 96))
  (f2-mul-xi! w (+ wo 60) w (+ wo 36) w (+ wo 96))
  (f2-add! w (+ wo 60) w (+ wo 60) w wo)
  (f2-mul-xi! w (+ wo 72) w (+ wo 48) w (+ wo 96))
  (f2-add! w (+ wo 72) w (+ wo 72) w (+ wo 12))
  (f2-add! w (+ wo 84) w (+ wo 12) w (+ wo 24))
  (f2-add! w (+ wo 84) w (+ wo 84) w (+ wo 36))
  (f2-sub! w (+ wo 84) w (+ wo 84) w wo)
  (f2-sub! w (+ wo 84) w (+ wo 84) w (+ wo 48))
  (f6-copy! out o w (+ wo 60)))
(defun f6-mul-v! (out o a ao w wo)
  (f2-mul-xi! w wo a (+ ao 24) w (+ wo 12))
  (f2-copy! out (+ o 24) a (+ ao 12))
  (f2-copy! out (+ o 12) a ao) (f2-copy! out o w wo) (values))
(defun f6-inv! (out o a ao w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo))
  (f2-square! w wo a ao w (+ wo 96))
  (f2-mul! w (+ wo 36) a (+ ao 12) a (+ ao 24) w (+ wo 96))
  (f2-mul-xi! w (+ wo 36) w (+ wo 36) w (+ wo 96))
  (f2-sub! w wo w wo w (+ wo 36))
  (f2-square! w (+ wo 12) a (+ ao 24) w (+ wo 96))
  (f2-mul-xi! w (+ wo 12) w (+ wo 12) w (+ wo 96))
  (f2-mul! w (+ wo 36) a ao a (+ ao 12) w (+ wo 96))
  (f2-sub! w (+ wo 12) w (+ wo 12) w (+ wo 36))
  (f2-square! w (+ wo 24) a (+ ao 12) w (+ wo 96))
  (f2-mul! w (+ wo 36) a ao a (+ ao 24) w (+ wo 96))
  (f2-sub! w (+ wo 24) w (+ wo 24) w (+ wo 36))
  (f2-mul! w (+ wo 36) a (+ ao 24) w (+ wo 12) w (+ wo 96))
  (f2-mul! w (+ wo 48) a (+ ao 12) w (+ wo 24) w (+ wo 96))
  (f2-add! w (+ wo 36) w (+ wo 36) w (+ wo 48))
  (f2-mul-xi! w (+ wo 36) w (+ wo 36) w (+ wo 96))
  (f2-mul! w (+ wo 48) a ao w wo w (+ wo 96))
  (f2-add! w (+ wo 36) w (+ wo 36) w (+ wo 48))
  (f2-inv! w (+ wo 36) w (+ wo 36) w (+ wo 96))
  (dotimes (i +f6-degree+)
    (f2-mul! out (+ o (* i 12)) w (+ wo (* i 12)) w (+ wo 36) w (+ wo 96))) (values))

(defun f12-mul! (out o a ao b bo w wo)
  (declare #.clempo.base:*hot* (type mont-words out a b w) (type fixnum o ao bo wo))
  (f6-mul! w wo a ao b bo w (+ wo 180))
  (f6-mul! w (+ wo 36) a (+ ao 36) b (+ bo 36) w (+ wo 180))
  (f6-add! w (+ wo 108) a ao a (+ ao 36))
  (f6-add! w (+ wo 144) b bo b (+ bo 36))
  (f6-mul! w (+ wo 72) w (+ wo 108) w (+ wo 144) w (+ wo 180))
  (f6-sub! w (+ wo 72) w (+ wo 72) w wo)
  (f6-sub! out (+ o 36) w (+ wo 72) w (+ wo 36))
  (f6-mul-v! w (+ wo 108) w (+ wo 36) w (+ wo 180))
  (f6-add! out o w wo w (+ wo 108)) (values))
(defun f12-square! (out o a ao w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo))
  (f6-mul! w wo a ao a (+ ao 36) w (+ wo 180))
  (f6-add! w (+ wo 36) a ao a (+ ao 36))
  (f6-mul-v! w (+ wo 72) a (+ ao 36) w (+ wo 180))
  (f6-add! w (+ wo 72) w (+ wo 72) a ao)
  (f6-mul! w (+ wo 108) w (+ wo 36) w (+ wo 72) w (+ wo 180))
  (f6-sub! w (+ wo 108) w (+ wo 108) w wo)
  (f6-mul-v! w (+ wo 36) w wo w (+ wo 180))
  (f6-sub! out o w (+ wo 108) w (+ wo 36))
  (f6-add! out (+ o 36) w wo w wo) (values))
(defun f12-conjugate! (out o a ao)
  (f6-copy! out o a ao) (f6-neg! out (+ o 36) a (+ ao 36)) (values))
(defun f12-inv! (out o a ao w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo))
  (f6-square! w wo a ao w (+ wo 180))
  (f6-square! w (+ wo 36) a (+ ao 36) w (+ wo 180))
  (f6-mul-v! w (+ wo 72) w (+ wo 36) w (+ wo 180))
  (f6-sub! w wo w wo w (+ wo 72))
  (f6-inv! w (+ wo 108) w wo w (+ wo 180))
  (f6-mul! out o a ao w (+ wo 108) w (+ wo 180))
  (f6-mul! out (+ o 36) a (+ ao 36) w (+ wo 108) w (+ wo 180))
  (f6-neg! out (+ o 36) out (+ o 36)) (values))
(defun f4-square! (out o a ao b bo w wo)
  ;; Fp2[t]/(t²-xi): 2ab and (a+b)(a+xi*b)-ab-xi*ab.
  (f2-mul! w wo a ao b bo w (+ wo 36))
  (f2-add! w (+ wo 12) a ao b bo)
  (f2-mul-xi! w (+ wo 24) b bo w (+ wo 36))
  (f2-add! w (+ wo 24) w (+ wo 24) a ao)
  (f2-mul! w (+ wo 12) w (+ wo 12) w (+ wo 24) w (+ wo 36))
  (f2-sub! w (+ wo 12) w (+ wo 12) w wo)
  (f2-mul-xi! w (+ wo 24) w wo w (+ wo 36))
  (f2-sub! out o w (+ wo 12) w (+ wo 24))
  (f2-add! out (+ o 12) w wo w wo) (values))
(defun f12-cyclotomic-square! (out o a ao w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo))
  ;; z=(a0,b1,b0,a2,a1,b2). Three Fp4 squares, then +/- two old coefficients.
  (f4-square! w wo a ao a (+ ao 48) w (+ wo 72))
  (f4-square! w (+ wo 24) a (+ ao 36) a (+ ao 24) w (+ wo 72))
  (f4-square! w (+ wo 48) a (+ ao 12) a (+ ao 60) w (+ wo 72))
  (f2-mul-xi! w (+ wo 96) w (+ wo 60) w (+ wo 108))
  (macrolet ((combine (target temp plus)
               `(progn
                  (f2-add! w (+ wo 72) w (+ wo ,temp) w (+ wo ,temp))
                  (f2-add! w (+ wo 72) w (+ wo 72) w (+ wo ,temp))
                  (f2-add! w (+ wo 84) a (+ ao ,target) a (+ ao ,target))
                  (,(if plus 'f2-add! 'f2-sub!) out (+ o ,target) w (+ wo 72) w (+ wo 84)))))
    (combine 0 0 nil) (combine 48 12 t)
    (combine 12 24 nil) (combine 60 36 t)
    (combine 36 96 t) (combine 24 48 nil)) (values))

(defparameter *mont-frobenius-coefficients*
  (let ((out (make-array (* 12 72) :element-type '(unsigned-byte 64) :initial-element 0)))
    (dotimes (k 12)
      (let* ((gamma (f2-pow '(1 . 1) (/ (1- (expt +p+ k)) 6)))
             (powers (make-array 6 :initial-element '(1 . 0))))
        (loop for i from 1 below 6 do (setf (aref powers i) (f2* (aref powers (1- i)) gamma)))
        (loop for exponent in '(0 2 4 1 3 5) for i from 0 do
          (f2-from-integer! out (+ (* k 72) (* i 12)) (aref powers exponent))))) out))
(defun f12-frobenius! (out o a ao power w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao power wo))
  (let ((base (* (mod power 12) 72)))
    (declare (type fixnum base))
    (dotimes (i +f12-f2-degree+)
      (if (oddp power)
          (f2-conjugate! w wo a (+ ao (* i 12)))
          (f2-copy! w wo a (+ ao (* i 12))))
      (f2-mul! out (+ o (* i 12)) w wo *mont-frobenius-coefficients* (+ base (* i 12)) w (+ wo 12))))
  (values))
(defun f12-power! (out o a ao exponent cyclotomic w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo) (type integer exponent))
  (let ((negative (minusp exponent)) (n (abs exponent)))
    (f12-one! w wo) (f12-copy! w (+ wo 72) a ao)
    (loop for bit of-type fixnum downfrom (1- (integer-length n)) to 0 do
      (if cyclotomic
          (f12-cyclotomic-square! w wo w wo w (+ wo 144))
          (f12-square! w wo w wo w (+ wo 144)))
      (when (logbitp bit n) (f12-mul! w wo w wo w (+ wo 72) w (+ wo 144))))
    (when negative
      (unless cyclotomic (error "Negative power requires unitary input"))
      (f12-conjugate! w wo w wo))
    (f12-copy! out o w wo)))

(defun f12-final! (out o a ao w wo)
  (declare #.clempo.base:*hot* (type mont-words out a w) (type fixnum o ao wo))
  ;; Easy exponent (p^6-1)(p²+1).
  (f12-inv! w wo a ao w (+ wo 504))
  (f12-conjugate! w (+ wo 72) a ao)
  (f12-mul! w wo w wo w (+ wo 72) w (+ wo 504))
  (f12-frobenius! w (+ wo 72) w wo 2 w (+ wo 504))
  (f12-mul! w wo w wo w (+ wo 72) w (+ wo 504))
  ;; For BLS x=-0xd201000000010000 and r=x^4-x²+1,
  ;; h=(p^4-p²+1)/r=1+(x-1)²/3*(p+x)*(p²+x²-1).
  ;; This computes h exactly, not the equally valid-for-predicates 3h variant.
  (f12-power! w (+ wo 72) w wo #x460055555555aaab t w (+ wo 504))
  (f12-conjugate! w (+ wo 72) w (+ wo 72))
  (f12-power! w (+ wo 144) w (+ wo 72) #xd201000000010000 t w (+ wo 504))
  (f12-conjugate! w (+ wo 144) w (+ wo 144))
  (f12-conjugate! w (+ wo 216) w (+ wo 72))
  (f12-mul! w (+ wo 144) w (+ wo 144) w (+ wo 216) w (+ wo 504))
  (f12-power! w (+ wo 216) w (+ wo 144) #xd201000000010000 t w (+ wo 504))
  (f12-conjugate! w (+ wo 216) w (+ wo 216))
  (f12-frobenius! w (+ wo 288) w (+ wo 144) 1 w (+ wo 504))
  (f12-mul! w (+ wo 216) w (+ wo 216) w (+ wo 288) w (+ wo 504))
  (f12-power! w (+ wo 288) w (+ wo 216) #xd201000000010000 t w (+ wo 504))
  (f12-conjugate! w (+ wo 288) w (+ wo 288))
  (f12-power! w (+ wo 360) w (+ wo 288) #xd201000000010000 t w (+ wo 504))
  (f12-conjugate! w (+ wo 360) w (+ wo 360))
  (f12-frobenius! w (+ wo 288) w (+ wo 216) 2 w (+ wo 504))
  (f12-conjugate! w (+ wo 432) w (+ wo 216))
  (f12-mul! w (+ wo 360) w (+ wo 360) w (+ wo 288) w (+ wo 504))
  (f12-mul! w (+ wo 360) w (+ wo 360) w (+ wo 432) w (+ wo 504))
  (f12-mul! out o w wo w (+ wo 360) w (+ wo 504)) (values))

(defun f6-mul-01! (out o a ao b bo w wo)
  (declare #.clempo.base:*hot* (type mont-words out a b w) (type fixnum o ao bo wo))
  (f2-mul! w (+ wo 60) a ao b bo w (+ wo 84))
  (f2-mul! w (+ wo 72) a (+ ao 12) b (+ bo 12) w (+ wo 84))
  (f2-mul! w wo a (+ ao 24) b (+ bo 12) w (+ wo 84))
  (f2-mul-xi! w wo w wo w (+ wo 84))
  (f2-add! w wo w wo w (+ wo 60))
  (f2-add! w (+ wo 36) a ao a (+ ao 12))
  (f2-add! w (+ wo 48) b bo b (+ bo 12))
  (f2-mul! w (+ wo 12) w (+ wo 36) w (+ wo 48) w (+ wo 84))
  (f2-sub! w (+ wo 12) w (+ wo 12) w (+ wo 60))
  (f2-sub! w (+ wo 12) w (+ wo 12) w (+ wo 72))
  (f2-mul! w (+ wo 24) a (+ ao 24) b bo w (+ wo 84))
  (f2-add! w (+ wo 24) w (+ wo 24) w (+ wo 72))
  (f6-copy! out o w wo))
(defun f6-mul-1! (out o a ao b bo w wo)
  (f2-mul! w wo a (+ ao 24) b bo w (+ wo 36))
  (f2-mul-xi! w wo w wo w (+ wo 36))
  (f2-mul! w (+ wo 12) a ao b bo w (+ wo 36))
  (f2-mul! w (+ wo 24) a (+ ao 12) b bo w (+ wo 36))
  (f6-copy! out o w wo))
(defun f12-mul-line! (out o a ao line lo w wo)
  (declare #.clempo.base:*hot* (type mont-words out a line w) (type fixnum o ao lo wo))
  (f6-mul-01! w wo a ao line lo w (+ wo 180))
  (f6-mul-1! w (+ wo 36) a (+ ao 36) line (+ lo 24) w (+ wo 180))
  (f6-add! w (+ wo 108) a ao a (+ ao 36))
  (f2-copy! w (+ wo 144) line lo)
  (f2-add! w (+ wo 156) line (+ lo 12) line (+ lo 24))
  (f6-mul-01! w (+ wo 72) w (+ wo 108) w (+ wo 144) w (+ wo 180))
  (f6-sub! w (+ wo 72) w (+ wo 72) w wo)
  (f6-sub! out (+ o 36) w (+ wo 72) w (+ wo 36))
  (f6-mul-v! w (+ wo 108) w (+ wo 36) w (+ wo 180))
  (f6-add! out o w wo w (+ wo 108)) (values))
