;;; Pure integer BLS12-381 arithmetic and EIP-2537 boundary encodings.
(defpackage #:clempo.bls12-381
  (:use #:cl)
  (:import-from #:clempo.base #:make-octets #:integer->octets #:octets->integer
                #:octets-concat)
  (:export #:+p+ #:+r+ #:invalid-point #:g1-generator #:g2-generator
           #:g1-add #:g2-add #:g1-neg #:g2-neg #:g1-mul #:g2-mul
           #:g1-msm #:g2-msm #:g1-on-curve-p #:g2-on-curve-p
           #:g1-subgroup-p #:g2-subgroup-p #:g1-compress #:g2-compress
           #:g1-decompress #:g2-decompress #:g1-encode #:g2-encode
           #:g1-decode #:g2-decode #:pairing-check
           #:g1-add-precompile #:g2-add-precompile #:g1-msm-precompile
           #:g2-msm-precompile #:pairing-precompile))
(in-package #:clempo.bls12-381)

(defconstant +p+ #x1a0111ea397fe69a4b1ba7b6434bacd764774b84f38512bf6730d2a0f6b0f6241eabfffeb153ffffb9feffffffffaaab)
(defconstant +r+ #x73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001)
(define-condition invalid-point (error) ())
(defun invalid () (error 'invalid-point))

(defun fp-pow (base exponent)
  (let ((result 1) (base (mod base +p+)))
    (loop while (plusp exponent) do
      (when (oddp exponent) (setf result (mod (* result base) +p+)))
      (setf exponent (ash exponent -1))
      (when (plusp exponent) (setf base (mod (* base base) +p+))))
    result))
(defun fp-inv (n)
  (let ((a +p+) (b (mod n +p+)) (x 0) (y 1))
    (when (zerop b) (invalid))
    (loop until (zerop b) do
      (multiple-value-bind (q r) (floor a b)
        (psetf a b b r x y y (- x (* q y)))))
    (mod x +p+)))
(defun fp-sqrt (n)
  (let ((root (fp-pow n (ash (1+ +p+) -2))))
    (when (= (mod (* root root) +p+) (mod n +p+)) root)))
(defun fp+ (a b) (mod (+ a b) +p+))
(defun fp- (a b) (mod (- a b) +p+))
(defun fp* (a b) (mod (* a b) +p+))
(defun fp-neg (a) (mod (- a) +p+))
(defun f2+ (a b) (cons (fp+ (car a) (car b)) (fp+ (cdr a) (cdr b))))
(defun f2- (a b) (cons (fp- (car a) (car b)) (fp- (cdr a) (cdr b))))
(defun f2-neg (a) (cons (fp-neg (car a)) (fp-neg (cdr a))))
(defun f2* (a b)
  (let ((ac (* (car a) (car b))) (bd (* (cdr a) (cdr b))))
    (cons (mod (- ac bd) +p+)
          (mod (- (* (+ (car a) (cdr a)) (+ (car b) (cdr b))) ac bd) +p+))))
(defun f2-scale (a n) (cons (fp* (car a) n) (fp* (cdr a) n)))
(defun f2-inv (a)
  (let ((inv (fp-inv (+ (* (car a) (car a)) (* (cdr a) (cdr a))))))
    (cons (fp* (car a) inv) (fp* (- (cdr a)) inv))))
(defun f2/ (a b) (f2* a (f2-inv b)))
(defun f2-pow (base exponent)
  (let ((result (cons 1 0)))
    (loop while (plusp exponent) do
      (when (oddp exponent) (setf result (f2* result base)))
      (setf exponent (ash exponent -1))
      (when (plusp exponent) (setf base (f2* base base))))
    result))
(defun f2-zero-p (a) (and (zerop (car a)) (zerop (cdr a))))
(defun f2-sqrt (a)
  (cond ((f2-zero-p a) (cons 0 0))
        ((zerop (cdr a))
         (let ((r (fp-sqrt (car a))))
           (if r (cons r 0) (let ((i (fp-sqrt (- (car a)))))
                             (when i (cons 0 i))))))
        (t (let ((norm (fp-sqrt (+ (* (car a) (car a)) (* (cdr a) (cdr a))))))
             (when norm
               (let ((x (or (fp-sqrt (fp* (+ (car a) norm) (ash (1+ +p+) -1)))
                            (fp-sqrt (fp* (- (car a) norm) (ash (1+ +p+) -1))))))
                 (when (and x (not (zerop x)))
                   (let ((root (cons x (fp* (cdr a) (fp-inv (* 2 x))))))
                     (when (equal (f2* root root) a) root)))))))))

;;; Jacobian scalar arithmetic: one inversion at the affine boundary, never per bit.
;;; The macro specializes field operations rather than dispatching in the loop.
(defmacro define-group (prefix add sub mul neg inv zero one coefficient)
  (let ((dbl (intern (format nil "~A-JDOUBLE" prefix)))
        (jadd (intern (format nil "~A-JADD" prefix)))
        (affine (intern (format nil "~A-AFFINE" prefix)))
        (sum (intern (format nil "~A-ADD" prefix)))
        (minus (intern (format nil "~A-NEG" prefix)))
        (scale (intern (format nil "~A-MUL" prefix)))
        (curve (intern (format nil "~A-ON-CURVE-P" prefix)))
        (subgroup (intern (format nil "~A-SUBGROUP-P" prefix))))
    `(progn
       (defun ,dbl (point)
         (when (and point (not (equal (second point) ,zero)))
           (destructuring-bind (x y z) point
             (let* ((a (,mul x x)) (b (,mul y y)) (c (,mul b b))
                    (xb (,add x b)) (d0 (,sub (,sub (,mul xb xb) a) c))
                    (d (,add d0 d0)) (e (,add a (,add a a)))
                    (xx (,sub (,mul e e) (,add d d)))
                    (c2 (,add c c)) (c4 (,add c2 c2))
                    (yy (,sub (,mul e (,sub d xx)) (,add c4 c4))))
               (list xx yy (,mul (,add y y) z))))))
       (defun ,jadd (p q)
         (cond ((null p) q) ((null q) p)
               (t (destructuring-bind (x1 y1 z1) p
                    (destructuring-bind (x2 y2 z2) q
                      (let* ((z11 (,mul z1 z1)) (z22 (,mul z2 z2))
                             (u1 (,mul x1 z22)) (u2 (,mul x2 z11))
                             (s1 (,mul y1 (,mul z2 z22)))
                             (s2 (,mul y2 (,mul z1 z11)))
                             (h (,sub u2 u1)) (r (,sub s2 s1)))
                        (if (equal h ,zero)
                            (when (equal r ,zero) (,dbl p))
                            (let* ((hh (,mul h h)) (hhh (,mul h hh))
                                   (v (,mul u1 hh))
                                   (xx (,sub (,sub (,mul r r) hhh) (,add v v))))
                              (list xx (,sub (,mul r (,sub v xx)) (,mul s1 hhh))
                                    (,mul h (,mul z1 z2)))))))))))
       (defun ,affine (point)
         (when point
           (let* ((zi (,inv (third point))) (zi2 (,mul zi zi)))
             (cons (,mul (first point) zi2)
                   (,mul (second point) (,mul zi zi2))))))
       (defun ,sum (p q)
         (,affine (,jadd (when p (list (car p) (cdr p) ,one))
                        (when q (list (car q) (cdr q) ,one)))))
       (defun ,minus (p) (when p (cons (car p) (,neg (cdr p)))))
       (defun ,scale (point scalar)
         (unless (integerp scalar) (invalid))
         (when (minusp scalar) (setf scalar (- scalar) point (,minus point)))
         (let ((acc nil) (p (when point (list (car point) (cdr point) ,one))))
           (loop while (plusp scalar) do
             (when (oddp scalar) (setf acc (,jadd acc p)))
             (setf scalar (ash scalar -1))
             (when (plusp scalar) (setf p (,dbl p))))
           (,affine acc)))
       (defun ,curve (p)
         (or (null p)
             (equal (,mul (cdr p) (cdr p))
                    (,add (,mul (car p) (,mul (car p) (car p))) ,coefficient))))
       (defun ,subgroup (p) (and (,curve p) (null (,scale p +r+)))))))
(define-group g1 fp+ fp- fp* fp-neg fp-inv 0 1 4)
(define-group g2 f2+ f2- f2* f2-neg f2-inv '(0 . 0) '(1 . 0) '(4 . 4))

