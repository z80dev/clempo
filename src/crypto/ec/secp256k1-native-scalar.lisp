(in-package #:clempo.secp256k1)

(defun sw-constant (integer count)
  (let ((out (make-array count :element-type '(unsigned-byte 64) :initial-element 0)))
    (dotimes (i count out) (setf (aref out i) (ldb (byte 64 (* i 64)) integer)))))
(defparameter *sc-order* (sw-constant +secp256k1-n+ 4))
(defparameter *sf-prime* (sw-constant +secp256k1-p+ 4))
(defparameter *sf-seven* (sw-constant 7 4))
(defparameter *sc-r-squared* (sw-constant (mod (ash 1 512) +secp256k1-n+) 4))
(defconstant +sc-montgomery-factor+
  (mod (- (clempo.ec:invert (ldb (byte 64 0) +secp256k1-n+) (ash 1 64))) (ash 1 64)))

(declaim (inline sw-ge-p sw-one-p sw-sub! sw-add! sw-shift-right1! sc-half! sc-sub!))
(defmacro sw-compare-four (a ao b bo)
  (labels ((compare-word (i)
             (let ((x `(aref ,a (+ ,ao ,i))) (y `(aref ,b (+ ,bo ,i))))
               (if (zerop i) `(>= ,x ,y)
                   `(or (> ,x ,y) (and (= ,x ,y) ,(compare-word (1- i))))))))
    (compare-word 3)))
(defun sw-ge-p (a ao b bo)
  (declare #.clempo.base:*hot* (type secp-words a b) (type fixnum ao bo))
  (sw-compare-four a ao b bo))
(defun sw-one-p (a ao)
  (declare #.clempo.base:*hot* (type secp-words a) (type fixnum ao))
  (and (= (aref a ao) 1) (zerop (aref a (+ ao 1)))
       (zerop (aref a (+ ao 2))) (zerop (aref a (+ ao 3)))))
(defmacro sw-subtract-words (count)
  `(let ((carry 1))
     (declare (type bit carry))
     ,@(loop for i below count collect
         `(setf (values (aref out (+ o ,i)) carry)
                (sb-bignum::%subtract-with-borrow (aref a (+ ao ,i)) (aref b (+ bo ,i)) carry)))
     carry))
(defun sw-sub! (out o a ao b bo &optional (count 4))
  (declare #.clempo.base:*hot* (type secp-words out a b) (type fixnum o ao bo count))
  (ecase count (4 (sw-subtract-words 4)) (5 (sw-subtract-words 5))))
(defmacro sw-add-four ()
  `(let ((carry 0))
     (declare (type bit carry))
     ,@(loop for i below 4 collect
         `(setf (values (aref out (+ o ,i)) carry)
                (sb-bignum::%add-with-carry (aref a (+ ao ,i)) (aref b (+ bo ,i)) carry)))
     carry))
(defun sw-add! (out o a ao b bo)
  (declare #.clempo.base:*hot* (type secp-words out a b) (type fixnum o ao bo))
  (sw-add-four))
(defun sw-shift-right1! (a ao &optional (high 0))
  (declare #.clempo.base:*hot* (type secp-words a) (type fixnum ao) (type bit high))
  (let ((w0 (aref a ao)) (w1 (aref a (+ ao 1)))
        (w2 (aref a (+ ao 2))) (w3 (aref a (+ ao 3))))
    (declare (type (unsigned-byte 64) w0 w1 w2 w3))
    (setf (aref a ao) (logior (ash w0 -1) (ldb (byte 64 0) (ash w1 63)))
          (aref a (+ ao 1)) (logior (ash w1 -1) (ldb (byte 64 0) (ash w2 63)))
          (aref a (+ ao 2)) (logior (ash w2 -1) (ldb (byte 64 0) (ash w3 63)))
          (aref a (+ ao 3)) (logior (ash w3 -1) (ash high 63))))
  (values))
(defun sc-half! (a ao)
  (declare #.clempo.base:*hot* (type secp-words a) (type fixnum ao))
  (let ((high (if (oddp (aref a ao)) (sw-add! a ao a ao *sc-order* 0) 0)))
    (declare (type bit high))
    (sw-shift-right1! a ao high)))
(defun sc-sub! (out o a ao b bo)
  (declare #.clempo.base:*hot* (type secp-words out a b) (type fixnum o ao bo))
  (when (zerop (sw-sub! out o a ao b bo)) (sw-add! out o out o *sc-order* 0)) (values))
(defun sc-neg! (out o a ao)
  (declare #.clempo.base:*hot* (type secp-words out a) (type fixnum o ao))
  (if (sf-zero-p a ao) (sf-zero! out o) (sw-sub! out o *sc-order* 0 a ao)) (values))
(defun sc-inv! (out o a ao work wo)
  "Binary extended GCD in ordinary residues. Sixteen disjoint scratch words."
  (declare #.clempo.base:*hot* (type secp-words out a work) (type fixnum o ao wo))
  (when (sf-zero-p a ao) (error "Inverse of zero in secp256k1 scalar field."))
  (let ((u wo) (v (+ wo 4)) (x (+ wo 8)) (y (+ wo 12)))
    (declare (type fixnum u v x y))
    (sf-copy! work u a ao) (sf-copy! work v *sc-order* 0)
    (sf-one! work x) (sf-zero! work y)
    (loop until (or (sw-one-p work u) (sw-one-p work v)) do
      (loop while (evenp (aref work u)) do (sw-shift-right1! work u) (sc-half! work x))
      (loop while (evenp (aref work v)) do (sw-shift-right1! work v) (sc-half! work y))
      (if (sw-ge-p work u work v)
          (progn (sw-sub! work u work u work v) (sc-sub! work x work x work y))
          (progn (sw-sub! work v work v work u) (sc-sub! work y work y work x))))
    (sf-copy! out o work (if (sw-one-p work u) x y))) (values))

(defmacro define-sc-montgomery ()
  (let ((as (loop repeat 4 collect (gensym "A")))
        (bs (loop repeat 4 collect (gensym "B")))
        (ts (loop repeat 6 collect (gensym "T")))
        (carry (gensym "C")) (bit (gensym "BIT")) (m (gensym "M"))
        (ns (loop for i below 4 collect (ldb (byte 64 (* 64 i)) +secp256k1-n+))))
    `(defun sc-montgomery! (out o a ao b bo)
       (declare #.clempo.base:*hot* (type secp-words out a b) (type fixnum o ao bo))
       (let (,@(loop for x in as for i from 0 collect `(,x (aref a (+ ao ,i))))
             ,@(loop for x in bs for i from 0 collect `(,x (aref b (+ bo ,i))))
             ,@(loop for x in ts collect `(,x 0)) (,carry 0) (,bit 0) (,m 0))
         (declare (type (unsigned-byte 64) ,@as ,@bs ,@ts ,carry ,m) (type bit ,bit))
         ,@(loop for x in as append
             (append
              (list `(setf ,carry 0))
              (loop for y in bs for j from 0 collect
                `(setf (values ,carry ,(nth j ts)) (mul-add-word ,x ,y ,(nth j ts) ,carry)))
              (list `(setf (values ,(nth 4 ts) ,bit)
                            (sb-bignum::%add-with-carry ,(nth 4 ts) ,carry 0)
                           ,(nth 5 ts) (+ ,(nth 5 ts) ,bit))
                    `(setf ,m (nth-value 1 (sb-bignum::%multiply-and-add ,(first ts) +sc-montgomery-factor+ 0)))
                    `(setf ,carry 0))
              (loop for n in ns for j from 0 collect
                `(setf (values ,carry ,(nth j ts)) (mul-add-word ,m ,n ,(nth j ts) ,carry)))
              (list `(setf (values ,(nth 4 ts) ,bit)
                            (sb-bignum::%add-with-carry ,(nth 4 ts) ,carry 0)
                           ,(nth 5 ts) (+ ,(nth 5 ts) ,bit)))
              (loop for j below 5 collect `(setf ,(nth j ts) ,(nth (1+ j) ts)))
              (list `(setf ,(nth 5 ts) 0))))
         (when (or (plusp ,(nth 4 ts))
                   ,(labels ((comparison (i)
                               (if (zerop i) `(>= ,(nth i ts) ,(nth i ns))
                                   `(or (> ,(nth i ts) ,(nth i ns))
                                        (and (= ,(nth i ts) ,(nth i ns)) ,(comparison (1- i)))))))
                      (comparison 3)))
           (setf ,bit 1)
           ,@(loop for n in ns for j from 0 collect
               `(setf (values ,(nth j ts) ,bit)
                      (sb-bignum::%subtract-with-borrow ,(nth j ts) ,n ,bit))))
         ,@(loop for j below 4 collect `(setf (aref out (+ o ,j)) ,(nth j ts))) (values)))))
(define-sc-montgomery)
(defun sc-mul! (out o a ao b bo work wo)
  (declare #.clempo.base:*hot* (type secp-words out a b work) (type fixnum o ao bo wo))
  (sc-montgomery! work wo a ao b bo)
  (sc-montgomery! out o work wo *sc-r-squared* 0) (values))

(defmacro define-sw-product (name ac bc)
  (let ((as (loop repeat ac collect (gensym "A")))
        (bs (loop repeat bc collect (gensym "B")))
        (rs (loop repeat (+ ac bc) collect (gensym "R"))) (carry (gensym)))
    `(defun ,name (out o a ao b bo)
       (declare #.clempo.base:*hot* (type secp-words out a b) (type fixnum o ao bo))
       (let (,@(loop for x in as for i from 0 collect `(,x (aref a (+ ao ,i))))
             ,@(loop for x in bs for i from 0 collect `(,x (aref b (+ bo ,i))))
             ,@(loop for x in rs collect `(,x 0)) (,carry 0))
         (declare (type (unsigned-byte 64) ,@as ,@bs ,@rs ,carry))
         ,@(loop for x in as for i from 0 append
             (append (list `(setf ,carry 0))
                     (loop for y in bs for j from 0 collect
                       `(setf (values ,carry ,(nth (+ i j) rs))
                              (mul-add-word ,x ,y ,(nth (+ i j) rs) ,carry)))
                     (list `(setf ,(nth (+ i bc) rs) ,carry))))
         ,@(loop for r in rs for i from 0 collect `(setf (aref out (+ o ,i)) ,r)) (values)))))
(define-sw-product sw-product44! 4 4)
(define-sw-product sw-product22! 2 2)
(define-sw-product sw-product23! 2 3)

;; Independent nearest-lattice decomposition. The fixed-point approximations
;; need not reproduce a particular rounding tie: the exact lattice identity
;; holds for every coefficient and the resulting signed components fit 129 bits.
(defconstant +sg-a1+ #x3086d221a7d46bcde86c90e49284eb15)
(defconstant +sg-b1+ #xe4437ed6010e88286f547fa90abfe4c3)
(defconstant +sg-a2+ #x114ca50f7a8e2f3f657c1108d9d44cfd8)
(defparameter *sg-a1* (sw-constant +sg-a1+ 2))
(defparameter *sg-b1* (sw-constant +sg-b1+ 2))
(defparameter *sg-a2* (sw-constant +sg-a2+ 3))
(defparameter *sg-g1*
  (sw-constant (floor (+ (ash +sg-a1+ 384) (ash +secp256k1-n+ -1)) +secp256k1-n+) 4))
(defparameter *sg-g2*
  (sw-constant (floor (+ (ash +sg-b1+ 384) (ash +secp256k1-n+ -1)) +secp256k1-n+) 4))

(defun sg-coefficient! (work product coefficient)
  (declare #.clempo.base:*hot* (type secp-words work) (type fixnum product coefficient))
  (let ((carry (ldb (byte 1 63) (aref work (+ product 5)))))
    (declare (type bit carry))
    (setf (values (aref work coefficient) carry)
          (sb-bignum::%add-with-carry (aref work (+ product 6)) 0 carry)
          (aref work (+ coefficient 1))
          (sb-bignum::%add-with-carry (aref work (+ product 7)) 0 carry))) (values))
(defun sg-absolute! (work component)
  (declare #.clempo.base:*hot* (type secp-words work) (type fixnum component))
  (if (logbitp 63 (aref work (+ component 4)))
      (let ((carry 1))
        (declare (type bit carry))
        (dotimes (i 5)
          (setf (values (aref work (+ component i)) carry)
                (sb-bignum::%add-with-carry
                 (ldb (byte 64 0) (lognot (aref work (+ component i)))) 0 carry))) -1)
      1))
(defun sg-wnaf! (digits start work component sign width)
  (declare #.clempo.base:*hot* (type (simple-array (signed-byte 8) (*)) digits)
           (type secp-words work) (type fixnum start component sign width))
  (fill digits 0 :start start :end (+ start 130))
  (let ((length 0) (mask (1- (ash 1 width))) (half (ash 1 (1- width))))
    (declare (type fixnum length mask half))
    (loop until (sf-zero-p work component) do
      (clempo.base:invariant (< length 130) "GLV component exceeds digit capacity.")
      (when (oddp (aref work component))
        (let* ((low (logand (aref work component) mask))
               (digit (if (>= low half) (- low (1+ mask)) low)) (carry 0))
          (declare (type fixnum low digit) (type bit carry))
          (setf (aref digits (+ start length)) (* sign digit))
          (if (plusp digit)
              (progn
                (setf (values (aref work component) carry)
                      (sb-bignum::%subtract-with-borrow (aref work component) digit 1))
                (loop for i of-type fixnum from 1 below 4 do
                  (setf (values (aref work (+ component i)) carry)
                        (sb-bignum::%subtract-with-borrow (aref work (+ component i)) 0 carry))))
              (progn
                (setf (values (aref work component) carry)
                      (sb-bignum::%add-with-carry (aref work component) (- digit) 0))
                (loop for i of-type fixnum from 1 below 4 do
                  (setf (values (aref work (+ component i)) carry)
                        (sb-bignum::%add-with-carry (aref work (+ component i)) 0 carry)))))))
      (sw-shift-right1! work component) (incf length)) length))
(defun sg-decompose! (arena scalar digits stream1 stream2 width work)
  "Write signed GLV wNAFs. Thirty-two disjoint work words; SCALAR is canonical."
  (declare #.clempo.base:*hot* (type secp-words arena)
           (type (simple-array (signed-byte 8) (*)) digits)
           (type fixnum scalar stream1 stream2 width work))
  (let ((c1 (+ work 8)) (c2 (+ work 10)) (p1 (+ work 12)) (p2 (+ work 17))
        (a (+ work 22)) (b (+ work 27)))
    (declare (type fixnum c1 c2 p1 p2 a b))
    (sw-product44! arena work arena scalar *sg-g1* 0) (sg-coefficient! arena work c1)
    (sw-product44! arena work arena scalar *sg-g2* 0) (sg-coefficient! arena work c2)
    (sw-product22! arena p1 arena c1 *sg-a1* 0) (setf (aref arena (+ p1 4)) 0)
    (sw-product23! arena p2 arena c2 *sg-a2* 0)
    (sf-copy! arena a arena scalar) (setf (aref arena (+ a 4)) 0)
    (sw-sub! arena a arena a arena p1 5) (sw-sub! arena a arena a arena p2 5)
    (sw-product22! arena p1 arena c1 *sg-b1* 0) (setf (aref arena (+ p1 4)) 0)
    (sw-product22! arena p2 arena c2 *sg-a1* 0) (setf (aref arena (+ p2 4)) 0)
    (sw-sub! arena b arena p1 arena p2 5)
    (let ((asign (sg-absolute! arena a)) (bsign (sg-absolute! arena b)))
      (declare (type fixnum asign bsign))
      (clempo.base:invariant
       (and (zerop (aref arena (+ a 4))) (zerop (aref arena (+ a 3))) (<= (aref arena (+ a 2)) 1)
            (zerop (aref arena (+ b 4))) (zerop (aref arena (+ b 3))) (<= (aref arena (+ b 2)) 1))
       "GLV component outside 129-bit bound.")
      (max (sg-wnaf! digits stream1 arena a asign width)
           (sg-wnaf! digits stream2 arena b bsign width)))))
