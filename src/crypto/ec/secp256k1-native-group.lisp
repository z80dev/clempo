;;; Ordinary-limb Jacobian arithmetic. Offsets and scratch bounds count UB64 words.
;;; Inputs are canonical field residues, not necessarily normalized Jacobians.
;;; Scratch must be disjoint from inputs/output; exact output aliases are supported.
(in-package #:clempo.secp256k1)

(deftype sn-arena () '(simple-array (unsigned-byte 64) (*)))
(deftype sn-digits () '(simple-array (signed-byte 8) (520)))
(defconstant +sn-jdouble-work-words+ 32)
(defconstant +sn-jadd-work-words+ 56)
(defconstant +sn-jadd-affine-work-words+ 44)
(defconstant +sn-jwork-words+ 56)
(defconstant +sn-to-affine-work-words+ 32)
(defconstant +sn-joint-work-words+ 348)
(defconstant +sn-generator-x+
  #x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798)
(defconstant +sn-generator-y+
  #x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8)
(defconstant +sn-beta+
  #x7ae96a2b657c07106e64479eac3434e99cf0497512f58995c1396c28719501ee)

(declaim (type sn-arena *sn-beta-words* *sn-odd-g*))

(declaim (inline sn-jzero! sn-jcopy!))
(defun sn-jzero! (arena out)
  (declare #.clempo.base:*hot* (type sn-arena arena) (type fixnum out))
  (sf-zero! arena out)
  (sf-one! arena (+ out 4))
  (sf-zero! arena (+ out 8))
  (values))

(defun sn-jcopy! (arena out p)
  (declare #.clempo.base:*hot* (type sn-arena arena) (type fixnum out p))
  (dotimes (i 12) (setf (aref arena (+ out i)) (aref arena (+ p i))))
  (values))

(defun sn-jdouble! (arena out p work)
  (declare #.clempo.base:*hot* (type sn-arena arena) (type fixnum out p work))
  (when (or (sf-zero-p arena (+ p 8)) (sf-zero-p arena (+ p 4)))
    (sn-jzero! arena out)
    (return-from sn-jdouble! (values)))
  (let ((a work) (b (+ work 4)) (c (+ work 8)) (d (+ work 12))
        (e (+ work 16)) (x (+ work 20)) (y (+ work 24)) (z (+ work 28)))
    (declare (type fixnum a b c d e x y z))
    ;; a=X², b=Y², c=Y⁴, d=4XY², e=3X²; valid for every a=0 curve.
    (sf-square! arena a arena p)
    (sf-square! arena b arena (+ p 4))
    (sf-square! arena c arena b)
    (sf-mul! arena d arena p arena b)
    (sf-add! arena d arena d arena d)
    (sf-add! arena d arena d arena d)
    (sf-add! arena e arena a arena a)
    (sf-add! arena e arena e arena a)
    (sf-square! arena x arena e)
    (sf-sub! arena x arena x arena d)
    (sf-sub! arena x arena x arena d)
    (sf-sub! arena y arena d arena x)
    (sf-mul! arena y arena e arena y)
    (sf-add! arena c arena c arena c)
    (sf-add! arena c arena c arena c)
    (sf-add! arena c arena c arena c)
    (sf-sub! arena y arena y arena c)
    (sf-mul! arena z arena (+ p 4) arena (+ p 8))
    (sf-add! arena z arena z arena z)
    ;; All input reads precede the commit, including when OUT=P.
    (sf-copy! arena out arena x)
    (sf-copy! arena (+ out 4) arena y)
    (sf-copy! arena (+ out 8) arena z))
  (values))

(defun sn-jadd! (arena out p q work)
  (declare #.clempo.base:*hot* (type sn-arena arena) (type fixnum out p q work))
  (cond ((sf-zero-p arena (+ p 8)) (sn-jcopy! arena out q))
        ((sf-zero-p arena (+ q 8)) (sn-jcopy! arena out p))
        (t
         (let ((z1 work) (z2 (+ work 4)) (u1 (+ work 8)) (u2 (+ work 12))
               (s1 (+ work 16)) (s2 (+ work 20)) (h (+ work 24)) (r (+ work 28))
               (hh (+ work 32)) (hhh (+ work 36)) (v (+ work 40))
               (x (+ work 44)) (y (+ work 48)) (z (+ work 52)))
           (declare (type fixnum z1 z2 u1 u2 s1 s2 h r hh hhh v x y z))
           (sf-square! arena z1 arena (+ p 8))
           (sf-square! arena z2 arena (+ q 8))
           (sf-mul! arena u1 arena p arena z2)
           (sf-mul! arena u2 arena q arena z1)
           (sf-mul! arena s1 arena z2 arena (+ q 8))
           (sf-mul! arena s1 arena s1 arena (+ p 4))
           (sf-mul! arena s2 arena z1 arena (+ p 8))
           (sf-mul! arena s2 arena s2 arena (+ q 4))
           (sf-sub! arena h arena u2 arena u1)
           (sf-sub! arena r arena s2 arena s1)
           (cond ((sf-zero-p arena h)
                  (if (sf-zero-p arena r)
                      (sn-jdouble! arena out p work)
                      (sn-jzero! arena out)))
                 (t
                  (sf-square! arena hh arena h)
                  (sf-mul! arena hhh arena hh arena h)
                  (sf-mul! arena v arena u1 arena hh)
                  (sf-square! arena x arena r)
                  (sf-sub! arena x arena x arena hhh)
                  (sf-sub! arena x arena x arena v)
                  (sf-sub! arena x arena x arena v)
                  (sf-sub! arena y arena v arena x)
                  (sf-mul! arena y arena y arena r)
                  (sf-mul! arena s1 arena s1 arena hhh)
                  (sf-sub! arena y arena y arena s1)
                  (sf-mul! arena z arena (+ p 8) arena (+ q 8))
                  (sf-mul! arena z arena z arena h)
                  (sf-copy! arena out arena x)
                  (sf-copy! arena (+ out 4) arena y)
                  (sf-copy! arena (+ out 8) arena z))))))
  (values))

(defun sn-jadd-affine! (arena out p affine negate-p work)
  (declare #.clempo.base:*hot* (type sn-arena arena)
           (type fixnum out p affine work))
  ;; AFFINE is finite. A signed Y is staged even in the infinity case, so
  ;; OUT=P=AFFINE is an exact alias rather than an overlapping-copy hazard.
  (let ((z1 work) (u2 (+ work 4)) (s2 (+ work 8)) (h (+ work 12))
        (r (+ work 16)) (hh (+ work 20)) (hhh (+ work 24))
        (v (+ work 28)) (x (+ work 32)) (y (+ work 36)) (z (+ work 40)))
    (declare (type fixnum z1 u2 s2 h r hh hhh v x y z))
    (if (sf-zero-p arena (+ p 8))
        (progn
          (if negate-p (sf-neg! arena s2 arena (+ affine 4))
              (sf-copy! arena s2 arena (+ affine 4)))
          (sf-copy! arena out arena affine)
          (sf-copy! arena (+ out 4) arena s2)
          (sf-one! arena (+ out 8)))
        (progn
          (sf-square! arena z1 arena (+ p 8))
          (sf-mul! arena u2 arena affine arena z1)
          (sf-mul! arena s2 arena z1 arena (+ p 8))
          (sf-mul! arena s2 arena s2 arena (+ affine 4))
          (when negate-p (sf-neg! arena s2 arena s2))
          (sf-sub! arena h arena u2 arena p)
          (sf-sub! arena r arena s2 arena (+ p 4))
          (cond ((sf-zero-p arena h)
                 (if (sf-zero-p arena r)
                     (sn-jdouble! arena out p work)
                     (sn-jzero! arena out)))
                (t
                 (sf-square! arena hh arena h)
                 (sf-mul! arena hhh arena hh arena h)
                 (sf-mul! arena v arena p arena hh)
                 (sf-square! arena x arena r)
                 (sf-sub! arena x arena x arena hhh)
                 (sf-sub! arena x arena x arena v)
                 (sf-sub! arena x arena x arena v)
                 (sf-sub! arena y arena v arena x)
                 (sf-mul! arena y arena y arena r)
                 (sf-mul! arena s2 arena (+ p 4) arena hhh)
                 (sf-sub! arena y arena y arena s2)
                 (sf-mul! arena z arena (+ p 8) arena h)
                 (sf-copy! arena out arena x)
                 (sf-copy! arena (+ out 4) arena y)
                 (sf-copy! arena (+ out 8) arena z))))))
  (values))

(defun sn-to-affine! (arena out8 p work)
  "Write finite affine coordinates and return T; zero OUT8 and return NIL at infinity."
  (declare #.clempo.base:*hot* (type sn-arena arena) (type fixnum out8 p work))
  (when (sf-zero-p arena (+ p 8))
    (sf-zero! arena out8)
    (sf-zero! arena (+ out8 4))
    (return-from sn-to-affine! nil))
  ;; INV's 16-word workspace is dead before Y occupies its first four words.
  (sf-inv! arena work arena (+ p 8) arena (+ work 16))
  (sf-square! arena (+ work 4) arena work)
  (sf-mul! arena (+ work 8) arena (+ work 4) arena work)
  (sf-mul! arena (+ work 12) arena p arena (+ work 4))
  (sf-mul! arena (+ work 16) arena (+ p 4) arena (+ work 8))
  (sf-copy! arena out8 arena (+ work 12))
  (sf-copy! arena (+ out8 4) arena (+ work 16))
  t)

;; Read-only after load. The second half holds phi of each odd generator.
;; No legacy integer group operation or generator binding is needed at load.
(defparameter *sn-beta-words*
  (load-time-value
   (let ((a (make-array 4 :element-type '(unsigned-byte 64) :initial-element 0)))
     (sf-from-integer! a 0 +sn-beta+)
     a)
   t))

(defparameter *sn-odd-g*
  (load-time-value
   (let ((a (make-array 592 :element-type '(unsigned-byte 64) :initial-element 0))
         (table (make-array 512 :element-type '(unsigned-byte 64) :initial-element 0)))
     (sf-from-integer! a 512 +sn-generator-x+)
     (sf-from-integer! a 516 +sn-generator-y+)
     (sf-one! a 520)
     (sn-jdouble! a 524 512 536)
     (dotimes (i 32)
       (let ((offset (* i 8)))
         (sn-to-affine! a offset 512 536)
         (sf-mul! a (+ offset 256) a offset *sn-beta-words* 0)
         (sf-copy! a (+ offset 260) a (+ offset 4)))
       (unless (= i 31) (sn-jadd! a 512 512 524 536)))
     (replace table a :end2 512)
     table)
   t))

(defun sn-joint! (arena out12 r8 digits length work)
  "Four signed wNAF streams: G, phi(G), R, phi(R), each 130 low-to-high digits.
G streams have width 7; R streams width 5. LENGTH is in [0,130]. R is finite.
The 348-word scratch interval is disjoint from OUT12 and R8; OUT12 may equal R8.
Return an original-curve Jacobian without inversion, including when all streams vanish."
  (declare #.clempo.base:*hot* (type sn-arena arena) (type sn-digits digits)
           (type fixnum out12 r8 work) (type (integer 0 130) length))
  (when (zerop length)
    (sn-jzero! arena out12)
    (return-from sn-joint! (values)))
  (let ((twice (+ work 96)) (prefix (+ work 108)) (suffix (+ work 140))
        (denominator (+ work 144)) (d2 (+ work 148)) (d3 (+ work 152))
        (odd-r (+ work 156)) (phi-r (+ work 220)) (selected (+ work 284))
        (scratch (+ work 292)))
    (declare (type fixnum twice prefix suffix denominator d2 d3 odd-r phi-r selected scratch))
    ;; Build R,3R,...,15R as ordinary Jacobians. Valid secp256k1 points have
    ;; prime order, so none of these eight Z coordinates can vanish.
    (sf-copy! arena work arena r8)
    (sf-copy! arena (+ work 4) arena (+ r8 4))
    (sf-one! arena (+ work 8))
    (sn-jdouble! arena twice work scratch)
    (loop for i of-type fixnum from 1 below 8 do
      (sn-jadd! arena (+ work (* i 12)) (+ work (* (1- i) 12)) twice scratch))
    ;; Prefix/suffix products compute D/Z_i without dividing by any Z_i.
    ;; Each transformed odd point has affine coordinates (x_i D²,y_i D³)
    ;; on y²=x³+7D⁶. Keep D for undoing the isomorphism at the very end.
    (sf-one! arena denominator)
    (dotimes (i 8)
      (sf-copy! arena (+ prefix (* i 4)) arena denominator)
      (sf-mul! arena denominator arena denominator arena (+ work (* i 12) 8)))
    (sf-square! arena d2 arena denominator)
    (sf-mul! arena d3 arena d2 arena denominator)
    (sf-one! arena suffix)
    (loop for i of-type fixnum downfrom 7 to 0 do
      (let ((point (+ work (* i 12))) (affine (+ odd-r (* i 8)))
            (phi (+ phi-r (* i 8))))
        (declare (type fixnum point affine phi))
        (sf-mul! arena scratch arena (+ prefix (* i 4)) arena suffix)
        (sf-square! arena (+ scratch 4) arena scratch)
        (sf-mul! arena (+ scratch 8) arena (+ scratch 4) arena scratch)
        (sf-mul! arena affine arena point arena (+ scratch 4))
        (sf-mul! arena (+ affine 4) arena (+ point 4) arena (+ scratch 8))
        (sf-mul! arena phi arena affine *sn-beta-words* 0)
        (sf-copy! arena (+ phi 4) arena (+ affine 4))
        (sf-mul! arena suffix arena suffix arena (+ point 8))))
    (sn-jzero! arena out12)
    (loop for bit of-type fixnum downfrom (1- length) to 0 do
      (sn-jdouble! arena out12 out12 scratch)
      (dotimes (stream 4)
        (let ((digit (aref digits (+ (* stream 130) bit))))
          (declare (type (signed-byte 8) digit))
          (unless (zerop digit)
            (let* ((negative (minusp digit))
                   (index (ash (1- (abs digit)) -1))
                   (affine (+ (if (= stream 2) odd-r phi-r) (* index 8))))
              (declare (type fixnum index affine))
              (when (< stream 2)
                ;; Only selected G points are scaled. phi commutes with scaling.
                (let ((source (+ (* stream 256) (* index 8))))
                  (declare (type fixnum source))
                  (sf-mul! arena selected *sn-odd-g* source arena d2)
                  (sf-mul! arena (+ selected 4) *sn-odd-g* (+ source 4) arena d3))
                (setf affine selected))
              (sn-jadd-affine! arena out12 out12 affine negative scratch))))))
    ;; (X:Y:Z) on E_D maps to (X:Y:D*Z) on the original curve.
    (sf-mul! arena (+ out12 8) arena (+ out12 8) arena denominator))
  (values))
