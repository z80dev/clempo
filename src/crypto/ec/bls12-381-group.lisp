;;; Montgomery-arena Jacobian groups. All scratch belongs to the calling operation.
(in-package #:clempo.bls12-381)

(defconstant +g1-jwork-words+ 144)
(defconstant +g2-jwork-words+ 240)
(defconstant +g1-jmul-work-words+ 162)
(defconstant +g2-jmul-work-words+ 276)
(defconstant +bls-x-absolute+ #xd201000000010000)
(defconstant +g1-beta+
  793479390729215512621379701633421447060886740281060493010456487427281649075476305620758731620350)
(defconstant +g2-psi-x-imag+
  4002409555221667392624310435006688643935503118305586438271171395842971157480381377015405980053539358417135540939437)
(defconstant +g2-psi-y-real+
  2973677408986561043442465346520108879172042883009249989176415018091420807192182638567116318576472649347015917690530)
(defconstant +g2-psi-y-imag+
  1028732146235106349975324479215795277384839936929757896155643118032610843298655225875571310552543014690878354869257)

(deftype group-arena () '(simple-array (unsigned-byte 64) (*)))
(defun make-group-arena (words)
  (make-array words :element-type '(unsigned-byte 64) :initial-element 0))

;; Read-only after load; this table is never used as an output or scratch arena.
(defparameter *group-endomorphism-constants*
  (load-time-value
   (let ((a (make-group-arena 30)))
     (fp-from-integer! a 0 +g1-beta+)
     (fp-from-integer! a 12 +g2-psi-x-imag+)
     (fp-from-integer! a 18 +g2-psi-y-real+)
     (fp-from-integer! a 24 +g2-psi-y-imag+)
     a)
   t))

;;; This macro specializes only field operations and coordinate width. The point
;;; formulas are written once; neither group dispatch nor closures enter hot loops.
(defmacro define-limb-group (prefix width)
  (let* ((point-words (* 3 width))
         (scratch-words (+ (* 16 width) 48))
         (mul-scratch (+ point-words scratch-words)))
    (labels ((name (suffix) (intern (format nil "~A-~A" prefix suffix)))
             (rewrite (form)
               (if (atom form) form
                   (let ((field (assoc (car form)
                                       '((fadd! . "ADD!") (fsub! . "SUB!")
                                         (fmul! . "MUL!") (fsquare! . "SQUARE!")
                                         (fneg! . "NEG!") (finv! . "INV!")
                                         (fcopy! . "COPY!") (fzero! . "ZERO!")
                                         (fone! . "ONE!") (fzero-p . "ZERO-P")
                                         (fequal-p . "EQUAL-P")))))
                     (if field
                         `(,(intern (format nil "~A-~A" (if (= width 6) "FP" "F2")
                                            (cdr field)))
                           ,@(mapcar #'rewrite (cdr form))
                           ,@(when (or (eq (car form) 'finv!)
                                       (and (= width 12)
                                            (member (car form) '(fmul! fsquare!))))
                               '(work scratch)))
                         (mapcar #'rewrite form))))))
      (rewrite
       `(progn
          (defun ,(name "JZERO!") (out o)
            (declare #.clempo.base:*hot* (type group-arena out) (type fixnum o))
            (fzero! out o) (fone! out (+ o ,width)) (fzero! out (+ o ,(* 2 width)))
            (values))
          (defun ,(name "JCOPY!") (out o p po)
            (declare #.clempo.base:*hot* (type group-arena out p) (type fixnum o po))
            (dotimes (i ,point-words) (setf (aref out (+ o i)) (aref p (+ po i))))
            (values))
          (defun ,(name "JNEG!") (out o p po)
            (declare #.clempo.base:*hot* (type group-arena out p) (type fixnum o po))
            (,(name "JCOPY!") out o p po)
            (fneg! out (+ o ,width) out (+ o ,width)) (values))
          (defun ,(name "JFROM-AFFINE!") (out o point)
            (declare #.clempo.base:*hot* (type group-arena out) (type fixnum o))
            (if (null point) (,(name "JZERO!") out o)
                (progn
                  ,@(if (= width 6)
                        '((fp-from-integer! out o (car point))
                          (fp-from-integer! out (+ o 6) (cdr point)))
                        '((fp-from-integer! out o (caar point))
                          (fp-from-integer! out (+ o 6) (cdar point))
                          (fp-from-integer! out (+ o 12) (cadr point))
                          (fp-from-integer! out (+ o 18) (cddr point))))
                  (fone! out (+ o ,(* 2 width)))))
            (values))
          (defun ,(name "JTO-AFFINE") (p po work wo)
            (declare #.clempo.base:*hot* (type group-arena p work) (type fixnum po wo))
            (unless (fzero-p p (+ po ,(* 2 width)))
              (let ((scratch (+ wo ,(* 16 width))))
                (declare (type fixnum scratch))
                (fone! work wo)
                (when (fequal-p p (+ po ,(* 2 width)) work wo)
                  (return-from ,(name "JTO-AFFINE")
                    ,(if (= width 6)
                         '(cons (fp-to-integer p po) (fp-to-integer p (+ po 6)))
                         '(cons (cons (fp-to-integer p po) (fp-to-integer p (+ po 6)))
                                (cons (fp-to-integer p (+ po 12))
                                      (fp-to-integer p (+ po 18)))))))
                (finv! work wo p (+ po ,(* 2 width)))
                (fsquare! work (+ wo ,width) work wo)
                (fmul! work (+ wo ,(* 2 width)) p po work (+ wo ,width))
                (fmul! work (+ wo ,width) work (+ wo ,width) work wo)
                (fmul! work (+ wo ,(* 3 width)) p (+ po ,width) work (+ wo ,width))
                ,(if (= width 6)
                     '(cons (fp-to-integer work (+ wo 12)) (fp-to-integer work (+ wo 18)))
                     '(cons (cons (fp-to-integer work (+ wo 24))
                                  (fp-to-integer work (+ wo 30)))
                            (cons (fp-to-integer work (+ wo 36))
                                  (fp-to-integer work (+ wo 42))))))))
          (defun ,(name "JDOUBLE!") (out o p po work wo)
            (declare #.clempo.base:*hot* (type group-arena out p work)
                     (type fixnum o po wo))
            (if (or (fzero-p p (+ po ,(* 2 width))) (fzero-p p (+ po ,width)))
                (,(name "JZERO!") out o)
                (let ((a wo) (b (+ wo ,width)) (c (+ wo ,(* 2 width)))
                      (d (+ wo ,(* 3 width))) (e (+ wo ,(* 4 width)))
                      (x (+ wo ,(* 5 width))) (y (+ wo ,(* 6 width)))
                      (z (+ wo ,(* 7 width))) (scratch (+ wo ,(* 16 width))))
                  (declare (type fixnum a b c d e x y z scratch))
                  (declare (ignorable scratch))
                  ;; a=X^2, b=Y^2, c=b^2, d=4*X*b, e=3*a.
                  (fsquare! work a p po) (fsquare! work b p (+ po ,width))
                  (fsquare! work c work b)
                  (fmul! work d p po work b)
                  (fadd! work d work d work d) (fadd! work d work d work d)
                  (fadd! work e work a work a) (fadd! work e work e work a)
                  (fsquare! work x work e)
                  (fsub! work x work x work d) (fsub! work x work x work d)
                  (fsub! work y work d work x) (fmul! work y work e work y)
                  (fadd! work c work c work c) (fadd! work c work c work c)
                  (fadd! work c work c work c) (fsub! work y work y work c)
                  (fmul! work z p (+ po ,width) p (+ po ,(* 2 width)))
                  (fadd! work z work z work z)
                  ;; Commit last: OUT may be exactly P.
                  (fcopy! out o work x) (fcopy! out (+ o ,width) work y)
                  (fcopy! out (+ o ,(* 2 width)) work z)))
            (values))
          (defun ,(name "JADD!") (out o p po q qo work wo)
            (declare #.clempo.base:*hot* (type group-arena out p q work)
                     (type fixnum o po qo wo))
            (cond ((fzero-p p (+ po ,(* 2 width))) (,(name "JCOPY!") out o q qo))
                  ((fzero-p q (+ qo ,(* 2 width))) (,(name "JCOPY!") out o p po))
                  (t
                   (let ((z1 wo) (z2 (+ wo ,width)) (u1 (+ wo ,(* 2 width)))
                         (u2 (+ wo ,(* 3 width))) (s1 (+ wo ,(* 4 width)))
                         (s2 (+ wo ,(* 5 width))) (h (+ wo ,(* 6 width)))
                         (r (+ wo ,(* 7 width))) (hh (+ wo ,(* 8 width)))
                         (hhh (+ wo ,(* 9 width))) (v (+ wo ,(* 10 width)))
                         (x (+ wo ,(* 11 width))) (y (+ wo ,(* 12 width)))
                         (z (+ wo ,(* 13 width))) (scratch (+ wo ,(* 16 width))))
                     (declare (type fixnum z1 z2 u1 u2 s1 s2 h r hh hhh v x y z scratch))
                     (declare (ignorable scratch))
                     (fsquare! work z1 p (+ po ,(* 2 width)))
                     (fsquare! work z2 q (+ qo ,(* 2 width)))
                     (fmul! work u1 p po work z2) (fmul! work u2 q qo work z1)
                     (fmul! work s1 work z2 q (+ qo ,(* 2 width)))
                     (fmul! work s1 work s1 p (+ po ,width))
                     (fmul! work s2 work z1 p (+ po ,(* 2 width)))
                     (fmul! work s2 work s2 q (+ qo ,width))
                     (fsub! work h work u2 work u1) (fsub! work r work s2 work s1)
                     (cond ((fzero-p work h)
                            (if (fzero-p work r) (,(name "JDOUBLE!") out o p po work wo)
                                (,(name "JZERO!") out o)))
                           (t
                            (fsquare! work hh work h) (fmul! work hhh work hh work h)
                            (fmul! work v work u1 work hh) (fsquare! work x work r)
                            (fsub! work x work x work hhh)
                            (fsub! work x work x work v) (fsub! work x work x work v)
                            (fsub! work y work v work x) (fmul! work y work y work r)
                            (fmul! work s1 work s1 work hhh) (fsub! work y work y work s1)
                            (fmul! work z p (+ po ,(* 2 width)) q (+ qo ,(* 2 width)))
                            (fmul! work z work z work h)
                            (fcopy! out o work x) (fcopy! out (+ o ,width) work y)
                            (fcopy! out (+ o ,(* 2 width)) work z))))))
            (values))
          ;; Q must have Z=1 or Z=0. Buckets receive affine inputs, so avoid
          ;; computing their unit Z powers on every insertion.
          (defun ,(name "JADD-AFFINE!") (out o p po q qo work wo)
            (declare #.clempo.base:*hot* (type group-arena out p q work)
                     (type fixnum o po qo wo))
            (cond ((fzero-p p (+ po ,(* 2 width))) (,(name "JCOPY!") out o q qo))
                  ((fzero-p q (+ qo ,(* 2 width))) (,(name "JCOPY!") out o p po))
                  (t
                   (let ((z1 wo) (u2 (+ wo ,width)) (s2 (+ wo ,(* 2 width)))
                         (h (+ wo ,(* 3 width))) (r (+ wo ,(* 4 width)))
                         (hh (+ wo ,(* 5 width))) (hhh (+ wo ,(* 6 width)))
                         (v (+ wo ,(* 7 width))) (x (+ wo ,(* 8 width)))
                         (y (+ wo ,(* 9 width))) (z (+ wo ,(* 10 width)))
                         (scratch (+ wo ,(* 16 width))))
                     (declare (type fixnum z1 u2 s2 h r hh hhh v x y z scratch))
                     (declare (ignorable scratch))
                     (fsquare! work z1 p (+ po ,(* 2 width)))
                     (fmul! work u2 q qo work z1)
                     (fmul! work s2 work z1 p (+ po ,(* 2 width)))
                     (fmul! work s2 work s2 q (+ qo ,width))
                     (fsub! work h work u2 p po)
                     (fsub! work r work s2 p (+ po ,width))
                     (cond ((fzero-p work h)
                            (if (fzero-p work r) (,(name "JDOUBLE!") out o p po work wo)
                                (,(name "JZERO!") out o)))
                           (t
                            (fsquare! work hh work h) (fmul! work hhh work hh work h)
                            (fmul! work v p po work hh) (fsquare! work x work r)
                            (fsub! work x work x work hhh)
                            (fsub! work x work x work v) (fsub! work x work x work v)
                            (fsub! work y work v work x) (fmul! work y work y work r)
                            (fmul! work s2 p (+ po ,width) work hhh)
                            (fsub! work y work y work s2)
                            (fmul! work z p (+ po ,(* 2 width)) work h)
                            (fcopy! out o work x) (fcopy! out (+ o ,width) work y)
                            (fcopy! out (+ o ,(* 2 width)) work z))))))
            (values))
          (defun ,(name "JEQUAL-P") (p po q qo work wo)
            (declare #.clempo.base:*hot* (type group-arena p q work)
                     (type fixnum po qo wo))
            (let ((scratch (+ wo ,(* 16 width))))
              (declare (type fixnum scratch))
              (declare (ignorable scratch))
              (cond ((fzero-p p (+ po ,(* 2 width))) (fzero-p q (+ qo ,(* 2 width))))
                    ((fzero-p q (+ qo ,(* 2 width))) nil)
                    (t
                     (fsquare! work wo p (+ po ,(* 2 width)))
                     (fsquare! work (+ wo ,width) q (+ qo ,(* 2 width)))
                     (fmul! work (+ wo ,(* 2 width)) p po work (+ wo ,width))
                     (fmul! work (+ wo ,(* 3 width)) q qo work wo)
                     (and (fequal-p work (+ wo ,(* 2 width)) work (+ wo ,(* 3 width)))
                          (progn
                            (fmul! work wo work wo p (+ po ,(* 2 width)))
                            (fmul! work (+ wo ,width) work (+ wo ,width) q (+ qo ,(* 2 width)))
                            (fmul! work (+ wo ,(* 2 width)) p (+ po ,width) work (+ wo ,width))
                            (fmul! work (+ wo ,(* 3 width)) q (+ qo ,width) work wo)
                            (fequal-p work (+ wo ,(* 2 width)) work (+ wo ,(* 3 width)))))))))
          (defun ,(name "JMUL!") (out o p po scalar work wo)
            (declare #.clempo.base:*hot* (type group-arena out p work)
                     (type fixnum o po wo) (type integer scalar))
            (when (or (zerop scalar) (fzero-p p (+ po ,(* 2 width))))
              (,(name "JZERO!") out o)
              (return-from ,(name "JMUL!") (values)))
            ;; Read |scalar|'s bits directly, including negative bignums: forming
            ;; (- scalar) here would allocate. Above its lowest set bit, the
            ;; magnitude of a negative two's-complement integer complements it.
            (,(name "JCOPY!") work wo p po)
            (let ((negative (minusp scalar)) (low 0)
                  (top (1- (integer-length scalar))))
              (declare (type fixnum low top))
              (when negative
                (loop until (logbitp low scalar) do (incf low))
                (setf top (max top low))
                (,(name "JNEG!") work wo work wo))
              (fone! work (+ wo ,point-words))
              (let ((affine (fequal-p work (+ wo ,(* 2 width)) work (+ wo ,point-words))))
                (,(name "JZERO!") out o)
                (loop for bit of-type fixnum downfrom top to 0 do
                  (,(name "JDOUBLE!") out o out o work (+ wo ,point-words))
                  (when (if negative
                            (or (= bit low) (and (> bit low) (not (logbitp bit scalar))))
                            (logbitp bit scalar))
                    (if affine
                        (,(name "JADD-AFFINE!") out o out o work wo work (+ wo ,point-words))
                        (,(name "JADD!") out o out o work wo work (+ wo ,point-words)))))))
            (values))
          (defun ,(name "ADD") (p q)
            (let ((arena (make-group-arena ,(+ (* 2 point-words) scratch-words))))
              (,(name "JFROM-AFFINE!") arena 0 p)
              (,(name "JFROM-AFFINE!") arena ,point-words q)
              (,(name "JADD-AFFINE!") arena 0 arena 0 arena ,point-words arena ,(* 2 point-words))
              (,(name "JTO-AFFINE") arena 0 arena ,(* 2 point-words))))
          (defun ,(name "NEG") (p)
            (when p
              (let ((arena (make-group-arena ,point-words)))
                (,(name "JFROM-AFFINE!") arena 0 p)
                (,(name "JNEG!") arena 0 arena 0)
                ,(if (= width 6)
                     '(cons (fp-to-integer arena 0) (fp-to-integer arena 6))
                     '(cons (cons (fp-to-integer arena 0) (fp-to-integer arena 6))
                            (cons (fp-to-integer arena 12) (fp-to-integer arena 18)))))))
          (defun ,(name "MUL") (p scalar)
            (unless (integerp scalar) (invalid))
            (let ((arena (make-group-arena ,(+ point-words mul-scratch))))
              (,(name "JFROM-AFFINE!") arena 0 p)
              (,(name "JMUL!") arena 0 arena 0 scalar arena ,point-words)
              (,(name "JTO-AFFINE") arena 0 arena ,point-words)))
          (defun ,(name "AFFINE-CANONICAL-P") (p)
            (or (null p)
                (and (consp p)
                     ,(if (= width 6)
                          '(and (fp-canonical-p (car p)) (fp-canonical-p (cdr p)))
                          '(and (f2-canonical-p (car p)) (f2-canonical-p (cdr p)))))))
          ;; P is imported affine (Z=1 or zero), not an arbitrary Jacobian.
          (defun ,(name "JAFFINE-ON-CURVE-P") (p po work wo)
            (declare #.clempo.base:*hot* (type group-arena p work)
                     (type fixnum po wo))
            (or (fzero-p p (+ po ,(* 2 width)))
                (let ((scratch (+ wo ,(* 16 width))))
                  (declare (type fixnum scratch))
                  (declare (ignorable scratch))
                  (fsquare! work wo p po)
                  (fmul! work wo work wo p po)
                  ,@(if (= width 6)
                        `((fp-one! work (+ wo ,width)))
                        `((fp-one! work (+ wo ,width))
                          (fp-one! work (+ wo ,(+ width 6)))))
                  (fadd! work (+ wo ,width) work (+ wo ,width) work (+ wo ,width))
                  (fadd! work (+ wo ,width) work (+ wo ,width) work (+ wo ,width))
                  (fadd! work wo work wo work (+ wo ,width))
                  (fsquare! work (+ wo ,width) p (+ po ,width))
                  (fequal-p work wo work (+ wo ,width)))))
          (defun ,(name "ON-CURVE-P") (p)
            (or (null p)
                (and (,(name "AFFINE-CANONICAL-P") p)
                     (let ((arena (make-group-arena ,(+ point-words scratch-words))))
                       (,(name "JFROM-AFFINE!") arena 0 p)
                       (,(name "JAFFINE-ON-CURVE-P") arena 0 arena ,point-words)))))
          (defun ,(name "MSM") (points scalars)
            (declare #.clempo.base:*hot*)
            (let* ((n (length points))
                   (width (cond ((< n 8) 2) ((< n 32) 3) ((< n 128) 5)
                                ((< n 512) 6) (t 8)))
                   (count (ash 1 width)) (bits 0)
                   (bucket-base (* n ,point-words))
                   (acc (+ bucket-base (* count ,point-words)))
                   (running (+ acc ,point-words)) (wo (+ running ,point-words))
                   (arena (make-group-arena (+ wo ,scratch-words)))
                   ;; A vector allows one O(n) pass per window for lists as well.
                   (ss (coerce scalars 'simple-vector)))
              (declare (type simple-vector ss)
                       (type fixnum n width count bits bucket-base acc running wo))
              (unless (= n (length ss)) (invalid))
              (dotimes (i n)
                (let ((s (aref ss i)))
                  (unless (and (integerp s) (not (minusp s))) (invalid))
                  (setf bits (max bits (integer-length s)))))
              (let ((i 0))
                (declare (type fixnum i))
                (map nil (lambda (p)
                           (,(name "JFROM-AFFINE!") arena (* i ,point-words) p)
                           (incf i)) points))
              (,(name "JZERO!") arena acc)
              (loop for offset of-type fixnum from (* width (1- (ceiling bits width)))
                    downto 0 by width do
                (dotimes (i width) (,(name "JDOUBLE!") arena acc arena acc arena wo))
                ;; Reuse all buckets and scratch across windows. Only Z is read
                ;; for an empty bucket; no per-window array allocation or clearing X/Y.
                (dotimes (i count)
                  (fzero! arena (+ bucket-base (* i ,point-words) ,(* 2 width))))
                (dotimes (i n)
                  (let ((digit (ldb (byte width offset) (aref ss i))))
                    (declare (type fixnum digit))
                    (unless (zerop digit)
                      (let ((bucket (+ bucket-base (* digit ,point-words))))
                        (declare (type fixnum bucket))
                        (,(name "JADD-AFFINE!") arena bucket arena bucket arena (* i ,point-words)
                                                arena wo)))))
                (,(name "JZERO!") arena running)
                (loop for i of-type fixnum downfrom (1- count) to 1 do
                  (,(name "JADD!") arena running arena running
                                          arena (+ bucket-base (* i ,point-words)) arena wo)
                  (,(name "JADD!") arena acc arena acc arena running arena wo)))
              (,(name "JTO-AFFINE") arena acc arena wo))))))))

(define-limb-group g1 6)
(define-limb-group g2 12)

;;; Ark BLS12-381's subgroup criteria (2021/1130, sections 6 and 4).
;;; beta^3=1, beta!=1, phi(P)=(beta*X,Y,Z)=-[x^2]P on G1[r].
;;; psi(P)=(conj(X)*xi^((1-p)/3),conj(Y)*xi^((1-p)/2),conj(Z))
;;; equals [x]P on G2[r], with x=-0xd201000000010000 and xi=1+i.
(defun g1-subgroup-p (p)
  (or (null p)
      (and (g1-affine-canonical-p p)
           (let ((a (make-group-arena (+ 54 +g1-jmul-work-words+))))
             (g1-jfrom-affine! a 0 p)
             (and (g1-jaffine-on-curve-p a 0 a 54)
                  (progn
                    (g1-jmul! a 18 a 0 +bls-x-absolute+ a 54)
                    ;; Exclude nonzero points fixed by multiplication by |x|.
                    (and (not (g1-jequal-p a 0 a 18 a 54))
                         (progn
                           (g1-jmul! a 18 a 18 +bls-x-absolute+ a 54)
                           (g1-jneg! a 18 a 18)
                           (g1-jcopy! a 36 a 0)
                           (fp-mul! a 36 a 36 *group-endomorphism-constants* 0)
                           (g1-jequal-p a 18 a 36 a 54)))))))))

(defun g2-subgroup-p (p)
  (or (null p)
      (and (g2-affine-canonical-p p)
           (let ((a (make-group-arena (+ 108 +g2-jmul-work-words+))))
             (g2-jfrom-affine! a 0 p)
             (and (g2-jaffine-on-curve-p a 0 a 108)
                  (progn
                    (g2-jmul! a 36 a 0 (- +bls-x-absolute+) a 108)
                    (g2-jcopy! a 72 a 0)
                    (fp-neg! a 78 a 78) (fp-neg! a 90 a 90)
                    ;; Input is affine: conjugate Z=1 is unchanged.
                    (f2-mul! a 72 a 72 *group-endomorphism-constants* 6 a 108)
                    (f2-mul! a 84 a 84 *group-endomorphism-constants* 18 a 108)
                    (g2-jequal-p a 36 a 72 a 108)))))))
