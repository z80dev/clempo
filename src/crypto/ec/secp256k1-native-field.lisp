;;; Canonical ordinary four-word residues; 2^256 = 2^32+977 modulo p.
(defpackage #:clempo.secp256k1
  (:use #:cl)
  (:import-from #:clempo.base #:octets #:octets->integer #:integer->octets #:octets-concat)
  (:export #:ecrecover #:ecrecover-address #:make-recovery-scratch #:recovery-scratch #:*recovery-scratch*
           #:pubkey->address #:sign #:private->public #:ecdh
           #:+secp256k1-n+ #:+secp256k1-p+))
(in-package #:clempo.secp256k1)
(defconstant +secp256k1-p+ #xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2f)
(defconstant +secp256k1-n+ #xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141)
(deftype secp-words () '(simple-array (unsigned-byte 64) (*)))
(declaim (maybe-inline sf-mul! sf-add! sf-sub! sf-neg!))

(defmacro integer-limb (integer index)
  `(if (typep ,integer 'fixnum) ,(if (zerop index) integer 0)
       (if (< ,index (sb-bignum:%bignum-length ,integer))
           (sb-bignum::%bignum-ref ,integer ,index) 0)))
(declaim (inline mul-add-word))
(defun mul-add-word (a b c d)
  (declare #.clempo.base:*hot* (type (unsigned-byte 64) a b c d))
  ;; SBCL 2.6.8 ARM64's four-argument multiply-add can alias Y with HI.
  (multiple-value-bind (hi lo) (sb-bignum::%multiply-and-add a b c)
    (multiple-value-bind (low carry) (sb-bignum::%add-with-carry lo d 0)
      (values (ldb (byte 64 0) (+ hi carry)) low))))

(defmacro sf-fold-store (out off w0 w1 w2 w3 w4 w5 w6 w7)
  (let ((rs (loop repeat 4 collect (gensym "R"))) (hi (gensym)) (carry (gensym)))
    `(let (,@(loop for r in rs collect `(,r 0)) (,hi 0) (,carry 0))
       (declare (type (unsigned-byte 64) ,@rs ,hi) (type bit ,carry))
       ,@(loop for r in rs for high in (list w4 w5 w6 w7)
               for low in (list w0 w1 w2 w3) for i from 0 collect
           `(setf (values ,hi ,r) (mul-add-word ,high #x1000003d1 ,low ,(if (zerop i) 0 hi))))
       (setf (values ,hi ,(first rs))
             (sb-bignum::%multiply-and-add ,hi #x1000003d1 ,(first rs)))
       ,@(loop for r in (rest rs) for i from 0 collect
           `(setf (values ,r ,carry)
                  (sb-bignum::%add-with-carry ,r ,(if (zerop i) hi 0) ,(if (zerop i) 0 carry))))
       (when (= ,carry 1)
         ,@(loop for r in rs for i from 0 collect
             `(setf (values ,r ,carry)
                    (sb-bignum::%add-with-carry ,r ,(if (zerop i) #x1000003d1 0)
                                              ,(if (zerop i) 0 carry)))))
       (when (and (= ,(fourth rs) #xffffffffffffffff)
                  (= ,(third rs) #xffffffffffffffff) (= ,(second rs) #xffffffffffffffff)
                  (>= ,(first rs) #xfffffffefffffc2f))
         (setf ,(first rs) (ldb (byte 64 0) (+ ,(first rs) #x1000003d1))
               ,@(loop for r in (rest rs) append (list r 0))))
       ,@(loop for r in rs for i from 0 collect `(setf (aref ,out (+ ,off ,i)) ,r))
       (values))))

(defmacro define-sf-multiply ()
  (let ((as (loop repeat 4 collect (gensym "A")))
        (bs (loop repeat 4 collect (gensym "B")))
        (rs (loop repeat 8 collect (gensym "R"))) (carry (gensym)))
    `(defun sf-mul! (out o a ao b bo)
       (declare #.clempo.base:*hot* (type secp-words out a b) (type fixnum o ao bo))
       (let (,@(loop for x in as for i from 0 collect `(,x (aref a (+ ao ,i))))
             ,@(loop for x in bs for i from 0 collect `(,x (aref b (+ bo ,i))))
             ,@(loop for x in rs collect `(,x 0)) (,carry 0))
         (declare (type (unsigned-byte 64) ,@as ,@bs ,@rs ,carry))
         ,@(loop for x in as for i from 0 append
             (append (list `(setf ,carry 0))
                     (loop for y in bs for j from 0 collect
                       `(setf (values ,carry ,(nth (+ i j) rs))
                              (mul-add-word ,x ,y ,(nth (+ i j) rs) ,carry)))
                     (list `(setf ,(nth (+ i 4) rs) ,carry))))
         (sf-fold-store out o ,@rs)))))
(define-sf-multiply)
(declaim (inline sf-square! sf-copy! sf-zero! sf-one! sf-zero-p sf-equal-p))
(defun sf-square! (out o a ao) (sf-mul! out o a ao a ao))
(defun sf-copy! (out o a ao)
  (declare #.clempo.base:*hot* (type secp-words out a) (type fixnum o ao))
  (dotimes (i 4) (setf (aref out (+ o i)) (aref a (+ ao i)))) (values))
(defun sf-zero! (out o)
  (declare #.clempo.base:*hot* (type secp-words out) (type fixnum o))
  (dotimes (i 4) (setf (aref out (+ o i)) 0)) (values))
(defun sf-one! (out o) (sf-zero! out o) (setf (aref out o) 1) (values))
(defun sf-zero-p (a ao)
  (declare #.clempo.base:*hot* (type secp-words a) (type fixnum ao))
  (zerop (logior (aref a ao) (aref a (+ ao 1)) (aref a (+ ao 2)) (aref a (+ ao 3)))))
(defun sf-equal-p (a ao b bo)
  (declare #.clempo.base:*hot* (type secp-words a b) (type fixnum ao bo))
  (and (= (aref a ao) (aref b bo)) (= (aref a (+ ao 1)) (aref b (+ bo 1)))
       (= (aref a (+ ao 2)) (aref b (+ bo 2))) (= (aref a (+ ao 3)) (aref b (+ bo 3)))))

(defmacro define-sf-add-sub ()
  `(progn
     ,@(loop for subtract in '(nil t) for name in '(sf-add! sf-sub!)
             for op = (if subtract 'sb-bignum::%subtract-with-borrow 'sb-bignum::%add-with-carry)
             collect
       `(defun ,name (out o a ao b bo)
          (declare #.clempo.base:*hot* (type secp-words out a b) (type fixnum o ao bo))
          (let ((r0 0) (r1 0) (r2 0) (r3 0) (carry ,(if subtract 1 0)))
            (declare (type (unsigned-byte 64) r0 r1 r2 r3) (type bit carry))
            ,@(loop for r in '(r0 r1 r2 r3) for i from 0 collect
                `(setf (values ,r carry) (,op (aref a (+ ao ,i)) (aref b (+ bo ,i)) carry)))
            ,(if subtract
                 `(when (zerop carry)
                    (setf (values r0 carry) (sb-bignum::%subtract-with-borrow r0 #x1000003d1 1)
                          (values r1 carry) (sb-bignum::%subtract-with-borrow r1 0 carry)
                          (values r2 carry) (sb-bignum::%subtract-with-borrow r2 0 carry)
                          r3 (sb-bignum::%subtract-with-borrow r3 0 carry)))
                 `(if (= carry 1)
                      (setf (values r0 carry) (sb-bignum::%add-with-carry r0 #x1000003d1 0)
                            (values r1 carry) (sb-bignum::%add-with-carry r1 0 carry)
                            (values r2 carry) (sb-bignum::%add-with-carry r2 0 carry)
                            r3 (sb-bignum::%add-with-carry r3 0 carry))
                      (when (and (= r3 #xffffffffffffffff) (= r2 #xffffffffffffffff)
                                 (= r1 #xffffffffffffffff) (>= r0 #xfffffffefffffc2f))
                        (setf r0 (ldb (byte 64 0) (+ r0 #x1000003d1)) r1 0 r2 0 r3 0))))
            (setf (aref out o) r0 (aref out (+ o 1)) r1
                  (aref out (+ o 2)) r2 (aref out (+ o 3)) r3) (values))))))
(define-sf-add-sub)
(defun sf-neg! (out o a ao)
  (declare #.clempo.base:*hot* (type secp-words out a) (type fixnum o ao))
  (if (sf-zero-p a ao) (sf-zero! out o)
      (let ((r0 0) (r1 0) (r2 0) (r3 0) (carry 1))
        (declare (type (unsigned-byte 64) r0 r1 r2 r3) (type bit carry))
        (setf (values r0 carry) (sb-bignum::%subtract-with-borrow #xfffffffefffffc2f (aref a ao) carry)
              (values r1 carry) (sb-bignum::%subtract-with-borrow #xffffffffffffffff (aref a (+ ao 1)) carry)
              (values r2 carry) (sb-bignum::%subtract-with-borrow #xffffffffffffffff (aref a (+ ao 2)) carry)
              r3 (sb-bignum::%subtract-with-borrow #xffffffffffffffff (aref a (+ ao 3)) carry)
              (aref out o) r0 (aref out (+ o 1)) r1 (aref out (+ o 2)) r2 (aref out (+ o 3)) r3)))
  (values))

(defun sf-from-integer! (out o integer)
  "Import a canonical nonnegative integer, already checked at the public boundary."
  (declare #.clempo.base:*hot* (type secp-words out) (type fixnum o)
           (type (integer 0 #xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2e) integer))
  (setf (aref out o) (integer-limb integer 0) (aref out (+ o 1)) (integer-limb integer 1)
        (aref out (+ o 2)) (integer-limb integer 2) (aref out (+ o 3)) (integer-limb integer 3)) (values))
(defun sf-to-integer (a ao)
  (declare #.clempo.base:*hot* (type secp-words a) (type fixnum ao))
  (when (and (zerop (aref a (+ ao 1))) (zerop (aref a (+ ao 2))) (zerop (aref a (+ ao 3))))
    (return-from sf-to-integer (aref a ao)))
  (let ((out (sb-bignum::%allocate-bignum 5)))
    (dotimes (i 4) (setf (sb-bignum::%bignum-ref out i) (aref a (+ ao i))))
    (setf (sb-bignum::%bignum-ref out 4) 0)
    (sb-bignum::%normalize-bignum out 5)))

(declaim (inline read-word64-be))
(defun read-word64-be (bytes start)
  (declare #.clempo.base:*hot* (type octets bytes) (type fixnum start))
  (logior (ash (aref bytes start) 56) (ash (aref bytes (+ start 1)) 48)
          (ash (aref bytes (+ start 2)) 40) (ash (aref bytes (+ start 3)) 32)
          (ash (aref bytes (+ start 4)) 24) (ash (aref bytes (+ start 5)) 16)
          (ash (aref bytes (+ start 6)) 8) (aref bytes (+ start 7))))
(defun sw-read32! (out o bytes start)
  (declare #.clempo.base:*hot* (type secp-words out) (type octets bytes) (type fixnum o start))
  (dotimes (i 4) (setf (aref out (+ o i)) (read-word64-be bytes (+ start (* 8 (- 3 i)))))) (values))
(defun sw-write32! (bytes start a ao)
  (declare #.clempo.base:*hot* (type secp-words a) (type octets bytes) (type fixnum start ao))
  (dotimes (i 4)
    (let ((word (aref a (+ ao i))))
      (declare (type (unsigned-byte 64) word))
      (dotimes (j 8)
        (setf (aref bytes (+ start (* 8 (- 3 i)) j)) (ldb (byte 8 (* 8 (- 7 j))) word)))))
  (values))

(defun sf-square-times! (out o a ao count)
  (declare #.clempo.base:*hot* (type secp-words out a) (type fixnum o ao count))
  (sf-copy! out o a ao) (dotimes (i count) (sf-square! out o out o)) (values))
(defun sf-power223! (out o a ao work wo)
  "Build a^(2^223-1); retain a,a^3,a^(2^22-1),a^7 in 16 work words."
  (declare #.clempo.base:*hot* (type secp-words out a work) (type fixnum o ao wo))
  (sf-copy! work wo a ao)
  (sf-square! out o work wo) (sf-mul! work (+ wo 4) out o work wo)
  (sf-square! out o work (+ wo 4)) (sf-mul! out o out o work wo)
  (sf-copy! work (+ wo 12) out o)
  (sf-square-times! out o out o 3) (sf-mul! out o out o work (+ wo 12))
  (sf-square-times! out o out o 3) (sf-mul! out o out o work (+ wo 12))
  (sf-square-times! out o out o 2) (sf-mul! out o out o work (+ wo 4))
  (sf-copy! work (+ wo 8) out o)
  (sf-square-times! out o out o 11) (sf-mul! out o out o work (+ wo 8))
  (sf-copy! work (+ wo 8) out o)
  (sf-square-times! out o out o 22) (sf-mul! out o out o work (+ wo 8))
  (sf-copy! work (+ wo 12) out o)
  (dotimes (i 4)
    (sf-square-times! out o out o 44) (sf-mul! out o out o work (+ wo 12)))
  (sf-square! work (+ wo 12) work (+ wo 4))
  (sf-mul! work (+ wo 12) work (+ wo 12) work wo)
  (sf-square-times! out o out o 3) (sf-mul! out o out o work (+ wo 12)) (values))
(defun sf-inv! (out o a ao work wo)
  "One fixed addition chain; 16 scratch words disjoint from operands."
  (declare #.clempo.base:*hot* (type secp-words out a work) (type fixnum o ao wo))
  (when (sf-zero-p a ao) (error "Inverse of zero in secp256k1 Fp."))
  (sf-power223! out o a ao work wo)
  (sf-square-times! out o out o 23) (sf-mul! out o out o work (+ wo 8))
  (sf-square-times! out o out o 5) (sf-mul! out o out o work wo)
  (sf-square-times! out o out o 3) (sf-mul! out o out o work (+ wo 4))
  (sf-square-times! out o out o 2) (sf-mul! out o out o work wo) (values))
(defun sf-sqrt! (out o a ao work wo)
  "a^((p+1)/4); caller verifies the square. Same 16-word scratch contract."
  (declare #.clempo.base:*hot* (type secp-words out a work) (type fixnum o ao wo))
  (sf-power223! out o a ao work wo)
  (sf-square-times! out o out o 23) (sf-mul! out o out o work (+ wo 8))
  (sf-square-times! out o out o 6) (sf-mul! out o out o work (+ wo 4))
  (sf-square-times! out o out o 2) (values))
