    (sf-square-times! out o out o 44) (sf-mul! out o out o work (+ wo 12)))
  (sf-square! work (+ wo 12) work (+ wo 4))
  (sf-mul! work (+ wo 12) work (+ wo 12) work wo)
  (sf-square-times! out o out o 3) (sf-mul! out o out o work (+ wo 12)) (values))
(defun sf-inv! (out o a ao work wo)
  "One fixed addition chain; 16 scratch words disjoint from operands."
  (declare #.clempo.base:*hot* (type secp-words out a work) (type fixnum o ao wo))
  (when (sf-zero-p a ao) (error "Inverse of zero in secp256k1 Fp."))
  (sf-power223! out o a ao work wo)
  (sf-square-times! out o out o 23) (sf-mul! out o out o work (+ wo 8))
  (sf-square-times! out o out o 5) (sf-mul! out o out o work wo)
  (sf-square-times! out o out o 3) (sf-mul! out o out o work (+ wo 4))
  (sf-square-times! out o out o 2) (sf-mul! out o out o work wo) (values))
(defun sf-sqrt! (out o a ao work wo)
  "a^((p+1)/4); caller verifies the square. Same 16-word scratch contract."
  (declare #.clempo.base:*hot* (type secp-words out a work) (type fixnum o ao wo))
  (sf-power223! out o a ao work wo)
  (sf-square-times! out o out o 23) (sf-mul! out o out o work (+ wo 8))
  (sf-square-times! out o out o 6) (sf-mul! out o out o work (+ wo 4))
  (sf-square-times! out o out o 2) (values))
